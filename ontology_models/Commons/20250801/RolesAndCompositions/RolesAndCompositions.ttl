@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cmns-rlcmp: a owl:Ontology ;
    rdfs:label "Commons Roles and Compositions Ontology",
        "Commons 角色与组合本体（Commons Roles and Compositions Ontology）"@zh ;
    dct:abstract "This ontology defines the high-level things defining roles, which enable specification of the various participants in something, and the notion of a composition, i.e., relating something that is a specification for a 'whole', such as a product or recipe, to its ingredients or constituents, potentially with respect to some context-specific requirements." ;
    dct:contributor "Dean Allemang, Working Ontologist",
        "Elisa Kendall, Thematix Partners LLC" ;
    dct:license "https://opensource.org/licenses/MIT"^^xsd:anyURI ;
    rdfs:comment "定义角色、组合及其扮演/组成关系的基础本体。"@zh ;
    owl:imports cmns-av:,
        cmns-col:,
        cmns-cxtdsg:,
        <https://www.omg.org/spec/Commons/DatesAndTimes/>,
        <https://www.omg.org/spec/Commons/Designators/> ;
    owl:versionIRI <https://www.omg.org/spec/Commons/20230801/RolesAndCompositions/> ;
    skos:note "This ontology was derived from the Financial Industry Business Ontology (FIBO) and extended based on usage in other projects, such as the Pistoia Alliance Identification of Medicinal Products (IDMP) ontology project." ;
    cmns-av:copyright "Copyright (c) 2020-2023 EDM Council, Inc.",
        "Copyright (c) 2020-2023 Thematix Partners LLC",
        "Copyright (c) 2020-2023 Working Ontologist LLC",
        "Copyright (c) 2022-2023 Pistoia Alliance, Inc.",
        "Copyright (c) 2023 Object Management Group, Inc." .

cmns-rlcmp:Composition a owl:Class ;
    rdfs:label "composition",
        "组合（composition）"@zh ;
    rdfs:comment "为特定目的将其他事物（可能以特定角色）组合在一起而形成的特定产物。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-cxtdsg:Context ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom cmns-col:Constituent ;
            owl:onProperty cmns-col:hasConstituent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cmns-rlcmp:Role ;
            owl:onProperty cmns-rlcmp:hasRole ] ;
    skos:definition "distinct thing resulting from bringing together other things, possibly in specific roles, for a particular purpose" ;
    cmns-av:adaptedFrom "ISO/IEC 18384-1:2016, Information technology - Reference Architecture for Service Oriented Architecture (SOA RA) - Part 1: Terminology and concepts for SOA, clause 2.5 and ISO/IEC 18384-3:2016, Information technology - Reference Architecture for Service Oriented Architecture (SOA RA) - Part 3: Service Oriented Architecture ontology, clause 8.2",
        "ISO/TS 19807-1:2019(en), Nanotechnologies - Magnetic nanomaterials - Part 1: Specification of characteristics and measurements for magnetic nanosuspensions, clause 3.4" ;
    cmns-av:explanatoryNote "The composition may be specified based on the roles that the things play in the composition, such as the roles that various ingredients play in a recipe or pharmaceutical product, and such things may or may not be transformed in some way through the process of combining them. Quantification including the nature and amount of each thing, potentially including the ratio of the quantities, may be required depending kind of composition." ;
    cmns-av:usageNote "The properties hasConstituent and hasRole are included in value restrictions rather than via number restrictions to facilitate their use in complex property chains and other axioms as needed for some applications." .

cmns-rlcmp:FunctionalRole a owl:Class ;
    rdfs:label "functional role",
        "功能角色（functional role）"@zh ;
    rdfs:comment "表示某人、组织、过程或服务预期执行或提供的底层功能的角色。"@zh ;
    rdfs:subClassOf cmns-rlcmp:Role ;
    skos:definition "role representing an underlying functionality that something, such as a person, organization, process, or service, is expected to perform or deliver" ;
    skos:note "Functional roles can be assigned to be performed during an act." ;
    cmns-av:adaptedFrom "ISO 21298:2017(en), Health informatics - Functional and structural roles, clause 3.9",
        "ISO/IEC 19763-8:2015(en), Information technology - Metamodel framework for interoperability (MFI) - Part 8: Metamodel for role and goal model registration, clause 3.1.2" .

cmns-rlcmp:ProcessRole a owl:Class ;
    rdfs:label "process role",
        "过程角色（process role）"@zh ;
    rdfs:comment "将资源和参与者关联到为特定目的设计并组织的一组涉及多个企业实体的结构化活动的角色。"@zh ;
    rdfs:subClassOf cmns-rlcmp:Role ;
    skos:definition "role that associates resources and participants to a structured set of activities involving various enterprise entities, that is designed and organised for a given purpose" ;
    cmns-av:adaptedFrom "ISO 12651-2:2014(en), Electronic document management - Vocabulary - Part 2: Workflow management, clause 3.33",
        "ISO 18629-1:2004(en), Industrial automation systems and integration - Process specification language - Part 1: Overview and basic principles" .

cmns-rlcmp:StructuralRole a owl:Class ;
    rdfs:label "structural role",
        "结构角色（structural role）"@zh ;
    dct:source "ISO 21298:2017(en), Health informatics - Functional and structural roles, clause 3.26" ;
    rdfs:comment "以能力意义指定实体之间关系的角色，通常反映组织或结构关系（层级）。"@zh ;
    rdfs:subClassOf cmns-rlcmp:Role ;
    skos:definition "role specifying relations between entities in the sense of competence, often reflecting organizational or structural relations (hierarchies)" .

cmns-rlcmp:isManifestedIn a owl:ObjectProperty ;
    rdfs:label "is manifested in",
        "体现在…中（is manifested in）"@zh ;
    rdfs:comment "指示角色在其中实现、出现或发生的事物。"@zh ;
    rdfs:domain cmns-rlcmp:Role ;
    owl:inverseOf cmns-rlcmp:manifests ;
    skos:definition "indicates something in which the role is realized, appears, or occurs" .

cmns-rlcmp:isRoleIn a owl:ObjectProperty ;
    rdfs:label "is role in",
        "是…中的角色（is role in）"@zh ;
    rdfs:comment "识别涉及该角色的某事物，例如组合、情境或合同。"@zh ;
    rdfs:domain cmns-rlcmp:Role ;
    owl:inverseOf cmns-rlcmp:hasRole ;
    skos:definition "identifies something, such as a composition, situation, or contract, involving the role" .

cmns-rlcmp:isPlayedBy a owl:ObjectProperty ;
    rdfs:label "is played by",
        "由…扮演（is played by）"@zh ;
    rdfs:comment "指示填充该角色的人、组织或其他事物。"@zh ;
    rdfs:domain cmns-rlcmp:Role ;
    owl:inverseOf cmns-rlcmp:playsRole ;
    skos:definition "indicates something or someone, such as a person, organization, or other thing filling a role" ;
    skos:example "A party, counterparty, or third party to a contract is played by an organization or person; an issuer of a financial instrument is typically played by an organization; an ingredient in a recipe may be played by a substance." .

cmns-rlcmp:manifests a owl:ObjectProperty ;
    rdfs:label "manifests",
        "体现（manifests）"@zh ;
    rdfs:comment "指示在某种情境中实现、展示或显示某事物的角色。"@zh ;
    rdfs:range cmns-rlcmp:Role ;
    skos:definition "indicates a role that realizes, displays, or shows something, typically in some context" .

cmns-rlcmp:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role",
        "扮演角色（plays role）"@zh ;
    rdfs:comment "指示某人或某事物在某种情境下所扮演的部分。"@zh ;
    rdfs:range cmns-rlcmp:Role ;
    skos:definition "indicates a part that someone or something plays under some circumstance" ;
    skos:example "an organization may play the role of employer, issuer, regulatory agency, bank, custodian, manufacturer, vendor, etc.; a person may play the role of employee, examiner, banker, seller, buyer, etc." .

cmns-rlcmp:hasRole a owl:ObjectProperty ;
    rdfs:label "has role",
        "具有角色（has role）"@zh ;
    rdfs:comment "识别在某事物（例如组合）中扮演部分的角色。"@zh ;
    rdfs:range cmns-rlcmp:Role ;
    skos:definition "identifies something or someone playing a part in something, such as a composition" .

cmns-rlcmp:Role a owl:Class ;
    rdfs:label "role",
        "角色（role）"@zh ;
    rdfs:comment "某事物在特定情境中参与的命名具体行为。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty cmns-rlcmp:isPlayedBy ] ;
    skos:definition "named specific behavior of something participating in a particular context" ;
    cmns-av:adaptedFrom "ISO/IEC 19763-8:2015(en), Information technology - Metamodel framework for interoperability (MFI) - Part 8: Metamodel for role and goal model registration, clause 3.1.7" .

