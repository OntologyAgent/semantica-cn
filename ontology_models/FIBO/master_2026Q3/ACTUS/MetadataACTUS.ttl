See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2026-10-06T18:00:00"^^xsd:dateTime ;
    rdfs:comment "声明 ACTUS 域的构成（合约条款、条款映射、受控词汇三个本体）及版本信息。ACTUS 域把算法合约类型统一标准接入 FIBO。"@zh ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/ACTUS/20261001/MetadataACTUS/> ;
    cmns-av:copyright "Copyright (c) 2024-2025 Object Management Group",
        "Copyright (c) 2024-2026 ACTUS Financial Research Foundation",
        "Copyright (c) 2024-2026 EDM Association dba EDM Council, Inc." .

fibo-actus-mod:ACTUSDomain a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "ACTUS domain" ;
    dcterms:abstract "The FIBO Algorithmic Contract Types Unified Standards (ACTUS) Domain includes several ACTUS controlled vocabularies and maps them to FIBO, providing the corresponding semantics and enabling integration of knowledge graphs based on FIBO with the ACTUS system." ;
    dcterms:contributor "Federated Knowledge, LLC",
        "Intuitive Technology Partners, Inc.",
        "John F. Gemski",
        "Pinnacle Bank (Morgan Hill, California)",
        "ProBanker Simulations, LLC",
        "Tahoe Blue Ltd",
        "Thematix Partners, LLC" ;
    dcterms:hasPart <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTermMapping/>,
        <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/>,
        <https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSTaxonomy/> ;
    dcterms:license """Copyright (c) 2024-2026 ACTUS Financial Research Foundation
Copyright (c) 2024-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2024-2025 Object Management Group

