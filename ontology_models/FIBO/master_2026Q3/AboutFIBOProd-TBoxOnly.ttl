fibo-prod-tbox: a owl:Ontology ;
    rdfs:label "About FIBO Production - T-Box Only",
        "FIBO 生产版总入口·仅术语层（About FIBO Production, TBox Only）"@zh ;
    dcterms:abstract "This ontology is provided for the convenience of FIBO users. It loads the latest FIBO production ontologies, excluding reference data and examples, based on the contents of GitHub, rather than those that comprise a specific version, such as a quarterly release. Note that metadata files and other 'load' files, such as the various domain-specific 'all' files, are intentionally excluded." ;
    dcterms:issued "2018-03-31T18:00:00"^^xsd:dateTime ;
