    dcterms:modified "2025-05-27T18:00:00"^^xsd:dateTime ;
    dcterms:title "EDMC Financial Industry Business Ontology (FIBO) Business Entities (BE) Domain, European Extension" ;
    rdfs:comment "聚合 BE 域中欧洲法域的扩展本体（欧盟及欧洲各区域政府实体与法域个体），与 AllBE 配合用于欧洲场景。"@zh ;
    rdfs:seeAlso "https://spec.edmcouncil.org/fibo/"^^xsd:anyURI ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/BE/AllBE/>,
        fibo-be-ge-euj:,
        fibo-be-ge-eeuj:,
        fibo-be-ge-neuj:,
        fibo-be-ge-seuj:,
        fibo-be-ge-ukj:,
        fibo-be-ge-weuj: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20250501/AllBE-Europe/> ;
    cmns-av:copyright "Copyright (c) 2018-2025 EDM Council, Inc.",
        "Copyright (c) 2018-2025 Object Management Group, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for BE (European Extension) is provided for convenience for FIBO users.  This ontology does not add new assertions, but imports most of the Production (Released) ontologies that comprise the FIBO Business Entities (BE) domain, including all individuals for European governments and jurisdictions, and the related LCC region-specific ontologies. Note that the 45 ISO 3166-2 subdivision ontologies included are those defined as being part of Europe in the U.N. M49 Codes." .

