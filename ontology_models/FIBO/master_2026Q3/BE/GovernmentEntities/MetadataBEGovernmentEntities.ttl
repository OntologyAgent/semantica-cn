fibo-be-ge-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Government Entities Module",
        "BE 政府实体模块元数据（Metadata for the BE Government Entities Module）"@zh ;
    dcterms:abstract "The government entities module includes ontologies describing polities, government entities and their relations." ;
    dcterms:issued "2021-06-28T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    rdfs:comment "声明政府实体（Government Entities）模块的构成：政府实体核心本体加上全球各区域（亚洲五区、欧洲六区、拉美两区、北美四区）的政府实体与法域参考本体。"@zh ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/GovernmentEntities/MetadataBEGovernmentEntities/> ;
    cmns-av:copyright "Copyright (c) 2021-2023 EDM Council, Inc.",
        "Copyright (c) 2021-2023 Object Management Group, Inc." .

