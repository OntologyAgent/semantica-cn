		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "收录加勒比地区各国与属地（开曼群岛、百慕大等）的政体、政府与法域个体。"@zh ;
    owl:imports fibo-be-ge-ge:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-rga:,
        lcc-3166-1: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20250301/GovernmentEntities/NorthAmericanJurisdiction/CaribbeanGovernmentEntitiesAndJurisdictions/> ;
    skos:changeNote "The http://www.omg.org/spec/EDMC-FIBO/BE/20200701/GovernmentEntities/NorthAmericanJurisdiction/CaribbeanGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to correct the ontology prefix and address language-specific diacritical marks.",
        "The http://www.omg.org/spec/EDMC-FIBO/BE/20210201/GovernmentEntities/NorthAmericanJurisdiction/CaribbeanGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to correct spelling issues.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20211201/GovernmentEntities/NorthAmericanJurisdiction/CaribbeanGovernmentEntitiesAndJurisdictions.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230101/GovernmentEntities/NorthAmericanJurisdiction/CaribbeanGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230301/GovernmentEntities/NorthAmericanJurisdiction/CaribbeanGovernmentEntitiesAndJurisdictions.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389)." ;
    skos:scopeNote "The initial version of this ontology reflects the highest national or regional level (for British Commonwealth members) only." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2020-2025 EDM Council, Inc.",
        "Copyright (c) 2020-2025 Object Management Group, Inc." .

fibo-be-ge-cbj:AntiguaAndBarbudaEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Antigua and Barbuda entity" ;
    skos:definition "sovereign state and polity that consists of two major islands, Antigua and Barbuda (separated by 39 miles), and a number of smaller islands in the middle of the Leeward Islands, that is part of the Lesser Antilles" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:AntiguaAndBarbuda ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfAntiguaAndBarbuda .

fibo-be-ge-cbj:BahamianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Bahamian entity" ;
    skos:definition "sovereign state and polity that is The Bahamas" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:Bahamas ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheCommonwealthOfTheBahamas .

fibo-be-ge-cbj:BarbadianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Barbadian entity" ;
    skos:definition "sovereign state and polity that is Barbados" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:Barbados ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfBarbados .

fibo-be-ge-cbj:BermudanEntity a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalSovereignty ;
    rdfs:label "Bermudan entity" ;
    skos:definition "regional sovereignty and polity that is Bermuda" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:Bermuda ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfBermuda .

fibo-be-ge-cbj:CaymanIslandsEntity a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalSovereignty ;
    rdfs:label "Cayman Islands entity" ;
    skos:definition "regional sovereignty and polity that is the Cayman Islands" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:CaymanIslands ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheCaymanIslands .

fibo-be-ge-cbj:CubanEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Cuban entity" ;
    skos:definition "sovereign state and polity that is Cuba" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Cuba ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheRepublicOfCuba .

fibo-be-ge-cbj:DominicaEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Dominica entity" ;
    skos:definition "soverign state and polity that is Dominica" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Dominica ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheCommonwealthOfDominica .

fibo-be-ge-cbj:DominicanRepublicEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Dominican Republic entity" ;
    skos:definition "soverign state and polity that is the Dominican Republic" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:DominicanRepublic ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheDominicanRepublic .

fibo-be-ge-cbj:GrenadianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Grenadian entity" ;
    skos:definition "soverign state and polity that is Grenada" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:Grenada ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfGrenada .

fibo-be-ge-cbj:HaitianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Haitian entity" ;
    skos:definition "soverign state and polity that is Haiti" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Haiti ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheRepublicOfHaiti .

fibo-be-ge-cbj:JamaicanEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Jamaican entity" ;
    skos:definition "soverign state and polity that is Jamaica" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:Jamaica ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfJamaica .

fibo-be-ge-cbj:SaintKittsAndNevisEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Saint Kitts and Nevis entity" ;
    skos:definition "soverign state and polity that is the Federation of Saint Christopher and Nevis" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:SaintKittsAndNevis ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheFederationOfSaintChristopherAndNevis .

fibo-be-ge-cbj:SaintLucianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Saint Lucian entity" ;
    skos:definition "soverign state and polity that is Saint Lucia" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:SaintLucia ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfSaintLucia .

fibo-be-ge-cbj:SaintVincentianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Saint Vincentian entity" ;
    skos:definition "soverign state and polity that is Saint Vincent and the Grenadines (or simply Saint Vincent)" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:SaintVincentAndTheGrenadines ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfSaintVincentAndTheGrenadines .

fibo-be-ge-cbj:TrinidadianAndTobagonianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Trinidadian and Tobagonian entity" ;
    skos:definition "soverign state and polity that is the Republic of Trinidad and Tobago" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:TrinidadAndTobago ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-cbj:GovernmentOfTheRepublicOfTrinidadAndTobago .

fibo-be-ge-cbj:JurisdictionOfAntiguaAndBarbuda a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Antigua and Barbuda" ;
    skos:definition "jurisdiction of the Eastern Caribbean Supreme Court (based in Saint Lucia; one judge of the Supreme Court is a resident of the islands and presides over the High Court of Justice, including the Judicial Committee of the Privy Council (JCPC), which is the highest court of appeal for certain British territories, some Commonwealth countries and a few UK bodies" ;
    cmns-rga:hasReach lcc-3166-1:AntiguaAndBarbuda ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfAntiguaAndBarbuda .

fibo-be-ge-cbj:JurisdictionOfBarbados a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Barbados" ;
    skos:definition "jurisdiction of the judiciary of Barbados, an independent branch of the Barbadian government, subject only to the Barbadian Constitution, including the Magistrates' Court, Supreme Court, and Caribbean Court of Justice" ;
    cmns-rga:hasReach lcc-3166-1:Barbados ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfBarbados .

fibo-be-ge-cbj:JurisdictionOfBermuda a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Bermuda" ;
    skos:definition "jurisdiction of the judiciary of Bermuda, including the Magistrates' Court, Supreme Court, Court of Appeal, and Judicial Committee of the Privy Council (JCPC), which is the highest court of appeal for certain British territories, some Commonwealth countries and a few UK bodies" ;
    cmns-rga:hasReach lcc-3166-1:Bermuda ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfBermuda .

fibo-be-ge-cbj:JurisdictionOfCuba a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Cuba"@en,
        "jurisdicción de la República de Cuba"@es ;
    skos:definition "jurisdiction of the judiciary of the Republic of Cuba, including the system of courts that interprets and applies the law in Cuba" ;
    cmns-rga:hasReach lcc-3166-1:Cuba ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheRepublicOfCuba .

fibo-be-ge-cbj:JurisdictionOfDominica a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Dominica" ;
    skos:definition "jurisdiction of the judiciary of the Commonwealth of Dominica, which is a member of the International Criminal Court, with a Bilateral Immunity Agreement of protection with the US military, as covered under Article 98" ;
    cmns-rga:hasReach lcc-3166-1:Dominica ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheCommonwealthOfDominica .

fibo-be-ge-cbj:JurisdictionOfGrenada a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Grenada" ;
    skos:definition "jurisdiction of the judiciary of Grenada, which is part of the Eastern Caribbean States Supreme Court with an associate judge residing in Grenada" ;
    cmns-rga:hasReach lcc-3166-1:Grenada ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfGrenada .

fibo-be-ge-cbj:JurisdictionOfHaiti a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Haiti"@en,
        "juridiction de la République d'Haïti"@fr ;
    skos:definition "jurisdiction of the judiciary of Haiti, whose highest court is the Cour de Cassation, assisted by local and civil courts at a communal level" ;
    cmns-rga:hasReach lcc-3166-1:Haiti ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheRepublicOfHaiti .

fibo-be-ge-cbj:JurisdictionOfJamaica a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Jamaica" ;
    skos:definition "the jurisdiction of the judiciary of Jamaica, a system based on English common law and local statutes, including the Judicial Committee of the Privy Council (JCPC), which is the highest court of appeal for certain British territories, some Commonwealth countries and a few UK bodies" ;
    cmns-rga:hasReach lcc-3166-1:Jamaica ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfJamaica .

fibo-be-ge-cbj:JurisdictionOfSaintLucia a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Saint Lucia" ;
    skos:definition "jurisdiction of the judiciary of Saint Lucia, a mixed judicial system based on on both the civil law and English common law" ;
    cmns-rga:hasReach lcc-3166-1:SaintLucia ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfSaintLucia .

fibo-be-ge-cbj:JurisdictionOfSaintVincentAndTheGrenadines a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Federation of Saint Vincent and the Grenadines" ;
    skos:definition "jurisdiction of the judiciary of Saint Vincent and the Grenadines, which is divided into district courts, the Eastern Caribbean Supreme Court and the Privy Council in London being the court of last resort" ;
    cmns-rga:hasReach lcc-3166-1:SaintVincentAndTheGrenadines ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfSaintVincentAndTheGrenadines .

fibo-be-ge-cbj:JurisdictionOfTheCaymanIslands a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Cayman Islands" ;
    skos:definition "jurisdiction of the judiciary of the Cayman Islands, a four-tiered judicial system is based on English common law, colonial and local statutes, including the Judicial Committee of the Privy Council (JCPC), which is the highest court of appeal for certain British territories, some Commonwealth countries and a few UK bodies" ;
    cmns-rga:hasReach lcc-3166-1:CaymanIslands ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheCaymanIslands .

fibo-be-ge-cbj:JurisdictionOfTheCommonwealthOfTheBahamas a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Commonwealth of the Bahamas" ;
    skos:definition "jurisdiction of the judiciary of the Bahamas, a judicial system based on English common law and local statutes, including the Judicial Committee of the Privy Council (JCPC), which is the highest court of appeal for certain British territories, some Commonwealth countries and a few UK bodies, and which considered a safe jurisdiction as an International Financial Center (IFC), with a legal framework that is in compliance with the standards set by Organization for Economic Cooperation and Development (OECD)" ;
    cmns-rga:hasReach lcc-3166-1:Bahamas ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheCommonwealthOfTheBahamas .

fibo-be-ge-cbj:JurisdictionOfTheDominicanRepublic a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Dominican Republic" ;
    skos:definition "jurisdiction of the judiciary of the Dominican Republic, whose highest court is the Supreme Court of Justice, composed of 16 judges appointed by the National Council of Magistrates, an entity created by the constitutional reform of 1994 to ensure the independence of the Judicial Branch" ;
    cmns-rga:hasReach lcc-3166-1:DominicanRepublic ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheDominicanRepublic .

fibo-be-ge-cbj:JurisdictionOfTheFederationOfSaintChristopherAndNevis a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Federation of Saint Christopher and Nevis" ;
    skos:definition "jurisdiction of the judiciary of Saint Kitts and Nevis, a mixed judicial system based on on both the civil law and English common law" ;
    cmns-rga:hasReach lcc-3166-1:SaintKittsAndNevis ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheFederationOfSaintChristopherAndNevis .

fibo-be-ge-cbj:JurisdictionOfTheRepublicOfTrinidadAndTobago a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of the Republic of Trinidad and Tobago" ;
    skos:definition "jurisdiction of the judiciary of Trinidad and Tobago, a hierarchical system comprising a Supreme Court of Judicature, a Magistracy and a Family Court, with final appeal on some matters decided by the Judicial Committee of the Privy Council (JCPC)" ;
    cmns-rga:hasReach lcc-3166-1:TrinidadAndTobago ;
    cmns-rga:isJurisdictionOf fibo-be-ge-cbj:GovernmentOfTheRepublicOfTrinidadAndTobago .

fibo-be-ge-cbj:GovernmentOfAntiguaAndBarbuda a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Antigua and Barbuda"@en ;
    skos:definition "unitary parliamentary constitutional monarchy, with the queen (Elizabeth II) as head of state represented locally by a governor-general" ;
    cmns-rga:governs lcc-3166-1:AntiguaAndBarbuda ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfAntiguaAndBarbuda .

fibo-be-ge-cbj:GovernmentOfBarbados a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Barbados"@en ;
    skos:definition "unitary parliamentary constitutional monarchy, modeled on the British Westminster system, with the Queen of Barbados (Elizabeth II) as head of state, represented locally by a governor-general" ;
    cmns-rga:governs lcc-3166-1:Barbados ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfBarbados .

fibo-be-ge-cbj:GovernmentOfBermuda a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalGovernment ;
    rdfs:label "Government of Bermuda"@en ;
    rdfs:seeAlso <https://www.gov.bm/> ;
    skos:definition "parliamentary representative democratic dependency and a British island territory in the North Atlantic Ocean" ;
    cmns-rga:governs lcc-3166-1:Bermuda ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfBermuda .

fibo-be-ge-cbj:GovernmentOfGrenada a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Grenada"@en ;
    skos:definition "unitary two-party parliamentary constitutional monarchy that is a Commonwealth realm with Queen Elizabeth II as head of state, represented locally by a governor-general, located in the West Indies in the Caribbean Sea at the southern end of the Grenadines island chain" ;
    cmns-rga:governs lcc-3166-1:Grenada ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfGrenada .

fibo-be-ge-cbj:GovernmentOfJamaica a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Jamaica"@en ;
    skos:definition "parliamentary constitutional monarchy with legislative power vested in the bicameral Parliament of Jamaica, consisting of an appointed Senate and a directly elected House of Representatives, and an independent member of the British Commonwealth, situated in the Caribbean Sea" ;
    cmns-rga:governs lcc-3166-1:Jamaica ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfJamaica .

fibo-be-ge-cbj:GovernmentOfSaintLucia a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Saint Lucia"@en ;
    skos:definition "unitary parliamentary constitutional monarchy that is a Commonwealth realm with Queen Elizabeth II as head of state, represented locally by a governor-general, located in the West Indies in the eastern Caribbean Sea on the boundary with the Atlantic Ocean" ;
    cmns-rga:governs lcc-3166-1:SaintLucia ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfSaintLucia .

fibo-be-ge-cbj:GovernmentOfSaintVincentAndTheGrenadines a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Saint Vincent and the Grenadines"@en ;
    skos:definition "unitary parliamentary constitutional monarchy, with the Queen of Saint Vincent and the Grenadines (Elizabeth II) as head of state represented locally by a governor-general, an Anglo-Caribbean country of several islands in the Lesser Antilles island arc, in the southeast Windward Islands, which lies in the West Indies at the southern end of the eastern border of the Caribbean Sea where the latter meets the Atlantic Ocean" ;
    cmns-rga:governs lcc-3166-1:SaintVincentAndTheGrenadines ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfSaintVincentAndTheGrenadines .

fibo-be-ge-cbj:GovernmentOfTheCaymanIslands a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalGovernment ;
    rdfs:label "Government of the Cayman Islands"@en ;
    rdfs:seeAlso <http://www.gov.ky/> ;
    skos:definition "parliamentary democracy with judicial, executive and legislative branches, and a British Overseas Territory, encompassing 3 islands in the western Caribbean Sea" ;
    cmns-rga:governs lcc-3166-1:CaymanIslands ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfTheCaymanIslands .

fibo-be-ge-cbj:GovernmentOfTheCommonwealthOfDominica a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Commonwealth of Dominica"@en ;
    skos:definition "unitary parliamentary democracy that is an independent republic and member of the Commonwealth of Nations, one of few republics in the Caribbean" ;
    cmns-rga:governs lcc-3166-1:Dominica ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfDominica .

fibo-be-ge-cbj:GovernmentOfTheCommonwealthOfTheBahamas a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Commonwealth of the Bahamas"@en ;
    skos:definition "parliamentary constitutional monarchy, with the queen of the Bahamas (Elizabeth II) as head of state represented locally by a governor-general" ;
    cmns-rga:governs lcc-3166-1:Bahamas ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfTheCommonwealthOfTheBahamas .

fibo-be-ge-cbj:GovernmentOfTheDominicanRepublic a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the the Dominican Republic"@en ;
    skos:definition "unitary presidential republic that occupies the eastern five-eighths of the island of Hispaniola in the Greater Antilles archipelago, which it shares with Haiti" ;
    cmns-rga:governs lcc-3166-1:DominicanRepublic ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfTheDominicanRepublic .

fibo-be-ge-cbj:GovernmentOfTheFederationOfSaintChristopherAndNevis a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Federation of Saint Christopher and Nevis"@en ;
    skos:definition "federal parliamentary constitutional monarchy that is a Commonwealth realm with the Queen of Saint Christopher and Nevis (Queen Elizabeth II) as head of state, represented locally by a governor-general, located in the Leeward Islands chain of the Lesser Antilles" ;
    cmns-rga:governs lcc-3166-1:SaintKittsAndNevis ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfTheFederationOfSaintChristopherAndNevis .

fibo-be-ge-cbj:GovernmentOfTheRepublicOfCuba a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Cuba"@en,
        "Gobierno de la República de Cuba"@es ;
    rdfs:seeAlso <https://www.presidencia.gob.cu/en/government/> ;
    skos:definition "unitary Marxist-Leninist, one party socialist republic that includes the island of Cuba as well as Isla de la Juventud and several minor archipelagos" ;
    cmns-rga:governs lcc-3166-1:Cuba ;
    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfCuba .

fibo-be-ge-cbj:GovernmentOfTheRepublicOfHaiti a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Haiti"@en,
        "Gouvernement de la République d'Haïti"@fr ;
    skos:definition "unitary semi-presidential republic located on the island of Hispaniola in the Greater Antilles archipelago" ;
