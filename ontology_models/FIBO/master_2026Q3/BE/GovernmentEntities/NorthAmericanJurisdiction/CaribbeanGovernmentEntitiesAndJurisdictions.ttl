    cmns-rga:hasJurisdiction fibo-be-ge-cbj:JurisdictionOfHaiti .

fibo-be-ge-cbj:GovernmentOfTheRepublicOfTrinidadAndTobago a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Trinidad and Tobago"@en ;
