@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-le-fbo: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/> .
@prefix fibo-be-le-lei: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-be-oac-opty: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-oac-ctl: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/> .
@prefix fibo-fnd-oac-own: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-be-le-lei:RelationshipRecord a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-oac-opty:EntityOwnership ;
            owl:onProperty cmns-doc:records ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

fibo-be-oac-opty: a owl:Ontology ;
    rdfs:label "Ownership Parties Ontology",
        "所有权方本体（Ownership Parties Ontology）"@zh ;
    dcterms:abstract "This ontology defines concepts relating to types of organization owning parties. The concepts defined here are party in role concepts, which define the nature of some entity such as an organization or a legal person, in some role such as that of owning equity in the entity. These roles are defined in terms of the ownership enjoyed by the party, with distinctions between constitutional ownership i.e. ownership defined in terms of stockholder equity, and investment ownership more generally." ;
    dcterms:license """Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义所有权关系中的各方角色：所有者、受益所有人、名义持有人等。"@zh ;
    owl:imports fibo-be-le-fbo:,
        fibo-be-le-lei:,
        fibo-be-le-lp:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-oac-ctl:,
        fibo-fnd-oac-own:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-cls:,
        cmns-doc:,
        cmns-org:,
        cmns-pts: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20250301/OwnershipAndControl/OwnershipParties/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/BE/20131101/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified per the issue resolutions identified in the FIBO BE 1.0 FTF report.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20160201/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified per the FIBO 2.0 RFC to address missing labels and comments, and revise terminology related to shareholders' equity due to requirements for SEC/Equities.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20180801/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified as a part of a simplification strategy for the organizational class hierarchy and to support GLEIF LEI Level 2 ownership relationships.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20181201/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190901/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to eliminate duplication of concepts in LCC.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20200201/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to integrate the concept of a situation, situational roles, and corresponding relations with the definition of entity ownership, and eliminate unused and logically inconsistent properties.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20200601/OwnershipAndControl/OwnershipParties.rdf version of this ontology was revised to reflect the name change in FND from 'hasPrimaryParty' to 'hasActiveParty' to be more consistent with other role related properties.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20200701/OwnershipAndControl/OwnershipParties.rdf version of this ontology was revised to align isEquityHeldBy and hasInvestor with the situational pattern.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20200901/OwnershipAndControl/OwnershipParties.rdf version of this ontology was revised to eliminate references to guarantee providing member, which duplicates the concept of a guarantor and references a concept that is no longer needed, namely 'body incorporated with guarantee'.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20201201/OwnershipAndControl/OwnershipParties.rdf version of this ontology was revised to add a restriction on entity ownership for the ownership percentage.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20210401/OwnershipAndControl/OwnershipParties.rdf version of this ontology was revised to eliminate a dead link that was not necessary.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20220801/OwnershipAndControl/OwnershipParties.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230101/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230301/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to replace concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1 and clean up a few definitions.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20231201/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to replace additional concepts from FIBO FND with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20240101/OwnershipAndControl/OwnershipParties.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20240101/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to add a parent class of contract party to the definition of investory (SEC-113).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20250301/OwnershipAndControl/OwnershipParties.rdf version of this ontology was modified to reflect migration of concepts from accounting equity to ownership in FND (FND-409)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2013-2025 Object Management Group",
        "Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc." .

fibo-be-oac-opty:ConstitutionalOwner a owl:Class ;
    rdfs:label "constitutional owner",
        "章程性所有者（constitutional owner）"@zh ;
    rdfs:comment "以股东权益形式持有该实体股权的实体所有者。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:holds ;
            owl:someValuesFrom fibo-fnd-oac-own:ShareholdersEquity ],
        fibo-be-oac-opty:EntityOwner ;
    skos:definition "entity owner that holds an equity stake in said entity, in the form of shareholders' equity" ;
    cmns-av:explanatoryNote "Typically this would be share ownership or the holding of partnership equity. Ownership in this 'constitutional' sense means that the owner is in some way a member of the organization, such as an employee or director, as distinct from some outside investor." .

fibo-be-oac-opty:ControllingEquity a owl:Class ;
    rdfs:label "controlling equity",
        "控制性股权（controlling equity）"@zh ;
    rdfs:comment "依法或在相应股权工具中明示、正式赋予对实体之控制权的股东权益。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-fnd-oac-ctl:DeJureControl ;
            owl:onProperty fibo-fnd-rel-rel:confers ],
        fibo-fnd-oac-own:ShareholdersEquity ;
    skos:definition "shareholders's equity that formally confers control in the entity, either by law or as explicitly stated in a corresponding equity instrument" .

fibo-be-oac-opty:DirectConsolidation a owl:Class ;
    rdfs:label "direct consolidation",
        "直接合并（direct consolidation）"@zh ;
    rdfs:comment "以会计合并方式记录的对实体的直接所有权。"@zh ;
    rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
    skos:definition "direct ownership of an entity recorded as accounting consolidation" .

fibo-be-oac-opty:ForeignBranchOwnership a owl:Class ;
    rdfs:label "foreign branch ownership",
        "外国分支所有权（foreign branch ownership）"@zh ;
    rdfs:comment "某参与方对作为外国关联方且在法律上属于拥有实体一部分的正式组织或组织子单位的所有权。"@zh ;
    rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
    skos:definition "ownership by some party of some formal organization or organizational sub-unit that is a foreign affiliate and legally part of the owning entity" .

fibo-be-oac-opty:InvestorContract a owl:Class ;
    rdfs:label "investor contract",
        "投资者合同（investor contract）"@zh ;
    rdfs:comment "规定投资者向实体投资之条款、并规定赋予该投资者之权利的合同。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:definesTermsFor ;
            owl:someValuesFrom fibo-be-oac-opty:InvestmentEquity ],
        fibo-fnd-agr-ctr:WrittenContract ;
    skos:definition "Contract setting out the terms under which some investor invests in the entity and setting out the rights which are conferred on that investor." .

fibo-be-oac-opty:UltimateConsolidation a owl:Class ;
    rdfs:label "ultimate ownership",
        "最终所有权（ultimate ownership）"@zh ;
    rdfs:comment "以会计合并为证的、某参与方对另一法律实体的最高层（顶端、末端）祖先级所有权。"@zh ;
    rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
    skos:definition "highest-level (top, end) ancestral ownership, evidenced by accounting consolidation, by some party of some other legal entity" .

fibo-be-oac-opty:guarantees a owl:ObjectProperty ;
    rdfs:label "guarantees",
        "担保（guarantees）"@zh ;
    rdfs:comment "提供正式的保证或承诺，尤指与产品、服务或交易相关的某些条件将得到满足。"@zh ;
    skos:definition "provides a formal assurance or promise, esp. that certain conditions shall be fulfilled relating to a product, service, or transaction" .

fibo-be-oac-opty:hasDirectOwningEntity a owl:ObjectProperty ;
    rdfs:label "has direct owning entity",
        "具有直接拥有实体（has direct owning entity）"@zh ;
    rdfs:comment "将正式组织关联到直接的法律主体/所有者。"@zh ;
    owl:propertyChainAxiom ( fibo-be-oac-opty:hasDirectOwnership fibo-be-oac-opty:hasOwningEntity ) ;
    skos:definition "relates a formal organization to a direct legal person / owner" .

fibo-be-oac-opty:hasInvestmentEntity a owl:ObjectProperty ;
    rdfs:label "has investment entity",
        "具有投资实体（has investment entity）"@zh ;
    rdfs:comment "将法律主体关联到其直接拥有的正式组织或子公司，视所有权百分比而定。"@zh ;
    owl:propertyChainAxiom ( fibo-be-oac-opty:hasInvestmentOwnership fibo-be-oac-opty:hasOwnedEntity ) ;
    skos:definition "relates a legal person to a directly owned formal organization or subsidiary, depending on the percent ownership interest" .

fibo-be-oac-opty:Investor a owl:Class ;
    rdfs:label "investor",
        "投资者（investor）"@zh ;
    rdfs:comment "通过投资拥有某组织一定份额的参与方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:holds ;
            owl:someValuesFrom fibo-be-oac-opty:InvestmentEquity ],
        fibo-be-oac-opty:EntityOwner,
        fibo-fnd-agr-ctr:ContractParty ;
    skos:definition "party that owns some stake in some organization by way of investment" ;
    skos:editorialNote "This is regardless of whether or not the investor is also a constitutional owner (e.g. shareholder) in the entity." .

fibo-be-oac-opty:hasDirectOwnership a owl:ObjectProperty ;
    rdfs:label "has direct ownership",
        "具有直接所有权（has direct ownership）"@zh ;
    rdfs:comment "将正式组织关联到其被另一实体直接拥有的情形。"@zh ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fibo-be-le-fbo:NotForProfitOrganization fibo-be-le-lp:BusinessEntity cmns-org:LegalEntity ) ] ;
    rdfs:range fibo-be-oac-opty:EntityOwnership ;
    rdfs:subPropertyOf cmns-pts:experiences ;
    owl:inverseOf fibo-be-oac-opty:hasOwnedEntity ;
    skos:definition "relates a formal organization to the situation in which it is owned directly by another entity" .

fibo-be-oac-opty:hasInvestmentOwnership a owl:ObjectProperty ;
    rdfs:label "has investment ownership",
        "具有投资所有权（has investment ownership）"@zh ;
    rdfs:comment "将法律主体关联到其拥有正式组织的情境。"@zh ;
    rdfs:domain cmns-org:LegalPerson ;
    rdfs:range fibo-be-oac-opty:EntityOwnership ;
    rdfs:subPropertyOf cmns-pts:playsActiveRoleIn ;
    owl:inverseOf fibo-be-oac-opty:hasOwningEntity ;
    skos:definition "relates a legal person to the context in which it owns a formal organization" .

fibo-be-oac-opty:EntityOwner a owl:Class ;
    rdfs:label "entity owner",
        "实体所有者（entity owner）"@zh ;
    rdfs:comment "拥有正式企业组织或持有其所有权权益的所有者（个人、群体或其他企业实体）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:holds ;
            owl:someValuesFrom fibo-fnd-oac-own:OwnersEquity ],
        fibo-fnd-oac-own:Owner ;
    skos:definition "owner (person, group of people, or other business entity) that owns, or holds an ownership interest in, a formal business organization" .

fibo-be-oac-opty:InvestmentEquity a owl:Class ;
    rdfs:label "investment equity",
        "投资权益（investment equity）"@zh ;
    rdfs:comment "代表对某实体之所有权权益的权益，可能以股东权益形式存在，也可能不是。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
            owl:someValuesFrom fibo-be-oac-opty:Investor ],
        fibo-fnd-oac-own:OwnersEquity ;
    skos:definition "equity that represents an ownership interest in some entity, but may or may not take the form of shareholders's equity" ;
    skos:editorialNote "Typically an investment in some entity may take the form of shares (issued or privately held), i.e., shareholders' equity, or it may take the form of some capital amount which is not reflected in shareholders' equity. In each case, there would typically be a contractual basis for the investment setting out what controls or other benefits accrue to the investor." .

fibo-be-oac-opty:hasOwnedEntity a owl:ObjectProperty ;
    rdfs:label "has owned entity",
        "具有被拥有实体（has owned entity）"@zh ;
    rdfs:comment "标识被法律主体拥有的正式组织，可能包括独资企业。"@zh ;
    rdfs:domain fibo-be-oac-opty:EntityOwnership ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( fibo-be-le-fbo:NotForProfitOrganization fibo-be-le-lp:BusinessEntity cmns-org:LegalEntity ) ] ;
    rdfs:subPropertyOf cmns-pts:isExperiencedBy ;
    skos:definition "indicates a formal organization, including potentially a sole proprietorship, that is owned by a legal person" .

fibo-be-oac-opty:hasOwningEntity a owl:ObjectProperty ;
    rdfs:label "has owning entity",
        "具有拥有实体（has owning entity）"@zh ;
    rdfs:comment "标识拥有正式组织的参与方。"@zh ;
    rdfs:domain fibo-be-oac-opty:EntityOwnership ;
    rdfs:range cmns-org:LegalPerson ;
    rdfs:subPropertyOf cmns-pts:hasActiveParty ;
    skos:definition "indicates a party that owns a formal organization" .

fibo-be-oac-opty:EntityOwnership a owl:Class ;
    rdfs:label "entity ownership",
        "实体所有权（entity ownership）"@zh ;
    rdfs:comment "某参与方对某非政府正式组织之权益的所有权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-oac-opty:hasOwningEntity ;
            owl:someValuesFrom cmns-org:LegalPerson ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-le-lei:RelationshipQualifier ;
            owl:onProperty fibo-fnd-agr-ctr:isQualifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-be-le-lei:hasOwnershipPercentage ],
        [ a owl:Restriction ;
            owl:onProperty fibo-be-oac-opty:hasOwnedEntity ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-be-le-fbo:NotForProfitOrganization fibo-be-le-lp:BusinessEntity cmns-org:LegalEntity ) ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( fibo-fnd-oac-own:OwnersEquity fibo-fnd-agr-ctr:Contract ) ] ;
            owl:onProperty fibo-fnd-rel-rel:isConferredBy ],
        [ a owl:Restriction ;
            owl:onClass fibo-be-le-lei:RelationshipStatus ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-oac-own:Ownership ;
    skos:definition "ownership by some party of an interest in some non-governmental formal organization" .

