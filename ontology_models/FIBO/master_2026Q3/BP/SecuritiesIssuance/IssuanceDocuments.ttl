@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-bp-iss-doc: <https://spec.edmcouncil.org/fibo/ontology/BP/SecuritiesIssuance/IssuanceDocuments/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-law-cor: <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-sec-sec-iss: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

fibo-bp-iss-doc:FinalProspectus a owl:Class ;
    rdfs:label "final prospectus"@en,
        "最终招募说明书（final prospectus）"@zh ;
    rdfs:comment "描述发行事项的最终招募说明书，包括发行本身的事实（如截止日期）及已知的相关事实。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dt:succeeds ;
            owl:someValuesFrom fibo-bp-iss-doc:PreliminaryProspectus ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
            owl:someValuesFrom fibo-bp-iss-doc:OfferingDocumentTerms ],
        fibo-sec-sec-iss:Prospectus ;
    skos:definition "The final Prospectus for an issue describes the Offer Issue, including facts about the issue itself such as closing dates, and known facts about the securities that will form part of that issue."@en ;
    cmns-av:explanatoryNote "Anticipated facts might include expected issue price, yields, pool parameters as appropriate for the type of instrument being issued. Term origin:SMER"@en .

fibo-bp-iss-doc:Indenture a owl:Class ;
    rdfs:label "indenture"@en,
        "信托契约（indenture）"@zh ;
    rdfs:comment "债券与信用债券据以发行的书面合同，又称「信托契据」，载明到期日、利率、赎回条款等。"@zh ;
    rdfs:subClassOf fibo-bp-iss-doc:SecuritiesIssuanceAgreement,
        fibo-fnd-agr-ctr:WrittenContract ;
    skos:definition "A written contract, also known as a \"Deed of Trust\", under which bonds and debentures are issued, setting forth maturity date, interest rate, redemption rights, call privileges and other terms. Under the rules of the Trust Indenture Act of 1939, the contract is executed by the issuer and a trustee who acts on behalf of the bondholders."@en .

fibo-bp-iss-doc:IssuanceTrustAgreement a owl:Class ;
    rdfs:label "issuance trust agreement"@en,
        "发行信托协议（issuance trust agreement）"@zh ;
    rdfs:comment "就某次证券发行设立的信托协议。"@zh ;
    rdfs:subClassOf fibo-bp-iss-doc:SecuritiesIssuanceAgreement,
        fibo-fnd-agr-ctr:WrittenContract .

fibo-bp-iss-doc: a owl:Ontology ;
    rdfs:label "IssuanceDocuments"@en,
        "发行文件本体（Issuance Documents Ontology）"@zh ;
    dcterms:abstract "Ontology containing concepts about types of documentation that are used, referred to or generated by aspects of securities issuance processes." ;
    dcterms:license """Copyright (c) 2013-2025 EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.
		
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义证券发行过程中使用的法律文件：募集说明书、条款清单等。"@zh ;
    owl:imports fibo-fnd-agr-ctr:,
        fibo-fnd-law-cor:,
        fibo-fnd-utl-av:,
        fibo-sec-sec-iss:,
        cmns-av:,
        cmns-dt: ;
    owl:versionIRI fibo-bp-iss-doc: ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional ;
    cmns-av:copyright "Copyright (c) 2013-2025 EDM Council, Inc." .

fibo-bp-iss-doc:PreliminaryProspectus a owl:Class ;
    rdfs:label "preliminary prospectus"@en,
        "初步招募说明书（preliminary prospectus）"@zh ;
    rdfs:comment "发行营销前确定的招募说明书草案，其中某些条款将在发行后续阶段定稿。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
            owl:someValuesFrom fibo-bp-iss-doc:OfferingDocumentTerms ],
        fibo-sec-sec-iss:Prospectus ;
    skos:definition "The draft prospectus for the issue, as determined prior to marketing the issue. Certain terms in the draft prospectus will be finalized later in the issuance process to become the actual Prospectus. Term origin:DTCC issuance Reviews"@en .

fibo-sec-sec-iss:OfferingDocument a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
            owl:someValuesFrom fibo-bp-iss-doc:OfferingDocumentTerms ] .

fibo-bp-iss-doc:SecuritiesIssuanceAgreement a owl:Class ;
    rdfs:label "securities issuance agreement"@en,
        "证券发行协议（securities issuance agreement）"@zh ;
    rdfs:comment "就某次拟议证券发行订立的正式协议、契据或合同。"@zh ;
    rdfs:subClassOf fibo-sec-sec-iss:OfferingDocument ;
    skos:definition "A formal agreement, deed or contract in respect of some intended securities issuance."@en .

fibo-bp-iss-doc:OfferingDocumentTerms a owl:Class ;
    rdfs:label "offering document terms"@en,
        "发行文件条款（offering document terms）"@zh ;
    rdfs:comment "发行文件中包含的、在发行时产生法律约束力的条款。"@zh ;
    rdfs:subClassOf fibo-fnd-agr-ctr:ContractualElement ;
    skos:definition "terms included in an offering document that become legally binding at issue"@en ;
    cmns-av:explanatoryNote "They include, for example, call terms, interest payment terms, and so forth with respect to certain securities."@en .

