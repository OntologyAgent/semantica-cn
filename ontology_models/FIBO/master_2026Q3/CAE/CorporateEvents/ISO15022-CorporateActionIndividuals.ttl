fibo-cae-ce-15022:BIDS a [ a owl:Restriction ;
            owl:allValuesFrom fibo-cae-ce-srca:RepurchaseOffer ;
            owl:onProperty cmns-cls:classifies ],
        owl:NamedIndividual,
        fibo-cae-ce-act:BusinessStrategyClassifier ;
    rdfs:label "BIDS"@en ;
    skos:definition "ISO 15022 classifier for corporate actions in which an offer is made to existing shareholders by the issuing company to repurchase equity or other securities convertible into equity"@en ;
    cmns-col:isMemberOf fibo-cae-ce-15022:ISO15022CorporateActionClassificationScheme ;
    cmns-dsg:hasTag "BIDS" ;
    cmns-dsg:isDefinedIn fibo-cae-ce-15022:ISO15022CorporateActionClassificationScheme .

fibo-cae-ce-15022:BONU a [ a owl:Restriction ;
            owl:allValuesFrom fibo-cae-ce-srca:BonusIssue ;
