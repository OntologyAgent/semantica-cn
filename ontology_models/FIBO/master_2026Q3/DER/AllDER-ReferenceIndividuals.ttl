@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-der-drc-swpind: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/SwapsIndividuals/> .
@prefix fibo-derri-all: <https://spec.edmcouncil.org/fibo/ontology/DER/AllDER-ReferenceIndividuals/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-derri-all: a owl:Ontology ;
    rdfs:label "Derivatives Domain, with Reference Individuals",
        "DER 域参考个体入口（All DER, Reference Individuals）"@zh ;
    dcterms:abstract "The Derivatives (DER) Domain covers many of the concepts that are common to derivative instruments, including but not limited to options, futures, forwards, swaps, and a wide range of other derivatives. This ontology provides metadata about the Derivatives Domain and its contents." ;
    dcterms:contributor "Adaptive, Inc.",
        "Bloomberg LP",
        "Citigroup",
        "Commodities Futures Trading Commission (CFTC)",
        "Credit Suisse",
        "Deutsche Bank",
        "Exprentis",
        "Federated Knowledge LLC",
        "John F. Gemski",
        "John F. Tierney",
        "Mizuho Financial Group, Inc.",
        "Nordea Bank AB",
        "Office of Financial Research (US Dept of the Treasury)",
        "Quarule",
        "State Street Bank and Trust",
        "Tahoe Blue Ltd",
        "Thematix Partners LLC",
        "Wells Fargo Bank, N.A.",
        "Working Ontologist",
        "agnos.ai" ;
    dcterms:creator "https://wiki.edmcouncil.org/display/DER/FIBO+-+FCT+-+Derivatives+Home"^^xsd:anyURI ;
    dcterms:issued "2018-03-31T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-02-03T18:00:00"^^xsd:dateTime ;
    dcterms:title "Financial Industry Business Ontology (FIBO) Derivatives (DER) Domain, with Reference Individuals" ;
    rdfs:comment "聚合衍生品域的参考数据个体本体（标准化互换合约约定等实例）。"@zh ;
    rdfs:seeAlso <https://www.edmcouncil.org/fibo/> ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/DER/AllDER/>,
        fibo-der-drc-swpind:,
        <https://spec.edmcouncil.org/fibo/ontology/SEC/AllSEC-ReferenceIndividuals/> ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/DER/20230201/AllDER-ReferenceIndividuals/> ;
    cmns-av:copyright "Copyright (c) 2018-2023 EDM Council, Inc.",
        "Copyright (c) 2018-2023 Object Management Group, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for DER is provided for convenience for FIBO users.  This ontology does not add new assertions, but imports all of the Production (Released) ontologies that comprise the FIBO Foundations (FND), Business Entities (BE), Financial Business and Commerce (FBC), Indices and Indicators (IND), Securities (SEC), and Derivatives (DER) domains, including all individuals." .

