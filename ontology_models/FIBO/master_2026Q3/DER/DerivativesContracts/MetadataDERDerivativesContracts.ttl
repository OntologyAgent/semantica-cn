        "Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc." .

fibo-der-drc-mod:DerivativesContractsModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "derivatives contracts module" ;
    dcterms:abstract "The derivatives contracts module includes the contractual components common to all derivatives or to entire classes of derivatives." ;
