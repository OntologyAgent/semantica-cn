fibo-der-drc-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Derivatives (DER) Derivatives Contracts Module",
        "DER 衍生品合约模块元数据（Metadata for the DER Derivatives Contracts Module）"@zh ;
    dcterms:abstract "The derivatives contracts module includes the contractual components common to all derivatives or to entire classes of derivatives." ;
