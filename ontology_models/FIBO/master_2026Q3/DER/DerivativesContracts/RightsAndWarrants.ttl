@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-le-cb: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/> .
@prefix fibo-der-drc-bsc: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/> .
@prefix fibo-der-drc-comm: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CommoditiesContracts/> .
@prefix fibo-der-drc-cur: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CurrencyContracts/> .
@prefix fibo-der-drc-exo: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/ExoticOptions/> .
@prefix fibo-der-drc-raw: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/RightsAndWarrants/> .
@prefix fibo-der-sbd-sbd: <https://spec.edmcouncil.org/fibo/ontology/DER/SecurityBasedDerivatives/SecurityBasedDerivatives/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-ind-ei-ei: <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/> .
@prefix fibo-ind-mkt-bas: <https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/BasketIndices/> .
@prefix fibo-sec-dbt-bnd: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/> .
@prefix fibo-sec-dbt-ex: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/ExerciseConventions/> .
@prefix fibo-sec-eq-eq: <https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/> .
@prefix fibo-sec-sec-bsk: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/Baskets/> .
@prefix fibo-sec-sec-iss: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/> .
@prefix fibo-sec-sec-lst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-der-drc-raw: a owl:Ontology ;
    rdfs:label "Rights and Warrants Ontology"@en,
        "权利与权证本体（Rights and Warrants Ontology）"@zh ;
    dcterms:abstract "The Rights and Warrants ontology covers a range of financial instruments providing the holder with the privilege to subscribe to or receive specific assets on terms specified. These include rights (privileges) extended to existing security holders to make new securities available to them at reduced prices or for free, and warrants whereby the holder can purchase or sell back a given quantity of the instrument, commodity or currency during a specified period at a pre-defined price." ;
    dcterms:license """Copyright (c) 2015-2025 EDM Council, Inc.
Copyright (c) 2015-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义认股权证（warrant）、配股权（rights）等赋予持有人购买权利的证券。"@zh ;
    owl:imports fibo-be-le-cb:,
        fibo-der-drc-comm:,
        fibo-der-drc-cur:,
        fibo-der-drc-bsc:,
        fibo-der-drc-exo:,
        fibo-der-sbd-sbd:,
        fibo-fbc-fi-fi:,
        fibo-fbc-fct-fse:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        fibo-ind-ei-ei:,
        fibo-ind-mkt-bas:,
        fibo-sec-dbt-bnd:,
        fibo-sec-dbt-ex:,
        fibo-sec-eq-eq:,
        fibo-sec-sec-bsk:,
        fibo-sec-sec-iss:,
        fibo-sec-sec-lst:,
        cmns-av:,
        cmns-qtu:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/DER/20250801/DerivativesContracts/RightsAndWarrants/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/DER/20211101/DerivativesContracts/RightsAndWarrants.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary, to move the definition of an underlier and the related property, has underlier, to financial instruments so that these concepts are also available for use in relation to pool-backed securities.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20230201/DerivativesContracts/RightsAndWarrants.rdf version of this ontology was modified to add concepts including mini-future certificate and constant leverage certificate.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20230801/DerivativesContracts/RightsAndWarrants.rdf version of this ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20231201/DerivativesContracts/RightsAndWarrants.rdf version of this ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20240101/DerivativesContracts/RightsAndWarrants.rdf version of this ontology was modified to simplify and refine definitions related to underliers (DER-112).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20250301/DerivativesContracts/RightsAndWarrants.rdf version of the ontology was modified to align the definition of 'bond with warrant' with the CFI definition (SEC-207) and to adjust the class hierarchy and add definitions related to certain specific kinds of warrants (DER-150, DER-152 and DER-153)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2015-2025 EDM Council, Inc.",
        "Copyright (c) 2015-2025 Object Management Group, Inc." .

fibo-der-drc-raw:AllotmentRight a owl:Class ;
    rdfs:label "allotment right"@en,
        "配股权（allotment right）"@zh ;
    rdfs:comment "授予现有证券持有人的特权，使其有权免费获得新证券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-qtu:hasExpression ;
            owl:someValuesFrom fibo-der-drc-raw:AllotmentRightFormula ],
        fibo-der-sbd-sbd:EquityDerivative,
        fibo-fbc-fi-fi:Entitlement ;
    skos:definition "privileges allotted to existing security holders, entitling them to receive new securities free of charge"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "Allotment generally means the distribution of equity, particularly shares granted to a participating underwriting firm during an initial public offering (IPO)."@en ;
    cmns-av:synonym "bonus right"@en .

fibo-der-drc-raw:BarrierInstrumentBasedMiniFutureCertificate a owl:Class ;
    rdfs:label "barrier instrument-based mini-future certificate"@en,
        "基于障碍工具的迷你期货凭证（barrier instrument-based mini-future certificate）"@zh ;
    rdfs:comment "在产品存续期内障碍工具交易价格水平被突破时立即到期的迷你期货凭证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
    skos:definition "mini-future certificate that immediately expires if the barrier instrument trading price level is breached during product lifetime"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:BarrierUnderlyingMiniFutureCertificate a owl:Class ;
    rdfs:label "barrier underlying mini-future certificate"@en,
        "标的障碍迷你期货凭证（barrier underlying mini-future certificate）"@zh ;
    rdfs:comment "在产品存续期内标的价格突破障碍水平时立即到期的迷你期货凭证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
    skos:definition "mini-future certificate that immediately expires if the barrier underlying level is breached during product lifetime"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:BasketWarrant a owl:Class ;
    rdfs:label "basket warrant"@en,
        "篮子权证（basket warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定价格购买一揽子或一组资产的权证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-sec-bsk:BasketOfSecurities ] ],
        fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that permits the holder to acquire a package or group of assets at a specified price during a specified period"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:BondPurchaseRight a owl:Class ;
    rdfs:label "bond purchase right"@en,
        "债券购买权（bond purchase right）"@zh ;
    rdfs:comment "赋予潜在被收购方债券持有人以大幅折价购买该公司或任何收购该公司者之债券的权利的反收购安排。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-dbt-bnd:Bond ] ],
        fibo-der-drc-raw:PurchaseRight ;
    skos:definition "purchase right that gives a prospective acquiree's bondholders the right to buy bonds of the firm or bonds of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:BondSubscriptionRight a owl:Class ;
    rdfs:label "bond subscription right"@en,
        "债券认购权（bond subscription right）"@zh ;
    rdfs:comment "授予现有债券持有人以通常低于当时市价的价格认购新证券的认购权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-dbt-bnd:Bond ] ],
        fibo-der-drc-raw:SubscriptionRight ;
    skos:definition "subscription right entitling existing bond holders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CallPutWarrant a owl:Class ;
    rdfs:label "call put warrant"@en,
        "认购认沽权证（call put warrant）"@zh ;
    rdfs:comment "未明确认购或认沽特征、或明确同时包含认购和认沽特征的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:CallWarrant,
        fibo-der-drc-raw:PutWarrant ;
    skos:definition "warrant that either does not specify call or put features, or that explicitly includes both a call and put feature"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
    cmns-av:explanatoryNote "The call and put code, 'B', in the CFI stands for 'Both', meaning such a warrant embodies characteristics of both a call and a put. This can appear in structured warrants or exotic warrants where payout may depend on movements in either direction (or give the holder a choice at certain triggers)."@en ;
    cmns-av:synonym "straddle warrant"@en .

fibo-der-drc-raw:CombinedInstrumentsPurchaseRight a owl:Class ;
    rdfs:label "combined instruments purchase right"@en,
        "组合工具购买权（combined instruments purchase right）"@zh ;
    rdfs:comment "赋予潜在被收购方多种证券持有人购买该公司或任何收购该公司者之证券的权利的反收购安排。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:PurchaseRight ;
    skos:definition "purchase right that gives a prospective acquiree's holders of multiple securities the right to buy securities of the firm or securities of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CombinedInstrumentsSubscriptionRight a owl:Class ;
    rdfs:label "combined instruments subscription right"@en,
        "组合工具认购权（combined instruments subscription right）"@zh ;
    rdfs:comment "授予现有多种证券持有人以通常低于当时市价的价格认购新证券的认购权。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:SubscriptionRight ;
    skos:definition "subscription right entitling existing holders of multiple securities to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CommodityWarrant a owl:Class ;
    rdfs:label "commodity warrant"@en,
        "商品权证（commodity warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定价格购买指定数量商品的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-comm:CommodityDerivative,
        fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that permits the holder to acquire a specified amount of a commodity during a specified period at a specified price"@en ;
    skos:example "Commodity Warrants Australia (CWA) sells warrants based on 12 commodities and financial markets - crude oil, gold, silver, live cattle, corn, orange juice, soy, coffee, cocoa, the Dow Jones Industrial Average, the NASDAQ Composite Index and the S&P 500 Index."@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CommonConvertibleSharePurchaseRight a owl:Class ;
    rdfs:label "common convertible share purchase right"@en,
        "普通可转换股购买权（common convertible share purchase right）"@zh ;
    rdfs:comment "赋予潜在被收购方普通可转换股股东购买该公司或任何收购该公司者之普通可转换股的权利的购买权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:ConvertibleCommonShare ] ],
        fibo-der-drc-raw:PurchaseRight ;
    skos:definition "purchase right that gives a prospective acquiree's common, convertible shareholders the right to buy common, convertible shares of the firm or common, convertible shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CommonConvertibleShareSubscriptionRight a owl:Class ;
    rdfs:label "common convertible share subscription right"@en,
        "普通可转换股认购权（common convertible share subscription right）"@zh ;
    rdfs:comment "授予现有普通可转换股股东以通常低于当时市价的价格认购新证券的认购权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:ConvertibleCommonShare ] ],
        fibo-der-drc-raw:SubscriptionRight ;
    skos:definition "subscription right entitling existing common convertible shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CommonSharePurchaseRight a owl:Class ;
    rdfs:label "common share purchase right"@en,
        "普通股购买权（common share purchase right）"@zh ;
    rdfs:comment "赋予潜在被收购方普通股股东购买该公司或任何收购该公司者之普通股的权利的购买权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:CommonShare ] ],
        fibo-der-drc-raw:PurchaseRight ;
    skos:definition "purchase right that gives a prospective acquiree's common shareholders the right to buy common shares of the firm or common shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CommonShareSubscriptionRight a owl:Class ;
    rdfs:label "common share subscription right"@en,
        "普通股认购权（common share subscription right）"@zh ;
    rdfs:comment "授予现有普通股股东以通常低于当时市价的价格认购新证券的认购权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:CommonShare ] ],
        fibo-der-drc-raw:SubscriptionRight ;
    skos:definition "subscription right entitling existing common shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CompanyWarrant a owl:Class ;
    rdfs:label "公司权证（CompanyWarrant）"@zh ;
    rdfs:comment "由公司自身发行的权证，行权时通常涉及公司发行新股。"@zh ;
    owl:deprecated true ;
    owl:equivalentClass fibo-der-drc-raw:EquityWarrant .

fibo-der-drc-raw:ConstantLeverageCertificate a owl:Class ;
    rdfs:label "constant leverage certificate"@en,
        "恒定杠杆凭证（constant leverage certificate）"@zh ;
    rdfs:comment "将开放式凭证结构与无固定期限的杠杆期权相结合、使杠杆在无期限条件下可用的权益凭证。"@zh ;
    rdfs:subClassOf fibo-der-sbd-sbd:SecurityBasedDerivative,
        fibo-fbc-fi-fi:Entitlement,
        fibo-fbc-fi-fi:Option ;
    skos:definition "entitlement that combines the structure of an open-end certificate with a leverage option with no fixed term, making leverage available without a term restriction, without a knock-out barrier dependency"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:CurrencyWarrant a owl:Class ;
    rdfs:label "currency warrant"@en,
        "货币权证（currency warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定汇率购买指定金额某种货币的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-cur:CurrencyDerivative,
        fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that permits the holder to acquire a specified amount in a certain currency at a specified exchange rate during a specified period"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:DebtWarrant a owl:Class ;
    rdfs:label "debt warrant"@en,
        "债务权证（debt warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定价格购买指定数量债务工具或相关债务指标的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant,
        fibo-der-sbd-sbd:DebtInstrumentDerivative ;
    skos:definition "warrant that permits the holder to acquire a specified amount of a debt instrument or related debt observable a specified period at a specified price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:ExchangeTradedWarrant a owl:Class ;
    rdfs:label "exchange-traded warrant"@en,
        "交易所交易权证（exchange-traded warrant）"@zh ;
    rdfs:comment "在证券交易所挂牌的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:PublicWarrant,
        fibo-sec-sec-lst:ListedSecurity ;
    skos:definition "warrant that is listed on a securities exchange"@en .

fibo-der-drc-raw:ExoticWarrant a owl:Class ;
    rdfs:label "exotic warrant"@en,
        "奇异权证（exotic warrant）"@zh ;
    rdfs:comment "赋予持有人在非标准或复杂条件下买入（有时卖出）标的资产的权利（而非义务）的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that gives the holder the right (but not the obligation) to buy (or sometimes sell) an underlying asset under non-standard or complex conditions, often involving additional features not found in a plain vanilla (standard) warrant"@en ;
    cmns-av:explanatoryNote "Exotic warrants may be created by investment banks as part of structured products to meet specific investor needs. They are often identified with an 'X' in their English stock short name."@en,
        "Features of an exotic warrant may include (1) non-standard payoffs, such as path-dependent or condition-based payouts, (2) variations in the underlying asset(s), which may include equities, indices, currencies, interest rates, baskets of assets, etc., and (3) embedded optionality in terms of features such as barriers, lookbacks, digitals, or dual-currency terms."@en .

fibo-der-drc-raw:IndexWarrant a owl:Class ;
    rdfs:label "index warrant"@en,
        "指数权证（index warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定价格购买基于指数表现之指定金额的权证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                    owl:onClass [ a owl:Class ;
                            owl:unionOf ( fibo-ind-ei-ei:EconomicIndicator fibo-ind-mkt-bas:ReferenceIndex ) ] ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ] ],
        fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that permits the holder to acquire a specified amount based on the performance of an index during a specified period at a specified price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:LongMiniFutureCertificate a owl:Class ;
    rdfs:label "long mini-future certificate"@en,
        "做多迷你期货凭证（long mini-future certificate）"@zh ;
    rdfs:comment "通常授予持有人在规定期间内按指定价格购买特定标的资产之权利的迷你期货凭证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
    skos:definition "mini-future certificate that typically entitles the holder to acquire specific underlying assets during a specified period at a specified price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:PerpetualWarrant a owl:Class ;
    rdfs:label "perpetual warrant",
        "永续权证（perpetual warrant）"@zh ;
    rdfs:comment "无到期日的权证，赋予持有人按指定价格买入（认购权证）或卖出（认沽权证）标的资产的权利（而非义务）。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant ;
    skos:definition "warrant without an expiration date, giving the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a certain strike price" ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "The strike price, in the case of a perpetual warrant, is usually higher than the market value of the underlying asset at the time of issue."@en .

fibo-der-drc-raw:PreferredConvertibleSharePurchaseRight a owl:Class ;
    rdfs:label "preferred convertible share purchase right"@en,
        "优先可转换股购买权（preferred convertible share purchase right）"@zh ;
    rdfs:comment "赋予潜在被收购方优先可转换股股东购买该公司或任何收购该公司者之优先可转换股的权利的购买权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:ConvertiblePreferredShare ] ],
        fibo-der-drc-raw:PurchaseRight ;
    skos:definition "purchase right that gives a prospective acquiree's preferred, convertible shareholders the right to buy preferred, convertible shares of the firm or preferred, convertible shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:PreferredConvertibleShareSubscriptionRight a owl:Class ;
    rdfs:label "preferred convertible share subscription right"@en,
        "优先可转换股认购权（preferred convertible share subscription right）"@zh ;
    rdfs:comment "授予现有优先可转换股股东以通常低于当时市价的价格认购新证券的认购权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:ConvertiblePreferredShare ] ],
        fibo-der-drc-raw:SubscriptionRight ;
    skos:definition "subscription right entitling existing preferred, convertible shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:PreferredSharePurchaseRight a owl:Class ;
    rdfs:label "preferred share purchase right"@en,
        "优先股购买权（preferred share purchase right）"@zh ;
    rdfs:comment "赋予潜在被收购方优先股股东购买该公司或任何收购该公司者之优先股的权利的购买权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:PreferredShare ] ],
        fibo-der-drc-raw:PurchaseRight ;
    skos:definition "purchase right that gives a prospective acquiree's preferred shareholders the right to buy preferred shares of the firm or preferred shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:PreferredShareSubscriptionRight a owl:Class ;
    rdfs:label "preferred share subscription right"@en,
        "优先股认购权（preferred share subscription right）"@zh ;
    rdfs:comment "授予现有优先股股东以通常低于当时市价的价格认购新证券的认购权。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-sec-eq-eq:PreferredShare ] ],
        fibo-der-drc-raw:SubscriptionRight ;
    skos:definition "subscription right entitling existing preferred shareholders to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:PrivateWarrant a owl:Class ;
    rdfs:label "private warrant",
        "私募权证（private warrant）"@zh ;
    rdfs:comment "不可交易的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant,
        fibo-fbc-fi-fi:NonNegotiableSecurity ;
    skos:definition "warrant that is not tradable" .

fibo-der-drc-raw:ShortMiniFutureCertificate a owl:Class ;
    rdfs:label "short mini-future certificate"@en,
        "做空迷你期货凭证（short mini-future certificate）"@zh ;
    rdfs:comment "授予持有人以特定标的资产换取现金之权利的迷你期货凭证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:MiniFutureCertificate ;
    skos:definition "mini-future certificate that entitles the holder to acquire cash in exchange for specific underlying assets"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:StructuredWarrant a owl:Class ;
    rdfs:label "structured warrant"@en,
        "结构化权证（structured warrant）"@zh ;
    rdfs:comment "在交易所挂牌的权证，为投资者提供不直接购买标的资产即可参与其价格表现的途径。"@zh ;
    rdfs:seeAlso <https://www.phillipnova.com.sg/wp-content/uploads/2023/08/Structured-Warrants-Product-Info-Sheet.pdf> ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that is listed on an exchange, offering investors a way to participate in the price performance of an underlying asset without buying it directly"@en ;
    cmns-av:explanatoryNote "Unlike company-issued warrants, which are tied to corporate fundraising, structured warrants are issued by third-party financial institutions such as investment banks or brokers. They can be based on a variety of underlying assets, including individual company shares, a basket of shares, or an index."@en,
        "When structured warrants are exercised, they are typically cash-settled and do not lead to the creation of new shares, thus avoiding dilution of existing shareholders. This is in contrast with company-issued stock options, which can potentially lead to the issuance of new shares, which might dilute the value for existing shareholders."@en .

fibo-der-drc-raw:hasConversionRatio a owl:DatatypeProperty ;
    rdfs:label "has conversion ratio"@en,
        "具有转换比率（has conversion ratio）"@zh ;
    rdfs:comment "指明为买入或卖出特定数量证券或投资单位所需权证数量的换算系数。"@zh ;
    rdfs:domain fibo-fbc-fi-fi:Entitlement ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf cmns-qtu:hasNumericValue ;
    skos:definition "indicates the factor used to determine the number of warrants needed in order to buy or sell a specific number of securities or investment units"@en .

fibo-der-drc-raw:hasOversubscribeOption a owl:DatatypeProperty ;
    rdfs:label "has oversubscribe option"@en,
        "是否具有超额认购选择权（has oversubscribe option）"@zh ;
    rdfs:comment "表明在其他权利持有人选择不认购时，该权利凭证持有人是否可以获得相应证券。"@zh ;
    rdfs:domain fibo-fbc-fi-fi:Entitlement ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether the holders of the rights instrument may get securities in the event that other right holders choose not to subscribe"@en .

fibo-sec-dbt-bnd:BondWithWarrant a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:involves ;
            owl:someValuesFrom fibo-der-drc-raw:Warrant ] .

fibo-der-drc-raw:AllotmentRightFormula a owl:Class ;
    rdfs:label "allotment right formula"@en,
        "配股权公式（allotment right formula）"@zh ;
    rdfs:comment "用于计算配股权对应证券数量的规则，通常基于持有人所持该类工具的数量。"@zh ;
    rdfs:subClassOf cmns-qtu:Expression ;
    skos:definition "rule applied to calculate the number of securities for an allotment right, typically based on the number of these instruments that the holder holds"@en ;
    cmns-av:explanatoryNote "Note that there may be a combination of a rule expressed in text as well as an expression or more complex formula embedded in a contract for making this determination."@en .

fibo-der-drc-raw:EquityWarrant a owl:Class ;
    rdfs:label "equity warrant"@en,
        "股权权证（equity warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定价格购买指定数量权益工具的权证。"@zh ;
    rdfs:seeAlso <https://www.lawinsider.com/dictionary/company-warrant> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom fibo-be-le-cb:StockCorporation ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ] ],
        fibo-der-drc-raw:CallWarrant,
        fibo-der-drc-raw:TraditionalWarrant,
        fibo-der-sbd-sbd:EquityDerivative ;
    skos:definition "warrant that permits the holder to acquire a specified amount of an equity instrument during a specified period at a specified price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "An equity warrant typically enables a buyer to purchase shares of capital stock issued by the corporation whose equity is the underlying asset."@en ;
    cmns-av:synonym "company warrant"@en .

fibo-der-drc-raw:NakedWarrant a owl:Class ;
    rdfs:label "naked warrant"@en,
        "裸权证（naked warrant）"@zh ;
    rdfs:comment "赋予持有人按指定价格买入（认购权证）或卖出（认沽权证）标的资产的权利（而非义务）、但不伴随标的持有的权证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ],
        fibo-der-drc-raw:Warrant ;
    owl:disjointWith fibo-der-drc-raw:CoveredWarrant ;
    skos:definition "warrant that gives the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a specified price (the strike or exercise price) by a predetermined date, issued without an accompanying security by a third party that does not hold as many securities as would be required if all the warrants are exercised"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en .

fibo-der-drc-raw:PublicWarrant a owl:Class ;
    rdfs:label "public warrant",
        "公募权证（public warrant）"@zh ;
    rdfs:comment "可在场外（OTC）或通过交易所交易的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant,
        fibo-fbc-fi-fi:NegotiableSecurity ;
    skos:definition "warrant that may be traded over the counter (OTC) or through an exchange" .

fibo-der-drc-raw:PutWarrant a owl:Class ;
    rdfs:label "put warrant"@en,
        "认沽权证（put warrant）"@zh ;
    rdfs:comment "赋予买方（持有人）卖出指定资产（即以标的资产换取现金）的权利（而非义务）的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant ;
    skos:definition "warrant giving the buyer (holder) the right, but not the obligation, to sell the assets specified (i.e., acquire cash in exchange for the underlying assets, such as stock) back to the issuer at a fixed price or formula, on or before a specified date"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
    cmns-av:explanatoryNote "A put warrant is essentially a company-issued option to sell shares back to the issuer."@en .

fibo-der-drc-raw:TraditionalWarrant a owl:Class ;
    rdfs:label "traditional warrant"@en,
        "传统权证（traditional warrant）"@zh ;
    rdfs:comment "赋予持有人按指定价格买入（认购权证）或卖出（认沽权证）标的资产的权利（而非义务）的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant ;
    owl:disjointWith fibo-der-drc-raw:CoveredWarrant,
        fibo-der-drc-raw:NakedWarrant ;
    skos:definition "warrant that gives the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a specified price (the strike or exercise price) by a predetermined date, issued by the issuer of the underlying instrument"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:synonym "vanilla warrant"@en .

fibo-der-drc-raw:CallWarrant a owl:Class ;
    rdfs:label "call warrant"@en,
        "认购权证（call warrant）"@zh ;
    rdfs:comment "赋予买方（持有人）在规定期间内按指定价格购买特定标的资产的权利（而非义务）的权证。"@zh ;
    rdfs:subClassOf fibo-der-drc-raw:Warrant ;
    skos:definition "warrant giving the buyer (holder) the right, but not the obligation, to acquire specific underlying assets during a specified period at a specified price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, 2019."@en ;
    cmns-av:explanatoryNote "Exercising a call warrant whose underlying instrument is an equity involves buying new shares directly from the company, causing dilution."@en .

fibo-der-drc-raw:CoveredWarrant a owl:Class ;
    rdfs:label "covered warrant"@en,
        "备兑权证（covered warrant）"@zh ;
    rdfs:comment "赋予持有人按指定价格买入（认购权证）或卖出（认沽权证）标的资产的权利（而非义务）的权证，通常由第三方发行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ],
        fibo-der-drc-raw:Warrant ;
    skos:definition "warrant that gives the holder the right, but not the obligation, to buy (call warrant) or to sell (put warrant) an underlying asset at a specified price (the strike or exercise price) by a predetermined date, issued without an accompanying security by a third party that holds as many securities as would be required if all the warrants are exercised"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "Covered warrants are very similar to options in that they can be created to allow holders to benefit from either rising prices or falling prices, by having both put and call warrants. They can also be created on a wide variety of underlying instruments, not just equities and they are fairly standardised and are mostly traded on exchanges. The main difference is that warrants tend to have longer maturity dates, typically measured in years instead of months (as with options), and are easier to access for individuals as they can be bought and sold in the same way as shares in the stock exchange."@en,
        "In contrast to traditional equity warrants, with covered warrants, no new issuance of common stock occurs if the warrant is exercised. The underlying shares of common stock are usually either owned by the issuer of the covered warrants or the issuer has a mechanism, such as owning equity warrants for the underlying shares, through which they can obtain the shares."@en .

fibo-der-drc-raw:MiniFutureCertificate a owl:Class ;
    rdfs:label "mini-future certificate"@en,
        "迷你期货凭证（mini-future certificate）"@zh ;
    rdfs:comment "将开放式凭证结构与无固定期限的杠杆期权相结合、使杠杆在无期限条件下可用的权益凭证。"@zh ;
    rdfs:subClassOf fibo-der-drc-exo:BarrierOption,
        fibo-der-sbd-sbd:SecurityBasedDerivative,
        fibo-fbc-fi-fi:Entitlement ;
    skos:definition "entitlement that combines the structure of an open-end certificate with a leverage option with no fixed term, making leverage available without a term restriction, and whose payoff depends on whether or not the underlying asset has reached or exceeded a predetermined price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "The price of a mini-future always corresponds to its intrinsic value, i.e. the capital outlay, plus the bid-ask spread. The financing costs associated with building up the leverage effect are offset against the capital outlay on a daily basis, thereby eliminating the need for a premium. Investors have to pay only financing costs they actually utilize. In contrast to options, factors like volatility have no influence at all on the price of mini-futures."@en .

fibo-der-drc-raw:PurchaseRight a owl:Class ;
    rdfs:label "purchase right"@en,
        "购买权（purchase right）"@zh ;
    rdfs:comment "一种反收购安排：赋予潜在被收购方股东以折扣价购买该公司或任何收购该公司者之股份的权利。"@zh ;
    rdfs:subClassOf fibo-fbc-fi-fi:Entitlement ;
    skos:definition "anti-takeover device that gives a prospective acquiree's shareholders the right to buy shares of the firm or shares of anyone who acquires the firm at a deep discount to their fair market value"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "The underlying is usually shares but this not necessarily the case. Also known as \"Poison Pill\"."@en .

fibo-der-drc-raw:SubscriptionRight a owl:Class ;
    rdfs:label "subscription right"@en,
        "认购权（subscription right）"@zh ;
    rdfs:comment "授予现有证券持有人的特权，使其有权以通常低于当时市价的价格认购新证券。"@zh ;
    rdfs:subClassOf fibo-fbc-fi-fi:Entitlement ;
    skos:definition "privileges allotted to existing security holders, entitling them to subscribe to new securities at a price normally lower than the prevailing market price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "A subscription rights issue increases the number of shares in the market, thus leading to a dilution in each share's value."@en ;
    cmns-av:synonym "anti-dilution right"@en,
        "preemptive right"@en,
        "subscription privilege"@en .

fibo-fbc-fi-fi:Entitlement a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-sec-sec-iss:SecurityForm ;
            owl:onProperty fibo-sec-sec-iss:isIssuedInForm ] .

fibo-der-drc-raw:Warrant a owl:Class ;
    rdfs:label "warrant"@en,
        "权证（warrant）"@zh ;
    rdfs:comment "允许持有人在规定期间内按指定价格购买指定数量金融工具、商品、货币或其他资产的权益凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-ex:hasExerciseTerms ;
            owl:someValuesFrom fibo-sec-dbt-ex:ExerciseTerms ],
        fibo-fbc-fi-fi:Entitlement ;
    skos:definition "entitlement that permits the holder to purchase a specified amount of a financial instrument, commodity, currency or other asset during a specified period at a specified price"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote "Warrants are for any kind of instrument. Warrants may be privately issued and may not necessarily be traded on an exchange."@en .

