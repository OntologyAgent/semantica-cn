@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-der-drc-bsc: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/> .
@prefix fibo-der-drc-swp: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/> .
@prefix fibo-der-rtd-irswp: <https://spec.edmcouncil.org/fibo/ontology/DER/RateDerivatives/IRSwaps/> .
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-dt-bd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-fnd-pas-psch: <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-alx: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-ind-ei-ei: <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/> .
@prefix fibo-ind-ir-ir: <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/> .
@prefix fibo-sec-dbt-bnd: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/> .
@prefix fibo-sec-dbt-dbti: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-der-rtd-irswp: a owl:Ontology ;
    rdfs:label "Interest Rate Swaps Ontology",
        "利率互换本体（Interest Rate Swaps Ontology）"@zh ;
    dcterms:abstract "This ontology defines concepts specific to interest rate swap contracts, including but not limited to fixed and floating rate combinations, single and cross-currency contracts, etc." ;
    dcterms:license """Copyright (c) 2016-2025 EDM Council, Inc.
Copyright (c) 2016-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义利率互换（IRS）：固定利率与浮动利率现金流的交换结构。"@zh ;
    owl:imports fibo-der-drc-bsc:,
        fibo-der-drc-swp:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-fi-fi:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-dt-bd:,
        fibo-fnd-dt-fd:,
        fibo-fnd-dt-oc:,
        fibo-fnd-pas-psch:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-alx:,
        fibo-fnd-utl-av:,
        fibo-ind-ei-ei:,
        fibo-ind-ir-ir:,
        fibo-sec-dbt-bnd:,
        fibo-sec-dbt-dbti:,
        cmns-av:,
        cmns-dt:,
        cmns-doc:,
        cmns-qtu:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/DER/20250401/RateDerivatives/IRSwaps/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/DER/20180801/RateDerivatives/IRSwaps.rdf version of this ontology was modified to use the generic statistical measures and measurements now in FND.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20190501/RateDerivatives/IRSwaps/ version of this ontology was modified to eliminate the property 'hasPaymentSchedule' from the Swaps ontology in favor of the equivalent property with the same name from FND.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20200701/RateDerivatives/IRSwaps/ version of this ontology was modified take advantage of basic fixed and floating legs as higher level concepts common to many swaps, and to refine definitions to eliminate ambiguity and conform with ISO 704.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20201201/RateDerivatives/IRSwaps/ version of this ontology was modified to move the property 'exchanges' to FND given that it could be applied more generally than with respect to swaps only.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20210101/RateDerivatives/IRSwaps/ version of this ontology was modified to enable representation of plain vanilla interest rate swaps as a separate concept, to integrate the concept of an inflation swap and correct spelling.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20211201/RateDerivatives/IRSwaps/ version of this ontology was modified to reflect the addition of the concept of a rates swap and the corresponding rate-based leg to the Swaps ontology and augment this ontology to include both OIS and zero coupon swaps to facilitate mapping to the CFI standard as well as eliminate a redundant notional step percentage amount, which is not used anywhere.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20220301/RateDerivatives/IRSwaps/ version of this ontology was modified to eliminate deprecated swap elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20220501/RateDerivatives/IRSwaps.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary, and to move the definition of an underlier and the related property, has underlier, to financial instruments so that these concepts are also available for use in relation to pool-backed securities.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20230201/RateDerivatives/IRSwaps.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC), eliminating redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20230301/RateDerivatives/IRSwaps.rdf version of this ontology was modified to clarify restrictions on a plain vanilla IR swap.",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20230501/RateDerivatives/IRSwaps.rdf version of this ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20231201/RateDerivatives/IRSwaps.rdf version of this ontology was modified to simplify the class hierarchy, add a definition for fixed-fixed interest rate swap (DER-126), and to revise definitions related to swap leg-specific events (FBC-317).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20240301/RateDerivatives/IRSwaps.rdf version of this ontology was modified to eliminate deprecated elements that have been deprecated for more than 6 months (FND-386).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20241101/RateDerivatives/IRSwaps.rdf version of this ontology was modified to simplify and refine definitions related to underliers (DER-112).",
        "The https://spec.edmcouncil.org/fibo/ontology/DER/20250301/DerivativesContracts/IRSwaps.rdf version of this ontology was modified to further simplify and clarify definitions related to rate derivatives (DER-90)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2016-2025 EDM Council, Inc.",
        "Copyright (c) 2016-2025 Object Management Group, Inc." .

fibo-der-rtd-irswp:FixedFixedInterestRateSwap a owl:Class ;
    rdfs:label "fixed fixed interest rate swap",
        "固定对固定利率互换（fixed fixed interest rate swap）"@zh ;
    rdfs:comment "双方均支付通过互换安排之外无法获得的固定利率的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-der-rtd-irswp:FixedInterestRateLeg ;
            owl:onProperty fibo-fnd-rel-rel:exchanges ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        fibo-der-rtd-irswp:InterestRateSwap ;
    skos:definition "interest rate swap in which both parties pay a fixed interest rate that they could not otherwise obtain outside of a swap arrangement" ;
    skos:example "For example, each counterparty uses a different native currency, but wants to borrow money in the other counterparty's native currency." ;
    skos:note "Fixed-fixed swaps generally take the form of either a zero coupon swap or a cross-currency swap." ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of Financial Instruments (CFI code), Fourth edition, 2019-10." ;
    cmns-av:synonym "fixed-fixed interest rate swap" .

fibo-der-rtd-irswp:FixedFloatCrossCurrencyInterestRateSwap a owl:Class ;
    rdfs:label "fixed float cross-currency interest rate swap",
        "跨货币固定对浮动利率互换（fixed float cross-currency interest rate swap）"@zh ;
    rdfs:comment "以名义本金的固定利息支付交换浮动利息支付、且两笔支付流使用不同货币的利率互换。"@zh ;
    rdfs:subClassOf fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap,
        fibo-der-rtd-irswp:FixedFloatInterestRateSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap fibo-der-rtd-irswp:FixedFloatInterestRateSwap ) ] ;
    skos:definition "interest rate swap in which fixed interest payments on the notional are exchanged for floating interest payments and the two streams of interest payments are in different currencies" ;
    cmns-av:synonym "fixed float cross currency interest rate swap",
        "fixed-float cross-currency interest rate swap" .

fibo-der-rtd-irswp:FloatFloatCrossCurrencyInterestRateSwap a owl:Class ;
    rdfs:label "float float cross-currency interest rate swap",
        "跨货币浮动对浮动利率互换（float float cross-currency interest rate swap）"@zh ;
    rdfs:comment "交换基于两种不同货币不同利率之现金流的利率互换。"@zh ;
    rdfs:subClassOf fibo-der-rtd-irswp:FloatFloatInterestRateSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap fibo-der-rtd-irswp:FloatFloatInterestRateSwap ) ] ;
    skos:definition "interest rate swap that exchanges cashflows based on two different interest rates in different currencies" ;
    cmns-av:synonym "float-float cross-currency interest rate swap" .

fibo-der-rtd-irswp:FloatFloatSingleCurrencyInterestRateSwap a owl:Class ;
    rdfs:label "float float single currency interest rate swap",
        "单货币浮动对浮动利率互换（float float single currency interest rate swap）"@zh ;
    rdfs:comment "交换基于同一货币两种不同浮动利率之现金流的利率互换。"@zh ;
    rdfs:subClassOf fibo-der-rtd-irswp:FloatFloatInterestRateSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:FloatFloatInterestRateSwap fibo-der-rtd-irswp:SingleCurrencyInterestRateSwap ) ] ;
    skos:definition "interest rate swap that exchanges cashflows based on two different floating interest rates in the same currency" ;
    cmns-av:synonym "float-float single-currency interest rate swap" .

fibo-der-rtd-irswp:InflationSwap a owl:Class ;
    rdfs:label "inflation swap"@en,
        "通胀互换（inflation swap）"@zh ;
    rdfs:comment "一方按通胀率指数计算付款、另一方按另一通胀率或其他方式计算付款的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-der-drc-swp:hasLeg ;
            owl:someValuesFrom fibo-der-rtd-irswp:InflationLeg ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-sec-dbt-bnd:GovernmentBond ;
            owl:onProperty fibo-sec-dbt-bnd:isLinkedToFallback ],
        fibo-der-drc-bsc:RateBasedDerivative,
        fibo-der-drc-swp:RatesSwap ;
    skos:definition "rate swap in which one party pays an amount calculated using an inflation rate index, and the other party pays an amount calculated using another inflation rate index, or a fixed or floating interest rate"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en .

fibo-der-rtd-irswp:OvernightIndexSwap a owl:Class ;
    rdfs:label "overnight index swap"@en,
        "隔夜指数互换（overnight index swap）"@zh ;
    rdfs:comment "一腿的定期付款基于隔夜利率指数乘以与另一腿相同名义本金的互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-der-drc-swp:hasLeg ;
            owl:someValuesFrom fibo-der-rtd-irswp:OvernightRateIndexLeg ],
        fibo-der-rtd-irswp:InterestRateSwap ;
    skos:definition "swap in which the periodic payments for one leg are based on an overnight interest rate index multiplied by the same notional amount upon which payments for the other leg of the swap are based"@en ;
    cmns-av:abbreviation "OIS swap"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en ;
    cmns-av:explanatoryNote "The interest of the overnight rate portion of the swap is compounded and paid at reset dates. The present value for the leg is determined by either compounding of the overnight rate or by taking the geometric average of the rate over a given period."@en .

fibo-der-rtd-irswp:PlainVanillaInterestRateSwap a owl:Class ;
    rdfs:label "plain vanilla interest rate swap",
        "普通利率互换（plain vanilla interest rate swap）"@zh ;
    rdfs:comment "利息支付净额结算、名义本金不变、不内嵌任何期权或其他复杂结构的单货币固定对浮动利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-der-drc-swp:hasLeg ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                    owl:onClass fibo-der-rtd-irswp:NotionalStepSchedule ;
                    owl:onProperty fibo-fnd-dt-fd:hasSchedule ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-der-drc-swp:hasLeg ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                    owl:onClass fibo-der-rtd-irswp:NotionalStepChangeEvent ;
                    owl:onProperty cmns-doc:specifies ] ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-der-rtd-irswp:FixedFloatSingleCurrencyInterestRateSwap ;
    skos:definition "fixed-float single currency interest rate swap in which interest payments are netted, the notional principal does not change, and there are no embedded options" .

fibo-der-rtd-irswp:ZeroCouponInterestRateSwap a owl:Class ;
    rdfs:label "zero coupon interest rate swap",
        "零息利率互换（zero coupon interest rate swap）"@zh ;
    rdfs:comment "固定利率现金流复利累积并在到期日一次性支付（而非定期支付）的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-der-rtd-irswp:InterestRateSwap ;
    skos:definition "interest rate swap in which the fixed rate cash flows are compounded and paid once on the expiration date, rather than periodically; the payments on the other side (which can be based on a floating interest rate or a fixed rate) follow typical swap payment schedules" ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en .

fibo-der-rtd-irswp:hasFirstNotionalStepDate a owl:ObjectProperty ;
    rdfs:label "has first notional step date",
        "具有首个名义本金阶梯日（has first notional step date）"@zh ;
    rdfs:comment "指明名义本金阶梯计划表中的首个日期。"@zh ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasStartDate ;
    skos:definition "indicates the initial date in a notional step schedule" .

fibo-der-rtd-irswp:hasFloatingRateCap a owl:ObjectProperty ;
    rdfs:label "has floating rate cap",
        "具有浮动利率上限（has floating rate cap）"@zh ;
    rdfs:comment "指明浮动利率债务利率的可选上限。"@zh ;
    rdfs:range fibo-fbc-dae-dbt:FloatingInterestRate ;
    rdfs:subPropertyOf fibo-fbc-dae-dbt:hasInterestRate ;
    skos:definition "indicates an optional ceiling (cap) on interest rates on floating rate debts" ;
    cmns-av:explanatoryNote "Rate caps can be viewed as insurance, ensuring that the maximum borrowing rate never exceeds the specified cap level." .

fibo-der-rtd-irswp:hasFloatingRateFloor a owl:ObjectProperty ;
    rdfs:label "has floating rate floor",
        "具有浮动利率下限（has floating rate floor）"@zh ;
    rdfs:comment "指明浮动利率债务利率的可选下限。"@zh ;
    rdfs:range fibo-fbc-dae-dbt:FloatingInterestRate ;
    rdfs:subPropertyOf fibo-fbc-dae-dbt:hasInterestRate ;
    skos:definition "indicates an optional lower bound on interest rates on floating rate debts" .

fibo-der-rtd-irswp:hasFloatingRateSpread a owl:DatatypeProperty ;
    rdfs:label "has floating rate spread",
        "具有浮动利率利差（has floating rate spread）"@zh ;
    rdfs:comment "规定可用于调整浮动利率的可选利差。"@zh ;
    rdfs:range xsd:decimal ;
    skos:definition "defines the spread rate that can optionally be used to adjust the floating rate" ;
    cmns-av:explanatoryNote "Such adjustments may be added to or subtracted from the floating rate." .

fibo-der-rtd-irswp:hasLastNotionalStepDate a owl:ObjectProperty ;
    rdfs:label "has last notional step date",
        "具有最后名义本金阶梯日（has last notional step date）"@zh ;
    rdfs:comment "指明名义本金阶梯计划表中的最后日期。"@zh ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasEndDate ;
    skos:definition "indicates the final date in a notional step schedule" .

fibo-der-rtd-irswp:hasRateMultiplier a owl:DatatypeProperty ;
    rdfs:label "has rate multiplier",
        "具有利率乘数（has rate multiplier）"@zh ;
    rdfs:comment "指明在加入浮动利率利差之前应用于票息的乘数。"@zh ;
    rdfs:range xsd:decimal ;
    skos:definition "indicates a multiplier applied to the coupon before adding the floating rate spread" .

fibo-der-rtd-irswp:FixedFloatSingleCurrencyInterestRateSwap a owl:Class ;
    rdfs:label "fixed float single currency interest rate swap",
        "单货币固定对浮动利率互换（fixed float single currency interest rate swap）"@zh ;
    rdfs:comment "以名义本金的固定利息支付交换浮动利息支付、且两笔支付流使用同一货币的利率互换。"@zh ;
    rdfs:subClassOf fibo-der-rtd-irswp:FixedFloatInterestRateSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:FixedFloatInterestRateSwap fibo-der-rtd-irswp:SingleCurrencyInterestRateSwap ) ] ;
    skos:definition "interest rate swap in which fixed interest payments on the notional are exchanged for floating interest payments and where both payment streams are expressed in terms of the same currency" ;
    cmns-av:synonym "fixed-float single-currency interest rate swap" .

fibo-der-rtd-irswp:InflationLeg a owl:Class ;
    rdfs:label "inflation leg"@en,
        "通胀腿（inflation leg）"@zh ;
    rdfs:comment "与通胀指数（如消费者价格指数 CPI）挂钩的通胀互换浮动利率腿。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:hasUnderlier ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-ind-ei-ei:EconomicIndicator ] ],
        fibo-der-drc-swp:FloatingLeg ;
    skos:definition "floating rate leg of an inflation swap linked to an inflation index, such as the Consumer Price Index (CPI)"@en .

fibo-der-rtd-irswp:NotionalStepAmount a owl:Class ;
    rdfs:label "notional step amount",
        "名义本金阶梯金额（notional step amount）"@zh ;
    rdfs:comment "在每个阶梯日从名义本金中减去（或增加）的金额。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-fnd-acc-cur:MonetaryAmount fibo-fnd-acc-cur:PercentageMonetaryAmount ) ] ],
        cmns-qtu:ScalarQuantityValue ;
    skos:definition "the amount of money that is subtracted from the notional on each step date" ;
    cmns-av:explanatoryNote "Note that this is an actual concrete sum of money, which may be specified either as a monetary amount (e.g. dollars and cents) or as a percentage of either the original notional amount or the previous notional amount." .

fibo-der-rtd-irswp:NotionalStepPeriodLength a owl:Class ;
    rdfs:label "notional step period length",
        "名义本金阶梯周期长度（notional step period length）"@zh ;
    rdfs:comment "表示阶梯变更发生频率的重复区间，为计算计划表中计算周期的整数倍。"@zh ;
    rdfs:subClassOf fibo-fnd-dt-fd:RecurrenceInterval ;
    skos:definition "recurrence interval indicating the frequency with which step changes occur, which is a multiple of the calculation period in the calculation schedule" .

fibo-der-rtd-irswp:OvernightRateIndexLeg a owl:Class ;
    rdfs:label "overnight rate index leg",
        "隔夜利率指数腿（overnight rate index leg）"@zh ;
    rdfs:comment "定期付款基于隔夜利率指数乘以相同名义本金的浮动腿。"@zh ;
    rdfs:subClassOf fibo-der-rtd-irswp:FloatingInterestRateLeg ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:someValuesFrom fibo-ind-ir-ir:OvernightRate ] ;
    skos:definition "floating leg in which periodic payments are based on an overnight interest rate index multiplied by the same notional amount on which the payments for the other leg of the swap are based" ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-06-15"@en .

fibo-der-rtd-irswp:NotionalStepChangeEvent a owl:Class ;
    rdfs:label "notional step change event",
        "名义本金阶梯变更事件（notional step change event）"@zh ;
    rdfs:comment "某一互换腿名义本金发生阶梯式变更的事件。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-doc:specifies ;
            owl:someValuesFrom fibo-der-rtd-irswp:NotionalStepAmount ],
        fibo-fbc-pas-fpas:ContractLifecycleEventOccurrence,
        fibo-sec-dbt-dbti:StepEvent ;
    skos:definition "event in which a step change in the notional amount for a given swap leg occurs" ;
    cmns-av:explanatoryNote "The frequency / period length of the steps in the step schedule is a multiple of the calculation period or frequency. For example, if the notional is recalculated on every calculation date, applying a new interest rate to the new notional amount, then the two frequencies are the same. If notional is updated every second calculation period, then the step schedule specifies periods that are twice as long, and so on." .

fibo-der-rtd-irswp:NotionalStepSchedule a owl:Class ;
    rdfs:label "notional step schedule",
        "名义本金阶梯计划表（notional step schedule）"@zh ;
    rdfs:comment "计息名义本金变更的计划表，由规则的阶梯事件序列构成。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-oc:hasOccurrence ;
            owl:someValuesFrom fibo-der-rtd-irswp:NotionalStepChangeEvent ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-fd:hasRecurrenceInterval ;
            owl:someValuesFrom fibo-der-rtd-irswp:NotionalStepPeriodLength ],
        fibo-fbc-dae-dbt:ProjectedContractEventSchedule,
        fibo-sec-dbt-dbti:StepSchedule ;
    skos:definition "schedule of changes in the notional amount on which interest is paid, comprising the regular sequence of step events" .

fibo-der-rtd-irswp:SingleCurrencyInterestRateSwap a owl:Class ;
    rdfs:label "single currency interest rate swap",
        "单货币利率互换（single currency interest rate swap）"@zh ;
    rdfs:comment "两笔利息支付流使用同一货币的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:Currency ;
            owl:onProperty cmns-doc:specifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-der-rtd-irswp:InterestRateSwap ;
    skos:definition "interest rate swap in which the two streams of interest payments are in the same currency" .

fibo-der-rtd-irswp:CrossCurrencyInterestRateSwap a owl:Class ;
    rdfs:label "cross-currency interest rate swap",
        "跨货币利率互换（cross-currency interest rate swap）"@zh ;
    rdfs:comment "两笔利息支付流使用不同货币的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:Currency ;
            owl:onProperty cmns-doc:specifies ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        fibo-der-rtd-irswp:InterestRateSwap ;
    skos:definition "interest rate swap in which the two streams of interest payments are in different currencies" .

fibo-der-rtd-irswp:FixedInterestRateLeg a owl:Class ;
    rdfs:label "fixed interest rate leg",
        "固定利率腿（fixed interest rate leg）"@zh ;
    rdfs:comment "规定固定利息金额及该利息支付条款的固定腿。"@zh ;
    rdfs:subClassOf fibo-der-drc-swp:FixedLeg,
        fibo-der-rtd-irswp:InterestRateSwapLeg ;
    owl:disjointWith fibo-der-rtd-irswp:FloatingInterestRateLeg ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:InterestRateSwapLeg [ a owl:Restriction ;
                        owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
                        owl:someValuesFrom fibo-fbc-dae-dbt:FixedInterestRate ] ) ] ;
    skos:definition "fixed leg that specifies fixed interest amounts and terms for the payment of that interest" ;
    cmns-av:explanatoryNote "This may be the funding leg of some swaps (i.e. one party agrees to pay fixed interest amounts in exchange for whatever is the other leg) or it may be one or both sides of an interest rate swap, where the two parties exchange different interest payment streams." ;
    cmns-av:synonym "fixed interest rate payment stream" .

fibo-der-rtd-irswp:FixedFloatInterestRateSwap a owl:Class ;
    rdfs:label "fixed float interest rate swap",
        "固定对浮动利率互换（fixed float interest rate swap）"@zh ;
    rdfs:comment "以名义本金的固定利息支付交换浮动利息支付的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty fibo-fnd-rel-rel:exchanges ;
                        owl:someValuesFrom fibo-der-rtd-irswp:FixedInterestRateLeg ] [ a owl:Restriction ;
                        owl:onProperty fibo-fnd-rel-rel:exchanges ;
                        owl:someValuesFrom fibo-der-rtd-irswp:FloatingInterestRateLeg ] ) ],
        fibo-der-rtd-irswp:InterestRateSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:InterestRateSwap [ a owl:Restriction ;
                        owl:onProperty fibo-der-drc-swp:hasLeg ;
                        owl:someValuesFrom fibo-der-rtd-irswp:FixedInterestRateLeg ] [ a owl:Restriction ;
                        owl:onProperty fibo-der-drc-swp:hasLeg ;
                        owl:someValuesFrom fibo-der-rtd-irswp:FloatingInterestRateLeg ] ) ] ;
    skos:definition "interest rate swap in which fixed interest payments on the notional are exchanged for floating interest payments" ;
    cmns-av:synonym "fixed-float interest rate swap" .

fibo-der-rtd-irswp:FloatFloatInterestRateSwap a owl:Class ;
    rdfs:label "float float interest rate swap",
        "浮动对浮动利率互换（float float interest rate swap）"@zh ;
    rdfs:comment "交换基于两种不同浮动利率之现金流的利率互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-der-rtd-irswp:FloatingInterestRateLeg ;
            owl:onProperty fibo-fnd-rel-rel:exchanges ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        fibo-der-drc-swp:BasisSwap,
        fibo-der-rtd-irswp:InterestRateSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:InterestRateSwap [ a owl:Restriction ;
                        owl:onClass fibo-der-rtd-irswp:FloatingInterestRateLeg ;
                        owl:onProperty fibo-der-drc-swp:hasLeg ;
                        owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ] ) ] ;
    skos:definition "interest rate swap that exchanges cashflows based on two different floating interest rates" ;
    cmns-av:adaptedFrom "http://www.investopedia.com/terms/b/basisrateswap.asp"^^xsd:anyURI ;
    cmns-av:explanatoryNote "This is a swap in which two parties swap variable interest rates based on different money markets, and this is usually done to limit interest-rate risk that a company faces as a result of having differing lending and borrowing rates." ;
    cmns-av:synonym "basis rate swap",
        "float-float interest rate swap" .

fibo-der-rtd-irswp:FloatingInterestRateLeg a owl:Class ;
    rdfs:label "floating interest rate leg",
        "浮动利率腿（floating interest rate leg）"@zh ;
    rdfs:comment "就某一名义本金支付可变利息、并与某一基础利率参考挂钩的浮动腿。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:InterestRateResetSchedule ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:InterestRateSettingEvent ;
            owl:onProperty cmns-doc:specifies ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:InterestRateReset ;
            owl:onProperty cmns-doc:specifies ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:InterestCalculationSchedule ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ],
        fibo-der-drc-swp:FloatingLeg,
        fibo-der-rtd-irswp:InterestRateSwapLeg ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-rtd-irswp:InterestRateSwapLeg [ a owl:Restriction ;
                        owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
                        owl:someValuesFrom fibo-fbc-dae-dbt:FloatingInterestRate ] ) ] ;
    skos:definition "floating leg in which variable interest is paid on some notional amount, linked to some underlying interest reference rate" ;
    cmns-av:explanatoryNote "Instead of an absolute rate you have either a variable reference rate or fixed reference rate and an offset that varies in some way, called a spread (same as margin in floating rate notes)." ;
    cmns-av:synonym "floating interest rate swap stream" .

fibo-der-rtd-irswp:InterestRateSwapLeg a owl:Class ;
    rdfs:label "interest rate swap leg",
        "利率互换腿（interest rate swap leg）"@zh ;
    rdfs:comment "具有利率支付流的互换腿，包括该支付流的参数化表示和现金流表示。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:DayCountConvention ;
            owl:onProperty fibo-fnd-dt-bd:hasBusinessRecurrenceIntervalConvention ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:InterestCalculationSchedule ;
            owl:onProperty cmns-doc:specifies ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-dae-dbt:InterestPaymentSchedule ;
            owl:onProperty fibo-fnd-pas-psch:hasPaymentSchedule ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:Currency ;
            owl:onProperty cmns-doc:specifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-der-rtd-irswp:NotionalStepSchedule ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ],
        fibo-der-drc-swp:RateBasedLeg ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-drc-swp:RateBasedLeg [ a owl:Restriction ;
                        owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
                        owl:someValuesFrom fibo-fnd-acc-cur:InterestRate ] ) ] ;
    skos:definition "swap leg that has an interest rate payment stream, including both a parametric and cashflow representation for the stream of payments" ;
    cmns-av:synonym "interest rate swap stream" .

fibo-der-rtd-irswp:InterestRateSwap a owl:Class ;
    rdfs:label "interest rate swap",
        "利率互换（interest rate swap）"@zh ;
    rdfs:comment "至少一腿的参考标的为利率的互换。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-der-rtd-irswp:InterestRateSwapLeg ;
            owl:onProperty fibo-fnd-rel-rel:exchanges ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        fibo-der-drc-bsc:InterestRateDerivative,
        fibo-der-drc-swp:RatesSwap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fibo-der-drc-swp:Swap [ a owl:Restriction ;
                        owl:onClass fibo-der-rtd-irswp:InterestRateSwapLeg ;
                        owl:onProperty fibo-der-drc-swp:hasLeg ;
                        owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ] ) ] ;
    skos:definition "swap in which the reference (underlier) for at least one leg is an interest rate" .

