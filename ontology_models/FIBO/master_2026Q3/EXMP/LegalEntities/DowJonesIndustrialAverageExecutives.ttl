@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-oac-cpty: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/> .
@prefix fibo-be-oac-exec: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/> .
@prefix fibo-exmp-le-djiac: <https://spec.edmcouncil.org/fibo/ontology/EXMP/LegalEntities/DowJonesIndustrialAverageCompanies/> .
@prefix fibo-exmp-le-djiaex: <https://spec.edmcouncil.org/fibo/ontology/EXMP/LegalEntities/DowJonesIndustrialAverageExecutives/> .
@prefix fibo-fnd-aap-ppl: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix fibo-fnd-org-fm: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix lcc-3166-1: <https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

fibo-exmp-le-djiaex: a owl:Ontology ;
    rdfs:label "US Example Executives",
        "美国公司高管示例（US Example Executives）"@zh ;
    dcterms:abstract "This ontology includes example corporate executives and other people to demonstrate how to model them using FIBO." ;
    dcterms:license """Copyright (c) 2022-2026 EDM Association dba EDM Council, Inc.
		Copyright (c) 2022-2025 Object Management Group, Inc.
		
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "收录道指成分公司高管的示例个体。"@zh ;
    owl:imports fibo-be-oac-cpty:,
        fibo-be-oac-exec:,
        fibo-exmp-le-djiac:,
        fibo-fnd-aap-ppl:,
        fibo-fnd-org-fm:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-dt:,
        cmns-dsg:,
        cmns-pts:,
        cmns-rlcmp:,
        lcc-3166-1: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/EXMP/20260601/LegalEntities/DowJonesIndustrialAverageExecutives/> ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2022-2025 Object Management Group, Inc.",
        "Copyright (c) 2022-2026 EDM Association dba EDM Council, Inc." .

fibo-exmp-le-djiaex:KatherineAdamsAsSeniorVicePresidentOfGovernmentAffairs a owl:NamedIndividual,
        fibo-be-oac-exec:CorporateOfficer ;
    rdfs:label "Katherine Adams as senior vice president of Government Affairs" ;
    skos:definition "Katherine Adams in the role of Senior Vice President of Government Affairs of Apple Inc." ;
    fibo-be-oac-exec:isOfficerOf fibo-exmp-le-djiaex:AppleIncAsControlledParty ;
    cmns-rlcmp:isPlayedBy fibo-exmp-le-djiaex:KatherineAdams .

fibo-exmp-le-djiaex:TimCookAsChiefExecutiveOfficer a owl:NamedIndividual,
        fibo-be-oac-exec:ChiefExecutiveOfficer ;
    rdfs:label "Tim Cook as Chief Executive Officer" ;
    skos:definition "Tim Cook in the role of CEO of Apple Inc." ;
    fibo-be-oac-exec:isOfficerOf fibo-exmp-le-djiaex:AppleIncAsControlledParty ;
    cmns-rlcmp:isPlayedBy fibo-exmp-le-djiaex:TimCook .

fibo-exmp-le-djiaex:EmploymentOfKatherineAdamsAtAppleInc a owl:NamedIndividual,
        fibo-fnd-org-fm:Employment ;
    rdfs:label "Employment of Katherine Adams at Apple Inc." ;
    skos:definition "situation representing the relationship between Apple Inc. as an employer and Katherine Adams as an employee" ;
    fibo-fnd-org-fm:hasEmployedParty fibo-exmp-le-djiaex:KatherineAdamsAsEmployee ;
    fibo-fnd-org-fm:hasEmployingParty fibo-exmp-le-djiaex:AppleIncAsEmployer .

fibo-exmp-le-djiaex:EmploymentOfTimCookAtAppleInc a owl:NamedIndividual,
        fibo-fnd-org-fm:Employment ;
    rdfs:label "Employment of Tim Cook at Apple Inc." ;
    skos:definition "situation representing the relationship between Apple Inc. as an employer and Tim Cook as an employee" ;
    fibo-fnd-org-fm:hasEmployedParty fibo-exmp-le-djiaex:TimCookAsEmployee ;
    fibo-fnd-org-fm:hasEmployingParty fibo-exmp-le-djiaex:AppleIncAsEmployer ;
    cmns-pts:holdsDuring fibo-exmp-le-djiaex:TimCookPeriodOfEmployment .

fibo-exmp-le-djiaex:KatherineAdamsAsEmployee a owl:NamedIndividual,
        fibo-fnd-org-fm:Employee ;
    rdfs:label "Katherine Adams as employee" ;
    skos:definition "Katherine Adams in the role of being employed by Apple Inc." ;
    fibo-fnd-org-fm:isEmployedIn fibo-exmp-le-djiaex:EmploymentOfKatherineAdamsAtAppleInc ;
    fibo-fnd-org-fm:isEmployeeOf fibo-exmp-le-djiaex:AppleIncAsEmployer ;
    cmns-rlcmp:isPlayedBy fibo-exmp-le-djiaex:KatherineAdams .

fibo-exmp-le-djiaex:KatherineAdamsDateOfBirth a owl:NamedIndividual,
        fibo-fnd-aap-ppl:DateOfBirth ;
    rdfs:label "Katherine Adams date of birth" ;
    skos:definition "date on which Katherine Adams was born" ;
    cmns-dt:hasDateValue "1964-04-20" .

fibo-exmp-le-djiaex:KatherineAdamsFullLegalName a owl:NamedIndividual,
        fibo-fnd-aap-ppl:PersonName ;
    rdfs:label "Katherine Adams full legal name" ;
    skos:definition "name that is on Katherine Adams' birth certificate and that she uses for legal purposes" ;
    fibo-fnd-aap-ppl:hasFullLegalName "Katherine Leatherman Adams" ;
    cmns-dsg:isNameOf fibo-exmp-le-djiaex:KatherineAdams .

fibo-exmp-le-djiaex:TimCookAsEmployee a owl:NamedIndividual,
        fibo-fnd-org-fm:Employee ;
    rdfs:label "Tim Cook as employee" ;
    skos:definition "Tim Cook in the role of being employed by Apple Inc." ;
    fibo-fnd-org-fm:isEmployedIn fibo-exmp-le-djiaex:EmploymentOfTimCookAtAppleInc ;
    fibo-fnd-org-fm:isEmployeeOf fibo-exmp-le-djiaex:AppleIncAsEmployer ;
    cmns-rlcmp:isPlayedBy fibo-exmp-le-djiaex:TimCook .

fibo-exmp-le-djiaex:TimCookDateOfBirth a owl:NamedIndividual,
        fibo-fnd-aap-ppl:DateOfBirth ;
    rdfs:label "Tim Cook date of birth" ;
    skos:definition "date on which Tim Cook was born" ;
    cmns-dt:hasDateValue "1960-11-01" .

fibo-exmp-le-djiaex:TimCookFullLegalName a owl:NamedIndividual,
        fibo-fnd-aap-ppl:PersonName ;
    rdfs:label "Tim Cook full legal name" ;
    skos:definition "name that is on Tim Cook's birth certificate and that he uses for legal purposes" ;
    fibo-fnd-aap-ppl:hasFullLegalName "Timothy Donald Cook" ;
    cmns-dsg:isNameOf fibo-exmp-le-djiaex:TimCook .

fibo-exmp-le-djiaex:TimCookHireDate a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Tim Cook hire date" ;
    skos:definition "date on which Tim Cook was hired by Apple Inc." ;
    cmns-dt:hasDateValue "1998-03-01" .

fibo-exmp-le-djiaex:TimCookPeriodOfEmployment a owl:NamedIndividual,
        cmns-dt:DatePeriod ;
    rdfs:label "Tim Cook period of employment" ;
    skos:definition "date period reflecting when Tim Cook was (is) employed by Apple Inc." ;
    cmns-dt:hasStartDate fibo-exmp-le-djiaex:TimCookHireDate ;
    cmns-dt:hasWndDate fibo-exmp-le-djiaex:TimCookRetirementDate .

fibo-exmp-le-djiaex:TimCookRetirementDate a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Tim Cook retirement date" ;
    skos:definition "effective date on which Tim Cook retires from Apple Inc." ;
    cmns-dt:hasDateValue "2026-09-01" .

fibo-exmp-le-djiaex:AppleIncAsControlledParty a owl:NamedIndividual,
        fibo-be-oac-cpty:ControlledParty ;
    rdfs:label "Apple Inc. as controlled party" ;
    skos:definition "Apple Inc. in its role as a corporation that is controlled to some degree by its corporate officers" ;
    cmns-rlcmp:isPlayedBy fibo-exmp-le-djiac:AppleInc-US-CA .

fibo-exmp-le-djiaex:KatherineAdams a owl:NamedIndividual,
        fibo-fnd-aap-ppl:Person ;
    rdfs:label "Katherine Adams" ;
    skos:definition "person that is an American attorney and corporate lawyer" ;
    fibo-fnd-aap-ppl:hasCitizenship lcc-3166-1:UnitedStatesOfAmerica ;
    fibo-fnd-aap-ppl:hasDateOfBirth fibo-exmp-le-djiaex:KatherineAdamsDateOfBirth ;
    cmns-dsg:hasName fibo-exmp-le-djiaex:KatherineAdamsFullLegalName .

fibo-exmp-le-djiaex:TimCook a owl:NamedIndividual,
        fibo-fnd-aap-ppl:Person ;
    rdfs:label "Tim Cook" ;
    skos:definition "person that lives in Palo Alto, California in the San Francisco Bay Area" ;
    fibo-fnd-aap-ppl:hasCitizenship lcc-3166-1:UnitedStatesOfAmerica ;
    fibo-fnd-aap-ppl:hasDateOfBirth fibo-exmp-le-djiaex:TimCookDateOfBirth ;
    cmns-dsg:hasName fibo-exmp-le-djiaex:TimCookFullLegalName .

fibo-exmp-le-djiaex:AppleIncAsEmployer a owl:NamedIndividual,
        fibo-fnd-org-fm:Employer ;
    rdfs:label "Apple Inc. as employer" ;
    skos:definition "Apple Inc. in its role as a corporation that has employees" ;
    cmns-rlcmp:isPlayedBy fibo-exmp-le-djiac:AppleInc-US-CA .

