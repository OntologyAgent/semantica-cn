    skos:definition "Delaware Division of Corporations business entity identifier for NYSE Holdings LLC" ;
    cmns-dsg:hasTag "5257784" ;
    cmns-id:identifies fibo-exmp-le-mktex:NYSEHoldingsLLC-US-DE ;
    cmns-ra:isRegisteredIn fibo-fbc-fct-usjrga:DelawareBusinessEntitiesRegistry .

fibo-exmp-le-mktex:NewYorkStockExchangeLLCBusinessEntityIdentifier a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifier ;
    rdfs:label "New York Stock Exchange LLC business entity identifier" ;
    skos:definition "the New York Department of State Division of Corporations business entity identifier for New York Stock Exchange LLC" ;
    cmns-dsg:hasTag "3230916" ;
    cmns-id:identifies fibo-exmp-le-mktex:NewYorkStockExchangeLLC-US-NY ;
    cmns-ra:isRegisteredIn fibo-fbc-fct-usjrga:NewYorkBusinessEntitiesRegistry .

fibo-exmp-le-mktex:UnitedAgentGroupInc-US-DE-BusinessEntityIdentifier a owl:NamedIndividual,
