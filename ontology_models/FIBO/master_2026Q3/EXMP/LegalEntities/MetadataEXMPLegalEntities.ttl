fibo-exmp-le-mod: a owl:Ontology ;
    rdfs:label "Metadata about the FIBO Example Legal Entities Module",
        "EXMP 法律实体示例模块元数据（Metadata for the EXMP Legal Entities Module）"@zh ;
    dcterms:abstract "This module contains example legal entities and executives combining details from other parts of FIBO that demonstrate how to model them." ;
