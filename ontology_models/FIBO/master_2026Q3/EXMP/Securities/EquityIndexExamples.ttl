@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-exmp-sec-eqind: a owl:Ontology ;
    rdfs:label "Equity Index Example Individuals Ontology",
        "股指示例个体本体（Equity Index Example Individuals Ontology）"@zh ;
    dcterms:abstract "This ontology provides examples of how to represent common equity indices as identified in the IND-EFT-DEV use case." ;
    dcterms:license """Copyright (c) 2020-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2020-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "收录股票指数（如道琼斯工业平均指数）的示例个体。"@zh ;
    owl:imports fibo-be-fct-pub:,
        fibo-be-le-fbo:,
        <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/>,
        fibo-be-plc-plc:,
        fibo-exmp-sec-eqex:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-fi-fi:,
        fibo-fbc-fct-breg:,
        fibo-fbc-fct-cra:,
        fibo-fbc-fct-usjrga:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-dt-fd:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-alx:,
        fibo-fnd-utl-av:,
        fibo-ind-ind-ind:,
        fibo-ind-mkt-bas:,
        fibo-sec-sec-bsk:,
        fibo-sec-sec-cls:,
        cmns-av:,
        cmns-col:,
        cmns-dt:,
        cmns-org:,
        cmns-qtu:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/EXMP/20260601/Securities/EquityIndexExamples/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/IND/20210901/MarketIndices/EquityIndexExampleIndividuals.rdf version of this ontology was modified to reflect the move of market data provider from interest rates in IND to publishers in BE.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20221001/MarketIndices/EquityIndexExampleIndividuals.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20230201/MarketIndices/EquityIndexExampleIndividuals.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC), eliminating redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20230301/MarketIndices/EquityIndexExampleIndividuals.rdf version of this ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20240101/MarketIndices/EquityIndexExampleIndividuals.rdf version of this ontology was modified to eliminate implicit punning and revise properties that are now deprecated (moved to Commons).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20240901/MarketIndices/EquityIndexExampleIndividuals.rdf version of this ontology was modified to revise a remaining property that moved to Commons.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20241101/MarketIndices/EquityIndexExampleIndividuals.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20250301/MarketIndices/EquityIndexExampleIndividuals.rdf version of the ontology was modified to move examples to a separate domain area for clarification for FIBO users (FND-407)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2020-2025 Object Management Group, Inc.",
        "Copyright (c) 2020-2026 EDM Association dba EDM Council, Inc." .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-AppleIncCommonStockConstituent a owl:NamedIndividual,
        fibo-sec-sec-bsk:SecuritiesBasketConstituent ;
    rdfs:label "Dow Jones Industrial Average basket - Apple Inc. common stock constituent" ;
    skos:definition "Apple Inc. common stock constituent of the DJIA basket of 30 stocks" ;
    fibo-fnd-dt-fd:hasDateAdded fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-AppleIncCommonStockDateAdded ;
    fibo-fnd-rel-rel:involves fibo-exmp-sec-eqex:XNASListedAppleIncCommonStock ;
    fibo-fnd-utl-alx:hasWeight 1.0 ;
    cmns-col:isConstituentOf fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-IBMCommonStockConstituent a owl:NamedIndividual,
        fibo-sec-sec-bsk:SecuritiesBasketConstituent ;
    rdfs:label "Dow Jones Industrial Average basket - IBM common stock constituent" ;
    skos:definition "IBM common stock constituent of the DJIA basket of 30 stocks" ;
    fibo-fnd-dt-fd:hasDateAdded fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-IBMCommonStockDateAdded ;
    fibo-fnd-rel-rel:involves fibo-exmp-sec-eqex:XNYSListedInternationalBusinessMachinesCorporationCommonStock ;
    fibo-fnd-utl-alx:hasWeight 1.0 ;
    cmns-col:isConstituentOf fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheCoca-ColaCompanyCommonStockConstituent a owl:NamedIndividual,
        fibo-sec-sec-bsk:SecuritiesBasketConstituent ;
    rdfs:label "Dow Jones Industrial Average basket - The Coca-Cola Company common stock constituent" ;
    skos:definition "The Coca-Cola Company common stock constituent of the DJIA basket of 30 stocks" ;
    fibo-fnd-dt-fd:hasDateAdded fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheCoca-ColaCompanyCommonStockDateAdded ;
    fibo-fnd-rel-rel:involves fibo-exmp-sec-eqex:XNYSListedTheCoca-ColaCompanyCommonStock ;
    fibo-fnd-utl-alx:hasWeight 1.0 ;
    cmns-col:isConstituentOf fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheHomeDepotCommonStockConstituent a owl:NamedIndividual,
        fibo-sec-sec-bsk:SecuritiesBasketConstituent ;
    rdfs:label "Dow Jones Industrial Average basket - The Home Depot, Inc. common stock constituent" ;
    skos:definition "The Home Depot, Inc. common stock constituent of the DJIA basket of 30 stocks" ;
    fibo-fnd-dt-fd:hasDateAdded fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheHomeDepotCommonStockDateAdded ;
    fibo-fnd-rel-rel:involves fibo-exmp-sec-eqex:XNYSListedTheHomeDepotIncCommonStock ;
    fibo-fnd-utl-alx:hasWeight 1.0 ;
    cmns-col:isConstituentOf fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheProctorAndGambleCompanyCommonStockConstituent a owl:NamedIndividual,
        fibo-sec-sec-bsk:SecuritiesBasketConstituent ;
    rdfs:label "Dow Jones Industrial Average basket - The Proctor & Gamble Company common stock constituent" ;
    skos:definition "The Proctor & Gamble Company common stock constituent of the DJIA basket of 30 stocks" ;
    fibo-fnd-dt-fd:hasDateAdded fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheProctorAndGambleCompanyCommonStockDateAdded ;
    fibo-fnd-rel-rel:involves fibo-exmp-sec-eqex:XNYSListedTheProctorAndGambleCompanyCommonStock ;
    fibo-fnd-utl-alx:hasWeight 1.0 ;
    cmns-col:isConstituentOf fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageValue-2023-03-06T120514-0500 a owl:NamedIndividual,
        fibo-fnd-utl-alx:NumericIndexValue ;
    rdfs:label "Dow Jones Industrial Average value as of Mar 6, 2020" ;
    skos:definition "individual representing the value of the DJIA on 6 Mar 2020 at 12:05:14 pm in NYC" ;
    fibo-fnd-acc-cur:hasRateValue 25523.20 ;
    fibo-ind-ind-ind:hasQuotationDateTime "2020-03-06T12:05:14-05:00"^^xsd:dateTime ;
    cmns-qtu:isValueOf fibo-exmp-sec-eqind:DowJonesIndustrialAverage .

fibo-exmp-sec-eqind:StandardAndPoors500CompositeIndex a owl:NamedIndividual,
        fibo-ind-mkt-bas:EquityIndex ;
    rdfs:label "Standard & Poor's Composite Index" ;
    skos:definition "equity index that is calculated based on the float-adjusted market capitalization of approximately 500 large companies listed on stock exchanges in the United States" ;
    fibo-be-fct-pub:hasPublisher fibo-exmp-sec-eqind:SPDowJonesIndices ;
    fibo-fbc-dae-dbt:isBasedOn fibo-exmp-sec-eqind:StandardAndPoors500CompositeIndexBasket ;
    fibo-fnd-utl-alx:isCalculatedViaMethodology "The components of the S&P 500 are selected by a committee. When considering the eligibility of a new addition, the committee assesses the company's merit using eight primary criteria: market capitalization, liquidity, domicile, public float, sector classification, financial viability, and length of time publicly traded and stock exchange."@en ;
    cmns-av:abbreviation "S&P 500" ;
    cmns-av:explanatoryNote "The S&P 500 is a market capitalization-weighted index and the performance of the 10 largest companies in the index account for 21.8 percent of the performance of the index."@en .

fibo-exmp-sec-eqind:DowJonesIndustrialAverage a owl:NamedIndividual,
        fibo-ind-mkt-bas:EquityIndex ;
    rdfs:label "Dow Jones Industrial Average" ;
    skos:definition "equity index of 30 substantial stocks that are traded on the New York Stock Exchange (NYSE) and the Nasdaq" ;
    fibo-be-fct-pub:hasPublisher fibo-exmp-sec-eqind:SPDowJonesIndices ;
    fibo-fbc-dae-dbt:isBasedOn fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket ;
    fibo-fnd-utl-alx:isCalculatedViaMethodology "The index is calculated by adding the price of a single share of each stock together, with equal weighting, and dividing by the Dow Divisor which is constantly adjusted, and is currently around 0.1474."@en ;
    cmns-av:abbreviation "DJIA",
        "Dow" ;
    cmns-av:explanatoryNote ""@en .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-AppleIncCommonStockDateAdded a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Dow Jones Industrial Average basket - Apple Inc. common stock date added" ;
    skos:definition "individual representing the date that Apple Inc. common stock was initially added to the DJIA, replacing AT&T Inc." ;
    cmns-dt:hasDateValue "2015-03-19" .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-IBMCommonStockDateAdded a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Dow Jones Industrial Average basket - IBM common stock date added" ;
    skos:definition "individual representing the date that IBM common stock was most recently added to the DJIA" ;
    cmns-dt:hasDateValue "1979-06-29" .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheCoca-ColaCompanyCommonStockDateAdded a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Dow Jones Industrial Average basket - The Coca-Cola Company common stock date added" ;
    skos:definition "individual representing the date that The Coca-Cola Company common stock was most recently added to the DJIA" ;
    cmns-dt:hasDateValue "1987-03-12" .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheHomeDepotCommonStockDateAdded a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Dow Jones Industrial Average basket - The Home Depot, Inc. common stock date added" ;
    skos:definition "individual representing the date that The Home Depot, Inc. common stock was added to the DJIA" ;
    cmns-dt:hasDateValue "1999-11-01" .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket-TheProctorAndGambleCompanyCommonStockDateAdded a owl:NamedIndividual,
        cmns-dt:ExplicitDate ;
    rdfs:label "Dow Jones Industrial Average basket - The Proctor & Gamble Company common stock date added" ;
    skos:definition "individual representing the date that The Proctor & Gamble Company common stock was added to the DJIA" ;
    cmns-dt:hasDateValue "1932-05-26" .

fibo-exmp-sec-eqind:StandardAndPoors500CompositeIndexBasket a [ a owl:Restriction ;
            owl:onProperty cmns-qtu:hasExpression ;
            owl:someValuesFrom fibo-ind-mkt-bas:CapitalizationBasedWeightingFunction ],
        owl:NamedIndividual,
        fibo-ind-mkt-bas:BasketOfEquities ;
    rdfs:label "Standard & Poor's Composite Index basket" ;
    skos:definition "basket of common shares issued by approximately 500 large-cap companies that are traded on American stock exchanges" ;
    fibo-fbc-pas-fpas:hasSelectingParty fibo-exmp-sec-eqind:SPDowJonesIndicesLLC-US-DE ;
    fibo-fbc-pas-fpas:hasSelectionCriteria "To qualify for the S&P 500, a company must meet certain committee-established criteria, which include (1) a market cap of at least $13.1 billion, (2) trading the value of its market capitalization annually, (3) at least a quarter-million of its shares have been traded in each of the previous six months (4) the majority of shares are in the public's hands, (5) being publicly traded for at least a year, and (6) earnings over the most recent four quarters and in the most recent quarter must be positive." .

fibo-exmp-sec-eqind:SPDowJonesIndices a owl:NamedIndividual,
        fibo-be-fct-pub:MarketDataProvider,
        fibo-fbc-pas-fpas:FinancialServiceProvider ;
    rdfs:label "S & P Dow Jones Indices" ;
    skos:definition "financial service and market data provider that is a global provider of index-based data and research" ;
    cmns-rlcmp:isPlayedBy fibo-exmp-sec-eqind:SPDowJonesIndicesLLC-US-DE .

fibo-exmp-sec-eqind:SPDowJonesIndicesLLC-US-DE a owl:NamedIndividual,
        fibo-be-plc-plc:PrivateCompanyWithLimitedLiability ;
    rdfs:label "S & P Dow Jones Indices LLC US-DE" ;
    skos:definition "the S & P Dow Jones Indices LLC legal entity that is a Delaware limited liability company" ;
    fibo-be-le-fbo:hasHeadquartersAddress fibo-fbc-fct-cra:SPGlobalHeadquartersAddress ;
    fibo-be-oac-cctl:hasDomesticUltimateParent fibo-fbc-fct-cra:SPGlobal ;
    fibo-fbc-pas-fpas:hasLegalAgent fibo-fbc-fct-usjrga:CorporationServiceCompany ;
    cmns-org:hasWebsite "https://us.spindices.com/"^^xsd:anyURI .

fibo-exmp-sec-eqind:DowJonesIndustrialAverageBasket a [ a owl:Restriction ;
            owl:onProperty cmns-qtu:hasExpression ;
            owl:someValuesFrom fibo-ind-mkt-bas:CapitalizationBasedWeightingFunction ],
        owl:NamedIndividual,
        fibo-ind-mkt-bas:BasketOfEquities ;
    rdfs:label "Dow Jones Industrial Average basket" ;
    skos:definition "basket of 30 substantial stocks that are traded on the New York Stock Exchange (NYSE) and the Nasdaq" ;
    fibo-fbc-pas-fpas:hasSelectionCriteria "The Averages Committee, which includes the managing editor of The Wall Street Journal, the head of Dow Jones Indexes research, and the head of CME Group research, determine which components become a part of the DJIA. There are no set rules the Averages Committee must follow when selecting Dow components, only broad parameters to ensure those companies represent a large portion of the overall economic performance in the United States. Each average is reviewed at least once annually, but composition changes are rare for the sake of continuity. Since its beginnings in May of 1896, the Dow Jones stocks list has only changed 54 times. As of June 2018, the last remaining company of the original 12 components of the DJIA, General Electric (GE), was replaced by Walgreens Boots Alliance." .

