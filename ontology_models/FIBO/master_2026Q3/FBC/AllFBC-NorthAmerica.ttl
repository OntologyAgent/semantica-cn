    dcterms:modified "2026-06-19T18:00:00"^^xsd:dateTime ;
    dcterms:title "Financial Industry Business Ontology (FIBO) Financial Business and Commerce (FBC) Domain, North American Extension" ;
    rdfs:comment "聚合 FBC 域中北美法域的扩展本体（美国与加拿大的金融服务实体、监管机构及受控词汇等）。"@zh ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/BE/AllBE-NorthAmerica/>,
        <https://spec.edmcouncil.org/fibo/ontology/FBC/AllFBC-ReferenceMarkets/>,
        fibo-fbc-fct-cra:,
        fibo-fbc-fct-cafse:,
        fibo-fbc-fct-cajrga:,
        fibo-fbc-fct-usfse:,
        fibo-fbc-fct-usjrga: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FBC/20261001/AllFBC-NorthAmerica/> ;
    cmns-av:copyright "Copyright (c) 2020-2025 Object Management Group, Inc.",
        "Copyright (c) 2020-2026 EDM Association dba EDM Council, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for the North American Extension of FBC is provided for convenience for FIBO users. This ontology does not add new assertions, but imports most of the Production (Released) ontologies that comprise the FIBO Foundations (FND), Business Entities (BE) and Financial Business and Commerce (FBC) domains, including all of FND but excluding individuals for European governments and jurisdictions, financial services and regulatory organizations and related registries, as well as the related LCC region-specific ontologies." .

