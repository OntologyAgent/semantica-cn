		See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2025-10-06T18:00:00"^^xsd:dateTime ;
    dcterms:title "EDMA Financial Industry Business Ontology (FIBO) Financial Business and Commerce (FBC) Domain" ;
    rdfs:comment "聚合金融商业与贸易（Financial Business and Commerce，FBC）域的全部生产本体：金融工具、金融市场、金融服务机构、监管机构、金融产品与服务、债务与担保等，一次导入即获得 FBC 域完整模型。"@zh ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/BE/AllBE/>,
        fibo-fbc-dae-cre:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-dae-gty:,
        fibo-fbc-fi-fi:,
        fibo-fbc-fi-ip:,
        fibo-fbc-fi-stl:,
        fibo-fbc-fct-bc:,
        fibo-fbc-fct-breg:,
        fibo-fbc-fct-fse:,
        fibo-fbc-fct-mkt:,
        fibo-fbc-fct-rga:,
        fibo-fbc-pas-caa:,
        fibo-fbc-pas-fpas: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FBC/20261001/AllFBC/> ;
    cmns-av:copyright "Copyright (c) 2015-2025 Object Management Group, Inc.",
        "Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for FBC is provided for convenience for FIBO users. This ontology does not add new assertions, but imports most of the Production (Released) ontologies that comprise the FIBO Foundations (FND), Business Entities (BE) and Financial Business and Commerce (FBC) domains, excluding individuals for governments and jurisdictions, financial services and most regulatory organizations and related registries, as well as the LCC region-specific ontologies." .

