@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cds: <https://www.omg.org/spec/Commons/CodesAndCodeSets/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-ra: <https://www.omg.org/spec/Commons/RegistrationAuthorities/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-le-cb: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/> .
@prefix fibo-be-le-fbo: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/> .
@prefix fibo-be-le-lei: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/> .
@prefix fibo-fbc-fct-breg: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fnd-aap-ppl: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix fibo-fnd-arr-cls: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/> .
@prefix fibo-fnd-arr-lif: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/> .
@prefix fibo-fnd-plc-adr: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-be-le-fbo:ValueAddedTaxIdentificationNumber a owl:Class ;
    rdfs:subClassOf cmns-ra:RegisteredIdentifier .

fibo-fbc-fct-breg: a owl:Ontology ;
    rdfs:label "Business Registries Ontology",
        "商业登记机构本体（Business Registries Ontology）"@zh ;
    dcterms:abstract "This ontology extends the Registration Authorities ontology to define specific kinds of registries, such as business entity registries, registries for identifiers and codes of various sorts, and registries for financial institutions and intermediaries based on jurisdiction, who regulates them, and the services they provide." ;
    dcterms:license """Copyright (c) 2020-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2020-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义商业登记机构（如公司注册处）及其登记职能。"@zh ;
    owl:imports fibo-be-le-cb:,
        fibo-be-le-fbo:,
        fibo-be-le-lei:,
        fibo-fbc-fct-fse:,
        fibo-fnd-aap-ppl:,
        fibo-fnd-arr-cls:,
        fibo-fnd-plc-adr:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-cls:,
        cmns-cds:,
        cmns-col:,
        cmns-dt:,
        cmns-dsg:,
        cmns-id:,
        cmns-org:,
        cmns-pts:,
        cmns-ra:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FBC/20260701/FunctionalEntities/BusinessRegistries/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/FBC/20150801/FunctionalEntities/BusinessRegistries.rdf version of this ontology was modified per the issue resolutions identified in the FIBO FBC 1.1 RTF report.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20160801/FunctionalEntities/BusinessRegistries.rdf version of this ontology was modified per FIBO 2.0 RFC primarily to loosen the constraints on address properties and better support standards including ISO 9362 (BIC codes), ISO 13616 (IBAN and BBAN codes), and ISO 17442 (the GLIEF LEI standard).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20180801/FunctionalEntities/BusinessRegistries.rdf version of this ontology was modified to generalize certain unions where they were no longer required, use the composite date datatype where appropriate, add individuals for entity expiration reason and validation level to better align with the GLEIF LEI data, and move international registration authorities, such as SWIFT, to a separate ontology for better modularity.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20190501/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to replace hasDefinition with isDefinedIn to clarify intent.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20190701/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20190901/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to eliminate duplication with concepts in LCC, simplify addresses, normalize definitions to be ISO 704 compliant, and rationalize address properties.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20200301/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to replace uses of hasTag in Relations with hasTag from LCC, as the more complex union of datatypes in the Relations concept is not needed here.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20200701/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to eliminate circular and ambiguous definitions.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20210201/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to reflect the move of certain organization-specific concepts from BE to FND.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20210901/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to clarify the definition of registry identifier and augment the definitions of certain identifiers, such as an LEI, to make them registry identifiers, as well as to modify the definition of an LOU to be a Registrar rather than RegistrationAuthority, and deprecate the redundant LOU identifier.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20211201/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to eliminate deprecated content.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20220501/FunctionalEntities/BusinessRegistries.rdf version of this ontology was revised to eliminate dead links and address text formatting issues uncovered by hygiene testing.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20220801/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary and refine the definitions of certain date properties to allow for broader usage, such as for market-related content.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230101/FunctionalEntities/BusinessRegistries.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230301/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to eliminate deprecations that are more than 6 months old.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20231101/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20240101/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20250301/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to merge details from the old corporations ontology into corporate bodies for consistency and useability (BE-259).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20251201/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to augment details related to GLEIF LEI records as needed to extend examples (FND-407).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20260601/FunctionalEntities/BusinessRegistries.rdf version of the ontology was modified to replace references to the now deprecated hasTag property in Relations with its equivalent in OMG Commons (FND-412)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2020-2025 Object Management Group, Inc.",
        "Copyright (c) 2020-2026 EDM Association dba EDM Council, Inc." .

fibo-fbc-fct-breg:ActiveStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityStatus ;
    rdfs:label "active status" ;
    skos:definition "status indicating that as of the last report or update, the entity was legally registered and operating" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "ACTIVE" .

fibo-fbc-fct-breg:AnnulledStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "annulled status" ;
    skos:definition "status indicating that the registration was determined to be erroneous or invalid after issuance" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "ANNULLED" .

fibo-fbc-fct-breg:BusinessRegisterIdentifier a owl:Class ;
    rdfs:label "business register identifier",
        "商业登记册标识符（business register identifier）"@zh ;
    rdfs:comment "唯一标识商业登记册的标识符，例如由全球法人识别编码基金会（GLEIF）登记册标识的登记册。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-ra:isRegisteredBy ;
            owl:someValuesFrom fibo-fbc-fct-breg:BusinessRegistrationAuthority ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-breg:BusinessRegistry ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "identifier that uniquely identifies a business register, such as a register identified by the Global Legal Entity Identifier Foundation (GLEIF) registration authorities list" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/gleif-registration-authorities-list"^^xsd:anyURI .

fibo-fbc-fct-breg:CancelledStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "cancelled status" ;
    skos:definition "status indicating that the registration was abandoned prior to issuance" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "CANCELLED" .

fibo-fbc-fct-breg:DuplicateStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "duplicate status" ;
    skos:definition "status indicating that the registration was determined to be a duplicate registration of the same entity as another registration; duplicate status is assigned to the non-surviving registration (i.e. the identifier that should no longer be used)" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "DUPLICATE" .

fibo-fbc-fct-breg:EntityExpirationReasonCorporateAction a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityExpirationReason ;
    rdfs:label "entity expiration reason - corporate action" ;
    skos:definition "expiration reason indicating that an entity was acquired or merged with another entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "CORPORATE_ACTION" .

fibo-fbc-fct-breg:EntityExpirationReasonDissolved a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityExpirationReason ;
    rdfs:label "entity expiration reason - disolved" ;
    skos:definition "expiration reason indicating that an entity ceased to operate" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "DISSOLVED" .

fibo-fbc-fct-breg:EntityExpirationReasonOther a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityExpirationReason ;
    rdfs:label "entity expiration reason - other" ;
    skos:definition "expiration reason indicating something that is neither due to disolution nor corporate action" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "OTHER" .

fibo-fbc-fct-breg:EntityLegalFormRegistry a owl:Class ;
    rdfs:label "entity legal form registry",
        "实体法律形式登记册（entity legal form registry）"@zh ;
    rdfs:comment "按照特定司法管辖区规定，登记和维护商业实体有效法律形式信息的登记册。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-breg:EntityLegalFormRegistryEntry ],
        cmns-ra:Registry ;
    skos:definition "registry for registering and maintaining information about the legal forms that are valid for business entities for a particular jurisdiction following the ISO 20275 standard" ;
    cmns-av:abbreviation "ELF registry" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/code-lists/iso-20275-entity-legal-forms-code-list"^^xsd:anyURI .

fibo-fbc-fct-breg:EntityValidationLevelEntitySuppliedOnly a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityValidationLevel ;
    rdfs:label "entity validation level - entity-supplied only" ;
    skos:definition "Based on the validation procedures in use by the LOU responsible for the record, the information associated with this record has significant reliance on the information that a submitter provided due to the unavailability of corroborating information." ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "ENTITY_SUPPLIED_ONLY" .

fibo-fbc-fct-breg:EntityValidationLevelFullyCorroborated a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityValidationLevel ;
    rdfs:label "entity validation level - fully corroborated" ;
    skos:definition "Based on the validation procedures in use by the LOU responsible for the record, there is sufficient information contained in authoritative public sources to corroborate the information that the submitter has provided for the record." ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "FULLY_CORROBORATED" .

fibo-fbc-fct-breg:EntityValidationLevelPartiallyCorroborated a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityValidationLevel ;
    rdfs:label "entity validation level - partially corroborated" ;
    skos:definition "Based on the validation procedures in use by the LOU responsible for the record, the information supplied by the registrant can be partially corroborated by public authoritative sources, while some of the record is dependent upon the information that the registrant submitted, either due to conflicts with authoritative information, or due to data unavailability." ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "PARTIALLY_CORROBORATED" .

fibo-fbc-fct-breg:InactiveStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:EntityStatus ;
    rdfs:label "inactive status" ;
    skos:definition "status indicating that the entity is no longer legally registered and/or operating, whether as a result of business closure, acquisition by or merger with another (or new) entity, or determination of illegitimacy" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "INACTIVE" .

fibo-fbc-fct-breg:IssuedStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "issued status" ;
    skos:definition "status indicating that the registration has been validated and issued, and which identifies an entity that was operating legally as of the last update" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "ISSUED" .

fibo-fbc-fct-breg:LapsedStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "lapsed status" ;
    skos:definition "status indicating that the registration that has not been renewed by the specified renewal date and is not known by public sources to have ceased operation as of the last update" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "LAPSED" .

fibo-fbc-fct-breg:LegalEntityIdentifierRegistry a owl:Class ;
    rdfs:label "legal entity identifier registry",
        "法人识别编码登记册（legal entity identifier registry）"@zh ;
    rdfs:comment "为特定司法管辖区登记和维护商业实体信息的登记册。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-breg:LegalEntityIdentifierRegistryEntry ],
        fibo-fbc-fct-breg:BusinessRegistry ;
    skos:definition "registry for registering and maintaining information about business entities for a particular jurisdiction" ;
    cmns-av:abbreviation "LEI registry" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:LocalOperatingUnit a owl:Class ;
    rdfs:label "local operating unit",
        "本地运营单位（local operating unit）"@zh ;
    rdfs:comment "经全球法人识别编码基金会授权、可签发法人识别编码（LEI）的注册机构。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:issues ;
            owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifier ],
        [ a owl:Restriction ;
            owl:onProperty cmns-ra:registers ;
            owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifier ],
        cmns-ra:Registrar ;
    skos:definition "registrar that is authorized by the Global LEI Foundation to issue legal entity identifiers" ;
    cmns-av:abbreviation "LOU" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-av:explanatoryNote "LOUs supply registration, renewal and other services, and act as the primary interface for legal entities wishing to obtain an LEI." .

fibo-fbc-fct-breg:MergedStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "merged status" ;
    skos:definition "status indicating that the registration is for an entity that has been merged into another legal entity, such that this legal entity no longer exists as an independently operating entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "MERGED" .

fibo-fbc-fct-breg:PendingArchivalStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "pending archival status" ;
    skos:definition "status indicating that the registration is about to be transferred to a different registration authority, after which its registration status will revert to a non-pending status" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "PENDING_ARCHIVAL" .

fibo-fbc-fct-breg:PendingTransferStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "pending transfer status" ;
    skos:definition "status indicating that the registration has requested transfer to a different registration authority, and for which transfer is in progress" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "PENDING_TRANSFER" .

fibo-fbc-fct-breg:PendingValidationStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "pending validation status" ;
    skos:definition "status indicating that an application for registration has been submitted and is in process, pending validation" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "PENDING_VALIDATION" .

fibo-fbc-fct-breg:RegistrationAuthorityCode a owl:Class ;
    rdfs:label "registration authority code",
        "登记主管机构代码（registration authority code）"@zh ;
    rdfs:comment "唯一标识商业登记册、并与登记主管机构和司法管辖区相关联的标识符，由全球法人识别编码基金会签发。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-breg:BusinessRegistry ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-cds:CodeElement,
        cmns-ra:RegisteredIdentifier ;
    skos:definition "identifier that uniquely identifies a business registry, and is associated with a registration authority and jurisdiction, issued by the Global Legal Entity Identifier Foundation (GLEIF)" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/gleif-registration-authorities-list"^^xsd:anyURI .

fibo-fbc-fct-breg:RetiredStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "retired status" ;
    skos:definition "status indicating that the registration is for an entity that has ceased operation, without having been merged into another entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "RETIRED" .

fibo-fbc-fct-breg:TransferredStatus a owl:NamedIndividual,
        fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:label "transferred status" ;
    skos:definition "status indicating that the registration that has been transferred to a different registration authority" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-dsg:hasTag "TRANSFERRED" .

fibo-fbc-fct-breg:hasAlternativeLanguageLegalName a owl:DatatypeProperty ;
    rdfs:label "has alternative language legal name",
        "具有替代语言法定名称（has alternative language legal name）"@zh ;
    rdfs:comment "表示实体在其注册司法管辖区所使用的替代语言的注册法定名称。"@zh ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:hasLegalName ;
    skos:definition "denotes a registered legal name for the entity in an alternative language used in the legal jurisdiction in which the entity is registered" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasAutomaticallyTransliteratedLegalName a owl:DatatypeProperty ;
    rdfs:label "has automatically transliterated legal name",
        "具有自动转写法定名称（has automatically transliterated legal name）"@zh ;
    rdfs:comment "表示实体法定名称的自动生成的 ASCII 转写形式。"@zh ;
    rdfs:subPropertyOf fibo-fbc-fct-breg:hasTransliteratedLegalName ;
    skos:definition "denotes an auto-generated ASCII-transliterated representation of the legal name for the entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasInitialRegistrationDate a owl:DatatypeProperty ;
    rdfs:label "has initial registration date",
        "具有初始登记日期（has initial registration date）"@zh ;
    rdfs:comment "指明标识符或其他登记项目创建和/或首次登记的日期。"@zh ;
    rdfs:range cmns-dt:CombinedDateTime ;
    rdfs:subPropertyOf cmns-ra:hasRegistrationDate ;
    skos:definition "indicates the date on which an identifier or other registered item was created and/or first registered" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasPreferredTransliteratedLegalName a owl:DatatypeProperty ;
    rdfs:label "has preferred transliterated legal name",
        "具有首选转写法定名称（has preferred transliterated legal name）"@zh ;
    rdfs:comment "表示实体法定名称的首选 ASCII 转写形式。"@zh ;
    rdfs:subPropertyOf fibo-fbc-fct-breg:hasTransliteratedLegalName ;
    skos:definition "denotes a preferred ASCII-transliterated representation of the legal name for the entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasPriorLegalName a owl:DatatypeProperty ;
    rdfs:label "has prior legal name",
        "具有曾用法定名称（has prior legal name）"@zh ;
    rdfs:comment "表示实体此前使用过的主要法定名称。"@zh ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:hasLegalName,
        fibo-fnd-rel-rel:wasFormerlyKnownAs ;
    skos:definition "denotes a primary legal name that was used previously for the entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasRegistrationRevisionDate a owl:DatatypeProperty ;
    rdfs:label "has registration status revision date",
        "具有登记状态修订日期（has registration status revision date）"@zh ;
    rdfs:comment "指明登记册中特定登记状态被修订的日期。"@zh ;
    rdfs:range cmns-dt:CombinedDateTime ;
    rdfs:subPropertyOf cmns-ra:hasRegistrationDate ;
    skos:definition "indicates the date that the status of a specific registration in the registry was revised" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasRenewalDate a owl:DatatypeProperty ;
    rdfs:label "has renewal date",
        "具有续展日期（has renewal date）"@zh ;
    rdfs:comment "指明登记册中特定登记须续展或更新的日期。"@zh ;
    rdfs:range cmns-dt:CombinedDateTime ;
    rdfs:subPropertyOf cmns-ra:hasRegistrationDate ;
    skos:definition "indicates the date by which a specific registration in the registry must be renewed or updated" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI,
        "https://www.swift.com/standards/data-standards/bic?tl=en#BICPolicyandDatarecord"^^xsd:anyURI ;
    cmns-av:usageNote "This property is equivalent to the date of expiry in some registries, such as the BIC registry." .

fibo-fbc-fct-breg:hasTradingOrOperationalName a owl:DatatypeProperty ;
    rdfs:label "has trading or operational name",
        "具有经营名称（has trading or operational name）"@zh ;
    rdfs:comment "表示实体当前使用的「以……名义经营」「品牌名」等名称，该名称是对法定名称的补充而非替代。"@zh ;
    rdfs:subPropertyOf cmns-dsg:hasTextualName ;
    skos:definition "denotes a 'trading as', 'brand name', 'doing business as', or 'operating under' name currently used by the entity in addition to, but not replacing, the (primary) legal, official registered name" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasValidationDate a owl:DatatypeProperty ;
    rdfs:label "has validation date",
        "具有核验日期（has validation date）"@zh ;
    rdfs:comment "指明登记册中特定登记最近一次被审核和核验的日期。"@zh ;
    rdfs:range cmns-dt:CombinedDateTime ;
    rdfs:subPropertyOf cmns-ra:hasRegistrationDate ;
    skos:definition "indicates the date that a specific registration in the registry was most recently reviewed and validated" ;
    cmns-av:adaptedFrom "https://www.swift.com/standards/data-standards/bic?tl=en#BICPolicyandDatarecord"^^xsd:anyURI .

fibo-fbc-fct-breg:isSelfMaintained a owl:DatatypeProperty ;
    rdfs:label "is self-maintained",
        "是否自行维护（is self-maintained）"@zh ;
    rdfs:comment "表明实体信息是由内部维护还是由第三方维护。"@zh ;
    rdfs:range xsd:string ;
    skos:definition "indicates whether the information about the entity is maintained internally or by a third-party" ;
    cmns-av:adaptedFrom "https://www.swift.com/standards/data-standards/bic?tl=en#BICPolicyandDatarecord"^^xsd:anyURI .

fibo-fnd-aap-ppl:PassportNumber a owl:Class ;
    rdfs:subClassOf cmns-ra:RegisteredIdentifier .

fibo-fbc-fct-breg:EntityLegalFormRegistryEntry a owl:Class ;
    rdfs:label "entity legal form registry entry",
        "实体法律形式登记册条目（entity legal form registry entry）"@zh ;
    rdfs:comment "符合 ISO 20275 标准的实体法律形式登记册记录。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-be-le-lei:EntityLegalFormIdentifier ],
        cmns-ra:RegistryEntry ;
    skos:definition "entry in an entity legal form registry that conforms to ISO 20275" ;
    cmns-av:abbreviation "ELF registry entry" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/code-lists/iso-20275-entity-legal-forms-code-list"^^xsd:anyURI .

fibo-fbc-fct-breg:LegalEntityIdentifierRegistryEntry a owl:Class ;
    rdfs:label "legal entity identifier registry entry",
        "法人识别编码登记册条目（legal entity identifier registry entry）"@zh ;
    rdfs:comment "符合 ISO 17442 及全球法人识别编码基金会（GLEIF）通用数据格式（CDF）的登记册记录。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-be-le-lei:LegalEntityIdentifier ;
            owl:onProperty fibo-fbc-fct-breg:hasManagingLocalOperatingUnit ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fct-breg:hasValidationLevel ;
            owl:someValuesFrom fibo-fbc-fct-breg:EntityValidationLevel ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fct-breg:hasRegistrationStatus ;
            owl:someValuesFrom fibo-fbc-fct-breg:RegistrationStatus ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifier ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:BusinessRegistrationAuthority ;
            owl:onProperty fibo-fbc-fct-breg:hasValidationAuthority ],
        fibo-fbc-fct-breg:BusinessRegistryEntry ;
    skos:definition "entry in a legal entity identifier registry that conforms to ISO 17442 and the Global Legal Entity Identifier Foundation (GLEIF) Common Data Format (CDF)" ;
    cmns-av:abbreviation "LEI registry entry" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:NorthAmericanIndustryClassificationSystemScheme a owl:Class ;
    rdfs:label "North American Industry Classification System scheme",
        "北美行业分类体系方案（North American Industry Classification System scheme）"@zh ;
    rdfs:comment "定义北美行业分类体系（NAICS）代码的方案。"@zh ;
    rdfs:seeAlso <https://www.census.gov/naics/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-fbc-fct-breg:NorthAmericanIndustryClassificationSystemCode ],
        fibo-fnd-arr-cls:IndustrySectorClassificationScheme,
        cmns-cds:CodeSet ;
    skos:definition "the scheme defining the North American Industry Classification System (NAICS) Codes" ;
    cmns-av:explanatoryNote """The North American Industry Classification System (NAICS) is the standard used by Federal statistical agencies in classifying business establishments for the purpose of collecting, analyzing, and publishing statistical data related to the U.S. business economy.

NAICS was developed under the auspices of the Office of Management and Budget (OMB), and adopted in 1997 to replace the Standard Industrial Classification (SIC) system. It was developed jointly by the U.S. Economic Classification Policy Committee (ECPC), Statistics Canada and Mexico's Instituto Nacional Estadistica y Geografia, to allow for a high level of comparability in business statistics among the North American countries.""" .

fibo-fbc-fct-breg:StandardIndustrialClassificationScheme a owl:Class ;
    rdfs:label "standard industrial classification scheme",
        "标准行业分类方案（standard industrial classification scheme）"@zh ;
    rdfs:comment "定义标准行业分类（SIC）代码表的方案。"@zh ;
    rdfs:seeAlso <https://www.osha.gov/pls/imis/sic_manual.html/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-fbc-fct-breg:StandardIndustrialClassificationCode ],
        fibo-fnd-arr-cls:IndustrySectorClassificationScheme,
        cmns-cds:CodeSet ;
    skos:definition "the scheme defining the Standard Industrial Classification (SIC) Code List" ;
    cmns-av:explanatoryNote "Standard Industrial Classifications are four-digit codes that categorize companies by the type of business activities they engage in. These codes were created by the U.S. government in 1937 to facilitate analysis of economic activity across government agencies and within industries. They were mostly replaced in 1997 by a new system of six-digit codes called the North American Industry Classification System (NAICS). The new codes were adopted in part to standardize industry data collection and analysis in between Canada, the United States and Mexico which had entered into the North American Free Trade Agreement. Note that certain organizations, such as the Securities and Exchange Commission (SEC) still use SIC codes for some purposes." .

fibo-fbc-fct-breg:hasEntityExpirationDate a owl:DatatypeProperty ;
    rdfs:label "has entity expiration date",
        "具有实体终止日期（has entity expiration date）"@zh ;
    rdfs:comment "指明实体终止存在的日期。"@zh ;
    rdfs:range cmns-dt:CombinedDateTime ;
    rdfs:subPropertyOf fibo-fbc-fct-breg:hasExpiryDate ;
    skos:definition "indicates the date on which an entity ceases(d) to exist" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasEntityExpirationReason a owl:ObjectProperty ;
    rdfs:label "has entity expiration reason",
        "具有实体终止原因（has entity expiration reason）"@zh ;
    rdfs:comment "指明实体终止存在的原因（如解散、与其他实体合并等）。"@zh ;
    rdfs:range fibo-fbc-fct-breg:EntityExpirationReason ;
    rdfs:subPropertyOf cmns-dsg:isSignifiedBy ;
    skos:definition "indicates the reason that an entity ceased to exist (i.e., disolved, merged with another entity, etc.)" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasEntityStatus a owl:ObjectProperty ;
    rdfs:label "has entity status",
        "具有实体状态（has entity status）"@zh ;
    rdfs:comment "指明实体的状态（如存续、注销）。"@zh ;
    rdfs:range fibo-fbc-fct-breg:EntityStatus ;
    rdfs:subPropertyOf fibo-fnd-arr-lif:hasStage ;
    skos:definition "indicates the status of the entity (i.e., active, inactive)" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasExpiryDate a owl:DatatypeProperty ;
    rdfs:label "has expiry date",
        "具有到期日（has expiry date）"@zh ;
    rdfs:comment "指明某事物终止存在的日期。"@zh ;
    rdfs:range cmns-dt:CombinedDateTime ;
    skos:definition "indicates the date on which something ceases(d) to exist" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasManagingLocalOperatingUnit a owl:ObjectProperty ;
    rdfs:label "has managing local operating unit",
        "具有管理本地运营单位（has managing local operating unit）"@zh ;
    rdfs:comment "将法人识别记录与注册相关法人识别编码的本地运营单位标识符关联起来。"@zh ;
    owl:propertyChainAxiom ( cmns-ra:isRegisteredBy cmns-rlcmp:isPlayedBy cmns-id:isIdentifiedBy ) ;
    skos:definition "relates a legal entity identification record to the identifier for the local operating unit that registered the relevant legal entity identifier" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasRegistryName a owl:DatatypeProperty ;
    rdfs:label "has registry name",
        "具有登记册名称（has registry name）"@zh ;
    rdfs:comment "表示登记册的名称，例如登记法律实体商业登记标识符的商业登记册。"@zh ;
    rdfs:domain cmns-ra:Registry ;
    rdfs:subPropertyOf cmns-dsg:hasTextualName ;
    skos:definition "denotes a name for the registry, for example, for a business registry in which a business registration identifier for the legal entity is registered" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasValidationAuthority a owl:ObjectProperty ;
    rdfs:label "has validation authority",
        "具有核验机构（has validation authority）"@zh ;
    rdfs:comment "标识法律实体的商业登记主管机构，本地运营单位（LOU）以其作为核验依据。"@zh ;
    rdfs:range fibo-fbc-fct-breg:BusinessRegistrationAuthority ;
    rdfs:subPropertyOf cmns-pts:hasPartyRole ;
    skos:definition "identifies the business registration authority for the legal entity, used by the Local Operating Unit (LOU) as the basis for validation, as defined in the GLEIF Registration Authorities List" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:hasValidationLevel a owl:ObjectProperty ;
    rdfs:label "has validation level",
        "具有核验级别（has validation level）"@zh ;
    rdfs:comment "指明注册机构对法律实体执行的核验级别。"@zh ;
    rdfs:range fibo-fbc-fct-breg:EntityValidationLevel ;
    skos:definition "indicates the level of validation performed by the registrar with respect to the legal entity" .

cmns-org:LegalEntity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:NorthAmericanIndustryClassificationSystemCode ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:EntityExpirationReason ;
            owl:onProperty fibo-fbc-fct-breg:hasEntityExpirationReason ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:StandardIndustrialClassificationCode ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-dt:CombinedDateTime ;
            owl:onProperty fibo-fbc-fct-breg:hasEntityExpirationDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:EntityStatus ;
            owl:onProperty fibo-fbc-fct-breg:hasEntityStatus ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-org:LegalEntity ;
            owl:onProperty cmns-dt:precedes ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-plc-adr:PhysicalAddress ;
            owl:onProperty fibo-be-le-fbo:hasHeadquartersAddress ] .

fibo-fbc-fct-breg:BusinessRegistryEntry a owl:Class ;
    rdfs:label "business registry entry",
        "商业登记册条目（business registry entry）"@zh ;
    rdfs:comment "商业登记册中的一条记录。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-ra:hasRegistrationDate ;
            owl:someValuesFrom cmns-dt:CombinedDateTime ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-be-le-cb:RegistrationIdentifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:RegistrationStatus ;
            owl:onProperty fibo-fbc-fct-breg:hasRegistrationStatus ],
        cmns-ra:RegistryEntry ;
    skos:definition "entry in a business registry" .

fibo-fbc-fct-breg:hasRegistrationStatus a owl:ObjectProperty ;
    rdfs:label "has registration status",
        "具有登记状态（has registration status）"@zh ;
    rdfs:comment "指明特定登记（如标识符或许可证的登记）的状态。"@zh ;
    rdfs:range fibo-fbc-fct-breg:RegistrationStatus ;
    rdfs:subPropertyOf fibo-fnd-arr-lif:hasStage ;
    skos:definition "indicates the status of a specific registration, such as for an identifier or license" .

fibo-fbc-fct-breg:hasTransliteratedLegalName a owl:DatatypeProperty ;
    rdfs:label "has transliterated legal name",
        "具有转写法定名称（has transliterated legal name）"@zh ;
    rdfs:comment "表示实体法定名称的可选 ASCII 转写（即拉丁化/罗马化）形式。"@zh ;
    rdfs:subPropertyOf fibo-be-le-lei:hasTransliteratedName,
        fibo-fnd-rel-rel:hasLegalName ;
    skos:definition "denotes an optional ASCII-transliterated (i.e. Latin- or Romanized) representation of the legal name for the entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

cmns-org:FormalOrganization a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:NorthAmericanIndustryClassificationSystemCode ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-fct-breg:StandardIndustrialClassificationCode ;
            owl:onProperty cmns-cls:isClassifiedBy ] .

fibo-fbc-fct-breg:NorthAmericanIndustryClassificationSystemCode a owl:Class ;
    rdfs:label "North American Industry Classification System code",
        "北美行业分类体系代码（North American Industry Classification System code）"@zh ;
    rdfs:comment "代表某一行业的北美行业分类体系（NAICS）代码。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom cmns-org:FormalOrganization ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-breg:NorthAmericanIndustryClassificationSystemScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-arr-cls:IndustrySectorClassifier,
        cmns-cds:CodeElement ;
    skos:definition "the North American Industry Classification System (NAICS) code representing an industry" ;
    cmns-av:abbreviation "NAICS code" .

fibo-fbc-fct-breg:StandardIndustrialClassificationCode a owl:Class ;
    rdfs:label "standard industrial classification code",
        "标准行业分类代码（standard industrial classification code）"@zh ;
    rdfs:comment "代表某一行业的标准行业分类（SIC）代码。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom cmns-org:FormalOrganization ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-breg:StandardIndustrialClassificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-arr-cls:IndustrySectorClassifier,
        cmns-cds:CodeElement ;
    skos:definition "the SIC code representing an industry" ;
    cmns-av:abbreviation "SIC code" .

fibo-be-le-lei:LegalEntityIdentifier a owl:Class ;
    rdfs:subClassOf cmns-ra:RegisteredIdentifier .

fibo-fbc-fct-breg:BusinessRegistrationAuthority a owl:Class ;
    rdfs:label "business registration authority",
        "商业登记主管机构（business registration authority）"@zh ;
    rdfs:comment "负责维护商业实体登记册的登记主管机构。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:manages ;
            owl:someValuesFrom fibo-fbc-fct-breg:BusinessRegistry ],
        [ a owl:Restriction ;
            owl:onProperty cmns-ra:registers ;
            owl:someValuesFrom fibo-be-le-cb:RegistrationIdentifier ],
        cmns-ra:Registrar,
        cmns-ra:RegistrationAuthority ;
    skos:definition "registration authority that is responsible for maintaining a registry of business entities" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/gleif-registration-authorities-list"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A business registry may include any government-managed registry for registering a business, such as a state department of corporations in the US, as well as other registries such as a local operating unit (LOU) for registration of legal entity identifiers (LEIs). Any sanctioned registration authority as defined by the Registration Authorities List, published by GLEIF, is a business registration authority in this sense." .

fibo-fbc-fct-breg:BusinessRegistry a owl:Class ;
    rdfs:label "business registry",
        "商业登记册（business registry）"@zh ;
    rdfs:comment "用于登记和维护商业实体信息的登记册。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-breg:BusinessRegistryEntry ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty fibo-fbc-fct-breg:hasRegistryName ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-breg:BusinessRegistrationAuthority ;
            owl:onProperty cmns-org:isManagedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-ra:Registry ;
    skos:definition "registry for registering and maintaining information about business entities" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/gleif-registration-authorities-list"^^xsd:anyURI .

fibo-fbc-fct-breg:EntityStatus a owl:Class ;
    rdfs:label "entity status",
        "实体状态（entity status）"@zh ;
    rdfs:comment "表明实体运营和/或法律状态的生命周期阶段。"@zh ;
    rdfs:subClassOf fibo-fnd-arr-lif:LifecycleStage ;
    skos:definition "lifecycle stage indicating the operational and/or legal status of an entity" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-av:explanatoryNote "In some jurisdictions, there may be other possible values for entity status, such as suspended in the State of California, thus the individuals provided herein are not intended to be exhaustive." .

fibo-fbc-fct-breg:EntityExpirationReason a owl:Class ;
    rdfs:label "entity expiration reason",
        "实体终止原因（entity expiration reason）"@zh ;
    rdfs:comment "表示法律实体终止存在和/或终止运营原因的代码。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-cds:CodeElement ;
    skos:definition "code for the reason that a legal entity ceased to exist and/or operate" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:EntityValidationLevel a owl:Class ;
    rdfs:label "entity validation level",
        "实体核验级别（entity validation level）"@zh ;
    rdfs:comment "表示全球法人识别编码基金会（GLEIF）或本地运营单位（LOU）对注册人提供的参考数据所执行核验级别的代码。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-cds:CodeElement ;
    skos:definition "code for the level of validation performed by the GLEIF or LOU with respect to the reference data provided by the registrant" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-fbc-fct-breg:RegistrationStatus a owl:Class ;
    rdfs:label "registration status",
        "登记状态（registration status）"@zh ;
    rdfs:comment "表明某事物（如企业或法律实体）特定登记状态的生命周期阶段，由登记主管机构规定。"@zh ;
    rdfs:subClassOf fibo-fnd-arr-lif:LifecycleStage ;
    skos:definition "lifecycle stage indicating the status of a given registration of something, such as a business or legal entity, as specified by the registration authority" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI ;
    cmns-av:explanatoryNote "There may be other possible values for registration status, depending on the registry, thus the individuals provided herein are not intended to be exhaustive." .

