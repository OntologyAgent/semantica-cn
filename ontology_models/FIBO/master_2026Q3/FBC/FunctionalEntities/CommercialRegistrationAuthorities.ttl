fibo-fbc-fct-cra:ClearstreamBankingSA a owl:NamedIndividual,
        fibo-be-le-cb:StockCorporation ;
    rdfs:label "Clearstream Banking S.A." ;
    rdfs:seeAlso <https://www.euroclear.com/about/en/ourgovernancestructure.html> ;
    skos:definition "Euroclear legal entity that provides post-trade infrastructure and securities services in Europe and internationally" ;
