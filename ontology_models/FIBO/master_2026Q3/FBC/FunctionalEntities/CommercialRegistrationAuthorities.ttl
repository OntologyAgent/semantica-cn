fibo-fbc-fct-cra:Clearstream a owl:NamedIndividual,
        fibo-be-fct-pub:Publisher,
        fibo-fbc-fct-fse:CentralCounterpartyClearingHouse,
        fibo-fbc-fct-fse:CentralSecuritiesDepository,
        fibo-fbc-fct-fse:ClearingBank,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Clearstream Banking" ;
    rdfs:seeAlso <http://www.clearstream.com/clearstream-en/about-clearstream> ;
    skos:definition "Clearstream functional entity, which is an international central securities depository (ICSD) based in Luxembourg, providing post-trade infrastructure and securities services for the international market and 56 domestic markets worldwide" ;
    cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:ClearstreamBankingSA .

fibo-fbc-fct-cra:DTCCDataRepositoryOwnership a owl:NamedIndividual,
        fibo-be-oac-opty:DirectConsolidation ;
    rdfs:label "DTCC Data Repository ownership" ;
    skos:definition "entity ownership context for the DTCC Data Repository, a wholly owned subsidiary of the Depository Trust & Clearing Corporation" ;
    fibo-be-le-lei:hasOwnershipPercentage 100.0 ;
    fibo-be-oac-opty:hasOwnedEntity fibo-fbc-fct-cra:DTCCDataRepositoryLLC-US-NY ;
    fibo-be-oac-opty:hasOwningEntity fibo-fbc-fct-cra:DTCC-US-DE ;
    fibo-fnd-agr-ctr:isQualifiedBy fibo-be-le-lei:GenerallyAcceptedAccountingPrinciples .

fibo-fbc-fct-cra:Euroclear a owl:NamedIndividual,
        fibo-be-fct-pub:Publisher,
        fibo-fbc-fct-fse:CentralCounterpartyClearingHouse,
        fibo-fbc-fct-fse:CentralSecuritiesDepository,
        fibo-fbc-fct-fse:ClearingBank,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Euroclear" ;
    rdfs:seeAlso <https://www.euroclear.com/en.html> ;
    skos:definition "Euroclear functional entity, which is a global clearing house, central securities depository, and custodian that specializes in the settlement of securities transactions as well as the safekeeping and asset servicing of these securities" ;
    cmns-rlcmp:isPlayedBy fibo-fbc-fct-cra:EuroclearSANV .

