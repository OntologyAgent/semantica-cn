fibo-fbc-fct-mkti: a owl:Ontology ;
    rdfs:label "Markets Individuals",
        "市场个体本体（Markets Individuals）"@zh ;
    dcterms:abstract """This ontology includes individuals representing the set of markets and exchanges corresponding to the ISO 10383 Codes for exchanges and market identification (MIC) standard.
      This set of markets and MIC codes is current with respect to the published ISO 10383 data as of the dct:issued date, as processed for FIBO on the dct:modified date.""" ;
    dcterms:issued "2026-09-11T14:53:15" ;
    dcterms:license """Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2018-2025 Object Management Group, Inc.
