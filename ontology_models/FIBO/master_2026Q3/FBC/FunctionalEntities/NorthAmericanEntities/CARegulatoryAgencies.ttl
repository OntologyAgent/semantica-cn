fibo-fbc-fct-cajrga:InformationReturnsProgramNumber a owl:Class ;
    rdfs:label "information return program number",
        "信息申报计划编号（information return program number）"@zh ;
    rdfs:comment "由实体的商业编号、'RZ'缩写和用于信息申报的 4 位子账户编号拼接而成。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:LedgerAccount ;
            owl:onProperty cmns-id:identifies ],
        [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-cajrga:InformationReturnsIdentifierScheme ;
            owl:onProperty cmns-col:isMemberOf ],
        [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-caj:CanadianJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        fibo-fbc-fct-cajrga:BusinessNumber ;
    skos:definition "concatenation of an entity's business number, the 'RZ' abbreviation and a 4-digit subaccount number used for information returns" ;
    skos:example "000000000RZ0001" ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/completing-slips-summaries/financial-slips-summaries/information-returns-program-account.html"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An organization may have more than one information returns program number through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration. As opposed to other program numbers, this number is used for filing information returns and not as an account." .

