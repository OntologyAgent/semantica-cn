    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "taxation authority of the Government of Canada" ;
    fibo-be-le-fbo:hasHeadquartersAddress fibo-fbc-fct-cajrga:CanadaRevenueAgencyHeadOfficeAddress ;
    fibo-fnd-rel-rel:hasLegalName "Canada Revenue Agency"@en,
        "Agence du revenu du Canada"@fr ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/revenue-agency.html"^^xsd:anyURI ;
    cmns-av:explanatoryNote "This agency administers tax laws for the Canadian government and for several of the provinces and territories of Canada." ;
    cmns-col:isPartOf fibo-be-ge-caj:GovernmentOfCanada ;
    cmns-org:hasWebsite "https://www.canada.ca/en/revenue-agency.html"^^xsd:anyURI ;
    cmns-rga:hasJurisdiction fibo-be-ge-caj:CanadianJurisdiction .

fibo-fbc-fct-cajrga:CanadaRevenueAgencyHeadOfficeAddress a owl:NamedIndividual,
        fibo-fnd-plc-adr:ConventionalStreetAddress ;
    rdfs:label "Canada Revenue Agency head office address" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "head office address for the Canada Revenue Agency" ;
    fibo-fnd-plc-adr:hasAddressLine1 "555 Mackenzie Avenue" ;
    fibo-fnd-plc-adr:hasPostalCode "K1A 0L5" ;
    cmns-loc:hasCountry lcc-3166-1:Canada ;
    cmns-loc:hasMunicipality fibo-fbc-fct-bci:Ottawa ;
    cmns-loc:hasSubdivision lcc-3166-2-ca:Ontario .

fibo-fbc-fct-cajrga:CorporationIncomeTaxNumberIdentifierScheme a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifierScheme ;
    rdfs:label "Canada Revenue Agency corporation income tax number identifier scheme" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "registration identifier scheme for corporation income tax numbers defined by the Canada Revenue Agency for the registration of a business or legal entity" ;
    cmns-doc:refersTo fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme .

fibo-fbc-fct-cajrga:GoodsServicesTaxHarmonizedSalesTaxRegistrationIdentifierScheme a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifierScheme ;
    rdfs:label "Canada Revenue Agency Goods and Services Tax / Harmonized Sales Tax registration number identifier scheme" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "registration identifier scheme for GST/HST accounts defined by the Canada Revenue Agency for the registration of a business or legal entity" ;
    cmns-av:abbreviation "Canada Revenue Agency GST/HST registation number identifier scheme" ;
    cmns-doc:refersTo fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme .

fibo-fbc-fct-cajrga:ImportExportProgramNumberIdentifierScheme a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifierScheme ;
    rdfs:label "Canada Revenue Agency import export program number identifier scheme" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "registration identifier scheme for an import export program number defined by the Canada Revenue Agency for the registration of a business or legal entity" ;
    cmns-doc:refersTo fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme .

fibo-fbc-fct-cajrga:InformationReturnsIdentifierScheme a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifierScheme ;
    rdfs:label "Canada Revenue Agency information return program number identifier scheme" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "registration identifier scheme for information return program numbers defined by the Canada Revenue Agency for the registration of a business or legal entity" ;
    cmns-doc:refersTo fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme .

fibo-fbc-fct-cajrga:PayrollDeductionsProgramIdentifierRegistrationService a owl:NamedIndividual,
        cmns-ra:RegistrationService ;
    rdfs:label "Canada Revenue Agency payroll deductions program number registration service" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    rdfs:seeAlso <https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/payroll/How-open-payroll-account.html> ;
    skos:definition "Canada Revenue Agency service for the registration of payroll deductions program number accounts" ;
    cmns-org:isProvidedBy fibo-fbc-fct-cajrga:CanadianBusinessTaxRegistrar .

fibo-fbc-fct-cajrga:RegisteredCharityProgramNumberIdentifierScheme a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifierScheme ;
    rdfs:label "Canada Revenue Agency registered charity program number identifier scheme" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "registration identifier scheme for registered charity program numbers defined by the Canada Revenue Agency for the registration of a business or legal entity" ;
    cmns-doc:refersTo fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme .

fibo-fbc-fct-cajrga:BankOfCanada a owl:NamedIndividual,
        fibo-be-ge-ge:GovernmentAgency ;
    rdfs:label "Bank of Canada"@en,
        "Banque du Canada"@fr ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "central bank of Canada" ;
    fibo-be-le-fbo:hasHeadquartersAddress fibo-fbc-fct-cajrga:BankOfCanadaHeadOfficeAddress ;
    fibo-fnd-rel-rel:hasLegalName "Bank of Canada"@en,
        "Banque du Canada"@fr ;
    cmns-av:adaptedFrom "https://www.bankofcanada.ca/wp-content/uploads/2010/11/regulation_canadian_financial.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote """The Bank of Canada's overall goal is to promote a stable and efficient financial system in Canada. The focus on the financial system as a whole parallels the Bank's approach to monetary policy, which focuses on the entire economy.
 
 The Bank provides liquidity to the financial system, gives policy advice to the federal government on the design and development of the system, oversees major clearing and settlement systems, and provides banking services to these systems and their participants.""" ;
    cmns-col:isPartOf fibo-be-ge-caj:GovernmentOfCanada ;
    cmns-org:hasWebsite "https://www.bankofcanada.ca/"^^xsd:anyURI ;
    cmns-rga:hasJurisdiction fibo-be-ge-caj:CanadianJurisdiction .

fibo-fbc-fct-cajrga:BusinessNumber a owl:Class ;
    rdfs:label "business number",
        "商业编号（business number）"@zh ;
    rdfs:comment "加拿大法律实体（通常为企业）的标准标识符，是唯一的 9 位数字编号。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-caj:CanadianJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme ;
            owl:onProperty cmns-col:isMemberOf ],
        fibo-fnd-pty-pty:TaxIdentifier,
        cmns-org:OrganizationIdentifier ;
    skos:definition "unique, 9-digit number that is the standard identifier for legal entities in Canada which are typically a business" ;
    skos:example "000000000" ;
    cmns-av:abbreviation "BN" ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/services/taxes/business-number.html"^^xsd:anyURI .

fibo-fbc-fct-cajrga:BusinessNumberRegistrationIdentifierScheme a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifierScheme,
        fibo-fnd-pty-pty:TaxIdentificationScheme ;
    rdfs:label "Canada Revenue Agency business number registration identifier scheme" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "registration identifier scheme for business numbers defined by the Canada Revenue Agency for the registration of a business or legal entity" .

fibo-fbc-fct-cajrga:CanadianBusinessTaxRegistrar a owl:NamedIndividual,
        fibo-fbc-fct-breg:BusinessRegistrationAuthority,
        cmns-rga:RegulatoryAgency ;
    rdfs:label "Canadian business and tax registrar" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "regulatory agency and registration authority role of the Canada Revenue Agency" ;
    cmns-org:manages fibo-fbc-fct-cajrga:BusinessNumberRegistry ;
    cmns-org:provides fibo-fbc-fct-cajrga:BusinessNumberRegistrationService ;
    cmns-rlcmp:isPlayedBy fibo-fbc-fct-cajrga:CanadaRevenueAgency .

fibo-fbc-fct-cajrga: a owl:Ontology ;
    rdfs:label "Canadian Regulatory Agencies Ontology",
        "加拿大监管机构本体（Canadian Regulatory Agencies Ontology）"@zh ;
    dcterms:abstract "This ontology extends the primary regulatory agencies ontology in FBC with additional regulators that are specific to the United States and augments certain U.S. financial services entities based on who regulates them." ;
    dcterms:license """Copyright (c) 2016-2026 EDM Association dba EDM Council, Inc.
