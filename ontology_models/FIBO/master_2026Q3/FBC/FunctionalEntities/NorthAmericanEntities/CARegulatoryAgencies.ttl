fibo-fbc-fct-cajrga:RegisteredCharityProgramNumber a owl:Class ;
    rdfs:label "registered charity program number",
        "注册慈善机构计划编号（registered charity program number）"@zh ;
    rdfs:comment "由实体的商业编号、'RR'缩写和用于注册慈善机构捐赠申报的 4 位子账户编号拼接而成。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:LedgerAccount ;
            owl:onProperty cmns-id:identifies ],
        [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-caj:CanadianJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-cajrga:RegisteredCharityProgramNumberIdentifierScheme ;
            owl:onProperty cmns-col:isMemberOf ],
        fibo-fbc-fct-cajrga:BusinessNumber ;
    skos:definition "concatenation of an entity's business number, the 'RR' abbreviation and a 4-digit subaccount number used for registered charity contribution" ;
    skos:example "000000000RR0001" ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/revenue-agency/services/charities-giving/charities/operating-a-registered-charity/registration-number.html"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An organization may have more than one registered charity account through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration." .

