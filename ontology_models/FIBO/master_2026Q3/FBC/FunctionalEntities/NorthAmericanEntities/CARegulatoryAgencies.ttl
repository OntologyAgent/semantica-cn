fibo-fbc-fct-cajrga:BankOfCanadaLegalEntityIdentifierRegistryEntry a owl:NamedIndividual,
        fibo-fbc-fct-breg:LegalEntityIdentifierRegistryEntry ;
    rdfs:label "Bank of Canada legal entity identifier registry entry" ;
    skos:definition "legal entity identifier for the Bank of Canada" ;
    fibo-fbc-fct-breg:hasInitialRegistrationDate "2014-03-27T18:39:00-07:00"^^xsd:dateTime ;
    fibo-fbc-fct-breg:hasRegistrationRevisionDate "2025-02-26T07:49:54-08:00"^^xsd:dateTime ;
    fibo-fbc-fct-breg:hasRegistrationStatus fibo-fbc-fct-breg:IssuedStatus ;
    fibo-fbc-fct-breg:hasRenewalDate "2026-02-26T07:49:54-08:00"^^xsd:dateTime ;
    fibo-fbc-fct-breg:hasValidationLevel fibo-fbc-fct-breg:EntityValidationLevelEntitySuppliedOnly ;
    cmns-col:comprises <https://rdf.gleif.org/L1/L-549300PN6MKI0CLP4T28-LEI> .

fibo-fbc-fct-cajrga:CanadianBankingRegulatoryAgencyAndCentralBank a owl:NamedIndividual,
        fibo-fbc-fct-fse:CentralBank,
        cmns-ra:RegistrationAuthority,
        cmns-rga:RegulatoryAgency ;
    rdfs:label "Canadian banking regulatory agency, registration authority and central bank role of the Bank of Canada" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "regulatory agency, registration authority and central banking role of the Bank of Canada" ;
    cmns-av:adaptedFrom "http://www.bankofcanada.ca/"^^xsd:anyURI ;
    cmns-rlcmp:isPlayedBy fibo-fbc-fct-cajrga:BankOfCanada .

fibo-fbc-fct-cajrga:CorporationIncomeTaxNumber a owl:Class ;
    rdfs:label "corporation income tax number",
        "公司所得税编号（corporation income tax number）"@zh ;
    rdfs:comment "由实体的商业编号、'RC'缩写和用于申报公司所得税的 4 位子账户编号拼接而成。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-caj:CanadianJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:LedgerAccount ;
            owl:onProperty cmns-id:identifies ],
        [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-cajrga:CorporationIncomeTaxNumberIdentifierScheme ;
            owl:onProperty cmns-col:isMemberOf ],
        fibo-fbc-fct-cajrga:BusinessNumber ;
    skos:definition "concatenation of an entity's business number, the 'RC' abbreviation and a 4-digit subaccount number used for reporting corporate income tax" ;
    skos:example "000000000RC0001" ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/registering-your-business/corporation-income-tax-program-account.html"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An organization may have more than one tax account through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration." .

fibo-fbc-fct-cajrga:CorporationIncomeTaxNumberRegistrationService a owl:NamedIndividual,
        cmns-ra:RegistrationService ;
    rdfs:label "Canada Revenue Agency corporation income tax number registration service" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    rdfs:seeAlso <https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/gst-hst-businesses/account-register.html> ;
    skos:definition "Canada Revenue Agency service for the registration of corporation income tax accounts" ;
    cmns-org:isProvidedBy fibo-fbc-fct-cajrga:CanadianBusinessTaxRegistrar .

fibo-fbc-fct-cajrga:CorporationIncomeTaxNumberRegistry a owl:NamedIndividual,
        fibo-fbc-fct-breg:BusinessRegistry ;
    rdfs:label "Canada Revenue Agency corporation income tax number registry" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    skos:definition "Canada Revenue Agency corporation income tax number registry" ;
    cmns-av:explanatoryNote "No public access." ;
    cmns-org:isManagedBy fibo-fbc-fct-cajrga:CanadianBusinessTaxRegistrar ;
    cmns-rga:isGovernedBy fibo-be-ge-caj:CanadianJurisdiction .

fibo-fbc-fct-cajrga:GoodsServicesTaxHarmonizedSalesTaxNumberRegistry a owl:NamedIndividual,
        fibo-fbc-fct-breg:BusinessRegistry ;
    rdfs:label "Canada Revenue Agency Goods and Services Tax / Harmonized Sales Tax number registry" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
    rdfs:seeAlso <https://www.canada.ca/en/revenue-agency/services/e-services/e-services-businesses/confirming-a-gst-hst-account-number/terms-conditions-use.html> ;
    skos:definition "registry that records and tracks individual GST/HST numbers for the Canada Revenue Agency" ;
    cmns-av:abbreviation "GST/HST number registry" ;
    cmns-av:explanatoryNote "Limited public access." ;
    cmns-org:isManagedBy fibo-fbc-fct-cajrga:CanadianBusinessTaxRegistrar ;
    cmns-rga:isGovernedBy fibo-be-ge-caj:CanadianJurisdiction .

fibo-fbc-fct-cajrga:GoodsServicesTaxHarmonizedSalesTaxRegistrationNumber a owl:Class ;
    rdfs:label "Goods and Services Tax / Harmonized Sales Tax registration number",
        "商品及服务税/统一销售税登记编号（Goods and Services Tax / Harmonized Sales Tax registration number）"@zh ;
    rdfs:comment "由实体的商业编号、'RT'缩写和用于申报 GST/HST 的 4 位子账户编号拼接而成。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-cajrga:GoodsServicesTaxHarmonizedSalesTaxRegistrationIdentifierScheme ;
            owl:onProperty cmns-col:isMemberOf ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:LedgerAccount ;
            owl:onProperty cmns-id:identifies ],
        [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-caj:CanadianJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        fibo-be-le-fbo:ValueAddedTaxIdentificationNumber,
        fibo-fbc-fct-cajrga:BusinessNumber ;
    skos:definition "concatenation of an entity's business number, the 'RT' abbreviation and a 4-digit subaccount number used for reporting GST/HST" ;
    skos:example "000000000RT0001" ;
    cmns-av:abbreviation "GST/HST registation number" ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/gst-hst-businesses/account-register.html"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An organization may have more than one GST/HST account through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration." .

fibo-fbc-fct-cajrga:GoodsServicesTaxHarmonizedSalesTaxRegistrationService a owl:NamedIndividual,
        cmns-ra:RegistrationService ;
    rdfs:label "Canada Revenue Agency GST/HST number registration service" ;
    rdfs:isDefinedBy fibo-fbc-fct-cajrga: ;
