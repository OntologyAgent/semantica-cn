fibo-fbc-fct-cajrga:PayrollDeductionsProgramNumber a owl:Class ;
    rdfs:label "payroll deductions program number",
        "工资代扣计划编号（payroll deductions program number）"@zh ;
    rdfs:comment "由实体的商业编号、'RP'缩写和用于申报工资代扣的 4 位子账户编号拼接而成。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-cajrga:PayrollDeductionsProgramIdentifierRegistrationService ;
            owl:onProperty cmns-col:isMemberOf ],
        [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-caj:CanadianJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:LedgerAccount ;
            owl:onProperty cmns-id:identifies ],
        fibo-fbc-fct-cajrga:BusinessNumber ;
    skos:definition "concatenation of an entity's business number, the 'RP' abbreviation and a 4-digit subaccount number used for reporting payroll deductions" ;
    skos:example "000000000RP0001" ;
    cmns-av:adaptedFrom "https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/payroll/what-payroll-account.html"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An organization may have more than one deduction account through its subunits, this is handled through additional 4-digit subaccount numbers. This is used as both an account and an identifier for the registration." .

