@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-loc: <https://www.omg.org/spec/Commons/Locations/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-rga: <https://www.omg.org/spec/Commons/RegulatoryAgencies/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix cmns-sfc: <https://www.omg.org/spec/Commons/SitesAndFacilities/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-ge-usj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/USGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-be-le-cb: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/> .
@prefix fibo-be-le-fbo: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/> .
@prefix fibo-be-oac-cctl: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fbc-fct-usfse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-oac-ctl: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/> .
@prefix fibo-fnd-oac-own: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix lcc-3166-1: <https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-fbc-fct-usfse: a owl:Ontology ;
    rdfs:label "US Financial Services Entities Ontology",
        "美国金融服务实体本体（US Financial Services Entities Ontology）"@zh ;
    dcterms:abstract "This ontology extends the primary financial services entities ontology in FBC with additional kinds of entities that are specific to the United States." ;
    dcterms:license """Copyright (c) 2015-2025 EDM Council, Inc.
Copyright (c) 2015-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义美国法域下的金融服务机构类型与个体。"@zh ;
    owl:imports fibo-be-ge-usj:,
        fibo-be-le-cb:,
        fibo-be-le-fbo:,
        fibo-be-oac-cctl:,
        fibo-fbc-fct-fse:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-oac-ctl:,
        fibo-fnd-oac-own:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-col:,
        cmns-loc:,
        cmns-org:,
        cmns-rga:,
        cmns-rlcmp:,
        cmns-sfc:,
        lcc-3166-1: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FBC/20251201/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/FBC/20150801/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified per the issue resolutions identified in the FIBO FBC 1.0 FTF report.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20160801/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to generalize the definition of credit union.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20180801/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20190901/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to eliminate circular definitions and revise names such that concepts don't appear to refer to multiple things.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20210201/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to eliminate dead links and address text formatting issues identified through hygiene testing.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20220801/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary, add additional kinds of institutions in order to answer competency questions using the National Information Center (NIC) repository, leverage the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) to eliminate redundancies in FIBO, and clean up a couple of definitions to be ISO 704 compliant.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230301/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to augment the representation of institutions based on their definitions in the law, in order to answer competency questions using the National Information Center (NIC) repository",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230401/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of this ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20240101/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20250301/FunctionalEntities/NorthAmericanEntities/USFinancialServicesEntities.rdf version of the ontology was modified to to reuse concepts from the Commons 1.3 sites and facilities ontology (FND-401)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2015-2025 EDM Council, Inc.",
        "Copyright (c) 2015-2025 Object Management Group, Inc." .

fibo-fbc-fct-usfse:AgreementCorporation-Banking a owl:Class ;
    rdfs:label "agreement corporation - banking",
        "协议公司——银行类（agreement corporation - banking）"@zh ;
    rdfs:comment "章程允许其从事国际银行业务的协议公司。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:DepositoryInstitution,
        fibo-fbc-fct-usfse:AgreementCorporation ;
    skos:definition "agreement corporation whose charter allows the corporation to engage in international banking" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:AgreementCorporation-Investment a owl:Class ;
    rdfs:label "agreement corporation - investment",
        "协议公司——投资类（agreement corporation - investment）"@zh ;
    rdfs:comment "章程允许其从事国际投资银行业务的协议公司。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:InvestmentBank,
        fibo-fbc-fct-usfse:AgreementCorporation ;
    skos:definition "agreement corporation whose charter allows the corporation to engage in international investment banking" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:BankersBankNotSubjectToReserveRequirements a owl:Class ;
    rdfs:label "bankers' bank that is not subject to reserve requirements",
        "不受准备金要求约束的银行家银行（bankers' bank that is not subject to reserve requirements）"@zh ;
    rdfs:comment "其活动不受联邦储备特定要求限制的银行家银行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty fibo-fbc-fct-usfse:isSubjectToReserveRequirements ],
        fibo-fbc-fct-usfse:BankersBank ;
    skos:definition "bankers' bank whose activities are not limited by specific requirements of the Federal Reserve" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/nicpubweb/Content/DataDownload/NPW%20Data%20Dictionary.pdf" .

fibo-fbc-fct-usfse:BankersBankSubjectToReserveRequirements a owl:Class ;
    rdfs:label "bankers' bank subject to reserve requirements",
        "受准备金要求约束的银行家银行（bankers' bank subject to reserve requirements）"@zh ;
    rdfs:comment "其活动受联邦储备特定要求限制的银行家银行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty fibo-fbc-fct-usfse:isSubjectToReserveRequirements ],
        fibo-fbc-fct-usfse:BankersBank ;
    skos:definition "bankers' bank whose activities are limited by specific requirements of the Federal Reserve" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/nicpubweb/Content/DataDownload/NPW%20Data%20Dictionary.pdf" .

fibo-fbc-fct-usfse:CooperativeBank a owl:Class ;
    rdfs:label "cooperative bank",
        "合作银行（cooperative bank）"@zh ;
    rdfs:comment "依照其特许或组建所在州的法律组织和运营的州特许储蓄协会。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:ThriftInstitution ;
    skos:definition "state-chartered savings association that is organized and operates according to the laws of the state in which it is chartered or organized, including Massachusetts, New Hampshire, Rhode Island or Vermont" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:DomesticEntityOther a owl:Class ;
    rdfs:label "domestic entity other",
        "其他境内实体（domestic entity other）"@zh ;
    rdfs:comment "通常在美国从事与银行业务相关活动的境内机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:DomesticEntity ;
    skos:definition "domestic institution that engages in banking activities usually in connection with the business of banking in the United States" ;
    cmns-av:abbreviation "DEO" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "This classification is used primarily to cover organizations acting as financial institutions in the US that are not otherwise classified in the context of the National Information Center (NIC)." .

fibo-fbc-fct-usfse:EdgeCorporation-Banking a owl:Class ;
    rdfs:label "edge corporation - banking",
        "埃奇公司——银行类（edge corporation - banking）"@zh ;
    rdfs:comment "章程允许其从事国际银行业务的埃奇公司。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:DepositoryInstitution,
        fibo-fbc-fct-usfse:EdgeCorporation ;
    skos:definition "edge corporation whose charter allows the corporation to engage in international banking" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:EdgeCorporation-DomesticBranch a owl:Class ;
    rdfs:label "edge corporation - domestic branch",
        "埃奇公司——境内分行（edge corporation - domestic branch）"@zh ;
    rdfs:comment "位于美国境内的埃奇公司分行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
            owl:onProperty cmns-org:isDomiciledIn ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-fbc-fct-usfse:EdgeCorporation ] ],
        fibo-be-le-fbo:Branch ;
    skos:definition "branch of an edge corporation that is located in the United States" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:EdgeCorporation-Investment a owl:Class ;
    rdfs:label "edge corporation - investment",
        "埃奇公司——投资类（edge corporation - investment）"@zh ;
    rdfs:comment "章程允许其从事国际投资银行业务的埃奇公司。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:InvestmentBank,
        fibo-fbc-fct-usfse:EdgeCorporation ;
    skos:definition "edge corporation whose charter allows the corporation to engage in international investment banking" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:FarmCreditSystemInstitution a owl:Class ;
    rdfs:label "farm credit system institution",
        "农业信贷体系机构（farm credit system institution）"@zh ;
    rdfs:comment "由农业信贷管理局监督、检查和监管、并依相关法案运营的联邦特许金融机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:FinancialInstitution,
        fibo-fbc-fct-usfse:DomesticEntity ;
    skos:definition "federally-chartered financial institution that is supervised, examined, and regulated by the Farm Credit Administration and operates in accordance with the Farm Credit Act of 1971, as amended, 12 U.S.C. 2001 et seq" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "All Farm Credit System institutions are federally-chartered instrumentalities of the United States." .

fibo-fbc-fct-usfse:FederalCreditUnion a owl:Class ;
    rdfs:label "federal credit union",
        "联邦信用合作社（federal credit union）"@zh ;
    rdfs:comment "具有联邦隶属关系的信用合作社。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:USCreditUnion ;
    skos:definition "credit union that has a federal affiliation" .

fibo-fbc-fct-usfse:FinancialHoldingCompany a owl:Class ;
    rdfs:label "financial holding company",
        "金融控股公司（financial holding company）"@zh ;
    rdfs:comment "依 1999 年《格雷姆-里奇-比利雷法》获准从事广泛银行相关业务的金融实体。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:BankHoldingCompany ;
    skos:definition "financial entity engaged in a broad range of banking-related activities as permitted under the Gramm-Leach-Bliley Act of 1999" ;
    skos:note "Can be a domestic or foreign domiciled holding company" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "These activities include: insurance underwriting, securities dealing and underwriting, financial and investment advisory services, merchant banking, issuing or selling securitized interests in bank-eligible assets, and generally engaging in any non-banking activity authorized by the Bank Holding Company Act. The Federal Reserve Board is responsible for supervising the financial condition and activities of financial holding companies. Similarly, any non-bank commercial company that is predominantly engaged in financial activities, earning 85 percent or more of its gross revenues from financial services, may choose to become a financial holding company. These companies are required to sell any non-financial (commercial) businesses within ten years." ;
    cmns-av:synonym "Financial Holding Company / BHC" .

fibo-fbc-fct-usfse:ForeignBankingOrganizationAsABankHoldingCompany a owl:Class ;
    rdfs:label "foreign banking organization as a bank holding company",
        "作为银行控股公司的外国银行机构（foreign banking organization as a bank holding company）"@zh ;
    rdfs:comment "在美国境内属于银行控股公司的外国银行机构。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
                    owl:onProperty cmns-org:isDomiciledIn ] ],
        fibo-fbc-fct-fse:BankHoldingCompany,
        fibo-fbc-fct-usfse:ForeignBankingOrganization ;
    skos:definition "foreign banking organization that is a bank holding company in the United States" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/nicpubweb/Content/HELP/Institution%20Type%20Description.htm"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A foreign banking organization that also acts as a bank holding company is thus supervised by the Board of Governors of the Federal Reserve." ;
    cmns-av:synonym "Financial Holding Company / FBO" .

fibo-fbc-fct-usfse:ForeignBankingOrganizationOfABankHoldingCompany a owl:Class ;
    rdfs:label "foreign banking organization of a bank holding company",
        "银行控股公司旗下的外国银行机构（foreign banking organization of a bank holding company）"@zh ;
    rdfs:comment "由银行控股公司拥有或控制的外国银行机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:ForeignBankingOrganization ;
    skos:definition "foreign banking organization that is owned or controlled by a bank holding company" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/nicpubweb/Content/HELP/Institution%20Type%20Description.htm"^^xsd:anyURI .

fibo-fbc-fct-usfse:ForeignBranchOfForeignBankManagedByUSOffice a owl:Class ;
    rdfs:label "foreign branch of foreign bank managed by US office",
        "由美国机构管理的外国银行境外分行（foreign branch of foreign bank managed by US office）"@zh ;
    rdfs:comment "位于美国境外、母行也在美国境外、但由该行的美国分行或代理处管理的分行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:isManagedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( [ a owl:Restriction ;
                                owl:onProperty cmns-rlcmp:isPlayedBy ;
                                owl:someValuesFrom fibo-fbc-fct-usfse:DomesticBranchOfAForeignBank ] fibo-fbc-fct-usfse:AgencyOfAForeignBankingOrganization ) ] ],
        fibo-fbc-fct-usfse:ForeignBranchOfForeignBank ;
    skos:definition "branch that resides outside of the United States whose parent is located outside of the United States that is managed by a US branch or agency of the foreign bank" .

fibo-fbc-fct-usfse:ForeignEntityOther a owl:Class ;
    rdfs:label "foreign entity other",
        "其他境外实体（foreign entity other）"@zh ;
    rdfs:comment "通常在其所在国家从事与银行业务相关活动的境外机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:FinancialInstitution ;
    owl:disjointWith fibo-fbc-fct-usfse:DomesticEntity ;
    skos:definition "foreign institution that engages in banking activities usually in connection with the business of banking in the countries where such foreign institutions are organized or operating" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:IndustrialBank a owl:Class ;
    rdfs:label "industrial bank",
        "工业银行（industrial bank）"@zh ;
    rdfs:comment "通过出售称为「投资股份」的凭证和吸收存款来筹集资金的有限服务金融机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:Bank ;
    skos:definition "limited service financial institution that raises funds by selling certificates called 'investment shares' and by accepting deposits" ;
    cmns-av:explanatoryNote "Often called Morris Plan banks or industrial loan companies, industrial banks are distinguished from commercial loan companies because industrial banks accept deposits in addition to making consumer loans. Industrial banks differ from commercial banks because they do not offer demand deposit (checking) accounts. Industrial banks are not regulated by the Federal Reserve." .

fibo-fbc-fct-usfse:IntermediateHoldingCompany a owl:Class ;
    rdfs:label "intermediate holding company",
        "中间控股公司（intermediate holding company）"@zh ;
    rdfs:comment "外国银行机构依联邦储备委员会 YY 条例（12 CFR）O 分部分设立或指定的银行控股公司。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:BankHoldingCompany ;
    skos:definition "bank holding company established or designated by a foreign banking organization under subpart O of the Federal Reserve Board's Regulation YY (12 CFR part 252)" .

fibo-fbc-fct-usfse:InternationalBankOfUSDepositoryEdgeTrustCompany a owl:Class ;
    rdfs:label "international bank of US depositary, edge, trust company",
        "美国存款机构、埃奇公司或信托公司旗下的国际银行（international bank of US depositary, edge, trust company）"@zh ;
    rdfs:comment "由美国存款性机构、埃奇法公司或信托公司拥有或控制的银行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:unionOf ( fibo-fbc-fct-fse:DepositoryInstitution fibo-fbc-fct-usfse:EdgeCorporation fibo-fbc-fct-fse:TrustCompany ) ] ] ],
        fibo-fbc-fct-fse:Bank ;
    skos:definition "bank that is owned or controlled by a US depository institution, Edge Act corporation or trust company" .

fibo-fbc-fct-usfse:InternationalNonBankSubsidiaryOfADomesticEntity a owl:Class ;
    rdfs:label "international non-bank subsidiary of a domestic entity",
        "境内实体的境外非银行子公司（international non-bank subsidiary of a domestic entity）"@zh ;
    rdfs:comment "总部位于美国境外、其 25% 或以上表决权股份由境内实体拥有或控制的非银行金融服务提供商。"@zh ;
    rdfs:seeAlso <https://fraser.stlouisfed.org/title/bank-holding-company-act-1956-984/fulltext> ;
    rdfs:subClassOf fibo-fbc-fct-usfse:NonBankSubsidiaryOfADomesticEntity ;
    owl:disjointWith fibo-fbc-fct-usfse:DomesticNonBankSubsidiaryOfADomesticEntity ;
    skos:definition "non-bank financial service provider based outside of the United States of which 25 percent or more of whose voting shares are owned or controlled by an entity that is based in the United States, or of which a majority of its directors are controlled by such domestic entity, or of which 25 percent or more of whose voting shares are held by trustees for the benefit of the shareholders or members of such domestic entity" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:LimitedBranchOfAForeignBank a owl:Class ;
    rdfs:label "limited branch of a foreign bank",
        "外国银行的有限分行（limited branch of a foreign bank）"@zh ;
    rdfs:comment "仅吸收依《联邦储备法》第 25A 条组建的公司所允许吸收之存款的外国银行分行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:DomesticBranchOfAForeignBank ;
    skos:definition "branch of a foreign bank that receives only such deposits as would be permitted for a corporation organized under section 25A of the Federal Reserve Act (12 U.S.C. 611-631)" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI .

fibo-fbc-fct-usfse:MutualSavingsBank a owl:Class ;
    rdfs:label "mutual savings bank",
        "互助储蓄银行（mutual savings bank）"@zh ;
    rdfs:comment "主要从个人吸收存款、并将大部分资金投放于抵押贷款的金融机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:SavingsBank ;
    skos:definition "financial institution that accepts deposits primarily from individuals and places a large portion of its funds into mortgage loans" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:NationalBank a owl:Class ;
    rdfs:label "national bank",
        "国民银行（national bank）"@zh ;
    rdfs:comment "章程由货币监理署（OCC）而非州银行监管机构批准的商业银行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:CommercialBank,
        fibo-fbc-fct-usfse:USBank ;
    skos:definition "commercial bank whose charter is approved by the Office of the Comptroller of the Currency (OCC) rather than by a state banking agency" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes#non-mem-banks"^^xsd:anyURI ;
    cmns-av:explanatoryNote "National Banks are required to be members of the Federal Reserve System and belong to the Federal Deposit Insurance Corporation." .

fibo-fbc-fct-usfse:NewYorkArticleXIIInvestmentCompany a owl:Class ;
    rdfs:label "New York Article XII investment company",
        "纽约州第十二条投资公司（New York Article XII investment company）"@zh ;
    rdfs:comment "依纽约州银行法第十二条设立、拥有广泛借贷权限并可投资股票和债券的专业非存款性贷款机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:NonDepositoryInstitution ;
    owl:disjointWith fibo-fbc-fct-fse:InvestmentCompany ;
    skos:definition "specialized non-depository lending institution that has broad borrowing and lending powers and may invest in stocks and bonds" ;
    cmns-av:adaptedFrom "https://www.dfs.ny.gov/institution_definition"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An Article XII Investment Company is not an 'investment company' subject to registration under the Investment Company Act of 1940. An Article XII Investment Company may accept credit balances in New York that are incidental to the exercise of its other powers and may accept deposits outside New York with the approval of the Superintendent. Article XII Investment Companies may specialize in commercial or retail sales finance; others are involved in domestic and international commercial and merchant banking." .

fibo-fbc-fct-usfse:NonDepositoryTrustCompany a owl:Class ;
    rdfs:label "non-depository trust company",
        "非存款性信托公司（non-depository trust company）"@zh ;
    rdfs:comment "接受并执行信托但不发行货币的信托公司；可以是联邦储备成员或非成员。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:NonDepositoryInstitution,
        fibo-fbc-fct-fse:TrustCompany ;
    skos:definition "trust company that accepts and executes trusts, but does not issue currency; non-depository trust companies can either be Federal Reserve Members or Federal Reserve Non-members" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:RegionalAdministrativeOfficeOfAForeignBank a owl:Class ;
    rdfs:label "regional administrative office of a foreign bank",
        "外国银行区域行政办事处（regional administrative office of a foreign bank）"@zh ;
    rdfs:comment "由在美国运营两个或以上分行、代理处、商业贷款公司或银行的外国银行设立的代表处，承担区域管理职能。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:RepresentativeOfficeOfAForeignBank ;
    skos:definition """representative office that 
(1) Is established by a foreign bank that operates two or more branches, agencies, commercial lending companies, or banks in the United States; 
(2) Is located in the same city as one or more of the foreign bank's branches, agencies, commercial lending companies, or banks in the United States; 
(3) Manages, supervises, or coordinates the operations of the foreign bank or its affiliates, if any, in a particular geographic area that includes the United States or a region thereof, including by exercising credit approval authority in that area pursuant to written standards, credit policies, and procedures established by the foreign bank; and 
(4) Does not solicit business from actual or potential customers of the foreign bank or its affiliates.""" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI ;
    cmns-av:synonym "regional administrative office" .

fibo-fbc-fct-usfse:StateCharteredBank a owl:Class ;
    rdfs:label "state-chartered bank",
        "州特许银行（state-chartered bank）"@zh ;
    rdfs:comment "章程由州银行监管机构批准的商业银行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:CommercialBank,
        fibo-fbc-fct-usfse:USBank ;
    skos:definition "commercial bank whose charter is approved by a state banking regulator" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A state bank is defined as any bank, banking association, trust company, savings bank, industrial bank (or similar depository institution operating substantially in the same manner as an industrial bank), or other banking institution which is engaged in the business of receiving deposits other than trust funds, and in the US, is incorporated under the laws of any State or which is operating under the Code of Law for the District of Columbia, including any cooperative bank or other unincorporated bank the deposits of which were insured by the Federal Deposit Insurance Corporation on the day before the date of the enactment of the Financial Institutions Reform, Recovery, and Enforcement Act of 1989.",
        "State-chartered banks may or may not be members of the Federal Reserve System, but typically belong to the Federal Deposit Insurance Corporation, who may be their primary federal regulator for those that are not FRS members." .

fibo-fbc-fct-usfse:StateCreditUnion a owl:Class ;
    rdfs:label "state credit union",
        "州信用合作社（state credit union）"@zh ;
    rdfs:comment "具有州隶属关系的信用合作社。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:USCreditUnion ;
    skos:definition "credit union that has a state affiliation" .

fibo-fbc-fct-usfse:StateSavingsBank a owl:Class ;
    rdfs:label "state savings bank",
        "州储蓄银行（state savings bank）"@zh ;
    rdfs:comment "具有州隶属关系的储蓄银行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:SavingsBank ;
    owl:disjointWith fibo-fbc-fct-usfse:FederalSavingsBank ;
    skos:definition "savings bank that has a state affiliation" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:USBankHoldingCompany a owl:Class ;
    rdfs:label "U.S. bank holding company",
        "美国银行控股公司（U.S. bank holding company）"@zh ;
    rdfs:comment "获准在美国开展业务、并依相关法律受联邦储备监管和监督的银行控股公司。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fct-fse:hasPortfolioCompany ;
            owl:someValuesFrom fibo-fbc-fct-usfse:USBank ],
        fibo-fbc-fct-fse:BankHoldingCompany,
        fibo-fbc-fct-usfse:DomesticEntity ;
    skos:definition "bank holding company that is licensed to conduct business in the United States and is regulated and supervised by the Federal Reserve in accordance with the Bank Holding Company Act of 1956" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "According to the FFIEC, a bank holding company is a company that owns and/or controls one or more U.S. banks or one that owns, or has controlling interest in, one or more banks. A bank holding company may also own another bank holding company, which in turn owns or controls a bank; the company at the top of the ownership chain is called the top holder. The Board of Governors is responsible for regulating and supervising bank holding companies, even if the bank owned by the holding company is under the primary supervision of a different federal agency (OCC or FDIC).",
        "From the Bank Holding Company Act of 1956, a 'bank holding company' means any company (1) which directly or indirectly owns, controls, or holds with power to vote, 25 per centum or more of the voting shares of each of two or more banks or of a company which is or becomes a bank holding company by virtue of this Act, or (2) which controls in any manner the election of a majority of the directors of each of two or more banks, or (3) for the benefit of whose shareholders or members 25 per centum or more of the voting shares of each of two or more banks or a bank holding company is held by trustees; and for the purposes of this Act, any successor to any such company shall be deemed to be a bank holding company from the date as of which such predecessor company became a bank holding company. Notwithstanding the foregoing, (A) no bank shall be a bank holding company by virtue of its ownership or control of shares in a fiduciary capacity, except where such shares are held for the benefit of the shareholders of such bank, (B) no company shall be a bank holding company which is registered under the Investment Company Act of 1940, and was so registered prior to May 15, 1955 (or which is affiliated with any such company in such manner as to constitute an affiliated company within the meaning of such Act), unless such company (or such affiliated company), as the case may be, directly owns 25 per centum or more of the voting shares of each of two or more banks, (C) no company shall be a bank holding company by virtue of its ownership or control of shares acquired by it in connection with its underwriting of securities and which are held only for such period of time as will permit the sale thereof upon a reasonable basis, (D) no company formed for the sole purpose of participating in a proxy solicitation shall be a bank holding company by virtue of its control of voting rights of shares acquired in the course of such solicitation, and (E) no company shall be a bank holding company if at least 80 per centum of its total assets are composed of holdings in the field of agriculture." .

fibo-fbc-fct-usfse:UninsuredFederalAgencyOfForeignBankingOrganization a owl:Class ;
    rdfs:label "uninsured federal agency of foreign banking organization",
        "外国银行机构的未参保联邦代理处（uninsured federal agency of foreign banking organization）"@zh ;
    rdfs:comment "依《联邦法规汇编》第 12 编第 3102 节及 1978 年《国际银行法》第 4 节设立并运营、但不受联邦存款保险公司承保的外国银行代理处。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:FederalAgencyOfForeignBankingOrganization ;
    skos:definition "agency of a foreign bank established and operating under section 3102 of CFR Title 12, Chapter 32 and section 4 of the International Banking Act of 1978 that is not insured or regulated by the Federal Deposit Insurance Corporation (FDIC)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:UninsuredFederalBranchOfForeignBankingOrganization a owl:Class ;
    rdfs:label "uninsured federal branch of foreign banking organization",
        "外国银行机构的未参保联邦分行（uninsured federal branch of foreign banking organization）"@zh ;
    rdfs:comment "外国银行设于美国任何州、吸收存款、依联邦法律设立并运营、但不受联邦存款保险公司承保的办事处或营业场所。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:FederalBranchOfForeignBankingOrganization ;
    owl:disjointWith fibo-fbc-fct-usfse:InsuredFederalBranchOfForeignBankingOrganization ;
    skos:definition "any office or any place of business of a foreign bank located in any State of the United States at which deposits are received established and operating under section 4 of the International Banking Act of 1978 that is not insured or regulated by the Federal Deposit Insurance Corporation (FDIC)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An uninsured branch does not accept retail deposits and need not apply for federal deposit insurance." .

fibo-fbc-fct-usfse:UninsuredStateAgencyOfForeignBankingOrganization a owl:Class ;
    rdfs:label "uninsured state agency of foreign banking organization",
        "外国银行机构的未参保州代理处（uninsured state agency of foreign banking organization）"@zh ;
    rdfs:comment "依美国任何州法律设立并运营、不受联邦存款保险公司承保或监管的外国银行代理处。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:StateAgencyOfForeignBankingOrganization ;
    skos:definition "agency of a foreign bank established and operating under the laws of any state that is not insured or regulated by the Federal Deposit Insurance Corporation (FDIC)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:UninsuredStateBranchOfForeignBankingOrganization a owl:Class ;
    rdfs:label "uninsured state branch of foreign banking organization",
        "外国银行机构的未参保州分行（uninsured state branch of foreign banking organization）"@zh ;
    rdfs:comment "外国银行设于美国任何州、吸收存款、依州法律设立并运营、但不受联邦存款保险公司承保的办事处或营业场所。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:StateBranchOfForeignBankingOrganization ;
    owl:disjointWith fibo-fbc-fct-usfse:InsuredStateBranchOfForeignBankingOrganization ;
    skos:definition "any office or any place of business of a foreign bank located in any State of the United States at which deposits are received, established and operating under the laws of that State that is not insured or regulated by the Federal Deposit Insurance Corporation (FDIC)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An uninsured branch does not accept retail deposits and need not apply for federal deposit insurance." .

fibo-fbc-fct-usfse:CommercialLendingCompany a owl:Class ;
    rdfs:label "commercial lending company",
        "商业贷款公司（commercial lending company）"@zh ;
    rdfs:comment "依《联邦储备法》第 25 条以外的法律组建、从事商业贷款业务的机构（银行或依该法第 25 条运营的组织除外）。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:NonDepositoryInstitution ;
    skos:definition "any institution, other than a bank or an organization operating under section 25 of the Federal Reserve Act [12 U.S.C. 601 et seq.], organized under the laws of any State of the United States, or the District of Columbia which maintains credit balances incidental to or arising out of the exercise of banking powers and engages in the business of making commercial loans" ;
    cmns-av:adaptedFrom "https://www.govinfo.gov/content/pkg/USCODE-2021-title12/pdf/USCODE-2021-title12-chap32-sec3101.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:DomesticNonBankSubsidiaryOfADomesticEntity a owl:Class ;
    rdfs:label "domestic non-bank subsidiary of a domestic entity",
        "境内实体的境内非银行子公司（domestic non-bank subsidiary of a domestic entity）"@zh ;
    rdfs:comment "总部位于美国、其 25% 或以上表决权股份由境内实体拥有或控制的非银行金融服务提供商。"@zh ;
    rdfs:seeAlso <https://fraser.stlouisfed.org/title/bank-holding-company-act-1956-984/fulltext> ;
    rdfs:subClassOf fibo-fbc-fct-usfse:DomesticEntity,
        fibo-fbc-fct-usfse:NonBankSubsidiaryOfADomesticEntity ;
    skos:definition "non-bank financial service provider based in the United States of which 25 percent or more of whose voting shares are owned or controlled by an entity that is also based in the United States, or of which a majority of its directors are controlled by such domestic entity, or of which 25 percent or more of whose voting shares are held by trustees for the benefit of the shareholders or members of such domestic entity" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:FederalAgencyOfForeignBankingOrganization a owl:Class ;
    rdfs:label "federal agency of foreign banking organization",
        "外国银行机构的联邦代理处（federal agency of foreign banking organization）"@zh ;
    rdfs:comment "依《联邦法规汇编》第 12 编第 3102 节及 1978 年《国际银行法》第 4 节设立并运营的外国银行代理处。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:AgencyOfAForeignBankingOrganization ;
    skos:definition "agency of a foreign bank established and operating under section 3102 of CFR Title 12, Chapter 32 and section 4 of the International Banking Act of 1978" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/USCODE-2021-title12/pdf/USCODE-2021-title12-chap32-sec3101.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:FederalSavingsBank a owl:Class ;
    rdfs:label "federal savings bank",
        "联邦储蓄银行（federal savings bank）"@zh ;
    rdfs:comment "具有联邦隶属关系的储蓄银行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:SavingsBank ;
    skos:definition "savings bank that has a federal affiliation" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:ForeignBranchOfForeignBank a owl:Class ;
    rdfs:label "foreign branch of foreign bank",
        "外国银行的境外分行（foreign branch of foreign bank）"@zh ;
    rdfs:comment "位于美国境外、其母行也位于美国境外的分行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-fbc-fct-usfse:ForeignBank ] ],
        fibo-fbc-fct-usfse:BranchOfADepositoryInstitution ;
    owl:disjointWith [ a owl:Restriction ;
            owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
            owl:onProperty cmns-org:isDomiciledIn ],
        fibo-fbc-fct-usfse:DomesticBranchOfDomesticBank,
        fibo-fbc-fct-usfse:ForeignBranchOfUSBank ;
    skos:definition "branch that resides outside of the United States whose parent is located outside of the United States" .

fibo-fbc-fct-usfse:ForeignBranchOfUSBank a owl:Class ;
    rdfs:label "foreign branch of US bank",
        "美国银行的境外分行（foreign branch of US bank）"@zh ;
    rdfs:comment "位于美国境外、但其母行位于美国境内的分行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-fbc-fct-usfse:USBank ] ],
        fibo-fbc-fct-usfse:BranchOfADepositoryInstitution ;
    owl:disjointWith [ a owl:Restriction ;
            owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
            owl:onProperty cmns-org:isDomiciledIn ],
        fibo-fbc-fct-usfse:DomesticBranchOfDomesticBank ;
    skos:definition "branch that resides outside of the United States, but has a parent that is located in the United States" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:InsuredFederalBranchOfForeignBankingOrganization a owl:Class ;
    rdfs:label "insured federal branch of foreign banking organization",
        "外国银行机构的参保联邦分行（insured federal branch of foreign banking organization）"@zh ;
    rdfs:comment "外国银行设于美国任何州、吸收存款、依联邦法律设立并运营且受联邦存款保险公司承保的办事处或营业场所。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:FederalBranchOfForeignBankingOrganization ;
    skos:definition "any office or any place of business of a foreign bank located in any State of the United States at which deposits are received established and operating under section 4 of the International Banking Act of 1978 that is insured and regulated by the Federal Deposit Insurance Corporation (FDIC)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:InsuredStateBranchOfForeignBankingOrganization a owl:Class ;
    rdfs:label "insured state branch of foreign banking organization",
        "外国银行机构的参保州分行（insured state branch of foreign banking organization）"@zh ;
    rdfs:comment "外国银行设于美国任何州、吸收存款、依州法律设立并运营且受联邦存款保险公司承保的办事处或营业场所。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:StateBranchOfForeignBankingOrganization ;
    skos:definition "any office or any place of business of a foreign bank located in any State of the United States at which deposits are received, established and operating under the laws of that State that is insured and regulated by the Federal Deposit Insurance Corporation (FDIC)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:RepresentativeOfficeOfAForeignBank a owl:Class ;
    rdfs:label "representative office of a foreign bank",
        "外国银行代表处（representative office of a foreign bank）"@zh ;
    rdfs:comment "外国银行设于美国任何州、且不属于联邦分行、联邦代理处、州分行、州代理处或商业贷款公司的办事机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:OfficeOfAForeignBank ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:playsRole ;
            owl:someValuesFrom fibo-fbc-fct-usfse:CommercialLendingCompany ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:playsRole ;
            owl:someValuesFrom fibo-fbc-fct-usfse:AgencyOfAForeignBankingOrganization ],
        fibo-fbc-fct-usfse:DomesticBranchOfAForeignBank ;
    skos:definition "office of a foreign bank which is located in any state and is not a federal branch, federal agency, state branch, state agency, or commercial lending company subsidiary" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI ;
    cmns-av:synonym "representative office" .

fibo-fbc-fct-usfse:SavingsLoanAssociation a owl:Class ;
    rdfs:label "savings loan association",
        "储蓄贷款协会（savings loan association）"@zh ;
    rdfs:comment "主要从个人吸收存款、并将资金主要投向住宅抵押贷款的金融机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:ThriftInstitution ;
    skos:definition "financial institution that accepts deposits primarily from individuals and channels its funds primarily into residential mortgage loans" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:synonym "savings and loan association" .

fibo-fbc-fct-usfse:SavingsLoanHoldingCompany a owl:Class ;
    rdfs:label "savings loan holding company",
        "储蓄贷款控股公司（savings loan holding company）"@zh ;
    rdfs:comment "直接或间接控制储蓄协会或相关控股公司的公司，明确排除同时属于银行控股公司的公司。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fct-fse:hasPortfolioCompany ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-fbc-fct-usfse:SavingsLoanAssociation fibo-fbc-fct-usfse:SavingsLoanHoldingCompany ) ] ],
        fibo-fbc-fct-fse:HoldingCompany,
        fibo-fbc-pas-fpas:FinancialServiceProvider ;
    owl:disjointWith fibo-fbc-fct-fse:BankHoldingCompany ;
    skos:definition "company that directly or indirectly controls a savings association or related holding company, and explicitly excludes any company that is also a bank holding company" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:synonym "savings and loan holding company" .

fibo-fbc-fct-usfse:StateAgencyOfForeignBankingOrganization a owl:Class ;
    rdfs:label "state agency of foreign banking organization",
        "外国银行机构的州代理处（state agency of foreign banking organization）"@zh ;
    rdfs:comment "依美国任何州（含哥伦比亚特区）法律设立并运营的外国银行代理处。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:AgencyOfAForeignBankingOrganization ;
    skos:definition "agency of a foreign bank established and operating under the laws of any state, where state means any State of the United States or the District of Columbia" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/USCODE-2021-title12/pdf/USCODE-2021-title12-chap32-sec3101.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:SubsidiaryOfADomesticEntity a owl:Class ;
    rdfs:label "subsidiary of a domestic entity",
        "境内实体的子公司（subsidiary of a domestic entity）"@zh ;
    rdfs:comment "其 25% 或以上表决权股份由总部位于美国的实体拥有或控制、或其实质多数股权受其控制的实体。"@zh ;
    rdfs:seeAlso <https://fraser.stlouisfed.org/title/bank-holding-company-act-1956-984/fulltext> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-oac-cctl:isSubsidiaryOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-fbc-fct-usfse:DomesticEntity ] ],
        fibo-be-oac-cctl:Subsidiary ;
    skos:definition "entity of which 25 percent or more of whose voting shares are owned or controlled by an entity that is based in the United States, or of which a majority of its directors are controlled by such domestic entity, or of which 25 percent or more of whose voting shares are held by trustees for the benefit of the shareholders or members of such domestic entity" ;
    cmns-av:explanatoryNote "From the perspective of the International Banking Act of 1978, the definition of subsidiary is the definition from the Bank Holding Act of 1956. Thus, the meaining of the term 'subsidiary' with respect to the NIC repository and, specifically, with respect to the definition of an 'international non-bank subsidiary of a domestic entity', is the definition from the Bank Holding Company Act of 1956.",
        "The Bank Holding Company Act of 1956 defines a 'Subsidiary', with respect to a specified bank holding company, means (1) any company 25 per centum or more of whose voting shares (excluding shares owned by the United States or by any company wholly owned by the United States) is owned or controlled by such bank holding company; or (2) any company the election of a majority of whose directors is controlled in any manner by such bank holding company; or (3) any company 25 per centum or more of whose voting shares are held by trustees for the benefit of the shareholders or members of such bank holding company." .

fibo-fbc-fct-usfse:AgreementCorporation a owl:Class ;
    rdfs:label "agreement corporation",
        "协议公司（agreement corporation）"@zh ;
    rdfs:comment "由州特许从事国际银行业务的公司，因该公司与联邦储备委员会订立「协议」而得名。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-le-cb:Corporation ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fct-fse:FinancialInstitution ;
    skos:definition "corporation chartered by a state to engage in international banking, so named because the corporation enters into an 'agreement' with the Fed's Board of Governors that it will limit its activities to those permitted" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:BankersBank a owl:Class ;
    rdfs:label "bankers' bank",
        "银行家银行（bankers' bank）"@zh ;
    rdfs:comment "除法律要求的董事资格股外，完全由其他存款性机构或存款性机构控股公司拥有的商业银行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty fibo-fbc-fct-usfse:isSubjectToReserveRequirements ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fct-fse:CommercialBank,
        fibo-fbc-fct-usfse:USBank ;
    skos:definition "commercial bank owned exclusively (except to the extent directors' qualifying shares are required by law) by other depository institutions or depository institution holding companies, the activities of which are limited by its articles of association exclusively to providing services to or for other depository institutions, their holding companies, and the officers, directors, and employees of such institutions and companies, and to providing correspondent banking services at the request of other depository institutions or their holding companies" ;
    cmns-av:adaptedFrom "Depository Institutions Deregulation and Monetary Control Act of 1980, available at https://www.govinfo.gov/content/pkg/STATUTE-94/pdf/STATUTE-94-Pg132.pdf, section 711" ;
    cmns-av:explanatoryNote "Bankers' banks are typically (1) organized solely to do business with other financial institutions (with the exceptions defined herein), (2) owned primarily by the financial institutions with which they conduct business, and (3) do not do business with the general public." .

fibo-fbc-fct-usfse:DomesticBranchOfDomesticBank a owl:Class ;
    rdfs:label "domestic branch of domestic bank",
        "境内银行的境内分行（domestic branch of domestic bank）"@zh ;
    rdfs:comment "位于美国境内、其母行也位于美国境内的分行。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-fbc-fct-usfse:USBank ] ],
        [ a owl:Restriction ;
            owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
            owl:onProperty cmns-org:isDomiciledIn ],
        fibo-fbc-fct-usfse:BranchOfADepositoryInstitution ;
    skos:definition "branch that resides in the United States, and whose parent is also located in the United States" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:ForeignBankingOrganization a owl:Class ;
    rdfs:label "foreign banking organization",
        "外国银行机构（foreign banking organization）"@zh ;
    rdfs:comment "总部设在美国境外、可收购或设立独立银行或银行控股公司的金融服务提供商。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-rga:RegulatoryAgency ;
            owl:onProperty fibo-fbc-fct-usfse:hasHomeCountrySupervisor ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fct-usfse:hasHomeCountry ;
            owl:someValuesFrom cmns-loc:Country ],
        fibo-fbc-pas-fpas:FinancialServiceProvider ;
    skos:definition "financial service provider that is headquartered outside the United States and that can acquire or establish freestanding banks or bank holding companies in the United States" ;
    cmns-av:abbreviation "FBO" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/nicpubweb/Content/HELP/Institution%20Type%20Description.htm"^^xsd:anyURI ;
    cmns-av:explanatoryNote """Foreign banking organization means: 
(1) A foreign bank, as defined in section 1(b)(7) of the International Banking Act of 1978 (12 U.S.C. 3101(7)), that: 
	(i) Operates a branch, agency, or commercial lending company subsidiary in the United States; 
	(ii) Controls a bank in the United States; or 
	(iii) Controls an Edge corporation acquired after March 5, 1987; and 
(2) Any company of which the foreign bank is a subsidiary.""",
        "These entities are regulated and supervised as domestic institutions." .

fibo-fbc-fct-usfse:NonBankSubsidiaryOfADomesticEntity a owl:Class ;
    rdfs:label "non-bank subsidiary of a domestic entity",
        "境内实体的非银行子公司（non-bank subsidiary of a domestic entity）"@zh ;
    rdfs:comment "其 25% 或以上表决权股份由总部位于美国的实体拥有或控制的非银行实体。"@zh ;
    rdfs:seeAlso <https://fraser.stlouisfed.org/title/bank-holding-company-act-1956-984/fulltext> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-oac-cctl:isSubsidiaryOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ] ],
        fibo-fbc-fct-usfse:SubsidiaryOfADomesticEntity ;
    owl:disjointWith fibo-fbc-fct-fse:Bank ;
    skos:definition "non-bank entity of which 25 percent or more of whose voting shares are owned or controlled by an entity that is based in the United States, or of which a majority of its directors are controlled by such domestic entity, or of which 25 percent or more of whose voting shares are held by trustees for the benefit of the shareholders or members of such domestic entity" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:StateBranchOfForeignBankingOrganization a owl:Class ;
    rdfs:label "state branch of foreign banking organization",
        "外国银行机构的州分行（state branch of foreign banking organization）"@zh ;
    rdfs:comment "外国银行设于美国任何州、吸收存款、依该州法律设立并运营的分行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:DomesticBranchOfAForeignBank ;
    owl:disjointWith fibo-fbc-fct-usfse:FederalBranchOfForeignBankingOrganization ;
    skos:definition "branch of a foreign bank located in any State of the United States at which deposits are received, established and operating under the laws of that State, where state means any State of the United States or the District of Columbia" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:USCreditUnion a owl:Class ;
    rdfs:label "U.S. credit union",
        "美国信用合作社（U.S. credit union）"@zh ;
    rdfs:comment "为促进会员节俭、并为勤俭或生产性目的创造信贷来源而组织的合作协会。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-le-cb:NotForProfitCorporation ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fct-fse:CreditUnion,
        fibo-fbc-fct-usfse:ThriftInstitution ;
    skos:definition "cooperative association organized for the purpose of promoting thrift among its members and creating a source of credit for provident or productive purposes" ;
    cmns-av:explanatoryNote "As soon as you deposit funds into a credit union account, you become a partial owner and participate in the union's profitability. Credit unions may be formed by large corporations and organizations for their employees and members." .

fibo-fbc-fct-usfse:hasHomeCountry a owl:ObjectProperty ;
    rdfs:label "has home country",
        "具有母国（has home country）"@zh ;
    rdfs:comment "就外国银行而言，指明该外国银行获得特许或注册成立的国家。"@zh ;
    rdfs:domain fibo-fbc-pas-fpas:FinancialServiceProvider ;
    rdfs:range cmns-loc:Country ;
    rdfs:subPropertyOf cmns-loc:hasCountry ;
    skos:definition "indicates, with respect to a foreign bank, the country in which the foreign bank is chartered or incorporated" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI .

fibo-fbc-fct-usfse:hasHomeCountrySupervisor a owl:ObjectProperty ;
    rdfs:label "has home country supervisor",
        "具有母国监管机构（has home country supervisor）"@zh ;
    rdfs:comment "就外国银行而言，指明其母国负有监管职责的政府实体。"@zh ;
    rdfs:domain fibo-fbc-pas-fpas:FinancialServiceProvider ;
    rdfs:range cmns-rga:RegulatoryAgency ;
    rdfs:subPropertyOf cmns-rga:isRegulatedBy ;
    skos:definition "indicates, with respect to a foreign bank, the governmental entity or entities in the foreign bank's home country with responsibility for the supervision and regulation of the foreign bank" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI .

fibo-fbc-fct-usfse:FederalBranchOfForeignBankingOrganization a owl:Class ;
    rdfs:label "federal branch of foreign banking organization",
        "外国银行机构的联邦分行（federal branch of foreign banking organization）"@zh ;
    rdfs:comment "依《联邦法规汇编》第 12 编第 3102 节及 1978 年《国际银行法》第 4 节设立并运营的外国银行分行。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:DomesticBranchOfAForeignBank ;
    skos:definition "branch of a foreign bank established and operating under section 3102 of CFR Title 12, Chapter 32 and section 4 of the International Banking Act of 1978" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/USCODE-2021-title12/pdf/USCODE-2021-title12-chap32-sec3101.pdf"^^xsd:anyURI .

fibo-fbc-fct-usfse:OfficeOfAForeignBank a owl:Class ;
    rdfs:label "office of a foreign bank",
        "外国银行办事机构（office of a foreign bank）"@zh ;
    rdfs:comment "外国银行在美国的任何分行、代理处、代表处或商业贷款公司子公司等设施。"@zh ;
    rdfs:subClassOf cmns-sfc:Facility ;
    skos:definition "facility that is any branch, agency, representative office, or commercial lending company subsidiary of a foreign bank in the United States" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI .

fibo-fbc-fct-usfse:SavingsBank a owl:Class ;
    rdfs:label "savings bank",
        "储蓄银行（savings bank）"@zh ;
    rdfs:comment "为吸收储蓄存款并对储蓄存款支付利息而组建的银行机构。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-usfse:ThriftInstitution ;
    skos:definition "banking institution organized to accept savings deposits and pay interest on those savings deposits" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Savings banks can have state and federal affiliations, for example, State Savings Banks and Federal Savings Banks" .

fibo-fbc-fct-usfse:isSubjectToReserveRequirements a owl:DatatypeProperty ;
    rdfs:label "is subject to reserve requirements",
        "是否受准备金要求约束（is subject to reserve requirements）"@zh ;
    rdfs:comment "表明金融服务提供商的某项能力是否以符合联邦储备特定政策、法规或要求为条件。"@zh ;
    rdfs:domain fibo-fbc-pas-fpas:FinancialServiceProvider ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether some capability of a financial service provider is contingent on conformance with certain Federal Reserve policies, regulations, or other requirements" .

fibo-fbc-fct-usfse:BranchOfADepositoryInstitution a owl:Class ;
    rdfs:label "branch of a depository institution",
        "存款性机构分支机构（branch of a depository institution）"@zh ;
    rdfs:comment "位于美国任何州、吸收存款的任何办事处或营业场所。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-fbc-fct-fse:DepositoryInstitution ] ],
        fibo-be-le-fbo:Branch ;
    skos:definition "any office or any place of business located in any State of the United States at which deposits are received" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI .

fibo-fbc-fct-usfse:EdgeCorporation a owl:Class ;
    rdfs:label "edge corporation",
        "埃奇公司（edge corporation）"@zh ;
    rdfs:comment "由联邦储备特许、从事国际银行和金融业务的股份公司，得名于《埃奇法》。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-le-cb:Corporation ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fct-fse:FinancialInstitution ;
    skos:definition "corporation chartered by the Federal Reserve to engage in international banking and financial operations" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:ForeignBank a owl:Class ;
    rdfs:label "foreign bank",
        "外国银行（foreign bank）"@zh ;
    rdfs:comment "依外国、美国属地、波多黎各、关岛、美属萨摩亚或维尔京群岛法律组建的金融机构。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-rga:RegulatoryAgency ;
            owl:onProperty fibo-fbc-fct-usfse:hasHomeCountrySupervisor ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fct-usfse:hasHomeCountry ;
            owl:someValuesFrom cmns-loc:Country ],
        fibo-fbc-fct-fse:Bank ;
    owl:disjointWith fibo-fbc-fct-fse:CentralBank,
        fibo-fbc-fct-usfse:USBank ;
    skos:definition "financial institution organized under the laws of a foreign country, a territory of the United States, Puerto Rico, Guam, American Samoa, or the Virgin Islands, which engages in the business of banking, or any subsidiary or affiliate, organized under such laws, of any such institution" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/nicpubweb/Content/HELP/Institution%20Type%20Description.htm"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "For the purposes of the International Banking Act of 1978, the term 'foreign bank' includes, without limitation, foreign commercial banks, foreign merchant banks and other foreign institutions that engage in banking activities usual in connection with the business of banking in the countries where such foreign institutions are organized or operating.",
        "Foreign bank means an organization that is organized under the laws of a foreign country and that engages directly in the business of banking outside the United States. The term foreign bank does not include a central bank of a foreign country that does not engage or seek to engage in a commercial banking business in the United States through an office." .

fibo-fbc-fct-usfse:ThriftInstitution a owl:Class ;
    rdfs:label "thrift institution",
        "节俭机构（thrift institution）"@zh ;
    rdfs:comment "主要吸收储蓄账户存款并将大部分资金投资于抵押贷款的储蓄协会。"@zh ;
    rdfs:subClassOf fibo-fbc-fct-fse:SavingsAssociation,
        fibo-fbc-fct-usfse:DomesticEntity ;
    skos:definition "savings association that primarily accepts savings account deposits and invests most of the proceeds in mortgages" ;
    skos:example "Savings banks and savings and loan associations and credit unions are examples of thrift institutions." ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:AgencyOfAForeignBankingOrganization a owl:Class ;
    rdfs:label "agency of a foreign banking organization",
        "外国银行机构代理处（agency of a foreign banking organization）"@zh ;
    rdfs:comment "外国银行设于美国任何州的营业场所，在该场所维持贷方余额、兑付支票、发放贷款，或在法律允许范围内从事其他业务。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom fibo-fbc-fct-usfse:OfficeOfAForeignBank ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
                    owl:onProperty cmns-org:isDomiciledIn ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-own:isOwnedAsset ;
            owl:someValuesFrom fibo-fbc-fct-usfse:ForeignBank ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:isControlledPartyOf ;
            owl:someValuesFrom fibo-fbc-fct-usfse:ForeignBank ],
        fibo-fbc-fct-fse:FinancialInstitution ;
    skos:definition "place of business of a foreign bank, located in any state, at which credit balances are maintained, checks are paid, money is lent, or, to the extent not prohibited by state or federal law, deposits are accepted from a person or entity that is not a citizen or resident of the United States" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI,
        "https://www.govinfo.gov/content/pkg/COMPS-275/pdf/COMPS-275.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote """Obligations shall not be considered credit balances unless they are: 
(1) Incidental to, or arise out of the exercise of, other lawful banking powers; 
(2) To serve a specific purpose; 
(3) Not solicited from the general public; 
(4) Not used to pay routine operating expenses in the United States such as salaries, rent, or taxes; 
(5) Withdrawn within a reasonable period of time after the specific purpose for which they were placed has been accomplished; and 
(6) Drawn upon in a manner reasonable in relation to the size and nature of the account.""" .

fibo-fbc-fct-usfse:DomesticBranchOfAForeignBank a owl:Class ;
    rdfs:label "domestic branch of a foreign bank",
        "外国银行的境内分行（domestic branch of a foreign bank）"@zh ;
    rdfs:comment "外国银行设于美国任何州、吸收存款的营业场所，且不属于法规定义的代理处。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-fbc-fct-usfse:ForeignBank ] ],
        [ a owl:Restriction ;
            owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
            owl:onProperty cmns-org:isDomiciledIn ],
        fibo-fbc-fct-usfse:BranchOfADepositoryInstitution,
        fibo-fbc-fct-usfse:OfficeOfAForeignBank ;
    owl:disjointWith [ a owl:Restriction ;
            owl:allValuesFrom fibo-fbc-fct-usfse:AgencyOfAForeignBankingOrganization ;
            owl:onProperty cmns-rlcmp:playsRole ] ;
    skos:definition "place of business of a foreign bank, located in any state, at which deposits are received, and that is not an agency as defined in https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21" ;
    cmns-av:adaptedFrom "https://www.ecfr.gov/current/title-12/chapter-II/subchapter-A/part-211/subpart-B/section-211.21"^^xsd:anyURI,
        "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI .

fibo-fbc-fct-usfse:USBank a owl:Class ;
    rdfs:label "U.S. bank",
        "美国银行（U.S. bank）"@zh ;
    rdfs:comment "获准在美国开展业务的银行。"@zh ;
    rdfs:seeAlso <https://www.sec.gov/about/laws/ica40.pdf> ;
    rdfs:subClassOf fibo-fbc-fct-fse:Bank,
        fibo-fbc-fct-usfse:DomesticEntity ;
    skos:definition "bank that is licensed to conduct business in the United States" ;
    cmns-av:adaptedFrom "As defined in the Federal Deposit Insurance Act, https://www.fdic.gov/regulations/laws/rules/1000-400.html#fdic1000sec.3a" ;
    cmns-av:explanatoryNote "A bank, as specified in the Investment Company Act of 1940, is a financial intermediary that is (a) a depository institution (as defined in section 3 of the Federal Deposit Insurance Act) or a branch or agency of a foreign bank (as such terms are defined in section 1(b) of the International Banking Act of 1978), (b) a member bank of the Federal Reserve System, (c) any other banking institution or trust company, whether incorporated or not, doing business under the laws of any State or of the United States, a substantial portion of the business of which consists of receiving deposits or exercising fiduciary powers similar to those permitted to national banks under the authority of the Comptroller of the Currency, and which is supervised and examined by State or Federal authority having supervision over banks, and which is not operated for the purpose of evading the provisions of this title, and (d) a receiver, conservator, or other liquidating agent of any institution or firm included in clause (a), (b), or (c) of this paragraph.",
        "The Bank Holding Company Act of 1956 defines a bank as any depository financial intermediary that accepts checking accounts (checks) or makes commercial loans, and its deposits are insured by a federal deposit insurance agency. A bank acts as a middleman between suppliers of funds and users of funds, substituting its own credit judgement for that of the ultimate suppliers of funds, collecting those funds from three sources: checking accounts, savings and time deposits; short-term borrowings from other banks; and equity capital. A bank earns money by reinvesting these funds in longer-term assets." .

fibo-fbc-fct-usfse:DomesticEntity a owl:Class ;
    rdfs:label "domestic entity",
        "境内实体（domestic entity）"@zh ;
    rdfs:comment "在美国注册成立并以美国为住所地的金融服务提供商。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( [ a owl:Restriction ;
                                owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
                                owl:onProperty cmns-org:isDomiciledIn ] [ a owl:Restriction ;
                                owl:hasValue fibo-be-ge-usj:UnitedStatesJurisdiction ;
                                owl:onProperty fibo-be-le-cb:isIncorporatedIn ] ) ] ],
        fibo-fbc-pas-fpas:FinancialServiceProvider ;
    skos:definition "financial service provider that is incorporated and domiciled in the United States" .

