fibo-fbc-fct-usnic: a owl:Ontology ;
    rdfs:label "US National Information Center (NIC) Controlled Vocabularies Ontology",
        "美国国家信息中心受控词汇本体（US NIC Controlled Vocabularies Ontology）"@zh ;
    dcterms:abstract "This ontology extends the US regulatory agencies ontology with a number of controlled vocabularies required for mapping FIBO to the National Information Center (NIC) Data Dictionary." ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:source "https://www.ffiec.gov/NPW"^^xsd:anyURI,
        "https://www.ffiec.gov/nicpubweb/Content/DataDownload/NPW%20Data%20Dictionary.pdf"^^xsd:anyURI ;
    rdfs:comment "收录美联储国家信息中心（NIC）用于描述金融机构属性的受控词汇个体。"@zh ;
    owl:imports fibo-fbc-fct-fse:,
        fibo-fbc-fct-usfse:,
        fibo-fbc-fct-usjrga:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-cls:,
        cmns-cds:,
        cmns-col:,
        cmns-dsg:,
        cmns-txt: ;
    owl:versionIRI fibo-fbc-fct-usnic: ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional ;
    cmns-av:copyright "Copyright (c) 2023 EDM Council, Inc." .

fibo-fbc-fct-usnic:NICEntityTypeClassifier-AGB a owl:NamedIndividual,
        fibo-fbc-fct-usnic:NICEntityTypeClassifier ;
    rdfs:label "NIC entity type classifier - AGB" ;
    skos:definition "term and code for an Agreement Corporation - Banking" ;
    cmns-txt:hasTextValue "AGB" .

