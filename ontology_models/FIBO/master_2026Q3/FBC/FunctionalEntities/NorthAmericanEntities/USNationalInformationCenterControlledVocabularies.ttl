fibo-fbc-fct-usnic:NationalInformationCenterControlledVocabulary a owl:Class ;
    rdfs:label "National Information Center (NIC) controlled vocabulary",
        "国家信息中心（NIC）受控词汇表（National Information Center (NIC) controlled vocabulary）"@zh ;
    rdfs:comment "用于刻画国家信息中心（NIC）所管理金融服务提供商内容之某项特征或方面的受控词汇表。"@zh ;
    rdfs:isDefinedBy "https://www.ffiec.gov/nicpubweb/Content/DataDownload/NPW%20Data%20Dictionary.pdf"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usnic:NationalInformationCenterClassificationSchemeAndCodeSet ;
            owl:onProperty cmns-dsg:isDefinedIn ],
        [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usnic:NationalInformationCenterClassificationSchemeAndCodeSet ;
            owl:onProperty cmns-col:isMemberOf ],
        cmns-cls:Classifier,
        cmns-cds:CodeElement ;
    skos:definition "controlled vocabulary that characterizes some feature or aspect of content about a financial service provider managed in the National Information Center (NIC) repository" .

fibo-fbc-fct-usnic:NationalInformationCenterClassificationSchemeAndCodeSet a owl:NamedIndividual,
        cmns-cls:ClassificationScheme,
        cmns-cds:CodeSet ;
    rdfs:label "National Information Center (NIC) Classification Scheme And Code Set" ;
    rdfs:isDefinedBy "https://www.ffiec.gov/nicpubweb/Content/DataDownload/NPW%20Data%20Dictionary.pdf"^^xsd:anyURI ;
    skos:definition "set of controlled vocabularies and codes for describing content managed in the National Information Center (NIC) repository" .

fibo-fbc-fct-usnic:NICEntityTypeClassifier a owl:Class ;
    rdfs:label "National Information Center (NIC) entity type classifier",
        "国家信息中心（NIC）实体类型分类器（National Information Center (NIC) entity type classifier）"@zh ;
    rdfs:comment "用于描述国家信息中心（NIC）信息库所管理功能实体性质的受控词汇表和代码。"@zh ;
    rdfs:isDefinedBy "https://www.ffiec.gov/nicpubweb/Content/DataDownload/NPW%20Data%20Dictionary.pdf"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-fpas:FinancialServiceProvider ;
            owl:onProperty cmns-cls:classifies ],
        fibo-fbc-fct-usnic:NationalInformationCenterControlledVocabulary ;
    skos:definition "controlled vocabulary and codes for describing the nature of the functional entities managed by the National Information Center (NIC) repository" .

