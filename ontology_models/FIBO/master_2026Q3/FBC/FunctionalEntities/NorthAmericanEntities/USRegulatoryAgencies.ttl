<https://rdf.gleif.org/L1/L-549300NOPSIMGJNT8J31-LEI> a owl:NamedIndividual,
        fibo-fbc-fct-breg:LegalEntityIdentifierRegistryEntry ;
    rdfs:label "Corporation Service Company legal entity identifier registry entry" ;
    skos:definition "legal entity identifier for Corporation Service Company" ;
    fibo-fbc-fct-breg:hasInitialRegistrationDate "2013-08-14T02:34:00"^^xsd:dateTime ;
    fibo-fbc-fct-breg:hasManagingLocalOperatingUnit <https://rdf.gleif.org/L1/L-529900T8BM49AURSDO55> ;
    fibo-fbc-fct-breg:hasRegistrationRevisionDate "2025-11-08T08:10:59"^^xsd:dateTime ;
    fibo-fbc-fct-breg:hasRegistrationStatus fibo-fbc-fct-breg:IssuedStatus ;
    fibo-fbc-fct-breg:hasRenewalDate "2026-12-14T20:44:04"^^xsd:dateTime ;
    fibo-fbc-fct-breg:hasValidationLevel fibo-fbc-fct-breg:EntityValidationLevelFullyCorroborated ;
    cmns-col:comprises <https://rdf.gleif.org/L1/L-549300NOPSIMGJNT8J31> ;
    cmns-doc:records <https://rdf.gleif.org/L1/L-549300NOPSIMGJNT8J31> .

