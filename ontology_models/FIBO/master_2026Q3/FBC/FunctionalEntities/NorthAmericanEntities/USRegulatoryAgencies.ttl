fibo-fbc-fct-usjrga:NICRegistryEntry a owl:Class ;
    rdfs:label "National Information Center (NIC) registry entry",
        "国家信息中心（NIC）登记册条目（National Information Center (NIC) registry entry）"@zh ;
    rdfs:comment "国家信息中心（NIC）信息库中的条目，该信息库由联邦储备收集金融数据和机构特征信息。"@zh ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usjrga:NationalInformationCenterRepository ;
            owl:onProperty cmns-col:isIncludedIn ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-usjrga:ResearchStatisticsSupervisionDiscountIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom fibo-fbc-pas-fpas:FinancialServiceProvider ;
            owl:onProperty cmns-cxtdsg:appliesTo ],
        cmns-ra:RegistryEntry ;
    skos:definition "an entry in the the National Information Center (NIC) repository, a repository of financial data and institution characteristics collected by the Federal Reserve System" ;
    cmns-av:adaptedFrom "http://www.ffiec.gov/nicpubweb/nicweb/NicHome.aspx"^^xsd:anyURI .

