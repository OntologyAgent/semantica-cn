        fibo-fbc-pas-fpas:FinancialServiceProvider,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "American Bankers Association Registration Authority" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    skos:definition "American Bankers Association (ABA) Registration Authority (RA), which is a function of the ABA for registration of issuer identification numbers in the US" ;
    cmns-av:abbreviation "ABA RA" ;
    cmns-org:manages fibo-fbc-fct-usjrga:ABAIINRegistry ;
    cmns-rlcmp:isPlayedBy fibo-fbc-fct-usjrga:AmericanBankersAssociation .

fibo-fbc-fct-usjrga:NationalCreditUnionAdministration a owl:NamedIndividual,
        fibo-be-ge-ge:GovernmentAgency,
        fibo-fbc-fct-usjrga:FederalGovernmentEntity ;
    rdfs:label "National Credit Union Administration" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    skos:definition "National Credit Union Administration (NCUA), the independent federal agency that regulates, charters and supervises federal credit unions" ;
    cmns-av:abbreviation "NCUA" ;
    cmns-av:explanatoryNote "An independent agency of the federal government, the NCUA operates and manages the National Credit Union Share Insurance Fund (NCUSIF), insuring the deposits of more than 98 million account holders in all federal credit unions and the overwhelming majority of state-chartered credit unions." ;
    cmns-col:isPartOf fibo-be-ge-usj:UnitedStatesGovernment ;
    cmns-org:hasWebsite "http://www.ncua.gov/Pages/default.aspx"^^xsd:anyURI ;
    cmns-rga:hasJurisdiction fibo-be-ge-usj:UnitedStatesJurisdiction .

fibo-fbc-fct-usjrga:NationalInformationCenterRepository a owl:NamedIndividual,
