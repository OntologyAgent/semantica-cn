fibo-fbc-fct-usjrga:FederalReserveSystemNonMemberInstitution a owl:Class ;
    rdfs:label "Federal Reserve System non-member institution",
        "联邦储备体系非成员机构（Federal Reserve System non-member institution）"@zh ;
    rdfs:comment "不属于联邦储备体系（FRS）成员的存款性机构。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( [ a owl:Restriction ;
                                owl:hasValue lcc-3166-1:UnitedStatesOfAmerica ;
                                owl:onProperty cmns-org:isDomiciledIn ] [ a owl:Restriction ;
                                owl:hasValue fibo-be-ge-usj:UnitedStatesJurisdiction ;
                                owl:onProperty fibo-be-le-cb:isIncorporatedIn ] ) ] ],
        [ a owl:Class ;
            owl:unionOf ( fibo-fbc-fct-usfse:StateCharteredBank fibo-fbc-fct-usfse:IndustrialBank ) ],
        fibo-fbc-fct-fse:DepositoryInstitution ;
    owl:disjointWith fibo-fbc-fct-usjrga:FederalReserveSystemMember ;
    skos:definition "depository institution that is not member of the Federal Reserve System (FRS)" ;
    cmns-av:adaptedFrom "https://www.ffiec.gov/npw/Help/InstitutionTypes"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A non-member bank is a commercial bank that is state-chartered and NOT a member of the Federal Reserve System. It includes all insured commercial banks and industrial banks." ;
    cmns-av:synonym "non-member bank" .

