fibo-fbc-fct-usjrga:EmployerIdentificationNumber a owl:Class ;
    rdfs:label "employer identification number",
        "雇主识别号（employer identification number）"@zh ;
    rdfs:comment "由美国国税局（IRS）为在美国经营的企业实体分配的唯一九位数字编号，用于身份识别。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-usjrga:EmployerIdentificationNumberingScheme ;
            owl:onProperty cmns-col:isMemberOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fct-usjrga:TaxpayerIdentificationNumber,
        cmns-org:OrganizationIdentifier ;
    skos:definition "unique nine-digit number assigned by the Internal Revenue Service (IRS) to business entities operating in the United States for the purposes of identification" ;
    cmns-av:abbreviation "EIN",
        "FEIN" ;
    cmns-av:adaptedFrom "https://www.irs.gov/businesses/small-businesses-self-employed/employer-id-numbers"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Note that despite the name, the business may not necessarily employ anyone." ;
    cmns-av:synonym "Federal Employer Identification Number",
        "Federal Tax Identification Number" .

fibo-fbc-fct-usjrga:FDICBusinessEntityIdentifier a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifier ;
    rdfs:label "FDIC business entity identifier" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    skos:definition "Delaware Department of Corporations business entity identifier for the FDIC" ;
    cmns-dsg:hasTag "1003818" ;
    cmns-dsg:isDefinedIn fibo-fbc-fct-usjrga:DelawareBusinessRegistrationIdentifierScheme ;
    cmns-id:identifies fibo-fbc-fct-usjrga:FederalDepositInsuranceCorporation ;
    cmns-rga:isGovernedBy fibo-be-ge-usj:StateOfDelawareJurisdiction .

fibo-fbc-fct-usjrga:FDICRegistryEntry a owl:Class ;
    rdfs:label "FDIC registry entry",
        "联邦存款保险公司登记册条目（FDIC registry entry）"@zh ;
    rdfs:comment "联邦存款保险公司（FDIC）机构名录中的条目，是 FDIC 就其承保机构收集的金融机构特征信息库。"@zh ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usjrga:FDICInstitutionDirectory ;
            owl:onProperty cmns-col:isIncludedIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom fibo-fbc-fct-fse:DepositoryInstitution ;
            owl:onProperty cmns-cxtdsg:appliesTo ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-usjrga:FDICCertificateNumber ],
        cmns-ra:RegistryEntry ;
    skos:definition "an entry in the FDIC institution directory, a repository of financial institution characteristics collected by the FDIC related to the institutions they insure" ;
    cmns-av:adaptedFrom "https://www7.fdic.gov/idasp/index.asp"^^xsd:anyURI .

