    rdfs:label "South Dakota, Secretary of State Corporations Division" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    skos:definition "State of South Dakota's Corporations Division" ;
    cmns-col:isPartOf fibo-be-ge-usj:StateOfSouthDakotaGovernment ;
    cmns-org:hasWebsite "https://sosenterprise.sd.gov/businessservices/"^^xsd:anyURI .

fibo-fbc-fct-usjrga:TaxpayerIdentificationNumber a owl:Class ;
    rdfs:label "taxpayer identification number",
        "纳税人识别号（taxpayer identification number）"@zh ;
    rdfs:comment "美国国税局（IRS）在税收管理中使用的识别编号。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-usjrga:TaxpayerIdentificationNumberingScheme ;
            owl:onProperty cmns-col:isMemberOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-usj:UnitedStatesJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        fibo-fnd-pty-pty:TaxIdentifier ;
    skos:definition "identification number used by the Internal Revenue Service (IRS) in the administration of tax laws in the United States" ;
    cmns-av:abbreviation "TIN" ;
    cmns-av:adaptedFrom "https://www.irs.gov/individuals/international-taxpayers/taxpayer-identification-numbers-tin"^^xsd:anyURI ;
    cmns-av:explanatoryNote """A TIN must be furnished on returns, statements, and other tax related documents. For example a number must be furnished:
- When filing tax returns.
- When claiming treaty benefits.

A TIN must be on a withholding certificate if the beneficial owner is claiming any of the following:
- Tax treaty benefits (other than for income from marketable securities)
- Exemption for effectively connected income
- Exemption for certain annuities.""" .

fibo-fbc-fct-usjrga:UniformBankPerformanceReportRepository a owl:NamedIndividual,
        cmns-ra:Registry ;
    rdfs:label "Uniform Bank Performance Report (UBPR) Repository" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    skos:definition "Federal Financial Institutions Examination Council (FFIEC)'s Uniform Bank Performance Report (UBPR) Repository, a repository of institution characteristics and analytical tool created for bank supervisory, examination, and management purposes" ;
    cmns-av:explanatoryNote "In a concise format, it shows the impact of management decisions and economic conditions on a bank's performance and balance-sheet composition. The performance and composition data contained in the report can be used as an aid in evaluating the adequacy of earnings, liquidity, capital, asset and liability management, and growth management. Bankers and examiners alike can use this report to further their understanding of a bank's financial condition, and through such understanding, perform their duties more effectively." ;
    cmns-org:isManagedBy fibo-fbc-fct-usjrga:FederalFinancialInstitutionsExaminationRegulator .

