fibo-fbc-fct-usfse:FinancialHoldingCompany a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usjrga:BoardOfGovernorsOfTheFederalReserveSystem ;
            owl:onProperty fibo-fbc-fct-usjrga:hasPrimaryFederalRegulator ] .

fibo-fbc-fct-usfse:NationalBank a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usjrga:NationalBankingRegulator ;
            owl:onProperty fibo-fbc-fct-usjrga:hasPrimaryFederalRegulator ],
        fibo-fbc-fct-usjrga:FederalReserveSystemMember .

fibo-fbc-fct-usjrga:ABABusinessEntityIdentifier a owl:NamedIndividual,
        fibo-be-le-cb:RegistrationIdentifier ;
    rdfs:label "ABA business entity identifier" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    skos:definition "Delaware Department of Corporations business entity identifier for the American Bankers Association (ABA)" ;
    cmns-dsg:hasTag "3409652" ;
    cmns-dsg:isDefinedIn fibo-fbc-fct-usjrga:DelawareBusinessRegistrationIdentifierScheme ;
    cmns-id:identifies fibo-fbc-fct-usjrga:AmericanBankersAssociation ;
    cmns-ra:isRegisteredIn fibo-fbc-fct-usjrga:DelawareBusinessEntitiesRegistry ;
    cmns-rga:isGovernedBy fibo-be-ge-usj:StateOfDelawareJurisdiction .

fibo-fbc-fct-usjrga:ABAIINRegistryEntry a owl:Class ;
    rdfs:label "ABA IIN registry entry",
        "美国银行家协会发行人识别号登记册条目（ABA IIN registry entry）"@zh ;
    rdfs:comment "美国银行家协会（ABA）发行人识别号（IIN）登记册中的条目，是 ABA 为其签发 IIN 的机构所收集的金融机构特征信息库。"@zh ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usjrga:ABAIINRegistry ;
            owl:onProperty cmns-col:isIncludedIn ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-usjrga:IssuerIdentificationNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom fibo-fbc-fct-fse:FinancialInstitution ;
            owl:onProperty cmns-cxtdsg:appliesTo ],
        cmns-ra:RegistryEntry ;
    skos:definition "an entry in the ABA IIN registry, a repository of financial institution characteristics collected by the ABA for those institutions to which they issue IINs" .

fibo-fbc-fct-usjrga:ABARTNRegistryEntry a owl:Class ;
    rdfs:label "ABA RTN registry entry",
        "美国银行家协会路由号码登记册条目（ABA RTN registry entry）"@zh ;
    rdfs:comment "美国银行家协会（ABA）路由号码（RTN）登记册中的条目，是 ABA 注册机构代表 ABA 收集的金融机构特征信息库。"@zh ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fbc-fct-usjrga:ABARTNRegistry ;
            owl:onProperty cmns-col:isIncludedIn ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-fct-usjrga:RoutingTransitNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom fibo-fbc-fct-fse:FinancialInstitution ;
            owl:onProperty cmns-cxtdsg:appliesTo ],
        cmns-ra:RegistryEntry ;
    skos:definition "an entry in the ABA RTN registry, a repository of financial institution characteristics collected by the ABA Registrar on behalf of the ABA" .

