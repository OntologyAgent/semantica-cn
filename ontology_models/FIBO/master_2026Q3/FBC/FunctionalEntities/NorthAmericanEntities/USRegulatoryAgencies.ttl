fibo-fbc-fct-usjrga:FederalReserveBankOfBoston a owl:NamedIndividual,
        fibo-fbc-fct-usjrga:FederalReserveDistrictBank ;
    rdfs:label "Federal Reserve Bank of Boston" ;
    rdfs:isDefinedBy fibo-fbc-fct-usjrga: ;
