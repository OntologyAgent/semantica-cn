@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-bauth: <https://www.omg.org/spec/Commons/BusinessAuthorizations/> .
@prefix cmns-cds: <https://www.omg.org/spec/Commons/CodesAndCodeSets/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-cxtid: <https://www.omg.org/spec/Commons/ContextualIdentifiers/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-loc: <https://www.omg.org/spec/Commons/Locations/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-ra: <https://www.omg.org/spec/Commons/RegistrationAuthorities/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix cmns-txt: <https://www.omg.org/spec/Commons/TextDatatype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-fct-fct: <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/> .
@prefix fibo-be-oac-exec: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/> .
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/> .
@prefix fibo-fbc-fct-breg: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-pas-caa: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-arr-doc: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-oac-own: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/> .
@prefix fibo-fnd-pas-pas: <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-fbc-pas-caa: a owl:Ontology ;
    rdfs:label "Clients and Accounts Ontology",
        "客户与账户本体（Clients and Accounts Ontology）"@zh ;
    dcterms:abstract "This ontology provides basic concepts related to accounts, including internal accounts such as ledger accounts as well as accounts managed for external parties, that are commonly used by financial services providers." ;
    dcterms:license """Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2015-2025 Object Management Group, Inc.
		
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义金融机构的客户、账户及账户持有关系。"@zh ;
    owl:imports fibo-be-fct-fct:,
        fibo-be-oac-exec:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-fi-fi:,
        fibo-fbc-fct-breg:,
        fibo-fbc-fct-fse:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-arr-doc:,
        fibo-fnd-dt-fd:,
        fibo-fnd-dt-oc:,
        fibo-fnd-gao-obj:,
        fibo-fnd-oac-own:,
        fibo-fnd-pas-pas:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-bauth:,
        cmns-cls:,
        cmns-cds:,
        cmns-col:,
        cmns-cxtdsg:,
        cmns-cxtid:,
        cmns-dt:,
        cmns-dsg:,
        cmns-doc:,
        cmns-id:,
        cmns-loc:,
        cmns-org:,
        cmns-pts:,
        cmns-ra:,
        cmns-rlcmp:,
        cmns-txt: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FBC/20261001/ProductsAndServices/ClientsAndAccounts/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/FBC/20160801/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised per the FIBO 2.0 RFC with respect to the definitions for accounts and account identifiers, such as BBAN and IBAN identifiers, including but not limited to bank accounts.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20180801/ProductsAndServices/ClientsAndAccounts/ version of this ontology was modified to support the addition of maturity-related properties to financial instruments.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20181101/ProductsAndServices/ClientsAndAccounts/ version of this ontology was modified to replace hasDefinition with isDefinedIn to clarify intent.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20190701/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20190901/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to eliminate the disjointness between a deposit account and investment account to allow for certain portfolio management accounts that have characteristics of both.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20191201/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to add definitions for balance, fee, general ledger, ledger account, income and related properties, revise definitions to be ISO 704 compliant, and eliminate duplication with concepts in LCC.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20200201/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to add definitions for transaction records, which are needed to represent statements of various sorts, to add the concept of an account statement, and to clean up and augment definitions related to accounts, account holders, etc. as required for the purpose of representing credit card accounts.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20200901/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to generalize the definition of customer account and eliminate ambiguity in others.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20201201/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to change a property on CertificateOfDeposit from has notional amount to has nominal value for the sake of consistency.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20210301/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to rename ownership related properties for consistent alignment with the ownership situational pattern.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20210401/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to reflect the move of certain organization-specific concepts from BE to FND, to incorporate the concept of a composite identifier for BBAN and IBAN definition, loosen the definition of bank identifier with respect to the nature of the functional entity it identifies, and clarify the identifier hierarchy and fix spelling.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20211201/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to reflect the move of hasTerm from FinancialInstruments to Contracts and add the definition of a lending officer.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20220101/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to link a credit agreement with an account and loosen transaction-related constraints such that the notion of a transaction can be applied to credit agreements generally.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20220301/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to clean up dead links and address text formatting hygiene issues.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20220801/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230101/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230301/ProductsAndServices/ClientsAndAccounts.rdf version of this ontology was revised to clarify and extend definitions related to non-bank financial institutions.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20230401/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to replace concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20231201/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to replace additional concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20240101/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to eliminate deprecated elements that were deprecated more than six months ago (FND-386).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20241101/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20250301/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to use new constructs from the Commons 1.3 Business Authorizations ontology (FND-401).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20251201/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to add the concept of a chart of accounts (FND-398).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20251201/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to reflect migration of concepts from accounting equity to ownership in FND (FND-409), to reflect definition refinement in financial products and services (SEC-219), and to replace references to the now deprecated hasTag property in Relations with its equivalent in OMG Commons (FND-412).",
        "The https://spec.edmcouncil.org/fibo/ontology/FBC/20260701/ProductsAndServices/ClientsAndAccounts.rdf version of the ontology was modified to add the concept of a distributed ledger (FBC-336) and establish accounts as records (SEC-221)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2015-2025 Object Management Group, Inc.",
        "Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc." .

fibo-fbc-pas-caa:AccountOwnership a owl:Class ;
    rdfs:label "account ownership",
        "账户所有权（account ownership）"@zh ;
    rdfs:comment "对账户的持有。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-own:hasOwningParty ;
            owl:someValuesFrom fibo-fbc-pas-caa:AccountHolder ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:AccountAsAnAsset ;
            owl:onProperty fibo-fnd-oac-own:hasOwnedAsset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-oac-own:Ownership ;
    skos:definition "holding of an account" .

fibo-fbc-pas-caa:AccountSpecificServiceAgreement a owl:Class ;
    rdfs:label "account-specific service agreement",
        "账户专属服务协议（account-specific service agreement）"@zh ;
    rdfs:comment "针对特定账户的服务协议，适用于客户在同一机构持有多个条款各异的账户的情形。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
            owl:someValuesFrom fibo-fbc-pas-caa:AccountProvider ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom fibo-fbc-pas-caa:Account ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractParty ;
            owl:someValuesFrom fibo-fbc-pas-caa:AccountHolder ],
        fibo-fnd-pas-pas:ServiceAgreement ;
    skos:definition "service-agreement that is account-specific, applicable in cases where a client might hold multiple accounts with differing terms and conditions" ;
    cmns-av:explanatoryNote "Customers of financial service providers frequently hold multiple accounts - brokerage accounts, checking and savings accounts, trust accounts, and so forth - which may have specific terms and conditions associated with them." .

fibo-fbc-pas-caa:AccountingTransaction a owl:Class ;
    rdfs:label "accounting transaction",
        "会计交易（accounting transaction）"@zh ;
    rdfs:comment "通过账户记录中的分录予以确认的事件。"@zh ;
    rdfs:subClassOf fibo-fnd-pas-pas:TransactionEvent ;
    skos:definition "event recognized by an entry in the records of an account" .

fibo-fbc-pas-caa:BrokerageAccount a owl:Class ;
    rdfs:label "brokerage account",
        "经纪账户（brokerage account）"@zh ;
    rdfs:comment "由经纪商提供、允许投资者存入资金并下达投资指令的账户。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:isProvidedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-fbc-fct-fse:Bank fibo-fbc-fct-fse:BrokerageFirm fibo-fbc-fct-fse:FuturesCommissionMerchant ) ] ],
        fibo-fbc-pas-caa:InvestmentAccount ;
    skos:definition "account offered by a broker that allows the investor to deposit funds and place investment orders" ;
    cmns-av:explanatoryNote "The investor owns the assets contained in the brokerage account and must usually claim as income any capital gains incurred." .

fibo-fbc-pas-caa:ChartOfAccounts a owl:Class ;
    rdfs:label "chart of accounts",
        "会计科目表（chart of accounts）"@zh ;
    rdfs:comment "依照适用法律、监管和报告要求对实体财务交易进行分类、记录和组织的结构化财务账户代码体系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:characterizes ;
            owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccount ],
        fibo-fnd-arr-doc:FinancialRecord,
        cmns-col:Arrangement ;
    skos:definition "structured system of financial account codes used to classify, record, and organize an entity's financial transactions in accordance with applicable legal, regulatory, and reporting requirements" .

fibo-fbc-pas-caa:DistributedLedger a owl:Class ;
    rdfs:label "distributed ledger",
        "分布式账本（distributed ledger）"@zh ;
    rdfs:comment "在一组节点间共享、并通过共识机制在节点间同步的账本。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:usesMethod ;
            owl:someValuesFrom fibo-fbc-pas-caa:DistributedLedgerTechnology ],
        fibo-fbc-pas-caa:Ledger ;
    skos:definition "ledger that is shared across a set of nodes and synchronized between the nodes using a consensus mechanism" ;
    skos:note "A distributed ledger is designed to be immutable, tamper-resistant, tamper-evident and append-only, containing final and definitive ledger records of confirmed and validated transactions. The nodes in the network use distributed ledger technology for communications and synchronization purposes." ;
    cmns-av:adaptedFrom "ISO 24165-1:2025, Digital token identifier (DTI) - Registration, assignment and structure, Part 1: Method for registration and assignment, Second edition, 2025-05." .

fibo-fbc-pas-caa:Fee a owl:Class ;
    rdfs:label "fee",
        "费用（fee）"@zh ;
    rdfs:comment "对所提供服务收取的报酬。"@zh ;
    rdfs:subClassOf fibo-fnd-acc-cur:MonetaryAmount ;
    skos:definition "charge for services performed" .

fibo-fbc-pas-caa:GeneralLedger a owl:Class ;
    rdfs:label "general ledger",
        "总分类账（general ledger）"@zh ;
    rdfs:comment "用于在会计期间内随交易过账而记录和汇总头寸变化的有组织的分类账户集合。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:Ledger,
        fibo-fnd-arr-doc:FinancialRecord ;
    skos:definition "organized collection of ledger accounts used to record and summarize changes in position as transactions are posted during an accounting period" ;
    cmns-av:explanatoryNote "A general ledger is used to aggregate all financial records of an organization for analysis and reporting purposes. It is specific to the accounting domain, whereas the concept of a 'ledger' may apply more broadly." .

fibo-fbc-pas-caa:InternationalBankAccountIdentifier a owl:Class ;
    rdfs:label "international bank account identifier",
        "国际银行账户标识符（international bank account identifier）"@zh ;
    rdfs:comment "基本银行账户号（BBAN）的扩展版本银行账户标识符，供国际使用（IBAN）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:BasicBankAccountIdentifier ;
            owl:onProperty cmns-col:comprises ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass cmns-loc:GeographicRegionIdentifier ;
            owl:onProperty cmns-col:comprises ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-pas-caa:BankAccountIdentifier,
        cmns-cxtid:StructuredIdentifier ;
    skos:definition "identifier for a bank account that is an expanded version of the basic bank account number (BBAN), intended for use internationally" ;
    skos:example "For an account in Switzerland, suppose that an example domestic account number is 762 1162-3852.957. Suppose further that the bank identifier portion of that domestic account number is 762, or normalized for the BBAN is '00762'. For that example, the corresponding BBAN is '00762011623852957' and IBAN is 'CH9300762011623852957'." ;
    cmns-av:abbreviation "IBAN" ;
    cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
    cmns-av:explanatoryNote "Note that international bank account numbers are formatted uniquely by country. A description of the country-specific formats is available from SWIFT (https://www.swift.com/), which is the ISO registrar for ISO 13616.",
        "The IBAN structure is defined in ISO 13616-1 and consists of a two-letter ISO 3166-1 country code, followed by two check digits and up to thirty alphanumeric characters for a BBAN (Basic Bank Account Number) which has a fixed length per country and, included within it, a bank identifier with a fixed position and a fixed length per country. The check digits are calculated based on the scheme defined in ISO/IEC 7064 (MOD97-10)." ;
    cmns-av:synonym "international bank account number" .

fibo-fbc-pas-caa:LedgerAccountClassifier-Assets a owl:NamedIndividual,
        fibo-fbc-pas-caa:LedgerAccountClassifier ;
    rdfs:label "ledger account classifier - assets" ;
    dcterms:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
    skos:definition "classifier for ledger accounts used to track present rights of an entity to an economic benefit" ;
    cmns-av:explanatoryNote "A present right of an entity to an economic benefit entitles the entity to the economic benefit and the ability to restrict others' access to the benefit to which the entity is entitled. Assets are economic resources that an entity controls as a result of past events and that it expects to generate future economic benefits.",
        "Assets commonly have features that help identify them - for example, assets may be contractual, tangible, exchangeable, or separable. However, those features are not essential characteristics of assets. Their absence is not sufficient to preclude an item from qualifying as an asset." ;
    cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-txt:hasTextValue "Assets" .

fibo-fbc-pas-caa:LedgerAccountClassifier-Equity a owl:NamedIndividual,
        fibo-fbc-pas-caa:LedgerAccountClassifier ;
    rdfs:label "ledger account classifier - equity" ;
    dcterms:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
    skos:definition "classifier for ledger accounts used to track the residual interest in the assets of an entity that remains after deducting its liabilities" ;
    cmns-av:synonym "Net Assets" ;
    cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-txt:hasTextValue "Equity" .

fibo-fbc-pas-caa:LedgerAccountClassifier-Expenses a owl:NamedIndividual,
        fibo-fbc-pas-caa:LedgerAccountClassifier ;
    rdfs:label "ledger account classifier - expenses" ;
    dcterms:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
    skos:definition "classifier for ledger accounts used to track outflows or other using up of assets of an entity or incurrences of its liabilities (or a combination of both) from delivering or producing goods, rendering services, or carrying out other activities" ;
    cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-txt:hasTextValue "Expenses" .

fibo-fbc-pas-caa:LedgerAccountClassifier-Liabilities a owl:NamedIndividual,
        fibo-fbc-pas-caa:LedgerAccountClassifier ;
    rdfs:label "ledger account classifier - liabilities" ;
    dcterms:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
    skos:definition "classifier for ledger accounts used to track present obligations of an entity to transfer an economic benefit" ;
    cmns-av:explanatoryNote "Liabilities are obligations whose settlement is expected to involve transferring assets, providing services, or other outflows of resources.",
        "Liabilities commonly have features that help identify them. For example, many liabilities require the obligated entity to pay cash to one or more identified other entities. Liabilities may not require an entity to pay cash but may require the entity to convey other assets, provide services, or transfer other economic benefits or to be ready to do so." ;
    cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-txt:hasTextValue "Liabilities" .

fibo-fbc-pas-caa:LedgerAccountClassifier-Revenue a owl:NamedIndividual,
        fibo-fbc-pas-caa:LedgerAccountClassifier ;
    rdfs:label "ledger account classifier - revenue" ;
    dcterms:source "'Conceptual Framework for Financial Reporting', September 2024, Financial Accounting Standards Board (FASB)." ;
    skos:definition "classifier for ledger accounts used to track inflows or other enhancements of assets of an entity or settlements of its liabilities (or a combination of both) from delivering or producing goods, rendering services, or carrying out other activities" ;
    cmns-col:isMemberOf fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-dsg:isDefinedIn fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
    cmns-txt:hasTextValue "Revenue" .

fibo-fbc-pas-caa:LendingOfficer a owl:Class ;
    rdfs:label "lending officer",
        "信贷主管（lending officer）"@zh ;
    rdfs:comment "对与特定借款人或账户的关系负总责的公司管理人员。"@zh ;
    rdfs:subClassOf fibo-be-oac-exec:CorporateOfficer,
        fibo-fbc-pas-caa:RelationshipManager ;
    skos:definition "corporate officer that has overarching responsibility for the relationship with a specific borrower or account" .

fibo-fbc-pas-caa:TimeDepositOpenAccount a owl:Class ;
    rdfs:label "time deposit open account",
        "定期开放存款账户（time deposit open account）"@zh ;
    rdfs:comment "允许（定期存单以外的）存款、并与存款人订有有效书面合同的定期存款账户。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:TimeDepositAccount ;
    owl:disjointWith fibo-fbc-pas-caa:TimeCertificateOfDepositAccount ;
    skos:definition "time deposit account that allows deposits (other than time certificates of deposit) for which there is in force a written contract with the depositor that neither the whole nor any part of such deposit may be withdrawn prior to (1) the date of maturity, which shall be not less than seven days after the date of the deposit, or (2) the expiration of a specified period of written notice of not less than seven days" .

fibo-fbc-pas-caa:hasPaymentDueDate a owl:ObjectProperty ;
    rdfs:label "has payment due date",
        "具有付款到期日（has payment due date）"@zh ;
    rdfs:comment "指明某笔款项须支付给债权人的截止日期。"@zh ;
    rdfs:range fibo-fbc-pas-caa:PaymentDueDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "indicates the date by which payment of some amount must be made to the creditor" .

fibo-fbc-pas-caa:hasPrimaryAccountHolder a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has primary account holder",
        "具有主要账户持有人（has primary account holder）"@zh ;
    rdfs:comment "将账户与被视为账户主要所有者的客户关联起来。"@zh ;
    rdfs:domain fibo-fbc-pas-caa:CustomerAccount ;
    rdfs:range fibo-fbc-pas-caa:CustomerAccountHolder ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:isHeldBy ;
    skos:definition "relates an account to a client or customer that is considered the primary owner of the account" ;
    cmns-av:explanatoryNote "Note that for many financial institutions, there must be a client or customer designated as the primary owner. In cases where there is a tax identifier associated with the account, it is that of the primary owner." ;
    cmns-av:synonym "has primary account owner" .

fibo-fbc-pas-caa:hasSecondaryAccountHolder a owl:ObjectProperty ;
    rdfs:label "has secondary account holder",
        "具有次要账户持有人（has secondary account holder）"@zh ;
    rdfs:comment "将账户与被视为账户次要有人的客户（共同所有人）关联起来。"@zh ;
    rdfs:domain fibo-fbc-pas-caa:CustomerAccount ;
    rdfs:range fibo-fbc-pas-caa:CustomerAccountHolder ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:isHeldBy ;
    skos:definition "relates an account to a client or customer that is considered a secondary, co-owner of the account" ;
    cmns-av:synonym "has account co-owner",
        "has secondary account owner" .

fibo-fbc-pas-caa:isLinkedToAccount a owl:ObjectProperty ;
    rdfs:label "is linked to account",
        "关联至账户（is linked to account）"@zh ;
    rdfs:comment "将给定客户账户与另一客户账户连接起来。"@zh ;
    rdfs:domain fibo-fbc-pas-caa:CustomerAccount ;
    rdfs:range fibo-fbc-pas-caa:CustomerAccount ;
    rdfs:subPropertyOf fibo-fbc-pas-fpas:relatesTo ;
    skos:definition "connects a given customer account to another customer account" .

fibo-fbc-dae-dbt:CreditAgreement a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:LoanOrCreditAccount ;
            owl:onProperty fibo-fbc-pas-caa:hasCorrespondingAccount ] .

fibo-fbc-fct-fse:Bank a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:provides ;
            owl:someValuesFrom fibo-fbc-pas-caa:DemandDepositAccount ],
        [ a owl:Restriction ;
            owl:onProperty cmns-org:provides ;
            owl:someValuesFrom fibo-fbc-pas-caa:CommercialLendingService ] .

fibo-fbc-fct-fse:DepositoryInstitution a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:provides ;
            owl:someValuesFrom fibo-fbc-pas-caa:DepositAccount ] .

fibo-fbc-pas-caa:AccountAsAnAsset a owl:Class ;
    rdfs:label "account as an asset",
        "作为资产的账户（account as an asset）"@zh ;
    rdfs:comment "以账户形式存在的金融资产。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom fibo-fbc-pas-caa:Account ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-own:isAssetOf ;
            owl:someValuesFrom fibo-fbc-pas-caa:AccountHolder ],
        fibo-fnd-oac-own:FinancialAsset ;
    skos:definition "financial asset in the form of an account" .

fibo-fbc-pas-caa:BankIdentifier a owl:Class ;
    rdfs:label "bank identifier",
        "银行标识符（bank identifier）"@zh ;
    rdfs:comment "唯一标识金融机构的标识符，在适当时还标识为该账户提供服务的该机构分支机构。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-fct-fse:FinancialInstitution ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fct-fse:FinancialServiceProviderIdentifier ;
    skos:definition "identifier that uniquely identifies the financial institution and, when appropriate, the branch of that financial institution servicing an account" ;
    cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
    cmns-av:synonym "bank number" .

fibo-fbc-pas-caa:BasicBankAccountIdentifier a owl:Class ;
    rdfs:label "basic bank account identifier",
        "基本银行账户标识符（basic bank account identifier）"@zh ;
    rdfs:comment "在特定国家唯一标识某一金融机构中某一账户的标识符，包含银行标识符（BBAN）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:BankIdentifier ;
            owl:onProperty cmns-col:comprises ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:BankAccountIdentifier ;
            owl:onProperty cmns-col:comprises ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-pas-caa:BankAccountIdentifier,
        cmns-cxtid:StructuredIdentifier ;
    skos:definition "identifier that uniquely identifies an individual account at a specific financial institution in a particular country and which includes a bank identifier of the financial institution servicing that account" ;
    cmns-av:abbreviation "BBAN" ;
    cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
    cmns-av:synonym "basic bank account number" .

fibo-fbc-pas-caa:CertificateOfDeposit a owl:Class ;
    rdfs:label "certificate of deposit"@en,
        "存单（certificate of deposit）"@zh ;
    rdfs:comment "与定期存款账户相关联、在一定期限（存期）内不可提取的现金类工具。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cmns-dt:Duration ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractDuration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-fbc-fi-fi:hasNominalValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:InterestRate ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-fi-fi:CashInstrument ;
    skos:definition "cash instrument associated with a time deposit account that cannot be withdrawn for a certain period of time (term)"@en ;
    cmns-av:abbreviation "CD" ;
    cmns-av:explanatoryNote "When the term is over it can be withdrawn or it can be held for another term. The longer the term the better the yield on the money." .

fibo-fbc-pas-caa:CommercialLendingService a owl:Class ;
    rdfs:label "commercial lending service",
        "商业贷款服务（commercial lending service）"@zh ;
    rdfs:comment "涉及为支持商业活动而提供信贷的服务。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-fpas:FinancialService ;
    skos:definition "service involving the extension of credit to support business activities" ;
    skos:example "Examples include operating lines of credit and term loans for property, plant and equipment (PP&E)." .

fibo-fbc-pas-caa:DistributedLedgerTechnology a owl:Class ;
    rdfs:label "distributed ledger technology",
        "分布式账本技术（distributed ledger technology）"@zh ;
    rdfs:comment "使分布式账本得以运营和使用的方法。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:Method ;
    skos:definition "method that enables the operation and use of distributed ledgers" ;
    cmns-av:abbreviation "DLT" ;
    cmns-av:adaptedFrom "ISO 24165-1:2025, Digital token identifier (DTI) - Registration, assignment and structure, Part 1: Method for registration and assignment, Second edition, 2025-05." .

fibo-fbc-pas-caa:InvestmentAccount a owl:Class ;
    rdfs:label "investment account",
        "投资账户（investment account）"@zh ;
    rdfs:comment "记录存放于金融机构的资金和/或证券的账户。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:isProvidedBy ;
            owl:someValuesFrom fibo-fbc-fct-fse:FinancialInstitution ],
        fibo-fbc-pas-caa:InvestmentOrDepositAccount ;
    skos:definition "account that provides a record of deposits of funds and/or securities held at a financial institution" ;
    cmns-av:explanatoryNote "The typical objectives of an investment account are to achieve long term growth, income or capital preservation from the deposited asset portfolio. Investment accounts are typically not insured." .

fibo-fbc-pas-caa:NonTransactionDepositAccount a owl:Class ;
    rdfs:label "non-transaction deposit account",
        "非交易存款账户（non-transaction deposit account）"@zh ;
    rdfs:comment "任何未被明确视为交易账户的存款账户。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:DepositAccount ;
    owl:disjointWith fibo-fbc-pas-caa:TransactionDepositAccount ;
    skos:definition "any deposit account that is not explicitly considered a transaction account" ;
    cmns-av:explanatoryNote "Non-transaction accounts include: (a) savings deposits ((i) money market deposit accounts (MMDAs) and (ii) other savings deposits) and (b) time deposits ((i) time certificates of deposit and (ii) time deposits, open account)." .

fibo-fbc-pas-caa:PaymentDueDate a owl:Class ;
    rdfs:label "payment due date",
        "付款到期日（payment due date）"@zh ;
    rdfs:comment "当期未偿余额、其部分金额或最低应付款额须支付给债权人的截止日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "date by which payment of the current outstanding balance, part thereof, or a minimum amount due must be made to the creditor" .

fibo-fbc-pas-caa:RelationshipManager a owl:Class ;
    rdfs:label "relationship manager",
        "客户经理（relationship manager）"@zh ;
    rdfs:comment "管理客户账户并维护其与服务提供商关系的责任方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:manages ;
            owl:someValuesFrom fibo-fbc-pas-caa:Account ],
        cmns-bauth:ResponsibleParty ;
    skos:definition "responsible party who manages a client's account and oversees their relationship with the service provider" ;
    cmns-av:synonym "account manager" .

fibo-fbc-pas-caa:TimeCertificateOfDepositAccount a owl:Class ;
    rdfs:label "time certificate of deposit account",
        "定期存单账户（time certificate of deposit account）"@zh ;
    rdfs:comment "允许以可转让或不可转让凭证证明的存款、或以收据证明的记账形式存款的定期存款账户。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
            owl:someValuesFrom fibo-fbc-pas-caa:CertificateOfDeposit ],
        fibo-fbc-pas-caa:TimeDepositAccount ;
    skos:definition "time deposit account that allows deposits evidenced by a negotiable or nonnegotiable instrument, or a deposit in book entry form evidenced by a receipt or similar acknowledgement issued by the bank, that provides, on its face, that the amount of such deposit is payable to the bearer, to any specified person, or to the order of a specified person, as follows: (1) on a certain date not less than seven days after the date of deposit, (2) at the expiration of a specified period not less than seven days after the date of the deposit, or (3) upon written notice to the bank which is to be given not less than seven days before the date of withdrawal." ;
    cmns-av:abbreviation "CDA" .

fibo-fbc-pas-caa:TransactionCategory a owl:Class ;
    rdfs:label "transaction category",
        "交易类别（transaction category）"@zh ;
    rdfs:comment "单笔交易的高层分类器。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-fbc-pas-caa:IndividualTransaction ],
        cmns-cls:Classifier,
        cmns-cds:CodeElement ;
    skos:definition "high-level classifier for an individual transaction" ;
    skos:example "credit, debit, fee" .

fibo-fbc-pas-caa:TransactionIdentifier a owl:Class ;
    rdfs:label "transaction identifier",
        "交易标识符（transaction identifier）"@zh ;
    rdfs:comment "与账户相关联的单笔交易的标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:IndividualTransaction ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "identifier for an individual transaction associated with an account" .

fibo-fbc-pas-caa:TransactionRecordIdentifier a owl:Class ;
    rdfs:label "transaction record identifier",
        "交易记录标识符（transaction record identifier）"@zh ;
    rdfs:comment "交易记录的唯一标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:TransactionRecord ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-ra:RegisteredIdentifier ;
    skos:definition "unique identifier for record of transactions" .

fibo-fbc-pas-caa:TransactionSubcategory a owl:Class ;
    rdfs:label "transaction subcategory",
        "交易子类别（transaction subcategory）"@zh ;
    rdfs:comment "交易的第二层分类器，例如直接存款、支票、预借现金、取款、付款、购买等。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty cmns-dsg:hasTag ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-fbc-pas-caa:IndividualTransaction ],
        cmns-cls:Classifier,
        cmns-cds:CodeElement ;
    skos:definition "second-level classifier for a transaction, e.g., direct deposit, check, cash advance, withdrawal, payment, purchase, and so forth" .

fibo-fbc-pas-caa:hasCorrespondingAccount a owl:ObjectProperty ;
    rdfs:label "has corresponding account",
        "具有对应账户（has corresponding account）"@zh ;
    rdfs:comment "将信贷协议与用作交易管理基础的账户关联起来。"@zh ;
    rdfs:domain fibo-fbc-dae-dbt:CreditAgreement ;
    rdfs:range fibo-fbc-pas-caa:LoanOrCreditAccount ;
    rdfs:subPropertyOf fibo-fbc-pas-fpas:relatesTo ;
    skos:definition "relates a credit agreement to an account used as the basis for managing transactions" .

fibo-fbc-pas-caa:hasEndingBalance a owl:ObjectProperty ;
    rdfs:label "has ending balance",
        "具有期末余额（has ending balance）"@zh ;
    rdfs:comment "将对账单与账单期间结束时账户中的可用金额关联起来。"@zh ;
    rdfs:domain fibo-fbc-pas-caa:AccountStatement ;
    rdfs:range fibo-fbc-pas-caa:Balance ;
    rdfs:subPropertyOf fibo-fbc-pas-caa:hasBalance ;
    skos:definition "relates an account statement to the amount of money available in that account at the end of the statement period" .

fibo-fbc-pas-caa:hasPostingDate a owl:ObjectProperty ;
    rdfs:label "has posting date",
        "具有过账日期（has posting date）"@zh ;
    rdfs:comment "指明交易过账至账户的日期。"@zh ;
    rdfs:range fibo-fbc-pas-caa:PostingDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "indicates the date that the transaction was posted to the account" .

fibo-fbc-pas-caa:hasStartingBalance a owl:ObjectProperty ;
    rdfs:label "has starting balance",
        "具有期初余额（has starting balance）"@zh ;
    rdfs:comment "将对账单与账单期间开始时账户中的可用金额关联起来。"@zh ;
    rdfs:domain fibo-fbc-pas-caa:AccountStatement ;
    rdfs:range fibo-fbc-pas-caa:Balance ;
    rdfs:subPropertyOf fibo-fbc-pas-caa:hasBalance ;
    skos:definition "relates an account statement to the amount of money available in that account at the beginning of the statement period" .

fibo-fbc-pas-caa:hasTransactionDate a owl:ObjectProperty ;
    rdfs:label "has transaction date",
        "具有交易日期（has transaction date）"@zh ;
    rdfs:comment "指明交易实际发生的日期。"@zh ;
    rdfs:range fibo-fbc-pas-caa:TransactionDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "indicates the date on which the transaction actually occurred" .

fibo-fbc-pas-caa:hasTransactionDescription a owl:DatatypeProperty ;
    rdfs:label "has transaction description",
        "具有交易描述（has transaction description）"@zh ;
    rdfs:comment "提供交易的文字描述。"@zh ;
    rdfs:domain fibo-fbc-pas-caa:IndividualTransaction ;
    rdfs:range xsd:string ;
    skos:definition "provides a textual description of the transaction" .

fibo-fbc-pas-caa:hasTransactionRecordStatus a owl:DatatypeProperty ;
    rdfs:label "has transaction record status",
        "具有交易记录状态（has transaction record status）"@zh ;
    rdfs:comment "指明交易记录的状态。"@zh ;
    rdfs:range xsd:string ;
    skos:definition "indicates the status of the transaction record" .

fibo-fbc-pas-caa:involvesMerchant a owl:ObjectProperty ;
    rdfs:label "involves merchant",
        "涉及商户（involves merchant）"@zh ;
    rdfs:comment "指明交易中涉及的商户（卖方）。"@zh ;
    rdfs:range fibo-be-fct-fct:Merchant ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:involves ;
    skos:definition "indicates the merchant (seller) involved in the transaction" .

fibo-fbc-pas-caa:recordsTransaction a owl:ObjectProperty ;
    rdfs:label "records transaction",
        "记录交易（records transaction）"@zh ;
    rdfs:comment "将对账单与其所记载的单笔交易关联起来。"@zh ;
    owl:propertyChainAxiom ( fibo-fbc-pas-caa:appliesToAccount fibo-fnd-arr-doc:hasRecord cmns-col:comprises ) ;
    skos:definition "links an account statement to the individual transactions it documents" .

fibo-fnd-pas-pas:ContractualProduct a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
            owl:someValuesFrom fibo-fnd-agr-ctr:Contract ] .

fibo-fbc-pas-caa:AccountStatement a owl:Class ;
    rdfs:label "account statement",
        "对账单（account statement）"@zh ;
    rdfs:comment "某一给定期间账户活动的定期汇总。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-dt:ExplicitDatePeriod ;
            owl:onProperty fibo-fnd-arr-doc:hasReportingPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:Balance ;
            owl:onProperty fibo-fbc-pas-caa:hasEndingBalance ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:Account ;
            owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-pas-caa:recordsTransaction ;
            owl:someValuesFrom fibo-fbc-pas-caa:IndividualTransaction ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:Balance ;
            owl:onProperty fibo-fbc-pas-caa:hasStartingBalance ],
        cmns-doc:LegalDocument,
        cmns-doc:Record ;
    skos:definition "periodic summary of account activity for a given period of time" ;
    cmns-av:explanatoryNote "Common kinds of account statements include checking account statements, usually provided monthly, and brokerage account statements, which are provided monthly or quarterly, depending on the terms of the account agreement. Monthly credit card bills are also considered account statements." .

fibo-fbc-pas-caa:DemandDepositAccount a owl:Class ;
    rdfs:label "demand deposit account",
        "活期存款账户（demand deposit account）"@zh ;
    rdfs:comment "不计息存款账户，存款可按要求立即支付，或原始期限或所需通知期极短。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:TransactionDepositAccount ;
    skos:definition "non-interest-bearing deposit account in which deposits are payable immediately on demand, or that are issued with an original maturity or required notice period of less than seven days, or that represent funds for which the depository institution does not reserve the right to require at least seven days' written notice of an intended withdrawal" ;
    cmns-av:abbreviation "DDA" ;
    cmns-av:explanatoryNote "Demand deposits include any matured time deposits without automatic renewal provisions, unless the deposit agreement provides for the funds to be transferred at maturity to another type of account. Demand deposits do not include: (i) money market deposit accounts (MMDAs) or (ii) NOW accounts." .

fibo-fbc-pas-caa:Ledger a owl:Class ;
    rdfs:label "ledger",
        "分类账（ledger）"@zh ;
    rdfs:comment "业务活动和交易的有组织记录。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccount ],
        cmns-doc:Record ;
    skos:definition "organized record of business activities and transactions" ;
    skos:example "inventory ledger, blockchain ledger, general ledger" .

fibo-fbc-pas-caa:LoanOrCreditAccount a owl:Class ;
    rdfs:label "loan or credit account",
        "贷款或信用账户（loan or credit account）"@zh ;
    rdfs:comment "与账户持有人按特定还款条款和条件从账户提供方获得资金的服务相关联的账户。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:Account ;
    owl:disjointWith fibo-fbc-pas-caa:InvestmentOrDepositAccount ;
    skos:definition "account associated with a service in which the account holder receives funds from the account provider under certain terms and conditions for repayment" ;
    cmns-av:explanatoryNote "Note that this may be an internal account held on behalf of an institution or a customer account, such as a line of credit account associated with an internal line of business." .

fibo-fbc-pas-caa:PostingDate a owl:Class ;
    rdfs:label "posting date",
        "过账日期（posting date）"@zh ;
    rdfs:comment "决定凭证或日记账分录记入账户记录所属过账期间的日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "date that determines in which posting period a document or journal entry is added to an account record" .

fibo-fbc-pas-caa:TimeDepositAccount a owl:Class ;
    rdfs:label "time deposit account",
        "定期存款账户（time deposit account）"@zh ;
    rdfs:comment "存款人无权、也不被允许在存款后六日内提取的存款账户，除非满足特定条件。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:NonTransactionDepositAccount,
        fibo-fnd-pas-pas:ContractualProduct ;
    skos:definition "deposit account that the depositor does not have a right, and is not permitted, to make withdrawals from within six days after the date of deposit unless the deposit is subject to an early withdrawal penalty of at least seven days' simple interest on amounts withdrawn within the first six days after deposit" ;
    cmns-av:explanatoryNote "A time deposit from which partial early withdrawals are permitted must impose additional early withdrawal penalties of at least seven days' simple interest on amounts withdrawn within six days after each partial withdrawal. If such additional early withdrawal penalties are not imposed, the account ceases to be a time deposit. The account may become a savings deposit if it meets the requirements for a savings deposit; otherwise it becomes a demand deposit." .

fibo-fbc-pas-caa:TransactionDate a owl:Class ;
    rdfs:label "transaction date",
        "交易日期（transaction date）"@zh ;
    rdfs:comment "特定交易发起的日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "date on which a specific transaction was initiated" .

fibo-fbc-pas-caa:TransactionDepositAccount a owl:Class ;
    rdfs:label "transaction deposit account",
        "交易存款账户（transaction deposit account）"@zh ;
    rdfs:comment "存款人/账户持有人可通过可转让票据、支付指令等方式转账或取款的存款账户。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:DepositAccount ;
    skos:definition "deposit account from which the depositor / account holder is permitted to make transfers or withdrawals by negotiable / transferable instruments, payment orders of withdrawal, telephone transfers, and so forth, and that may be accessible via an electronic device such as an automated teller machine (ATM), remote service unit (RSU), mobile device, and by debit card" ;
    cmns-av:explanatoryNote "Excluded from transaction accounts are savings deposits (both money market deposit accounts (MMDAs) and other savings deposits), even though such deposits permit some third-party transfers. However, an account that otherwise meets the definition of a savings deposit but that authorizes or permits the depositor to exceed the transfer limitations specified for that account shall be reported as a transaction account." .

fibo-fbc-pas-caa:hasCloseDate a owl:ObjectProperty ;
    rdfs:label "has close date",
        "具有关闭日期（has close date）"@zh ;
    rdfs:comment "将某事物与其被关闭的日期关联起来。"@zh ;
    rdfs:range fibo-fbc-pas-caa:CloseDate ;
    rdfs:subPropertyOf cmns-dt:hasEndDate,
        cmns-dt:hasExplicitDate ;
    skos:definition "relates something to the date that it was closed" .

fibo-fbc-pas-caa:hasOpenDate a owl:ObjectProperty ;
    rdfs:label "has open date",
        "具有开立日期（has open date）"@zh ;
    rdfs:comment "将某事物与其被创建的日期关联起来。"@zh ;
    rdfs:range fibo-fbc-pas-caa:OpenDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate,
        cmns-dt:hasStartDate ;
    skos:definition "relates something to the date that it was created" .

fibo-fbc-pas-caa:AccountIdentifier a owl:Class ;
    rdfs:label "account identifier",
        "账户标识符（account identifier）"@zh ;
    rdfs:comment "表示某一账户的标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:Account ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-ra:RegisteredIdentifier ;
    skos:definition "identifier that denotes an account" ;
    cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
    cmns-av:synonym "account number" .

fibo-fbc-pas-caa:BankAccountIdentifier a owl:Class ;
    rdfs:label "bank account identifier",
        "银行账户标识符（bank account identifier）"@zh ;
    rdfs:comment "标识银行提供的活期存款账户的标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:DemandDepositAccount ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fbc-pas-caa:AccountIdentifier ;
    skos:definition "identifier that identifies a demand deposit account provided by a bank" ;
    cmns-av:adaptedFrom "ISO 13616-1:2007 Financial services - International bank account number (IBAN)" ;
    cmns-av:synonym "bank account number" .

fibo-fbc-pas-caa:CloseDate a owl:Class ;
    rdfs:label "close date",
        "关闭日期（close date）"@zh ;
    rdfs:comment "某事物被关闭的日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "date on which something was closed" ;
    skos:example "account close date, transaction record close date, and so forth" .

fibo-fbc-pas-caa:CustomerAccountHolder a owl:Class ;
    rdfs:label "customer account holder",
        "客户账户持有人（customer account holder）"@zh ;
    rdfs:comment "拥有客户账户的一方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:holds ;
            owl:someValuesFrom fibo-fbc-pas-caa:CustomerAccount ],
        [ a owl:Class ;
            owl:unionOf ( fibo-fnd-pas-pas:Client fibo-fnd-pas-pas:Customer ) ],
        fibo-fbc-pas-caa:AccountHolder ;
    skos:definition "party that owns a customer account" .

fibo-fbc-pas-caa:DepositAccount a owl:Class ;
    rdfs:label "deposit account",
        "存款账户（deposit account）"@zh ;
    rdfs:comment "记录存放于存款性机构保管和管理的资金的账户。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:isProvidedBy ;
            owl:someValuesFrom fibo-fbc-fct-fse:DepositoryInstitution ],
        fibo-fbc-fct-fse:BankingProduct,
        fibo-fbc-pas-caa:InvestmentOrDepositAccount ;
    skos:definition "account that provides a record of money placed with a depository institution for safekeeping and management" ;
    skos:example "Deposit accounts include savings accounts, money market accounts, and transactional accounts, such as demand deposit accounts, among others." ;
    cmns-av:explanatoryNote "The account holder has the right to withdraw deposited funds, as set forth in the terms and conditions governing the account agreement. Deposit accounts may be insured up to a certain amount, depending on the jurisdiction." .

fibo-fbc-pas-caa:InvestmentOrDepositAccount a owl:Class ;
    rdfs:label "investment or deposit account",
        "投资或存款账户（investment or deposit account）"@zh ;
    rdfs:comment "与要求账户持有人提供资金交由账户提供方管理的产品或服务相关联的账户。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:Account ;
    skos:definition "account associated with a product or service that requires the account holder to provide funds for management by the account provider" ;
    cmns-av:explanatoryNote "The account holder may or may not be entitled to consideration in exchange for providing such funds, for example, interest, depending on the type of account and the terms and conditions associated with it. Also, there may be fees associated with management services provided by the account provider. Note too that this may be an internal account held on behalf of an institution or a customer account." .

fibo-fbc-pas-caa:LedgerAccount a owl:Class ;
    rdfs:label "ledger account",
        "分类账户（ledger account）"@zh ;
    rdfs:comment "分类账中某一要素或子要素的单独记录，记录并汇总该特定科目的增加、减少和余额。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:Account ;
    skos:definition "individual record for one element or sub-element in a ledger that records and summarizes increases, decreases, and balances associated with that specific element" ;
    cmns-av:explanatoryNote "Ledger accounts are internal to a legal entity's accounting system(s)." .

fibo-fbc-pas-caa:OpenDate a owl:Class ;
    rdfs:label "open date",
        "开立日期（open date）"@zh ;
    rdfs:comment "某事物被创建的日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "date on which something was created" .

fibo-fbc-pas-caa:TransactionRecord a owl:Class ;
    rdfs:label "transaction record",
        "交易记录（transaction record）"@zh ;
    rdfs:comment "与账户相关联的交易的记录。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:TransactionRecordIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:IndividualTransaction ;
            owl:onProperty cmns-col:comprises ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:Account ;
            owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty fibo-fbc-pas-caa:hasTransactionRecordStatus ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:OpenDate ;
            owl:onProperty fibo-fbc-pas-caa:hasOpenDate ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:CloseDate ;
            owl:onProperty fibo-fbc-pas-caa:hasCloseDate ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:AccountProvider ;
            owl:onProperty cmns-org:isManagedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-dt-fd:DatedStructuredCollection,
        cmns-doc:Record,
        cmns-ra:Registry ;
    skos:definition "record of transactions associated with an account" ;
    cmns-av:usageNote "The date a particular transaction record is closed typically corresponds to (and may precede) the date the account is closed, though in the case of certain accounts, such as a credit card account, if a customer is issued a new account or card number due to loss, fraud, or for some other reason, it is possible that multiple transaction records would be associated with the account. In that case, the close date might correspond to the date that a hold was placed on the original account." .

fibo-fbc-pas-caa:hasBalance a owl:ObjectProperty ;
    rdfs:label "has balance",
        "具有余额（has balance）"@zh ;
    rdfs:comment "将账户与该账户中可用的货币净额关联起来。"@zh ;
    rdfs:range fibo-fbc-pas-caa:Balance ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
    skos:definition "relates an account to the net amount of money available in that account" .

fibo-fbc-pas-caa:AccountProvider a owl:Class ;
    rdfs:label "account provider",
        "账户提供方（account provider）"@zh ;
    rdfs:comment "提供并服务账户的一方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-pts:isAPartyTo ;
                    owl:someValuesFrom fibo-fbc-pas-caa:Account ] ],
        cmns-org:ServiceProvider ;
    skos:definition "party that provides and services an account" .

fibo-fbc-pas-caa:appliesToAccount a owl:ObjectProperty ;
    rdfs:label "applies to account",
        "适用于账户（applies to account）"@zh ;
    rdfs:comment "指明交易记录或单笔交易所适用的账户。"@zh ;
    rdfs:range fibo-fbc-pas-caa:Account ;
    rdfs:subPropertyOf cmns-cxtdsg:appliesTo ;
    skos:definition "indicates the account to which the transaction record or individual transaction applies" .

fibo-fbc-pas-caa:AccountHolder a owl:Class ;
    rdfs:label "account holder",
        "账户持有人（account holder）"@zh ;
    rdfs:comment "拥有账户的一方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty fibo-fnd-oac-own:owns ;
                    owl:someValuesFrom fibo-fbc-pas-caa:Account ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:holds ;
            owl:someValuesFrom fibo-fbc-pas-caa:Account ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-pts:isAPartyTo ;
                    owl:someValuesFrom fibo-fbc-pas-caa:Account ] ],
        fibo-fnd-oac-own:Owner ;
    skos:definition "party that owns an account" ;
    cmns-av:explanatoryNote "An account holder is named on the account and is authorized to conduct transactions associated with the account. Authorization is typically evidenced by signatures maintained on file by the account provider.",
        "Note that this concept of account holder applies to internal accounts that are non-general ledger accounts also have account holders, such as payroll accounts, internal checking accounts associated with cashier's checks, and so forth." .

fibo-fbc-pas-caa:CustomerAccount a owl:Class ;
    rdfs:label "customer account",
        "客户账户（customer account）"@zh ;
    rdfs:comment "代表一组已识别、具名的余额和累计总额集合的账户，用于汇总某段期间与客户交易相关的活动。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:someValuesFrom fibo-fbc-pas-caa:AccountIdentifier ],
        [ a owl:Restriction ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:someValuesFrom fibo-fnd-pas-pas:ServiceAgreement ],
        [ a owl:Restriction ;
            owl:onProperty cmns-org:isProvidedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( fibo-fbc-pas-caa:AccountProvider fibo-fbc-pas-fpas:FinancialServiceProvider ) ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:exemplifies ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-fbc-pas-fpas:FinancialProduct fibo-fbc-pas-fpas:FinancialService ) ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isHeldBy ;
            owl:someValuesFrom fibo-fbc-pas-caa:CustomerAccountHolder ],
        fibo-fbc-pas-caa:Account ;
    skos:definition "account that represents an identified, named collection of balances and cumulative totals used to summarize customer transaction-related activity over a designated period of time" ;
    cmns-av:synonym "financial service account" .

fibo-fbc-pas-caa:Balance a owl:Class ;
    rdfs:label "balance",
        "余额（balance）"@zh ;
    rdfs:comment "可用或欠付的货币金额。"@zh ;
    rdfs:subClassOf fibo-fnd-acc-cur:MonetaryAmount ;
    skos:definition "amount of money available or owed" ;
    cmns-av:explanatoryNote "The balance is the net amount after factoring in all debits and credits, including service charges and fees." .

fibo-fbc-pas-caa:IndividualTransaction a owl:Class ;
    rdfs:label "individual transaction",
        "单笔交易（individual transaction）"@zh ;
    rdfs:comment "具有货币影响、并记录在与账户相关联的记录中的事件。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-fbc-pas-caa:TransactionRecord ;
            owl:onProperty cmns-ra:isRegisteredIn ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:TransactionIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-pas-pas:TransactionEvent ;
            owl:onProperty fibo-fnd-rel-rel:exemplifies ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:TransactionDate ;
            owl:onProperty fibo-fbc-pas-caa:hasTransactionDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:Account ;
            owl:onProperty fibo-fbc-pas-caa:appliesToAccount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:TransactionSubcategory ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty fibo-fbc-pas-caa:hasTransactionDescription ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:TransactionCategory ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-fct-fct:Merchant ;
            owl:onProperty fibo-fbc-pas-caa:involvesMerchant ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-fnd-acc-cur:hasMonetaryAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:PostingDate ;
            owl:onProperty fibo-fbc-pas-caa:hasPostingDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-dt-fd:DatedCollectionConstituent,
        fibo-fnd-dt-oc:Occurrence ;
    skos:definition "event that has a monetary impact and is documented in the records associated with an account" .

fibo-fbc-pas-caa:LedgerAccountClassifier a owl:Class ;
    rdfs:label "ledger account classifier",
        "分类账户分类器（ledger account classifier）"@zh ;
    rdfs:comment "依照适用法律、监管和报告要求组织实体财务账户的分类器。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccount ],
        [ a owl:Restriction ;
            owl:hasValue fibo-fbc-pas-caa:LedgerAccountClassificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ],
        cmns-cls:Classifier ;
    skos:definition "classifier used to organize an entity's financial accounts in accordance with applicable legal, regulatory, and reporting requirements" .

fibo-fbc-pas-caa:LedgerAccountClassificationScheme a [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-fbc-pas-caa:LedgerAccountClassifier ],
        owl:NamedIndividual,
        cmns-cls:ClassificationScheme,
        cmns-cds:CodeSet ;
    rdfs:label "ledger account classification scheme" ;
    skos:definition "classification scheme used to organize an entity's financial accounts in accordance with applicable legal, regulatory, and reporting requirements" .

fibo-fbc-pas-caa:Account a owl:Class ;
    rdfs:label "account",
        "账户（account）"@zh ;
    rdfs:comment "与常规交易和服务之业务安排相关记录的容器。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:CloseDate ;
            owl:onProperty fibo-fbc-pas-caa:hasCloseDate ],
        [ a owl:Restriction ;
            owl:onProperty cmns-org:isProvidedBy ;
            owl:someValuesFrom fibo-fbc-pas-caa:AccountProvider ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:AccountHolder ;
            owl:onProperty fibo-fnd-rel-rel:isHeldBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:TransactionRecord ;
            owl:onProperty fibo-fnd-arr-doc:hasRecord ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-pas-caa:hasBalance ;
            owl:someValuesFrom fibo-fbc-pas-caa:Balance ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fbc-pas-caa:AccountIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ],
        [ a owl:Restriction ;
            owl:onClass fibo-fbc-pas-caa:OpenDate ;
            owl:onProperty fibo-fbc-pas-caa:hasOpenDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-arr-doc:FinancialRecord ;
    skos:definition "container for records associated with a business arrangement for regular transactions and services" ;
    cmns-av:explanatoryNote "In general, an account is associated with a contractual relationship between a buyer and seller under which payment may be made at a later time. General ledger accounts are an exception to this, however, and typically do not have account holders, including internal account holders. They may, on the other hand, have responsible parties." .

