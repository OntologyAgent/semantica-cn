fibo-fnd-acc-4217:UnidadPrevisional a owl:NamedIndividual,
        fibo-fnd-acc-cur:Funds ;
    rdfs:label "Unidad Previsional" ;
    skos:definition "the funds Unidad Previsional"@en ;
    skos:note "The Unidad Previsional (UP) is a daily accounting unit that tracks changes to the nominal wage index. The value of UP is expressed in terms of Uruguayan Pesos per UP, with the initial value of one peso (UYU 1.00) on 04/30/2018. The institution responsible for the calculation and publication is the Instituto Nacional de Estadística (National Bureau of Statistics) according to Law 19,608."@en ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:PesoUruguayo ;
    fibo-fnd-acc-cur:hasMinorUnit "4" ;
    fibo-fnd-acc-cur:hasNumericCode "927" ;
    cmns-cxtdsg:isUsedBy lcc-3166-1:Uruguay ;
    cmns-dsg:hasTextualName "Unidad Previsional" .

fibo-fnd-acc-4217:UnidaddeFomento a owl:NamedIndividual,
        fibo-fnd-acc-cur:Funds ;
    rdfs:label "Unidad de Fomento" ;
    skos:definition "the funds Unidad de Fomento"@en ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:ChileanPeso ;
    fibo-fnd-acc-cur:hasMinorUnit "4" ;
    fibo-fnd-acc-cur:hasNumericCode "990" ;
    cmns-av:explanatoryNote "The CLF is a daily economically-financial unit calculated by the Central Bank of Chile according to inflation (as measured by the Chilean Consumer Price Index of the previous month). The value of the CLF is expressed in terms of Chilean Pesos per CLF. The use of CLF has been widely extended to all types of bank loans, financial investments (time deposits, mortgages and other public or private indexed instruments), contracts and fees in some cases." ;
    cmns-cxtdsg:isUsedBy lcc-3166-1:Chile ;
    cmns-dsg:hasTextualName "Unidad de Fomento" .

fibo-fnd-acc-4217:UnidaddeValorReal a owl:NamedIndividual,
        fibo-fnd-acc-cur:Funds ;
    rdfs:label "Unidad de Valor Real" ;
    skos:definition "the funds Unidad de Valor Real"@en ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:ColombianPeso ;
    fibo-fnd-acc-cur:hasMinorUnit "2" ;
    fibo-fnd-acc-cur:hasNumericCode "970" ;
    cmns-av:explanatoryNote "The UVR is a daily account unit set by the Central Bank of Colombia according to the variation in the Consumer Price Index of Colombia. The value of UVR is expressed in terms of Colombian Pesos per UVR. It is used to denominate and update mortgage loans and some public debt bonds." ;
    cmns-cxtdsg:isUsedBy lcc-3166-1:Colombia ;
    cmns-dsg:hasTextualName "Unidad de Valor Real" .

fibo-fnd-acc-4217:UruguayPesoenUnidadesIndexadas_UI a owl:NamedIndividual,
        fibo-fnd-acc-cur:Funds ;
    rdfs:label "Uruguay Peso en Unidades Indexadas (UI)" ;
    skos:definition "the funds Uruguay Peso en Unidades Indexadas (UI)"@en ;
    fibo-fnd-acc-cur:hasCurrency fibo-fnd-acc-4217:PesoUruguayo ;
    fibo-fnd-acc-cur:hasMinorUnit "0" ;
    fibo-fnd-acc-cur:hasNumericCode "940" ;
    cmns-av:explanatoryNote "The UYI (URUIURUI) is used for issuance of debt instruments by the Uruguayan government in the international global bond market. It is calculated based on an established methodology using underlying inflationary statistics in the Uruguayan market. (Introduced in 2002)." ;
    cmns-cxtdsg:isUsedBy lcc-3166-1:Uruguay ;
    cmns-dsg:hasTextualName "Uruguay Peso en Unidades Indexadas (UI)" .

