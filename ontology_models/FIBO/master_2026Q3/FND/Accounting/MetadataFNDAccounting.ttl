		See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2025-06-27T18:00:00"^^xsd:dateTime ;
    rdfs:comment "声明会计（Accounting）模块由货币金额、现金流、ISO 4217 货币代码三个本体构成，及版本信息。"@zh ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FND/20250601/Accounting/MetadataFNDAccounting/> ;
    cmns-av:copyright "Copyright (c) 2017-2025 EDM Council, Inc.",
        "Copyright (c) 2017-2025 Object Management Group, Inc." .

fibo-fnd-acc-mod:AccountingModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "accounting module" ;
    dcterms:abstract "This module contains ontologies of general accounting concepts including currency and the ISO 4217 reference currency codes." ;
    dcterms:hasPart <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CashFlows/>,
        <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/>,
        <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> ;
    dcterms:license """Copyright (c) 2025 EDM Council, Inc.
Copyright (c) 2025 Object Management Group, Inc.

