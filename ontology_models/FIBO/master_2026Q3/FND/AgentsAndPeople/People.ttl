@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-loc: <https://www.omg.org/spec/Commons/Locations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-rga: <https://www.omg.org/spec/Commons/RegulatoryAgencies/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix cmns-txt: <https://www.omg.org/spec/Commons/TextDatatype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-fnd-aap-ppl: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix fibo-fnd-arr-doc: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-plc-adr: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/> .
@prefix fibo-fnd-pty-pty: <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-fnd-aap-ppl: a owl:Ontology ;
    rdfs:label "People Ontology",
        "人员本体（People Ontology）"@zh ;
    dcterms:abstract "This ontology defines concepts for people and human related terms, for use in other FIBO ontology elements. People as defined here are human persons only. This ontology sets out a number of basic properties which are held by people or are definitive of a small number of specific types of people such as minors or adults. Primary use cases for determining the set of personal information definitions included are the common elements required to (1) open a bank account, (2) identify a sophisticated investor, and (3) establish foreign account ownership for money laundering purposes." ;
    dcterms:license """Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义自然人（person）的核心属性：姓名、出生日期、国籍、身份标识与联系方式，为雇员、客户、签署人等角色提供「人」的基础模型。"@zh ;
    owl:imports fibo-fnd-arr-doc:,
        <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/>,
        fibo-fnd-dt-fd:,
        fibo-fnd-pty-pty:,
        fibo-fnd-plc-adr:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-cls:,
        cmns-col:,
        cmns-cxtdsg:,
        cmns-dt:,
        cmns-dsg:,
        cmns-doc:,
        cmns-id:,
        cmns-loc:,
        cmns-pts:,
        cmns-rga:,
        cmns-rlcmp:,
        cmns-txt: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FND/20260701/AgentsAndPeople/People/> ;
    skos:changeNote "The http://spec.edmcouncil.org/fibo/ontology/FND/20130801/AgentsAndPeople/People.rdf version of the ontology was was modified per the issue resolutions identified in the FIBO FND 1.0 FTF report and in https://spec.edmcouncil.org/fibo/ontology/FND/1.0/AboutFND-1.0/. It was further revised in the FTF in advance of the Long Beach meeting, resulting in https://spec.edmcouncil.org/fibo/ontology/FND/20141101/AgentsAndPeople/People/.",
        "The http://spec.edmcouncil.org/fibo/ontology/FND/20141101/AgentsAndPeople/People.rdf version of the ontology was was modified per the issue resolutions identified in the FIBO FND 1.1 RTF report, primarily to use the hasAddress property in addresses, and change PostalAddress to PhysicalAddress in a restriction on Person. Also revised the identifiesAddress property in favor of verifiesAddress, and revised hasDateofBirth with respect to an identity document to be verifiesDateOfBirth, which was determined to be more appropriate by the RTF.",
        """The http://www.omg.org/spec/FIBO/Foundations/20130601/AgentsAndPeople/People.owl version of the ontology was revised in advance of the September 2013 New Brunswick, NJ meeting, as follows:
		(1) to use slash style URI/IRIss (also called 303 URIs, vs. hash style) as required to support server side processing 
		(2) to use version-independent IRIs for all definitions internally as opposed to version-specific IRIs
		(3) to change the file suffix from .owl to .rdf to increase usability in RDF tools
		(4) to use 4-level abbreviations and corresponding namespace prefixes for all FIBO ontologies, reflecting a family/specification/module/ontology structure
		(5) to incorporate changes to the specification metadata to support documentation at the family, specification, module, and ontology level, similar to the abbreviations.
		(6) to revise and extend the set of properties about people required to fulfill the set of use cases listed above.""",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20160201/AgentsAndPeople/People.rdf version of the ontology was modified per the FIBO 2.0 RFC, including integration of LCC.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20180801/AgentsAndPeople/People.rdf version of the ontology was modified to deprecate legally capable person in favor of natural person (defined in Business Entities).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20181101/AgentsAndPeople/People.rdf version of the ontology was was modified to revise a restriction on IdentityDocument to reference the appropriate identifier rather than use a tag. The impetus behind this change is to support privacy legislation, such as GDPR, which requires protection of both identifiers, such as a passport number, drivers' license number, etc. as well as the documents themselves. Thus, properties and individuals related to those identifiers are urgently needed.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20190501/AgentsAndPeople/People.rdf version of the ontology was modified to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20190501/AgentsAndPeople/People.rdf version of the ontology was modified to replace hasDefinition with isDefinedIn to clarify intent.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20190901/AgentsAndPeople/People.rdf version of the ontology was modified to eliminate duplication with concepts in LCC and correct a bug in a restriction on identity document.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20200201/AgentsAndPeople/People.rdf version of the ontology was modified to add explicit DateOfBirth and DateOfDeath, added DeathCertificate and related concepts, streamlined related properties and restrictions.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20201201/AgentsAndPeople/People.rdf version of the ontology was modified to add hasResidence, hasMailingAddress, and hasPrimaryResidence properties and a restriction on person with respect to residence accordingly, then to move hasMailingAddress to Parties.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20210301/AgentsAndPeople/People.rdf version of the ontology was modified to allow the People ontology to import Parties, rather than the other way around, to simplify the class hierarchy for ease of use in data mapping and alignment, and to add person name as a first class concept, revising property definitions to allow for structured names by loosening constraints.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20210401/AgentsAndPeople/People.rdf version of the ontology was modified to add concepts specific to legal age, age of majority, legal working age and legal working age person.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20210601/AgentsAndPeople/People.rdf version of the ontology was modified to revise the definition of passport number as a national identification number and eliminate restrictions that would cause people to be inferred to be passports.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20211101/AgentsAndPeople/People.rdf version of the ontology was modified to address hygiene issues with respect to text formatting.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20220701/AgentsAndPeople/People.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20230101/AgentsAndPeople/People.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20230301/AgentsAndPeople/People.rdf version of the ontology was modified to replace concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20231201/AgentsAndPeople/People.rdf version of the ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20240101/AgentsAndPeople/People.rdf version of the ontology was modified to replace an additional property with its equivalent from the OMG Commons Ontology Library (Commons) v1.1 (FBC-322).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20241001/AgentsAndPeople/People.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20250301/AgentsAndPeople/People.rdf version of the ontology was modified to add the concept of a contact, as a role someone can play, and of contact record, as the representation of the details that store the relevant information (FND-397).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20250901/AgentsAndPeople/People.rdf version of the ontology was modified to deprecate duplicate properties that are now available in OMG Commons Ontology Library (Commons) v1.3 (FND-412)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2013-2025 Object Management Group, Inc.",
        "Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc." .

fibo-fnd-aap-ppl:EmancipatedMinor a owl:Class ;
    rdfs:label "emancipated minor",
        "解除监护的未成年人（emancipated minor）"@zh ;
    rdfs:comment "获准在不受父母控制的情况下以自己名义或为自己账户经营业务或从事其他职业的未成年人。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:Minor ;
    skos:definition "a minor who is allowed to conduct a business or any other occupation on his or her own behalf or for their own account outside the control of a parent or guardian" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Emancipated_minor"^^xsd:anyURI ;
    cmns-av:explanatoryNote "The minor will then have full contractual capacity to conclude contracts with regard to the business. Whether parental consent is needed to achieve emancipated status varies from case to case. In some cases, court permission is necessary. Protocols vary by jurisdiction." .

fibo-fnd-aap-ppl:IncapacitatedAdult a owl:Class ;
    rdfs:label "incapacitated adult",
        "无行为能力成年人（incapacitated adult）"@zh ;
    rdfs:comment "在法律上被认定为不具有法律行为能力的成年人，通常因某种固有的身心障碍所致。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:Adult ;
    owl:disjointWith fibo-fnd-aap-ppl:LegallyCapableAdult ;
    skos:definition "an adult who is legally identified as not having legal capacity, typically as a result of some inherent physical or mental incapacity or as a result of having contracted some illness which temporarily deprives them of such capacity" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Capacity_(law)"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Individuals may have an inherent physical condition which prevents them from achieving the normal levels of performance expected from persons of comparable age, or their inability to match current levels of performance may be caused by contracting an illness. Whatever the cause, if the resulting condition is such that individuals cannot care for themselves, or may act in ways that are against their interests, those persons are vulnerable through dependency and require the protection of the state against the risks of abuse or exploitation. Hence, any agreements that were made are voidable, and a court may declare that person a ward of the state and grant power of attorney to an appointed legal guardian." .

fibo-fnd-aap-ppl:LegalWorkingAgePerson a owl:Class ;
    rdfs:label "legal working age person",
        "达到法定工作年龄的人（legal working age person）"@zh ;
    rdfs:comment "年龄大于其工作所在管辖区规定的最低法定工作年龄的人。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-aap-ppl:LegalWorkingAge ;
            owl:onProperty fibo-fnd-aap-ppl:hasMinimumLegalWorkingAge ],
        fibo-fnd-aap-ppl:Person ;
    skos:definition "person whose age is greater than the minimum legal working age specified in a jurisdiction in which they work" .

fibo-fnd-aap-ppl:Passport a owl:Class ;
    rdfs:label "passport",
        "护照（passport）"@zh ;
    rdfs:comment "由国家政府签发的正式身份证件，为国际旅行目的证明持有人的身份与国籍。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:PassportNumber ;
            owl:onProperty cmns-col:comprises ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-aap-ppl:IdentityDocument ;
    skos:definition "formal identity document, issued by a national government, which certifies the identity and nationality of its holder for the purpose of international travel" ;
    fibo-fnd-utl-av:definitionOrigin "https://en.wikipedia.org/wiki/Passport"^^xsd:anyURI ;
    cmns-av:explanatoryNote "The elements of identity contained in all standardized passports include information about the holder, including name, date of birth, gender and place of birth." .

fibo-fnd-aap-ppl:hasFamilyName a owl:DatatypeProperty ;
    rdfs:label "has family name",
        "具有姓氏（has family name）"@zh ;
    rdfs:comment "标识家庭成员共有的、区别于各成员名字的姓。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    owl:equivalentProperty fibo-fnd-aap-ppl:hasLastName,
        fibo-fnd-aap-ppl:hasSurname ;
    skos:definition "indicates the name shared in common to identify the members of a family, as distinguished from each member's given name" ;
    cmns-av:explanatoryNote "'Family name' is more commonly used in the United Kingdom than in the United States to refer to someone's surname." .

fibo-fnd-aap-ppl:hasFirstName a owl:DatatypeProperty ;
    rdfs:label "has first name",
        "具有名字（has first name）"@zh ;
    rdfs:comment "标识个人的名，即出生时为其选取或其后更改的名字。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    owl:equivalentProperty fibo-fnd-aap-ppl:hasGivenName ;
    skos:definition "indicates the given name or first name of a person, that is, the name chosen for them at birth or changed by them subsequently from the name given at birth" .

fibo-fnd-aap-ppl:hasMaidenName a owl:DatatypeProperty ;
    rdfs:label "has maiden name",
        "具有婚前姓（has maiden name）"@zh ;
    rdfs:comment "标识因婚姻而改姓之前的家族姓氏。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    skos:definition "indicates the name shared in common to identify the members of a family, that predates any changes of name due to marriage" .

fibo-fnd-aap-ppl:hasMiddleNameOrInitial a owl:DatatypeProperty ;
    rdfs:label "has middle name or initial",
        "具有中间名或首字母（has middle name or initial）"@zh ;
    rdfs:comment "位于个人名与姓之间的一个或多个附加名字或首字母。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    skos:definition "one or more additional names or initial letters for names that occur between a person's first and last name" .

fibo-fnd-aap-ppl:hasPrimaryResidence a owl:ObjectProperty ;
    rdfs:label "has primary residence",
        "具有主要居所（has primary residence）"@zh ;
    rdfs:comment "标识个人一年中大部分时间居住的住所。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range fibo-fnd-plc-adr:ConventionalStreetAddress ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasResidence ;
    skos:definition "identifies a dwelling where an individual resides the majority of the year" ;
    cmns-av:explanatoryNote "For tax purposes, in cases when an individual owns more than one home, their primary residence is the home in which they reside most of the time, and for which they can provide evidence to that effect. Having said this, there are cases, such as for individuals that have dual citizenship, where they may have multiple primary residences, one in each country in which they maintain a home. There may also be subtle issues related to 'rent control' that may impact the statements an individual makes about their primary residence. In other words, one cannot necessarily infer a person's identity from their primary place of residence." .

fibo-fnd-aap-ppl:isPointOfContactFor a owl:ObjectProperty ;
    rdfs:label "is point of contact for",
        "是……的联络点（is point of contact for）"@zh ;
    rdfs:comment "是该参与方作为联络点所服务的实体或目的。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Contact ;
    rdfs:subPropertyOf cmns-rlcmp:hasRole ;
    owl:inverseOf fibo-fnd-aap-ppl:hasPointOfContact ;
    skos:definition "is the entity or purpose for which the party is the point of contact" .

fibo-fnd-aap-ppl:BirthCertificate a owl:Class ;
    rdfs:label "birth certificate",
        "出生证明（birth certificate）"@zh ;
    rdfs:comment "证明出生情况的原始文件，或该出生登记的认证副本或表示。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:BirthCertificateIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-aap-ppl:IdentityDocument,
        cmns-doc:Certificate ;
    skos:definition "an original document certifying the circumstances of the birth, or a certified copy of or representation of the ensuing registration of that birth" ;
    cmns-av:adaptedFrom "http://en.wikipedia.org/wiki/Birth_certificate"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A birth certificate is a vital record that documents the birth of a child. Depending on the jurisdiction, a record of birth might or might not contain verification of the event by such as a midwife or doctor." ;
    cmns-av:synonym "certificate of live birth" .

fibo-fnd-aap-ppl:BirthCertificateIdentificationScheme a owl:Class ;
    rdfs:label "birth certificate identification scheme",
        "出生证明标识方案（birth certificate identification scheme）"@zh ;
    rdfs:comment "为出生证明分配标识符的体系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-fnd-aap-ppl:BirthCertificateIdentifier ],
        cmns-id:IdentificationScheme ;
    skos:definition "system for allocating identifiers to birth certificates" ;
    cmns-av:explanatoryNote "Schemes for birth certificate identification are typically regionally defined, and there may be jurisdiction-specific scope required as an additional restriction on a specific scheme." .

fibo-fnd-aap-ppl:ContactRecord a owl:Class ;
    rdfs:label "contact record",
        "联系人记录（contact record）"@zh ;
    rdfs:comment "关于处于特定通信或联络角色的参与方的记录。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:Contact ;
            owl:onProperty cmns-dsg:denotes ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-pty-pty:PartyRoleIdentifier ;
            owl:onProperty cmns-col:comprises ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-doc:Record ;
    skos:definition "record about a party in a specific communicative or liaison role" ;
    cmns-av:explanatoryNote "Contact records may include attributes such as name, role, communication channel, and affiliation, They may be found in registries, schemas, systems such as those designed for customer relationship management (CRM), enterprise resource planning (ERP), health information, legal and regulatory compliance and others, as well as personal address books, to support communications, coordination, support, or compliance." .

fibo-fnd-aap-ppl:DeathCertificate a owl:Class ;
    rdfs:label "death certificate",
        "死亡证明（death certificate）"@zh ;
    rdfs:comment "证明死亡情况（如死亡方式与时间）的原始文件，或该死亡登记的认证副本或表示。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DeathCertificateIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-aap-ppl:IdentityDocument,
        cmns-doc:Certificate ;
    skos:definition "original document certifying the circumstances of the death (such as how and when it occurred), or a certified copy of or representation of the ensuing registration of that death" ;
    cmns-av:explanatoryNote "A death certificate is a vital record documenting information (including age, occupation, place of birth, place of residence, and often identifying the parents and possibly spouse of the deceased) relating to a dead person and including a doctor's certification of the cause of death." .

fibo-fnd-aap-ppl:DeathCertificateIdentificationScheme a owl:Class ;
    rdfs:label "death certificate identification scheme",
        "死亡证明标识方案（death certificate identification scheme）"@zh ;
    rdfs:comment "为死亡证明分配标识符的体系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-fnd-aap-ppl:DeathCertificateIdentifier ],
        cmns-id:IdentificationScheme ;
    skos:definition "system for allocating identifiers to death certificates" ;
    cmns-av:explanatoryNote "Schemes for death certificate identification are typically regionally defined, and there may be jurisdiction-specific scope required as an additional restriction on a specific scheme." .

fibo-fnd-aap-ppl:DriversLicense a owl:Class ;
    rdfs:label "driver's license",
        "驾驶证（driver's license）"@zh ;
    rdfs:comment "声明某人可在公共道路上驾驶机动车辆（如摩托车、汽车、卡车或公共汽车）的官方文件。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DriversLicenseIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-aap-ppl:IdentityDocument ;
    skos:definition "an official document which states that a person may operate a motorized vehicle, such as a motorcycle, car, truck or a bus, on a public roadway or provides official identifying information for a non-driver" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Non-driver_identification_card#Non-driver_identification_cards"^^xsd:anyURI ;
    cmns-av:synonym "driving licence" .

fibo-fnd-aap-ppl:DriversLicenseIdentificationScheme a owl:Class ;
    rdfs:label "driver's license identification scheme",
        "驾驶证标识方案（driver's license identification scheme）"@zh ;
    rdfs:comment "为驾驶证、操作证或非驾驶身份证件分配标识符的体系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-fnd-aap-ppl:DriversLicenseIdentifier ],
        cmns-id:IdentificationScheme ;
    skos:definition "system for allocating identifiers to driver's, operating, or non-driver identification documents" ;
    cmns-av:explanatoryNote "Schemes for driver's license identification are typically regionally defined, and there may be jurisdiction-specific scope required as an additional restriction on a specific scheme." .

fibo-fnd-aap-ppl:LegallyCapableAdult a owl:Class ;
    rdfs:label "legally capable adult",
        "具有法律行为能力的成年人（legally capable adult）"@zh ;
    rdfs:comment "在某管辖区达到法定成年年龄、并获准以自己名义经营业务或从事其他职业的人。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:Adult ;
    skos:definition "person who has attained the age of majority as defined in some jurisdiction and who is allowed to conduct a business or any other occupation on his or her own behalf or for their own account" .

fibo-fnd-aap-ppl:Minor a owl:Class ;
    rdfs:label "minor",
        "未成年人（minor）"@zh ;
    rdfs:comment "低于某一年龄（通常是给定管辖区的法定成年年龄）的人，该年龄在法律上划分童年与成年。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:Person ;
    skos:definition "a person under a certain age, usually the age of majority in a given jurisdiction, which legally demarcates childhood from adulthood" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Minor_(law)"^^xsd:anyURI ;
    cmns-av:explanatoryNote "The age depends upon jurisdiction and application, but is generally 18." .

fibo-fnd-aap-ppl:NationalIdentificationNumberScheme a owl:Class ;
    rdfs:label "national identification number scheme",
        "国家身份号码方案（national identification number scheme）"@zh ;
    rdfs:comment "为国家身份号码分配标识符的体系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-fnd-aap-ppl:NationalIdentificationNumber ],
        cmns-id:IdentificationScheme ;
    skos:definition "system for allocating identifiers to national identification numbers" ;
    cmns-av:explanatoryNote "Schemes for national identification numbers are jurisdiction-specific by country." .

fibo-fnd-aap-ppl:PassportNumberIdentificationScheme a owl:Class ;
    rdfs:label "passport number identification scheme",
        "护照号码标识方案（passport number identification scheme）"@zh ;
    rdfs:comment "为护照分配标识符的体系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-fnd-aap-ppl:PassportNumber ],
        cmns-id:IdentificationScheme ;
    skos:definition "system for allocating identifiers to passports" ;
    cmns-av:explanatoryNote "Schemes for passport identification are jurisdiction-specific by country." .

fibo-fnd-aap-ppl:PersonName a owl:Class ;
    rdfs:label "person name",
        "人名（person name）"@zh ;
    rdfs:comment "某人在某情境中为人所知的指称。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-txt:Text ;
            owl:onProperty fibo-fnd-aap-ppl:hasSurname ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-txt:Text ;
            owl:onProperty fibo-fnd-aap-ppl:hasFullLegalName ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-txt:Text ;
            owl:onProperty fibo-fnd-aap-ppl:hasNamePrefix ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-txt:Text ;
            owl:onProperty fibo-fnd-aap-ppl:hasNameSuffix ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-aap-ppl:Person ;
            owl:onProperty cmns-dsg:isNameOf ],
        cmns-cxtdsg:ContextualName ;
    skos:definition "designation by which someone is known in some context" .

fibo-fnd-aap-ppl:hasAgeOfMajority a owl:ObjectProperty ;
    rdfs:label "has age of majority",
        "具有法定成年年龄（has age of majority）"@zh ;
    rdfs:comment "将某人关联到在某管辖区获得从事特定交易能力或被法律视为成年人所需的年龄。"@zh ;
    rdfs:range fibo-fnd-aap-ppl:AgeOfMajority ;
    rdfs:subPropertyOf fibo-fnd-dt-fd:hasAge ;
    skos:definition "relates someone to the age required to attain the capacity to engage in certain transactions or be treated legally as an adult in some jurisdiction" .

fibo-fnd-aap-ppl:hasCitizenship a owl:ObjectProperty ;
    rdfs:label "has citizenship",
        "具有国籍（has citizenship）"@zh ;
    rdfs:comment "将个人关联到其国籍国。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range cmns-loc:Country ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    skos:definition "links a person to their country of citizenship" .

fibo-fnd-aap-ppl:hasDateOfBirth a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has date of birth",
        "具有出生日期（has date of birth）"@zh ;
    rdfs:comment "标识个人出生的日期。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range fibo-fnd-aap-ppl:DateOfBirth ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "identifies the date on which an individual was born" .

fibo-fnd-aap-ppl:hasDateOfDeath a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has date of death",
        "具有死亡日期（has date of death）"@zh ;
    rdfs:comment "标识个人死亡的日期。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range fibo-fnd-aap-ppl:DateOfDeath ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "identifies the date on which an individual died" .

fibo-fnd-aap-ppl:hasFullLegalName a owl:DatatypeProperty ;
    rdfs:label "has full legal name",
        "具有完整法定姓名（has full legal name）"@zh ;
    rdfs:comment "标识个人的完整姓名，通常用于正式场合（包括法律或合同性质的场合）。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName,
        fibo-fnd-rel-rel:hasLegalName ;
    skos:definition "indicates the complete name of a person, typically used in formal situations including those of a legal or contractual nature" .

fibo-fnd-aap-ppl:hasGender a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has gender",
        "具有性别（has gender）"@zh ;
    rdfs:comment "将特定性别值与个人关联。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range xsd:string ;
    skos:definition "links a particular gender value with a person" .

fibo-fnd-aap-ppl:hasGivenName a owl:DatatypeProperty ;
    rdfs:label "has given name",
        "具有名（has given name）"@zh ;
    rdfs:comment "标识个人的名，即出生时为其选取或其后更改的名字。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    skos:definition "indicates the given name or first name of a person, that is, the name chosen for them at birth or changed by them subsequently from the name given at birth" .

fibo-fnd-aap-ppl:hasLastName a owl:DatatypeProperty ;
    rdfs:label "has last name",
        "具有姓（has last name）"@zh ;
    rdfs:comment "标识家庭成员共有的、区别于各成员名字的姓。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    owl:equivalentProperty fibo-fnd-aap-ppl:hasSurname ;
    skos:definition "indicates the name shared in common to identify the members of a family, as distinguished from each member's given name" .

fibo-fnd-aap-ppl:hasMinimumLegalWorkingAge a owl:ObjectProperty ;
    rdfs:label "has minimum legal working age",
        "具有最低法定工作年龄（has minimum legal working age）"@zh ;
    rdfs:comment "将某人关联到其居住管辖区的最低法定工作年龄。"@zh ;
    rdfs:range fibo-fnd-aap-ppl:LegalWorkingAge ;
    rdfs:subPropertyOf fibo-fnd-dt-fd:hasAge ;
    skos:definition "relates someone to the minimum legal working age for the jurisdiction in which they reside" .

fibo-fnd-aap-ppl:hasNamePrefix a owl:DatatypeProperty ;
    rdfs:label "has name prefix",
        "具有姓名前缀（has name prefix）"@zh ;
    rdfs:comment "标识位于个人姓名之前、提供其附加信息（如头衔、敬称或军衔）的字符或字符序列。"@zh ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "indicates a character or sequence of characters, preceding a person's name, that provides additional information about the person, such as a form of address representing a title, honorific, or military rank" .

fibo-fnd-aap-ppl:hasNameSuffix a owl:DatatypeProperty ;
    rdfs:label "has name suffix",
        "具有姓名后缀（has name suffix）"@zh ;
    rdfs:comment "标识位于个人姓名之后、提供其附加信息（如职位、学位、资格、官职或荣誉）的字符或字符序列。"@zh ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "indicates a character or sequence of characters, following a person's name, that provides additional information about the person, such as their position, educational degree, accreditation, office, or honor" .

fibo-fnd-aap-ppl:hasPlaceOfBirth a owl:ObjectProperty ;
    rdfs:label "has place of birth",
        "具有出生地（has place of birth）"@zh ;
    rdfs:comment "标识个人出生的位置。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range fibo-fnd-aap-ppl:PlaceOfBirth ;
    rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
    skos:definition "identifies the location where an individual was born" .

fibo-fnd-aap-ppl:hasPointOfContact a owl:ObjectProperty ;
    rdfs:label "has point of contact",
        "具有联络点（has point of contact）"@zh ;
    rdfs:comment "标识被指定为联络点的参与方。"@zh ;
    rdfs:range fibo-fnd-aap-ppl:Contact ;
    rdfs:subPropertyOf cmns-rlcmp:hasRole ;
    skos:definition "identifies a party designated as the point of contact for" .

fibo-fnd-aap-ppl:Adult a owl:Class ;
    rdfs:label "adult",
        "成年人（adult）"@zh ;
    rdfs:comment "在某管辖区达到法定成年年龄的人。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-aap-ppl:AgeOfMajority ;
            owl:onProperty fibo-fnd-aap-ppl:hasAgeOfMajority ],
        fibo-fnd-aap-ppl:Person ;
    skos:definition "person who has attained the age of majority as defined in some jurisdiction" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Adult"^^xsd:anyURI .

fibo-fnd-aap-ppl:AgeOfMajority a owl:Class ;
    rdfs:label "age of majority",
        "法定成年年龄（age of majority）"@zh ;
    rdfs:comment "在某管辖区获得成年人权利与责任的年龄。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:LegalAge ;
    skos:definition "age at which someone acquires the rights and responsibilities of an adult in some jurisdiction" .

fibo-fnd-aap-ppl:BirthCertificateIdentifier a owl:Class ;
    rdfs:label "birth certificate identifier",
        "出生证明标识符（birth certificate identifier）"@zh ;
    rdfs:comment "与记录儿童出生的生命统计记录关联的标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:BirthCertificate ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:BirthCertificateIdentificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "identifier associated with a vital record documenting the birth of a child" ;
    cmns-av:synonym "birth certificate number" .

fibo-fnd-aap-ppl:DateOfBirth a owl:Class ;
    rdfs:label "date of birth",
        "出生日期（date of birth）"@zh ;
    rdfs:comment "个人出生的显式日期（年、月、日）。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "explicit date, i.e., the day, month and year, on which an individual was born" ;
    cmns-av:synonym "birth date",
        "birthday" .

fibo-fnd-aap-ppl:DateOfDeath a owl:Class ;
    rdfs:label "date of death",
        "死亡日期（date of death）"@zh ;
    rdfs:comment "个人死亡的显式日期（年、月、日）。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "explicit date, i.e., the day, month and year, on which an individual died" ;
    cmns-av:synonym "death date" .

fibo-fnd-aap-ppl:DeathCertificateIdentifier a owl:Class ;
    rdfs:label "death certificate identifier",
        "死亡证明标识符（death certificate identifier）"@zh ;
    rdfs:comment "与记录个人死亡的生命统计记录关联的标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DeathCertificateIdentificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DeathCertificate ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "identifier associated with a vital record documenting the death of an individual" ;
    cmns-av:synonym "death certificate number" .

fibo-fnd-aap-ppl:DriversLicenseIdentifier a owl:Class ;
    rdfs:label "driver's license identifier",
        "驾驶证标识符（driver's license identifier）"@zh ;
    rdfs:comment "与机动车驾驶执照或非驾驶身份卡关联的标识符。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DriversLicenseIdentificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DriversLicense ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "identifier associated with a drivers' or operating license for operating a motor vehicle or non-driver identification card" ;
    cmns-av:synonym "driver's license number" .

fibo-fnd-aap-ppl:LegalAge a owl:Class ;
    rdfs:label "legal age",
        "法定年龄（legal age）"@zh ;
    rdfs:comment "在某管辖区获得做法律此前禁止之事的能力的年龄。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ;
            owl:someValuesFrom cmns-rga:Jurisdiction ],
        fibo-fnd-dt-fd:Age ;
    skos:definition "age at which someone acquires the capacity to do something that they were prohibited from doing before under the law in some jurisdiction" .

fibo-fnd-aap-ppl:LegalWorkingAge a owl:Class ;
    rdfs:label "legal working age",
        "法定工作年龄（legal working age）"@zh ;
    rdfs:comment "在某管辖区获得合法工作能力的年龄。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:LegalAge ;
    skos:definition "age at which someone acquires the capacity to work legally in some jurisdiction" .

fibo-fnd-aap-ppl:NationalIdentificationNumber a owl:Class ;
    rdfs:label "national identification number",
        "国家身份号码（national identification number）"@zh ;
    rdfs:comment "出现在由国家或管辖区签发的身份证件上的号码或文字。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:Person ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:NationalIdentificationNumberScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "number or text which appears on an identity document issued by a country or jurisdiction" ;
    cmns-av:adaptedFrom "http://en.wikipedia.org/wiki/National_identification_number"^^xsd:anyURI ;
    cmns-av:explanatoryNote """A national identification number, national identity number, or national insurance number is used by the governments of many countries as a means of tracking their citizens, permanent residents, and temporary residents for the purposes of work, taxation, government benefits, health care, and other governmentally-related functions. The number will appear on an identity document issued by a country.

The ways in which such a system is implemented are dependent on the country, but in most cases, a citizen is issued an identification number at birth or when they reach a legal age (typically the age of 18). Non-citizens may be issued such numbers when they enter the country, or when granted a temporary or permanent residence permit.

Many countries issued such numbers ostensibly for a singular purpose, but over time, they become a de facto national identification number. For example, the United States originally developed its Social Security number system as a means of disbursing Social Security benefits. However, due to function creep, the number has become utilized for other purposes to the point where it is almost essential to have one to, among other things, open a bank account, obtain a credit card, or drive a car.""" ;
    cmns-av:synonym "national identity number" .

fibo-fnd-aap-ppl:PassportNumber a owl:Class ;
    rdfs:label "passport number",
        "护照号码（passport number）"@zh ;
    rdfs:comment "与护照关联的国家身份号码。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:PassportNumberIdentificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-aap-ppl:NationalIdentificationNumber ;
    skos:definition "national identification number associated with a passport" .

fibo-fnd-aap-ppl:PlaceOfBirth a owl:Class ;
    rdfs:label "place of birth",
        "出生地（place of birth）"@zh ;
    rdfs:comment "个人出生的物理位置，包括国家、地区和市政区。"@zh ;
    rdfs:subClassOf cmns-loc:PhysicalLocation ;
    skos:definition "physical location, including country, region, and municipality where an individual was born" ;
    cmns-av:synonym "birth place" .

fibo-fnd-aap-ppl:hasResidence a owl:ObjectProperty ;
    rdfs:label "has residence",
        "具有居所（has residence）"@zh ;
    rdfs:comment "标识个人居住的住所。"@zh ;
    rdfs:domain fibo-fnd-aap-ppl:Person ;
    rdfs:range fibo-fnd-plc-adr:ConventionalStreetAddress ;
    rdfs:subPropertyOf fibo-fnd-plc-adr:hasAddress ;
    skos:definition "identifies a dwelling where an individual lives" .

fibo-fnd-aap-ppl:Contact a owl:Class ;
    rdfs:label "contact",
        "联系人（contact）"@zh ;
    rdfs:comment "作为指定联络点的参与方所扮演的角色，通常在某个系统或过程中。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:someValuesFrom fibo-fnd-pty-pty:PartyRoleIdentifier ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom cmns-pts:Party ],
        [ a owl:Restriction ;
            owl:onProperty cmns-dsg:isSignifiedBy ;
            owl:someValuesFrom fibo-fnd-aap-ppl:ContactRecord ],
        cmns-pts:PartyRole ;
    skos:definition "role or associated with a party serving as a designated point of communication, typically within a system or process" .

fibo-fnd-aap-ppl:hasSurname a owl:DatatypeProperty ;
    rdfs:label "has surname",
        "具有姓（has surname）"@zh ;
    rdfs:comment "标识家庭成员共有的、区别于各成员名字的姓。"@zh ;
    rdfs:subPropertyOf fibo-fnd-aap-ppl:hasPersonName ;
    skos:definition "indicates the name shared in common to identify the members of a family, as distinguished from each member's given name" .

fibo-fnd-aap-ppl:IdentityDocument a owl:Class ;
    rdfs:label "identity document",
        "身份证件（identity document）"@zh ;
    rdfs:comment "可用于核验个人身份各个方面的任何法律文件。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cmns-dt:Date ;
            owl:onProperty cmns-dt:hasDateOfIssuance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass cmns-dt:Date ;
            owl:onProperty fibo-fnd-arr-doc:hasExpirationDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass cmns-id:Identifier ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty cmns-id:identifies ;
            owl:someValuesFrom fibo-fnd-aap-ppl:Person ],
        cmns-doc:LegalDocument ;
    skos:definition "any legal document which may be used to verify aspects of a person's identity" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Identification_card"^^xsd:anyURI ;
    cmns-av:explanatoryNote "If issued in the form of a small, mostly standard-sized card, it is usually called an identity card (IC). Countries which do not have formal identity documents may require informal documents. In the absence of a formal identity document, driving licenses can be used in many countries as a method of proof of identity, although some countries do not accept driving licenses for identification, often because in those countries they don't expire as documents and can be old and easily forged. Most countries accept passports as a form of identification. Most countries have the rule that foreign citizens need to have their passport or occasionally a national identity card from their country available at any time if they do not have residence permit in the country." ;
    cmns-av:synonym "identity card" .

fibo-fnd-aap-ppl:hasPersonName a owl:DatatypeProperty ;
    rdfs:label "has person name",
        "具有人名（has person name）"@zh ;
    rdfs:comment "将名称关联到个人。"@zh ;
    rdfs:subPropertyOf cmns-dsg:hasTextualName ;
    skos:definition "links a name to an individual" ;
    cmns-av:explanatoryNote "Note that the concept of a person name may include symbology as long as the symbols are properly encoded. Because person name is a class, other iconography or symbology that cannot be encoded in UTF-8 can, alternatively, be linked or attached as a separate image or in another form." .

fibo-fnd-aap-ppl:Person a owl:Class ;
    rdfs:label "person"@en,
        "个人（person）"@zh ;
    rdfs:comment "具有自我意识的个体人类。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-loc:Country ;
            owl:onProperty fibo-fnd-aap-ppl:hasCitizenship ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-aap-ppl:PersonName ;
            owl:onProperty cmns-dsg:hasName ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-aap-ppl:DateOfDeath ;
            owl:onProperty fibo-fnd-aap-ppl:hasDateOfDeath ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-plc-adr:ConventionalStreetAddress ;
            owl:onProperty fibo-fnd-aap-ppl:hasResidence ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:DateOfBirth ;
            owl:onProperty fibo-fnd-aap-ppl:hasDateOfBirth ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-dt-fd:Age ;
            owl:onProperty fibo-fnd-dt-fd:hasAge ],
        [ a owl:Restriction ;
            owl:onClass fibo-fnd-aap-ppl:PlaceOfBirth ;
            owl:onProperty fibo-fnd-aap-ppl:hasPlaceOfBirth ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty fibo-fnd-aap-ppl:hasGender ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-pts:Party ;
    skos:definition "individual human being, with consciousness of self" ;
    cmns-av:synonym "natural person" .

