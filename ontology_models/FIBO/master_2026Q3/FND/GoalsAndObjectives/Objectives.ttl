@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-cxtid: <https://www.omg.org/spec/Commons/ContextualIdentifiers/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-fnd-gao-obj: a owl:Ontology ;
    rdfs:label "Objectives Ontology",
        "目标本体（Objectives Ontology）"@zh ;
    dcterms:abstract "This ontology defines concepts including goal, objective, program, and strategy. Objectives are defined as being distinct from goals, in that they constitute time limited and measurable targets which some entity may seek to attain in pursuit of its goals." ;
    dcterms:license """Copyright (c) 2013-2025 EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义目标（objective）及其与组织、计划的关系，用于表达机构的经营目标与投资目标。"@zh ;
    owl:imports fibo-fnd-dt-oc:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-col:,
        cmns-cxtdsg:,
        cmns-cxtid:,
        cmns-dt:,
        cmns-dsg:,
        cmns-id:,
        cmns-pts: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/FND/20251201/GoalsAndObjectives/Objectives/> ;
    skos:changeNote """The http://www.omg.org/spec/FIBO/Foundations/20130601/GoalsAndObjectives/Objectives.owl version of the ontology was revised in advance of the September 2013 New Brunswick, NJ meeting, as follows:
	(1) to use slash style URI/IRIss (also called 303 URIs, vs. hash style) as required to support server side processing 
	(2) to use version-independent IRIs for all definitions internally as opposed to version-specific IRIs
	(3) to change the file suffix from .owl to .rdf to increase usability in RDF tools
	(4) to use 4-level abbreviations and corresponding namespace prefixes for all FIBO ontologies, reflecting a family/specification/module/ontology structure
	(5) to incorporate changes to the specification metadata to support documentation at the family, specification, module, and ontology level, similar to the abbreviations
	(6) to eliminate an unnecessary hasObjectives property and related imports dependencies.""",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20130801/GoalsAndObjectives/Objectives.rdf version of this ontology was modified per the issue resolutions identified in the FIBO FND 1.0 FTF report and in https://spec.edmcouncil.org/fibo/ontology/FND/1.0/AboutFND-1.0/.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20180801/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to integrate concepts such as investment objective, business objective, strategy, and related properties.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20190401/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to integrate concepts such as distribution and sales strategy, and to eliminate duplication of concepts in LCC.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20200201/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to add the concept of a program, required for IND but also to represent compliance, and other kinds of programs.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20201101/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to address hygiene issues with respect to text formatting.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20220701/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to add the property 'has strategy' for use in linking to pricing, quotation, distribution, delivery, and other strategies or methods.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20221001/GoalsAndObjectives/Objectives.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary and eliminate unnecessary references to LCC.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20230101/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC), eliminating redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20230301/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to add the concept of a project and related attributes (LOAN-169).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20241101/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to add the concept of a method (SEC-200) and add nonprofit investment objectives (SEC-208).",
        "The https://spec.edmcouncil.org/fibo/ontology/FND/20250901/GoalsAndObjectives/Objectives.rdf version of this ontology was modified to add a parent concept for goal and objective, and a parent concept for strategy and method, and adjust definitions accordingly (FND-402) and add the concept of a study (FND-400)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2013-2025 EDM Council, Inc.",
        "Copyright (c) 2013-2025 Object Management Group, Inc." .

fibo-fnd-gao-obj:DistributionStrategy a owl:Class ;
    rdfs:label "distribution strategy",
        "分配策略（distribution strategy）"@zh ;
    rdfs:comment "使产品或服务可获得、或分配资金（如以股息或票息形式）的策略。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:Strategy ;
    skos:definition "strategy for making a product or service available, or for distributing funds, such as in the form of a dividend or coupon" .

fibo-fnd-gao-obj:LocalInvestmentObjective a owl:Class ;
    rdfs:label "local investment objective",
        "本地投资目标（local investment objective）"@zh ;
    rdfs:comment "旨在支持地理上集中的社区发展需求的财务目标。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:InvestmentObjective ;
    skos:definition "financial objective that aims to support geographically centralized, community development needs" .

fibo-fnd-gao-obj:SalesStrategy a owl:Class ;
    rdfs:label "sales strategy",
        "销售策略（sales strategy）"@zh ;
    rdfs:comment "销售某事物的策略，包括为销售过程分配资源、降低成本和优化收入。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:BusinessStrategy ;
    skos:definition "strategy for selling something, including allocating resources to the sales process, reducing costs, and optimizing revenues" .

fibo-fnd-gao-obj:Study a owl:Class ;
    rdfs:label "study",
        "研究（study）"@zh ;
    rdfs:comment "调查特定关注领域以确定其特性、关系、约束或影响的分析活动。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Goal ;
            owl:onProperty fibo-fnd-gao-obj:hasGoal ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-cxtdsg:Context ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        cmns-pts:Situation ;
    skos:definition "analytical activity that investigates a specified area of interest, to determine its characteristics, relationships, constraints, or implications" ;
    cmns-av:explanatoryNote "Studies involve exploration, analysis, sometimes modeling, and sometimes evaluation, but are not necessarily focused on evaluation and may or may not be criteria-based, which distinguishes it from the concept of an assessment. In a business context, a study might map capabilities, analyze value streams, or model information flows. Only some studies produce an assessment (e.g., capability maturity assessment). A clinical research study may observe, test, or model phenomena, and may or may not result in a clinical or risk assessment. A study conducted as part of a project or larger programme may explore feasibility, options, impacts, or requirements."@en .

fibo-fnd-gao-obj:TripleBottomLineObjective a owl:Class ;
    rdfs:label "triple bottom line objective",
        "三重底线目标（triple bottom line objective）"@zh ;
    rdfs:comment "将经济绩效、环境管理和社会责任作为同等成功标准加以整合的财务目标。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:InvestmentObjective ;
    skos:definition "financial objective that integrates economic performance, environmental stewardship, and social responsibility as co-equal criteria for success" .

fibo-fnd-gao-obj:hasStrategy a owl:ObjectProperty ;
    rdfs:label "has strategy",
        "具有战略（has strategy）"@zh ;
    rdfs:comment "应用战略。"@zh ;
    rdfs:range fibo-fnd-gao-obj:Strategy ;
    rdfs:subPropertyOf cmns-cxtdsg:uses ;
    skos:definition "applies strategy" .

fibo-fnd-gao-obj:usesMethod a owl:ObjectProperty ;
    rdfs:label "uses method",
        "使用方法（uses method）"@zh ;
    rdfs:comment "运用方法。"@zh ;
    rdfs:range fibo-fnd-gao-obj:Method ;
    rdfs:subPropertyOf cmns-cxtdsg:uses ;
    skos:definition "employs method" .

fibo-fnd-gao-obj:BusinessObjective a owl:Class ;
    rdfs:label "business objective",
        "业务目标（business objective）"@zh ;
    rdfs:comment "反映企业在一定时间框架和可用资源内的战略目标与方向的目标。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:Objective ;
    skos:definition "objective that reflects the strategic goals and direction of a business within a time frame and available resources" ;
    cmns-av:explanatoryNote "Business objectives allow an organization to define its goals and direction. A company uses strategy and tactics at every level of its operation to achieve its objectives. These define the way a company allocates its resources and the strengths, weaknesses and opportunities it may have. Companies usually do not alter their objectives once they are implemented, unless changes in circumstances arise. Setting a clear course for the organization is key to its success.",
        "In general, objectives are more specific and easier to measure than goals. Objectives are basic tools that underlie all planning and strategic activities. They serve as the basis for creating policy and evaluating performance. Some examples of business objectives include minimizing expenses, expanding internationally, or making a profit." .

fibo-fnd-gao-obj:BusinessStrategy a owl:Class ;
    rdfs:label "business strategy",
        "业务战略（business strategy）"@zh ;
    rdfs:comment "实现特定业务目标、目的、解决方案或结果的战略。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ;
            owl:someValuesFrom fibo-fnd-gao-obj:BusinessObjective ],
        fibo-fnd-gao-obj:Strategy ;
    skos:definition "strategy for achieving a specific business goal, objective, solution or outcome" .

fibo-fnd-gao-obj:FinancialObjective a owl:Class ;
    rdfs:label "financial objective",
        "财务目标（financial objective）"@zh ;
    rdfs:comment "反映参与方在一定时间框架和可用资源内的战略财务目标与方向的目标。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:Objective ;
    skos:definition "objective that reflects the strategic financial goals and direction of a party within a time frame and available resources" .

fibo-fnd-gao-obj:Method a owl:Class ;
    rdfs:label "method",
        "方法（method）"@zh ;
    rdfs:comment "以系统化、可重复的程序和操作上的明确性为特征的途径，由明确的步骤组成。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:Approach ;
    skos:definition "approach distinguished by systematic, repeatable procedures and operational specificity for doing or calculating something, consisting of defined steps or rules to achieve a result" .

fibo-fnd-gao-obj:ProgramIdentifier a owl:Class ;
    rdfs:label "programme identifier"@en-GB,
        "program identifier"@en-US,
        "项目群标识符（ProgramIdentifier）"@zh ;
    rdfs:comment "在项目群被管理的情境内唯一标识特定项目群的字符序列。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-id:identifies ;
            owl:someValuesFrom fibo-fnd-gao-obj:Program ],
        cmns-cxtid:ContextualIdentifier ;
    skos:definition "sequence of characters uniquely identifying a specific program within the context in which that program is administered" .

fibo-fnd-gao-obj:ProgramName a owl:Class ;
    rdfs:label "programme name"@en-GB,
        "program name"@en-US,
        "项目群名称（ProgramName）"@zh ;
    rdfs:comment "项目群在其被管理情境内的情境化指称。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:isNameOf ;
            owl:someValuesFrom fibo-fnd-gao-obj:Program ],
        cmns-cxtdsg:ContextualName ;
    skos:definition "contextual designation for a program within the context in which that program is administered" .

fibo-fnd-gao-obj:ProjectIdentifier a owl:Class ;
    rdfs:label "project identifier",
        "项目标识符（project identifier）"@zh ;
    rdfs:comment "在项目或其所属项目群被管理的情境内唯一标识特定项目的字符序列。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-id:identifies ;
            owl:someValuesFrom fibo-fnd-gao-obj:Project ],
        cmns-cxtid:ContextualIdentifier ;
    skos:definition "sequence of characters uniquely identifying a specific project within the context in which that project or an overarching program is administered" .

fibo-fnd-gao-obj:ProjectName a owl:Class ;
    rdfs:label "project name",
        "项目名称（project name）"@zh ;
    rdfs:comment "项目的情境化指称。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:isNameOf ;
            owl:someValuesFrom fibo-fnd-gao-obj:Project ],
        cmns-cxtdsg:ContextualName ;
    skos:definition "contextual designation for a project" .

fibo-fnd-gao-obj:isAddressedBy a owl:ObjectProperty ;
    rdfs:label "is addressed by",
        "由……应对（is addressed by）"@zh ;
    rdfs:comment "标识被……处理的事物，如愿景或目标。"@zh ;
    owl:inverseOf fibo-fnd-gao-obj:addresses ;
    skos:definition "indicates something, such a goal or objective, that is dealt with by" .

fibo-fnd-gao-obj:InvestmentObjective a owl:Class ;
    rdfs:label "investment objective",
        "投资目标（investment objective）"@zh ;
    rdfs:comment "投资者用于判断某项潜在投资是否适合自己或代表他人的财务目标。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:FinancialObjective ;
    skos:definition "financial objective used by an investor to determine whether or not a given potential investment is appropriate for themselves or on behalf of another party" ;
    skos:example "An investor whose objective is capital growth might choose to invest in more aggressive, growth-oriented mutual funds and/or stocks, over income-generating mutual funds and/or bonds." ;
    cmns-av:explanatoryNote "The combination of investment objectives and risk tolerance are typically used to identify appropriate investment options." .

fibo-fnd-gao-obj:addresses a owl:ObjectProperty ;
    rdfs:label "addresses",
        "应对（addresses）"@zh ;
    rdfs:comment "处理、处置或关注。"@zh ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:involves ;
    skos:definition "deals with, handles, or gives attention to" .

fibo-fnd-gao-obj:Aim a owl:Class ;
    rdfs:label "aim",
        "意向（aim）"@zh ;
    rdfs:comment "指明代理行动所指向的期望方向、状况或情形的意图，不要求精确的范围或可测性。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Approach ;
            owl:onProperty fibo-fnd-gao-obj:isAddressedBy ] ;
    skos:definition "intention specifying a desired direction, condition, or situation toward which an agent's actions are directed, without requiring precise scope or measurable criteria" ;
    cmns-av:explanatoryNote "Business aims are sometimes considered broad, long-term goals, and in such cases, the term 'aim' is used interchangeably with goal. Here, however we differentiate between qualitative goals and quantitative objectives, both of which are kinds of aims, with the critical differences including measurability and time frame. Goals tend to have a much longer trajectory, provide the basis for determining objectives, and are often aligned with an organization's mission, whereas objectives are short term and measurable." .

fibo-fnd-gao-obj:Approach a owl:Class ;
    rdfs:label "approach",
        "途径（approach）"@zh ;
    rdfs:comment "应对意向或问题的方式，以高层规划和系统化执行为特征，不预设范围或粒度。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Aim ;
            owl:onProperty fibo-fnd-gao-obj:addresses ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Objective ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ] ;
    skos:definition "way of addressing an aim or problem characterized by high-level planning and systematic execution, without presupposing scope or granularity" .

fibo-fnd-gao-obj:Program a owl:Class ;
    rdfs:label "programme"@en-GB,
        "program"@en-US,
        "项目群（Program）"@zh ;
    rdfs:comment "为获得单独管理所无法获得的收益而设计的事务状态与协调活动集。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Project ;
            owl:onProperty cmns-col:hasMember ],
        [ a owl:Restriction ;
            owl:onProperty cmns-dsg:hasDescription ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Objective ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:ProgramName ;
            owl:onProperty cmns-dsg:hasName ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:ProgramIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Goal ;
            owl:onProperty fibo-fnd-gao-obj:hasGoal ],
        cmns-pts:Situation ;
    skos:definition "state of affairs and coordinated set of activities designed to obtain benefits not available from managing them individually" ;
    cmns-av:adaptedFrom "https://www.prince2.com/usa/blog/project-vs-programme"^^xsd:anyURI .

fibo-fnd-gao-obj:Project a owl:Class ;
    rdfs:label "project",
        "项目（project）"@zh ;
    rdfs:comment "为交付有形产出而设计的事务状态及独特而临时的组织。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:ProjectIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Objective ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty fibo-fnd-dt-oc:hasOutput ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty fibo-fnd-dt-oc:hasInput ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:ProjectName ;
            owl:onProperty cmns-dsg:hasName ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Program ;
            owl:onProperty cmns-col:isMemberOf ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Goal ;
            owl:onProperty fibo-fnd-gao-obj:hasGoal ],
        [ a owl:Restriction ;
            owl:onProperty cmns-dsg:hasDescription ;
            owl:someValuesFrom xsd:string ],
        cmns-pts:Situation ;
    skos:definition "state of affairs and unique and temporary organization, designed to deliver a tangible output" ;
    cmns-av:adaptedFrom "https://www.prince2.com/usa/blog/project-vs-programme"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A project has a fixed - generally fairly short - timeframe, and a project manager is responsible for delivering the output on time and on budget."@en .

fibo-fnd-gao-obj:Strategy a owl:Class ;
    rdfs:label "strategy",
        "战略（strategy）"@zh ;
    rdfs:comment "指导决策并协调行动与计划以追求某意向的高层途径。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Goal ;
            owl:onProperty fibo-fnd-gao-obj:hasGoal ],
        fibo-fnd-gao-obj:Approach ;
    skos:definition "high-level approach that guides decision-making and the coordination of actions and plans in pursuit of some aim" ;
    cmns-av:explanatoryNote "A strategy is a high-level plan or approach designed to achieve a long-term goal or outcome, often by choosing among different possible methods or courses of action. A strategy may involve activities that are needed in order to achieve specific goals or objectives. It may take into account one or more policies or any number of restrictions and constraints. Strategies are typically distinguished by long-term orientation, adaptive planning, and broad scope."@en .

fibo-fnd-gao-obj:hasGoal a owl:ObjectProperty ;
    rdfs:label "has goal",
        "具有愿景（has goal）"@zh ;
    rdfs:comment "具有长期的期望结果。"@zh ;
    rdfs:range fibo-fnd-gao-obj:Goal ;
    skos:definition "has long-term, desired outcome" .

fibo-fnd-gao-obj:hasObjective a owl:ObjectProperty ;
    rdfs:label "has objective",
        "具有目标（has objective）"@zh ;
    rdfs:comment "旨在一定时间框架内、以可用资源达成。"@zh ;
    rdfs:range fibo-fnd-gao-obj:Objective ;
    skos:definition "aims to achieve within a time frame and with available resources" .

fibo-fnd-gao-obj:Goal a owl:Class ;
    rdfs:label "goal",
        "愿景（goal）"@zh ;
    rdfs:comment "以宽泛范围和抱负性质为特征的意向，常为定性的、长期的，用以达成某种期望状态。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:Aim ;
    skos:definition "aim distinguished by broad scope and aspirational character, often qualitative and long-term, in order to achieve a desired state" ;
    cmns-av:explanatoryNote "Many people endeavor to reach goals within a finite time by setting deadlines." .

fibo-fnd-gao-obj:Objective a owl:Class ;
    rdfs:label "objective",
        "目标（objective）"@zh ;
    rdfs:comment "以具体范围和可测标准为特征的意向，常为定量的、短期的，参与方寻求达成它。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-dt:DatePeriod ;
            owl:onProperty cmns-dt:hasDatePeriod ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-gao-obj:Goal ;
            owl:onProperty cmns-cxtdsg:appliesTo ],
        fibo-fnd-gao-obj:Aim ;
    skos:definition "aim distinguished by specific scope and measurable criteria, often quantitative and short-term that a party seeks to attain, typically in order to achieve its long-term goals" .

