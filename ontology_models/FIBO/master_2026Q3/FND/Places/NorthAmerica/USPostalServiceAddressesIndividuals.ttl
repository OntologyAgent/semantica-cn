        lcc-3166-1:UnitedStatesOfAmerica ;
    cmns-dsg:denotes lcc-3166-2-ca:Alberta ;
    cmns-dsg:hasTag "AB" ;
    cmns-id:identifies lcc-3166-2-ca:Alberta .

