@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-ind-ir-cm: <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/CommonInterestRates/> .
@prefix fibo-ind-ir-mdp: <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/MarketDataProviders/> .
@prefix fibo-indrr-all: <https://spec.edmcouncil.org/fibo/ontology/IND/AllIND-ReferenceRates/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-indrr-all: a owl:Ontology ;
    rdfs:label "Indices and Indicators Domain, Reference Rates",
        "IND 域参考利率入口（All IND, Reference Rates）"@zh ;
    dcterms:abstract "The FIBO Indices and Indicators (IND) Domain covers market indices and reference rates including economic indicators, foreign exchange, interest rates, and other benchmarks. The ontologies cover quoted interest rates, economic measures such as employment rates, and quoted indices required to support baskets of securities, including specific kinds of securities in share indices or bond indices, as well as credit indices." ;
    dcterms:contributor "88 Solutions",
        "Adaptive, Inc.",
        "Bank of New York Mellon",
        "Bloomberg LP",
        "Bureau of Economic Analysis (BEA, US Department of Commerce)",
        "Bureau of Labor Statistics (BLS, US Department of Commerce)",
        "Census Bureau (US Department of Commerce)",
        "Citigroup",
        "Dassault Systemes/No Magic",
        "Deutsche Bank",
        "Federal Reserve Bank of Kansas City",
        "HP Enterprise / Mphasis",
        "John F. Gemski",
        "John F. Tierney",
        "Nordea Bank AB",
        "Office of Financial Research (OFR), U.S. Department of the Treasury",
        "Pinnacle Bank (Morgan Hill, California)",
        "State Street Bank and Trust",
        "Statistics Canada",
        "Tahoe Blue Ltd",
        "Thematix Partners LLC",
        "Wells Fargo Bank, N. A.",
        "agnos.ai UK Ltd" ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "https://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-02-06T18:00:00"^^xsd:dateTime ;
    dcterms:title "Financial Industry Business Ontology (FIBO) Indices and Indicators (IND) Domain, Reference Rates" ;
    rdfs:comment "聚合市场常用参考利率的个体本体（各期限基准及发布机构），供需要利率主数据的场景加载。"@zh ;
    rdfs:seeAlso <https://www.edmcouncil.org/fibo/> ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/FBC/AllFBC-EuropeAndNorthAmerica/>,
        <https://spec.edmcouncil.org/fibo/ontology/IND/AllIND-NorthAmerica/>,
        fibo-ind-ir-cm:,
        fibo-ind-ir-mdp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/IND/20230201/AllIND-ReferenceRates/> ;
    cmns-av:copyright "Copyright (c) 2014-2023 EDM Council, Inc.",
        "Copyright (c) 2014-2023 Object Management Group, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for IND with Reference Rates is provided for convenience for FIBO users. It imports all of the Production (Released) ontologies that comprise the FIBO Foundations (FND), Business Entities (BE), Financial Business and Commerce (FBC), and Indices and Indicators (IND) domains, including all individuals (aside from examples), with additional FpML reference rates by currency." .

