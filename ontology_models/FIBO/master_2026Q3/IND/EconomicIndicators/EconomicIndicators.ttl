@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-loc: <https://www.omg.org/spec/Commons/Locations/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix cmns-rga: <https://www.omg.org/spec/Commons/RegulatoryAgencies/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-fct-fct: <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/> .
@prefix fibo-be-fct-pub: <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/> .
@prefix fibo-be-ge-ge: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-aap-ppl: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-arr-cls: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/> .
@prefix fibo-fnd-arr-doc: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-fnd-pas-pas: <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/> .
@prefix fibo-fnd-plc-adr: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/> .
@prefix fibo-fnd-utl-alx: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-ind-ei-ei: <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/> .
@prefix fibo-ind-ind-ind: <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-ind-ei-ei: a owl:Ontology ;
    rdfs:label "Economic Indicators Ontology",
        "经济指标本体（Economic Indicators Ontology）"@zh ;
    dcterms:abstract "This ontology provides the parameters which make up the various types of market economic indicators, along with basic facts about these such as the economies or countries they apply to." ;
    dcterms:license """Copyright (c) 2014-2025 EDM Council, Inc.
Copyright (c) 2014-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义宏观经济指标（GDP、CPI、失业率等）的通用结构：发布机构、发布频率与数值。"@zh ;
    owl:imports fibo-be-fct-fct:,
        fibo-be-fct-pub:,
        fibo-be-ge-ge:,
        fibo-be-le-lp:,
        fibo-fbc-fi-fi:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-aap-ppl:,
        fibo-fnd-arr-cls:,
        fibo-fnd-arr-doc:,
        fibo-fnd-dt-fd:,
        fibo-fnd-dt-oc:,
        fibo-fnd-plc-adr:,
        fibo-fnd-pas-pas:,
        fibo-fnd-utl-alx:,
        fibo-fnd-utl-av:,
        fibo-ind-ind-ind:,
        cmns-av:,
        cmns-cls:,
        cmns-col:,
        cmns-cxtdsg:,
        cmns-dt:,
        cmns-doc:,
        cmns-loc:,
        cmns-org:,
        cmns-pts:,
        cmns-qtu:,
        cmns-rga:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/IND/20250701/EconomicIndicators/EconomicIndicators/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/IND/20140601/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified per the issue resolutions identified in the FIBO IND 1.0 FTF 1 report.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20150501/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified per the issue resolutions identified in the FIBO IND 1.0 FTF 3 report.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20160801/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified per the FIBO 2.0 RFC. Primary changes include the addition of a number of statistical measures (mean, total, etc.) and their use in existing and new indicators, and the addition of several more economic indicators.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20180801/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to use natural person rather than legally capable person.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20181101/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to use hasCoverageArea rather than appliesTo in the restriction on an economic indicator relating it to a statistical area, to reflect use of actualExpression as an annotation rather than datatype property, and to migrate the general statistics concepts to FND (deprecated herein).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20190501/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20190901/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to eliminate duplicatation with concepts in LCC and merge countries with locations in FND.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20200301/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to reflect the change in name and definition of numeric index to numeric index value in FND.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20200401/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to add definitions for alternative unemployment calculations and correct a circular property definition.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20200901/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to eliminate references to external dictionary sites that no longer resolve, added a synonym to fixed basket and eliminated the restriction with respect to date period, which is not the primary concern of a fixed basket, revised the name of the 'goods or services population' to 'goods population' to eliminate a hygiene issue and reflect the synonym of 'basket of goods', and merged the statistical information publisher class from economic indicator publishers into this ontology.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/2021001/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to fix spelling errors.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20210301/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to eliminate the restriction on economic indicator (and its subclasses) that it has an indicator value - the restriction should be on the quantity value such that the value refers to the indicator it represents, and to revise the definition of civilian non-institutional population to correctly represent civilian non-institutional person (added).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20211201/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to address text formatting hygiene issues and clean up external links.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20220801/EconomicIndicators/EconomicIndicators.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20230201/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC), eliminating redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20230301/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to replace content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20231201/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.1 (FND-380).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20240101/EconomicIndicators/EconomicIndicators.rdf version of this ontology was modified to eliminate punning in the use of several indicators, eliminate 'obsolete' restrictions through refinement, and normalize certain definitions to be ISO 704 compliant (GitHub-2038 and GitHub-2028).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20240901/EconomicIndicators/EconomicIndicators.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/IND/20250301/EconomicIndicators/EconomicIndicators.rdf version of the ontology was modified to replace hasConstituent with hasMember for better semantic consistency (FND-396)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2014-2025 EDM Council, Inc.",
        "Copyright (c) 2014-2025 Object Management Group, Inc." .

fibo-ind-ei-ei:AverageDailyEarnings a owl:Class ;
    rdfs:label "average daily earnings",
        "平均日收入（average daily earnings）"@zh ;
    rdfs:comment "雇员在报告期内的平均日工资度量。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-ind-ei-ei:Daily ;
            owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ],
        fibo-ind-ei-ei:AverageEarnings ;
    skos:definition "measure of the average daily wage an employee makes over the reporting period" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI .

fibo-ind-ei-ei:AverageHourlyEarnings a owl:Class ;
    rdfs:label "average hourly earnings",
        "平均时薪（average hourly earnings）"@zh ;
    rdfs:comment "雇员在报告期内的平均小时工资度量。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-ind-ei-ei:Hourly ;
            owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ],
        fibo-ind-ei-ei:AverageEarnings ;
    skos:definition "measure of the average hourly wage an employee makes over the reporting period" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI .

fibo-ind-ei-ei:AverageMonthlyEarnings a owl:Class ;
    rdfs:label "average monthly earnings",
        "平均月收入（average monthly earnings）"@zh ;
    rdfs:comment "雇员在报告期内的平均月工资度量。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-ind-ei-ei:Monthly ;
            owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ],
        fibo-ind-ei-ei:AverageEarnings ;
    skos:definition "measure of the average monthly wage an employee makes over the reporting period" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI .

fibo-ind-ei-ei:AverageWeeklyEarnings a owl:Class ;
    rdfs:label "average weekly earnings",
        "平均周收入（average weekly earnings）"@zh ;
    rdfs:comment "雇员在报告期内的平均周工资度量。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-ind-ei-ei:Weekly ;
            owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ],
        fibo-ind-ei-ei:AverageEarnings ;
    skos:definition "measure of the average weekly wage an employee makes over the reporting period" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI .

fibo-ind-ei-ei:CapitalLaborEnergyMaterialsMultifactorProductivity a owl:Class ;
    rdfs:label "capital-labor-energy-materials multifactor productivity",
        "资本-劳动-能源-材料多要素生产率（capital-labor-energy-materials multifactor productivity）"@zh ;
    rdfs:comment "总产出数量指数与组合投入数量指数之比。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
    skos:definition "ratio of a quantity index of gross output to a quantity index of combined inputs" ;
    cmns-av:abbreviation "KLEMS-MFP" ;
    cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Shows the time profile of how productively combined inputs are used to generate gross output. Conceptually, the KLEMS productivity measure captures disembodied technical change. In practice, it reflects also efficiency change, economies of scale, variations in capacity utilisation and measurement errors." ;
    cmns-av:synonym "KLEMS multifactor productivity" .

fibo-ind-ei-ei:CapitalLaborMultifactorProductivityValueAdded a owl:Class ;
    rdfs:label "capital-labor multifactor productivity (MFP), based on value added",
        "基于增加值的资本-劳动多要素生产率（capital-labor multifactor productivity (MFP), based on value added）"@zh ;
    rdfs:comment "增加值数量指数与劳动和资本组合投入数量指数之比。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
    skos:definition "ratio of a quantity index of value added to a quantity index of combined labor and capital input" ;
    cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Capital-labour MFP indices show the time profile of how productively combined labour and capital inputs are used to generate value added. Conceptually, capital-labour productivity is not, in general, an accurate measure of technical change. It is, however, an indicator of an industry's capacity to contribute to economy-wide growth of income per unit of primary input. In practice, the measure reflects the combined effects of disembodied technical change, economies of scale, efficiency change, variations in capacity utilisation and measurement errors." .

fibo-ind-ei-ei:CapitalProductivityValueAdded a owl:Class ;
    rdfs:label "capital productivity, based on value added",
        "基于增加值的资本生产率（capital productivity, based on value added）"@zh ;
    rdfs:comment "增加值数量指数与资本投入数量指数之比。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
    skos:definition "ratio of a quantity index of value added to a quantity index of capital input" ;
    cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Changes in capital productivity indicate the extent to which output growth can be achieved with lower welfare costs in the form of foregone consumption.",
        "The capital productivity index shows the time profile of how productively capital is used to generate value added. Capital productivity reflects the joint influence of labour, intermediate inputs, technical change, efficiency change, economies of scale, capacity utilisation and measurement errors." .

fibo-ind-ei-ei:CombinedStatisticalArea a owl:Class ;
    rdfs:label "combined statistical area",
        "联合统计区（combined statistical area）"@zh ;
    rdfs:comment "以通勤模式衡量具有经济联系的相邻大都市区和小都市区的组合。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
            owl:onProperty cmns-col:comprises ],
        fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
    skos:definition "combination of adjacent metropolitan and micropolitan areas with economic ties measured by commuting patterns" ;
    cmns-av:abbreviation "CSA" ;
    cmns-av:adaptedFrom <https://en.wikipedia.org/wiki/Combined_statistical_area>,
        <https://obamawhitehouse.archives.gov/sites/default/files/omb/assets/fedreg_2010/06282010_metro_standards-Complete.pdf>,
        <https://www.federalregister.gov/documents/2021/07/16/2021-15159/2020-standards-for-delineating-core-based-statistical-areas> ;
    cmns-av:explanatoryNote "These areas that combine retain their own designations as metropolitan or micropolitan statistical areas within the larger combined statistical area." .

fibo-ind-ei-ei:DiscouragedWorkerPopulation a owl:Class ;
    rdfs:label "discouraged worker population",
        "气馁劳动者人口（discouraged worker population）"@zh ;
    rdfs:comment "边缘附着人口中因就业市场原因而当前不找工作的子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:MarginallyAttachedPopulation ;
    skos:definition "subset of the marginally attached population that have given a job-market related reason for not currently looking for work" ;
    cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" .

fibo-ind-ei-ei:EmployedPopulationPartTimeForNonEconomicReasons a owl:Class ;
    rdfs:label "employed population part-time for non-economic reasons",
        "因非经济原因兼职就业人口（employed population part-time for non-economic reasons）"@zh ;
    rdfs:comment "因疾病或其他健康医疗限制等非经济原因每周工作少于 30 至 35 小时的就业人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulationPartTime ;
    owl:disjointWith fibo-ind-ei-ei:EmployedPopulationPartTimeForEconomicReasons ;
    skos:definition "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week due to illness or other health or medical limitations, childcare problems, family or personal obligations, being in school or training, retirement or Social Security limits on earnings, and having a job where full-time work is less than 35 hours" ;
    cmns-av:adaptedFrom "https://www.bls.gov/cps/definitions.htm" ;
    cmns-av:synonym "population employed part-time for non-economic reasons" .

fibo-ind-ei-ei:EmployedPopulationTemporarilyNotAtWork a owl:Class ;
    rdfs:label "employed population temporarily not at work",
        "暂时不在岗就业人口（employed population temporarily not at work）"@zh ;
    rdfs:comment "因各种原因暂时离岗的就业人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulation ;
    skos:definition "subset of the employed population that includes persons that are temporarily absent from work for various reasons" ;
    cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" ;
    cmns-av:explanatoryNote "This includes persons temporarily not at work because of illness or injury, holiday or vacation, strike or lockout, educational or training leave, maternity or parental leave, reduction in economic activity, temporary disorganisation or suspension of work due to such reasons as bad weather, mechanical or electrical breakdown, or shortage of raw materials or fuels, or other temporary absence with or without leave should be considered as in paid employment provided they had a formal job attachment." .

fibo-ind-ei-ei:EstablishmentEmployment a owl:Class ;
    rdfs:label "establishment employment",
        "机构场所就业（establishment employment）"@zh ;
    rdfs:comment "表示在机构场所工作或为其工作的人员总数（含在业业主、活跃业务合伙人和无酬家庭工）的经济指标。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:EstablishmentPopulation ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    skos:definition "economic indicator representing the total number of persons who work in or for the establishment including working proprietors, active business partners and unpaid family workers, as well as persons working outside the establishment when paid by and under the control of the establishment, for example, sales representatives, outside service engineers and repair and maintenance personnel" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=780"^^xsd:anyURI ;
    cmns-av:explanatoryNote """Also included are salaried managers and salaried directors of incorporated enterprises. The total should include part-time workers and seasonal workers on the payroll, persons on short-term leave (sick leave, maternity leave, annual leave or vacation) and on strike, but not persons on indefinite leave, military leave or pension. 

Excluded are directors of incorporated enterprises and members of shareholders committees who are paid solely for their attendance at meetings, labour made available to the establishment by other units and charged for, such as contract workers paid through contractors, persons carrying out repair and maintenance work in the establishment on behalf of other units and all homeworkers.""" ;
    cmns-av:synonym "payroll employment" .

fibo-ind-ei-ei:Household a owl:Class ;
    rdfs:label "household",
        "住户（household）"@zh ;
    rdfs:comment "共同居住于一个住房单元（如房屋或公寓）作为通常居所、并共享部分或全部资源的个人或小群体。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-ind-ei-ei:HousingUnit ;
            owl:onProperty cmns-loc:hasLocation ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-fnd-aap-ppl:Person ],
        fibo-ind-ei-ei:InstitutionalUnit ;
    skos:definition "individual or small group of persons who occupy a housing unit (such as a house or apartment) as their usual place of residence, who pool some, or all, of their income and wealth and who consume certain types of goods and services collectively, mainly housing and food" ;
    cmns-av:adaptedFrom <http://stats.oecd.org/glossary/detail.asp?ID=1255> ;
    cmns-av:explanatoryNote """A household may be either (a) a one-person household, that is to say, a person who makes provision for his or her own food or other essentials for living without combining with any other person to form part of a multi-person household or (b) a multi-person household, that is to say, a group of two or more persons living together who make common provision for food or other essentials for living. The persons in the group may pool their incomes and may, to a greater or lesser extent, have a common budget; they may be related or unrelated persons or constitute a combination of persons both related and unrelated.

A household may be located in a housing unit or in a set of collective living quarters such as a boarding house, a hotel or a camp, or may comprise the administrative personnel in an institution. The household may also be homeless.""",
        "From the perspective of the U.S Census Bureau, a household includes the related family members and all the unrelated people, if any, such as lodgers, foster children, wards, or employees who share the housing unit. A person living alone in a housing unit, or a group of unrelated people sharing a housing unit such as partners or roomers, is also counted as a household. The count of households excludes group quarters [such as institutional facilities]. There are two major categories of households, 'family' and 'nonfamily'." .

fibo-ind-ei-ei:LaborProductivityGrossOutput a owl:Class ;
    rdfs:label "labor productivity, based on gross output",
        "基于总产出的劳动生产率（labor productivity, based on gross output）"@zh ;
    rdfs:comment "总产出数量指数与劳动投入数量指数之比。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
    skos:definition "ratio of a quantity index of gross output to a quantity index of labor input" ;
    cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Gross-output based labour productivity traces the labour requirements per unit of (physical) output. It reflects the change in the input coefficient of labour by industry and can help in the analysis of labour requirements by industry.",
        "Shows the time profile of how productively labour is used to generate gross output. Labour productivity changes reflect the joint influence of changes in capital, intermediate inputs, as well as technical, organisational and efficiency change within and between firms, the influence of economies of scale, varying degrees of capacity utilisation and measurement errors." .

fibo-ind-ei-ei:LaborProductivityValueAdded a owl:Class ;
    rdfs:label "labor productivity, based on value added",
        "基于增加值的劳动生产率（labor productivity, based on value added）"@zh ;
    rdfs:comment "增加值数量指数与劳动投入数量指数之比。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:Productivity ;
    skos:definition "ratio of a quantity index of value added to a quantity index of labor input" ;
    cmns-av:adaptedFrom "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "At the aggregate level, value-added based labour productivity forms a direct link to a widely used measure of living standards, income per capita. Productivity translates directly into living standards, by adjusting for changing working hours, unemployment, labour force participation rates and demographic changes.",
        "Shows the time profile of how productively labour is used to generate value added. Labour productivity changes reflect the joint influence of changes in capital, as well as technical, organisational and efficiency change within and between firms, the influence of economies of scale, varying degrees of capacity utilisation and measurement errors." .

fibo-ind-ei-ei:MetropolitanStatisticalArea a owl:Class ;
    rdfs:label "metropolitan statistical area",
        "大都市统计区（metropolitan statistical area）"@zh ;
    rdfs:comment "拥有至少一个 5 万人以上城市核心区的一个或多个相邻县（或同级单位）及其周边紧密联系地区。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
    skos:definition "one or more adjacent counties or county equivalents that have at least one urban core area of at least 50,000 population, plus adjacent territory that has a high degree of social and economic integration with the core as measured by commuting ties" ;
    cmns-av:abbreviation "MSA" ;
    cmns-av:adaptedFrom <https://en.wikipedia.org/wiki/List_of_Metropolitan_Statistical_Areas>,
        <https://obamawhitehouse.archives.gov/sites/default/files/omb/assets/fedreg_2010/06282010_metro_standards-Complete.pdf>,
        <https://www.federalregister.gov/documents/2021/07/16/2021-15159/2020-standards-for-delineating-core-based-statistical-areas> .

fibo-ind-ei-ei:MicropolitanStatisticalArea a owl:Class ;
    rdfs:label "micropolitan statistical area",
        "小都市统计区（micropolitan statistical area）"@zh ;
    rdfs:comment "拥有至少一个 1 万至 5 万人城市核心区的一个或多个相邻县（或同级单位）及其周边地区。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ;
    skos:definition "one or more adjacent counties or county equivalents that have at least one urban core area of at least 10,000 population but less than 50,000, plus adjacent territory that has a high degree of social and economic integration with the core as measured by commuting ties" ;
    cmns-av:abbreviation "μSA" ;
    cmns-av:adaptedFrom <https://en.wikipedia.org/wiki/List_of_micropolitan_statistical_areas>,
        <https://obamawhitehouse.archives.gov/sites/default/files/omb/assets/fedreg_2010/06282010_metro_standards-Complete.pdf>,
        <https://www.federalregister.gov/documents/2021/07/16/2021-15159/2020-standards-for-delineating-core-based-statistical-areas> .

fibo-ind-ei-ei:MilitaryPerson a owl:Class ;
    rdfs:label "military person",
        "军人（military person）"@zh ;
    rdfs:comment "现役军队成员。"@zh ;
    rdfs:subClassOf fibo-be-le-lp:LegallyCompetentNaturalPerson ;
    owl:disjointWith fibo-ind-ei-ei:Civilian ;
    skos:definition "person that is a member of the active duty military" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" .

fibo-ind-ei-ei:PersonalConsumptionExpenditures a owl:Class ;
    rdfs:label "personal consumption expenditures",
        "个人消费支出（personal consumption expenditures）"@zh ;
    rdfs:comment "表示「个人」或代表个人购买的货物与服务价值之度量的经济指标。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EconomicIndicator ;
    skos:definition "economic indicator representing measure of the value of the goods and services purchased by, or on the behalf of, 'persons'" ;
    cmns-av:abbreviation "PCE" ;
    cmns-av:adaptedFrom "https://www.bea.gov/data/consumer-spending/main"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Personal consumption expenditures consist of purchases of goods and services by households and by nonprofit institutions serving households (NPISHs). These goods and services include imputed expenditures on items such as the services of housing by a homeowner (the equivalent of rent), financial and insurance services for which there is no explicit charge, and medical care provided to individuals and financed by government or by private insurance." .

fibo-ind-ei-ei:StatisticalInformationPublisher a owl:Class ;
    rdfs:label "statistical information publisher",
        "统计信息发布方（statistical information publisher）"@zh ;
    rdfs:comment "打包并提供分析与统计数据的发布方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom cmns-org:FormalOrganization ],
        fibo-be-fct-pub:Publisher ;
    skos:definition "publisher that packages and makes analytical and statistical data available" .

fibo-ind-ei-ei:UltimateConsumer a owl:Class ;
    rdfs:label "ultimate consumer",
        "最终消费者（ultimate consumer）"@zh ;
    rdfs:comment "货物、产品或服务的最终使用者。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom fibo-fnd-aap-ppl:Person ],
        fibo-fnd-pas-pas:Consumer ;
    skos:definition "person that is the ultimate user of a good, product or service" ;
    cmns-av:explanatoryNote "For the purposes of the CPI and related statistics, the definition of consumer is limited to humans. In general, a consumer could include a pet, as the consumer of pet food, for example, although the pet owner would likely be the purchaser and target of advertising.",
        "The consumer is not always the purchaser of the product. Consumers are considered to be the users of the final product. For example, purchasers of building products are interim users of these products while constructing the finished product, which then may be purchased by the consumer." ;
    cmns-av:synonym "consumer as defined by the Consumer Price Index (CPI)" .

fibo-ind-ei-ei:UnderemployedPopulationWithRespectToOccupation a owl:Class ;
    rdfs:label "underemployed population with respect to occupation",
        "职业不匹配就业不足人口（underemployed population with respect to occupation）"@zh ;
    rdfs:comment "就业不足人口中所从事岗位与其培训和经验不符的子集（不含自愿转行者）。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:UnderemployedPopulation ;
    skos:definition "subset of the underemployed population that includes persons employed in a role that does not reflect their training and experience, excluding those that change careers" .

fibo-ind-ei-ei:UnderutilizedPopulation a owl:Class ;
    rdfs:label "underutilized population",
        "未充分利用人口（underutilized population）"@zh ;
    rdfs:comment "平民非机构人口中因经济原因兼职者、边缘附着劳动力及失业者的子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( fibo-ind-ei-ei:UnderemployedPopulation fibo-ind-ei-ei:UnemployedPopulation fibo-ind-ei-ei:MarginallyAttachedPopulation ) ] ;
    skos:definition "subset of the civilian non-institutional population that includes persons employed part-time for economic reasons, persons that are marginally attached to the labor force, and persons that are identified as unemployed" ;
    cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" .

fibo-ind-ei-ei:ValueAddedProducerPriceIndex a owl:Class ;
    rdfs:label "value-added producer price index",
        "增加值生产者价格指数（value-added producer price index）"@zh ;
    rdfs:comment "表示投入与产出生产者价格指数加权平均的经济指标。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-oc:hasInput ;
            owl:someValuesFrom fibo-ind-ei-ei:InputProducerPriceIndex ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-oc:hasInput ;
            owl:someValuesFrom fibo-ind-ei-ei:OutputProducerPriceIndex ],
        fibo-ind-ei-ei:ProducerPriceIndex ;
    skos:definition "economic indicator representing a weighted average of the input and output producer price indices" ;
    cmns-av:abbreviation "value-added PPI" ;
    cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI .

fibo-ind-ei-ei:excludesEnergyAndFood a owl:DatatypeProperty ;
    rdfs:label "excludes energy and food",
        "剔除能源与食品（excludes energy and food）"@zh ;
    rdfs:comment "表明该指数的计算是否剔除能源与食品价格。"@zh ;
    rdfs:domain fibo-ind-ei-ei:ConsumerPriceIndex ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether the calculation of the index includes energy and food prices or not" .

fibo-ind-ei-ei:hasIndicatorValue a owl:ObjectProperty ;
    rdfs:label "has indicator value",
        "具有指标值（has indicator value）"@zh ;
    rdfs:comment "指明给定指标的量值。"@zh ;
    rdfs:range cmns-qtu:ScalarQuantityValue ;
    rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
    skos:definition "specifies a quantity value for a given indicator" .

fibo-ind-ei-ei:CivilianLaborForceParticipationRate a owl:Class ;
    rdfs:label "civilian labor force participation rate",
        "平民劳动力参与率（civilian labor force participation rate）"@zh ;
    rdfs:comment "表示给定经济体在某指定时期内劳动力参与率的经济指标。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasComparisonPopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:CivilianLaborForce ],
        [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    skos:definition "economic indicator representing the rate of participation the labor force of a given economy for some specified period" ;
    cmns-av:adaptedFrom "https://www.bls.gov/cps/definitions.htm#lfpr"^^xsd:anyURI ;
    cmns-av:explanatoryNote "The labor force participation rate is the percentage of the population that is either employed or unemployed (that is, either working or actively seeking work)." ;
    cmns-qtu:describesActualExpression "civilian labor force ÷ civilian non-institutional population" .

fibo-ind-ei-ei:CivilianNonInstitutionalPerson a owl:Class ;
    rdfs:label "civilian non-institutional person",
        "平民非机构个人（civilian non-institutional person）"@zh ;
    rdfs:comment "不住在机构（如惩教所、长期护理医院或疗养院）内、且非现役的法定工作年龄人。"@zh ;
    rdfs:seeAlso <http://www.investopedia.com/terms/w/working-age-population.asp> ;
    rdfs:subClassOf fibo-fnd-aap-ppl:LegalWorkingAgePerson,
        fibo-ind-ei-ei:Civilian ;
    owl:disjointWith fibo-ind-ei-ei:InstitutionalPerson ;
    skos:definition "legal working-age person that does not live in an institution (for example, a correctional facility, long-term care hospital, or nursing home), and is not on active military duty" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
    cmns-av:explanatoryNote "The working-age population is the total population in a region, within a set range of ages, that is considered to be able and likely to work. The working-age population measure is used to give an estimate of the total number of potential workers within an economy. For example, in the U.S., it is 16, whereas in Canada it is 15." .

fibo-ind-ei-ei:Daily a owl:NamedIndividual,
        fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
    rdfs:label "daily" ;
    skos:definition "explicit recurrence interval of one day, or 24 hours" ;
    cmns-dt:hasDurationValue "P1D" .

fibo-ind-ei-ei:EmployedPopulationPartTimeForEconomicReasons a owl:Class ;
    rdfs:label "employed population part-time for economic reasons",
        "因经济原因兼职就业人口（employed population part-time for economic reasons）"@zh ;
    rdfs:comment "因工作量不足、不利商业条件等经济原因每周工作少于 30 至 35 小时的就业人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulationPartTime,
        fibo-ind-ei-ei:UnderemployedPopulation ;
    skos:definition "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week due to slack work, unfavorable business conditions, inability to find full-time work, and seasonal declines in demand" ;
    cmns-av:adaptedFrom "https://stats.oecd.org/Index.aspx?DatasetCode=STLABOUR",
        "https://www.bls.gov/cps/definitions.htm" ;
    cmns-av:synonym "involuntary part-time population",
        "population employed part-time for economic reasons" .

fibo-ind-ei-ei:EmploymentPopulationRatio a owl:Class ;
    rdfs:label "employment-population ratio",
        "就业人口比（employment-population ratio）"@zh ;
    rdfs:comment "表示给定经济体在某指定时期内就业人口与平民非机构总人口之比的经济指标。"@zh ;
    rdfs:seeAlso <http://www.bls.gov/news.release/pdf/empsit.pdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasComparisonPopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:EmployedPopulation ],
        [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    skos:definition "economic indicator representing the ratio of the employed population with respect to the overall civilian non-institutional population of a given economy for some specified period" ;
    cmns-qtu:describesActualExpression "employed population ÷ civilian non-institutional population" .

fibo-ind-ei-ei:FixedBasketConstituent a owl:Class ;
    rdfs:label "fixed basket constituent",
        "固定篮子成分（fixed basket constituent）"@zh ;
    rdfs:comment "固定篮子的组成成分。"@zh ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( fibo-fnd-pas-pas:Good cmns-org:Service ) ],
        fibo-fbc-pas-fpas:BasketConstituent,
        fibo-fnd-dt-fd:DatedCollectionConstituent ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty cmns-col:isConstituentOf ;
            owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ] ;
    skos:definition "component of a fixed basket" .

fibo-ind-ei-ei:FixedBasketPopulation a owl:Class ;
    rdfs:label "fixed basket population",
        "固定篮子总体（fixed basket population）"@zh ;
    rdfs:comment "由特定货物和/或服务构成的、为支持价格指数等调查而设计的统计全域。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-fnd-pas-pas:Good cmns-org:Service ) ] ],
        fibo-fnd-utl-alx:StatisticalUniverse ;
    skos:definition "statistical universe consisting of specific goods and/or services designed for the purposes of supporting surveys such as those used as the basis for price indices" ;
    cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
    cmns-av:synonym "goods and services population",
        "goods and/or services population" .

fibo-ind-ei-ei:GrossDomesticProduct a owl:Class ;
    rdfs:label "gross domestic product",
        "国内生产总值（gross domestic product）"@zh ;
    rdfs:comment "表示总体经济活动最广度量的经济指标，计量全部最终货物与服务的不重复总市值。"@zh ;
    rdfs:seeAlso <http://unstats.un.org/unsd/nationalaccount/docs/SNA2008.pdf> ;
    rdfs:subClassOf fibo-ind-ei-ei:EconomicIndicator ;
    owl:disjointWith fibo-ind-ei-ei:UnemploymentRate ;
    skos:definition "economic indicator representing the broadest measure of aggregate economic activity, measuring the total unduplicated market value of all final goods and services produced within a statistical area in a period" ;
    cmns-av:abbreviation "GDP" ;
    cmns-av:adaptedFrom "https://en.wikipedia.org/wiki/Gross_domestic_product"^^xsd:anyURI,
        "https://home.treasury.gov/system/files/261/FSOC-2013-Annual-Report.pdf"^^xsd:anyURI,
        "BEA's Handbook of Methods for GDP and related national accounts, available at https://www.bea.gov/methodologies/index.htm#national_meth" ;
    cmns-av:explanatoryNote "GDP represents a valuation expressed in terms of the prices actually paid by the purchaser after all applicable taxes and subsidies.",
        "Gross domestic product (GDP) is the value of the goods and services produced by the nation's economy less the value of the goods and services used up in production. GDP is also equal to the sum of personal consumption expenditures, gross private domestic investment, net exports of goods and services, and government consumption expenditures and gross investment. Conceptually, this measure can be arrived at by three separate means: as the sum of goods and services sold to final users, as the sum of income payments and other costs incurred in the production of goods and services, and as the sum of the value added at each stage of production. Although these three ways of measuring GDP are conceptually the same, their calculation may not result in identical estimates of GDP because of differences in data sources, timing, and estimation techniques." .

fibo-ind-ei-ei:Hourly a owl:NamedIndividual,
        fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
    rdfs:label "hourly" ;
    skos:definition "explicit recurrence interval of one hour, or 60 minutes" ;
    cmns-dt:hasDurationValue "P1H" .

fibo-ind-ei-ei:HousingUnit a owl:Class ;
    rdfs:label "housing unit",
        "住房单元（housing unit）"@zh ;
    rdfs:comment "作为独立居住空间占用的房屋、公寓、活动房屋、一组房间或单个房间，或空置但拟供居住者。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-fnd-plc-adr:PhysicalAddress ;
            owl:onProperty fibo-fnd-plc-adr:hasAddress ],
        cmns-loc:PhysicalLocation ;
    skos:definition "house, an apartment, a mobile home or trailer, a group of rooms, or a single room occupied as separate living quarters, or if vacant, intended for occupancy as separate living quarters" ;
    cmns-av:explanatoryNote "Separate living quarters are those in which the occupants live separately from any other individuals in the building and which have direct access from outside the building or through a common hall. For vacant units, the criteria of separateness and direct access are applied to the intended occupants whenever possible." .

fibo-ind-ei-ei:InflationRate a owl:Class ;
    rdfs:label "inflation rate",
        "通货膨胀率（inflation rate）"@zh ;
    rdfs:comment "表示给定统计区在指定时期内货物与服务价格变化的经济指标。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ],
        fibo-ind-ei-ei:EconomicIndicator ;
    skos:definition "economic indicator representing a change in prices of goods and services for a specified period, for a given statistical area" ;
    skos:editorialNote "Always either includes or excludes: Energy prices; Food prices. ALL inflation rates cite whether or not they exclude energy and food prices. If nothing stated it is assumed they include them." ;
    cmns-av:explanatoryNote "Inflation rate can be used to define changes, from period-to-period, in wage (wage inflation), house prices or producer inputs/outputs. It can be calculated month-over-month and quarter-over-quarter, as well as year-over-year, or on any periodic basis required by the publisher and its community of interest." .

fibo-ind-ei-ei:InputProducerPriceIndex a owl:Class ;
    rdfs:label "input producer price index",
        "投入生产者价格指数（input producer price index）"@zh ;
    rdfs:comment "表示生产者购买的货物与服务投入价格随时间变化率之度量的经济指标。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:ProducerPriceIndex ;
    skos:definition "economic indicator representing measure of the rate of change over time in the prices of inputs of goods and services purchased by the producer" ;
    cmns-av:abbreviation "input PPI" ;
    cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI .

fibo-ind-ei-ei:InstitutionalPerson a owl:Class ;
    rdfs:label "institutional person",
        "机构内人员（institutional person）"@zh ;
    rdfs:comment "因某种原因（如住院、康复或监禁）居住在机构内的人。"@zh ;
    rdfs:subClassOf fibo-fnd-aap-ppl:Person ;
    skos:definition "person that resides in an institution for some reason, due, for example, to hospitalization, rehabilitation, or incarceration" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" .

fibo-ind-ei-ei:Monthly a owl:NamedIndividual,
        fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
    rdfs:label "monthly" ;
    skos:definition "explicit recurrence interval of exactly one (1) month, regardless of the length in days of a given calendar month, but typically 30 days" ;
    cmns-dt:hasDurationValue "P1M" .

fibo-ind-ei-ei:OutputProducerPriceIndex a owl:Class ;
    rdfs:label "output producer price index",
        "产出生产者价格指数（output producer price index）"@zh ;
    rdfs:comment "表示产品离开生产者时的销售价格随时间变化率之度量的经济指标。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:ProducerPriceIndex ;
    skos:definition "economic indicator representing measure of the rate of change over time in the prices of products sold as they leave the producer" ;
    cmns-av:abbreviation "output PPI" ;
    cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI .

fibo-ind-ei-ei:Weekly a owl:NamedIndividual,
        fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
    rdfs:label "weekly" ;
    skos:definition "explicit recurrence interval of one week, or 7 days" ;
    cmns-dt:hasDurationValue "P7D" .

fibo-ind-ei-ei:hasDurationOfUnemployment a owl:ObjectProperty ;
    rdfs:label "has duration of unemployment",
        "具有失业时长（has duration of unemployment）"@zh ;
    rdfs:comment "指明被归类为失业的人持续寻找工作的时间长度，通常以周计。"@zh ;
    rdfs:range cmns-dt:Duration ;
    rdfs:subPropertyOf cmns-dt:hasDuration ;
    skos:definition "specifies the length of time, typically in weeks, that people classified as unemployed have been continuously looking for work" ;
    cmns-av:adaptedFrom <https://www.bls.gov/cps/definitions.htm> .

fibo-ind-ei-ei:hasSeriesOrigin a owl:ObjectProperty ;
    rdfs:label "has series origin",
        "具有序列起点（has series origin）"@zh ;
    rdfs:comment "指明给定经济指标时间序列的原始起始日期。"@zh ;
    rdfs:range cmns-dt:Date ;
    rdfs:subPropertyOf cmns-dt:hasStartDate ;
    skos:definition "specifies the original starting date for the time series for a given economic indicator" .

fibo-ind-ei-ei:isSeasonallyAdjusted a owl:DatatypeProperty ;
    rdfs:label "is seasonally adjusted",
        "经季节调整（is seasonally adjusted）"@zh ;
    rdfs:comment "表明是否应用了某种公开的正式方法对总体或指数值的季节性波动进行补偿。"@zh ;
    rdfs:range xsd:boolean ;
    skos:definition "a predicate indicating whether some published formal method is applied that compensates for seasonal variations in the population or index value" ;
    cmns-av:explanatoryNote "Example explanation from the US Bureau of Labor Statistics: Because price data are used for different purposes by different groups, the Bureau of Labor Statistics publishes seasonally adjusted as well as unadjusted changes each month. ... Seasonal factors used in computing the seasonally adjusted indexes are derived by the X-13ARIMA-SEATS Seasonal Adjustment Method. Seasonally adjusted indexes and seasonal factors are computed annually. Each year, the last five years of seasonally adjusted data are revised." .

fibo-ind-ei-ei:Civilian a owl:Class ;
    rdfs:label "civilian",
        "平民（civilian）"@zh ;
    rdfs:comment "非军队成员（即非现役）的人。"@zh ;
    rdfs:subClassOf fibo-be-le-lp:LegallyCompetentNaturalPerson ;
    skos:definition "person that is not a member of the military (i.e., that is not on active duty)" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" .

fibo-ind-ei-ei:ConsumerPriceIndex a owl:Class ;
    rdfs:label "consumer price index",
        "消费者价格指数（consumer price index）"@zh ;
    rdfs:comment "表示家庭消费的消费货物与服务价格随时间变化之度量的经济指标。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-oc:hasInput ;
            owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    owl:disjointWith fibo-ind-ei-ei:CivilianLaborForceParticipationRate,
        fibo-ind-ei-ei:EmploymentPopulationRatio,
        fibo-ind-ei-ei:GrossDomesticProduct,
        fibo-ind-ei-ei:InflationRate,
        fibo-ind-ei-ei:UnemploymentRate ;
    skos:definition "economic indicator representing measure of the change over time in the prices of consumer goods and services that households consume" ;
    cmns-av:abbreviation "CPI" ;
    cmns-av:adaptedFrom "http://unstats.un.org/unsd/nationalaccount/docs/SNA2008.pdf"^^xsd:anyURI,
        "http://www.ilo.org/public/english/bureau/stat/guides/cpi/"^^xsd:anyURI .

fibo-ind-ei-ei:EmployedPopulationPartTime a owl:Class ;
    rdfs:label "employed population part-time",
        "兼职就业人口（employed population part-time）"@zh ;
    rdfs:comment "按通常工时每周工作少于 30 至 35 小时的就业人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulation ;
    skos:definition "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week based on usual working hours" ;
    cmns-av:adaptedFrom "https://stats.oecd.org/Index.aspx?DatasetCode=STLABOUR" ;
    cmns-av:explanatoryNote "In the U.S., part-time workers are those who usually work fewer than 35 hours per week. See https://www.bls.gov/cps/definitions.htm for additional details.",
        "The definition of part-time varies considerably from country to country according to the OECD. Classification may be based on (1) employee perception, (2) usual working hours, which is the most reliable measure, or (3) actual working hours, which varies due to holidays, illness, etc." ;
    cmns-av:synonym "population employed part-time" .

fibo-ind-ei-ei:Enterprise a owl:Class ;
    rdfs:label "enterprise",
        "企业（enterprise）"@zh ;
    rdfs:comment "生产和/或销售货物或服务的功能型企业实体。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-fnd-pas-pas:Good cmns-org:Service ) ] ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom cmns-org:LegalPerson ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-ind-ei-ei:Establishment ],
        [ a owl:Class ;
            owl:unionOf ( fibo-fnd-pas-pas:Producer cmns-org:ServiceProvider ) ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:someValuesFrom fibo-fnd-arr-cls:IndustrySectorClassifier ],
        fibo-be-fct-fct:FunctionalBusinessEntity,
        fibo-ind-ei-ei:InstitutionalUnit ;
    skos:definition "functional business entity that produces and/or sells goods or services" ;
    cmns-av:adaptedFrom "http://www.bls.gov/opub/hom/glossary.htm#E"^^xsd:anyURI ;
    cmns-av:explanatoryNote "An enterprise (a private firm, government, or nonprofit organization) can consist of a single establishment or multiple establishments. All establishments in an enterprise may be classified in one industry (e.g., a chain), or they may be classified in different industries (e.g., a conglomerate)." .

fibo-ind-ei-ei:EnterprisePopulation a owl:Class ;
    rdfs:label "enterprise population",
        "企业总体（enterprise population）"@zh ;
    rdfs:comment "为支持就业和生产者价格等调查而设计的企业统计全域。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-ind-ei-ei:Enterprise ],
        fibo-fnd-utl-alx:StatisticalUniverse ;
    skos:definition "statistical universe consisting of enterprises designed for the purposes of supporting surveys such as those used as the basis for employment and producer price indices" .

fibo-ind-ei-ei:Establishment a owl:Class ;
    rdfs:label "establishment",
        "机构场所（establishment）"@zh ;
    rdfs:comment "从单一物理位置运营的企业（或企业的一部分）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-plc-adr:PhysicalAddress ;
            owl:onProperty fibo-fnd-plc-adr:hasAddress ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-ind-ei-ei:Enterprise ;
            owl:onProperty cmns-col:isConstituentOf ],
        fibo-ind-ei-ei:InstitutionalUnit ;
    skos:definition "an enterprise (or part of an enterprise) that operates from a single physical location" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=857"^^xsd:anyURI,
        "http://www.bls.gov/opub/hom/glossary.htm#E"^^xsd:anyURI,
        "http://www.statcan.gc.ca/eng/concepts/units"^^xsd:anyURI ;
    cmns-av:explanatoryNote "The physical location of a certain economic activity - for example, a factory, mine, store, or office. An individual establishment is generally classified by having one NAICS code associated with it for statistical purposes, whereas an enterprise may be classified by multiple NAICS codes. The statistical structure is defined based on the operating structure and the accounting data produced by that entity. A given location may only need to publish revenues, whereas an operating unit (establishment) has employment statistics, etc. An establishment is defined as a producing unit at a single geographical location at which or from which economic activity is conducted and for which, at a minimum, employment data are available. In the case of a home-based business, the actual physical location would be specified as two distinct institutional units - as a household from a personal living and consumer perspective and as an establishment / operating unit due to the statistics required of the business." .

fibo-ind-ei-ei:EstablishmentPopulation a owl:Class ;
    rdfs:label "establishment population",
        "机构场所总体（establishment population）"@zh ;
    rdfs:comment "企业总体中聚焦于机构场所的子集。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-ind-ei-ei:Establishment ],
        fibo-ind-ei-ei:EnterprisePopulation ;
    skos:definition "a subset of the enterprise population focused on establishments" .

fibo-ind-ei-ei:MarginallyAttachedPopulation a owl:Class ;
    rdfs:label "marginally attached population",
        "边缘附着人口（marginally attached population）"@zh ;
    rdfs:comment "当前既不工作也不找工作、但表示想要并可以工作且近期找过工作的人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:PopulationNotInLaborForce ;
    skos:definition "subset of the population that includes people who currently are neither working nor looking for work but indicate that they want and are available for a job and have looked for work sometime in the past 12 months" ;
    cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" .

fibo-ind-ei-ei:PopulationNotInLaborForce a owl:Class ;
    rdfs:label "population not in the labor force",
        "非劳动力人口（population not in the labor force）"@zh ;
    rdfs:comment "报告期内被报告机构认定为既非就业也非失业的平民非机构人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
    owl:disjointWith fibo-ind-ei-ei:CivilianLaborForce ;
    skos:definition "subset of the civilian, noninstitutional population, that is considered neither employed nor unemployed by the reporting agency during the reporting period" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
    cmns-av:explanatoryNote "There are a number of distinctions with respect to how individuals are counted from country to country, including whether or not they are considered employed if they are on unpaid leave for some reason, and whether or not they are counted multiple times if they have more than one paying job." .

fibo-ind-ei-ei:UnemployedPopulation a owl:Class ;
    rdfs:label "unemployed population",
        "失业人口（unemployed population）"@zh ;
    rdfs:comment "平民劳动力中被认为没有工作、但（除暂时生病外）可以工作、且已作出具体求职努力的子集。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasDurationOfUnemployment ;
            owl:someValuesFrom cmns-dt:Duration ],
        fibo-ind-ei-ei:CivilianLaborForce ;
    owl:disjointWith fibo-ind-ei-ei:EmployedPopulation ;
    skos:definition "subset of the civilian labor force that is considered to have had no employment but was available for work, except for temporary illness, and had made specific efforts to find employment sometime during a specified period, during the reporting period" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
    cmns-av:explanatoryNote "Persons who were waiting to be recalled to a job from which they had been laid off need not have been looking for work to be classified as unemployed." .

fibo-ind-ei-ei:UnemploymentRate a owl:Class ;
    rdfs:label "unemployment rate",
        "失业率（unemployment rate）"@zh ;
    rdfs:comment "表示给定经济体在某指定时期内失业人口与平民劳动力之比的经济指标。"@zh ;
    rdfs:seeAlso <http://www.bls.gov/news.release/pdf/empsit.pdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:CivilianLaborForce ],
        [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasComparisonPopulation ;
            owl:someValuesFrom fibo-ind-ei-ei:UnemployedPopulation ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    skos:definition "economic indicator representing the ratio of the unemployed population with respect to the civilian labor force of a given economy for some specified period" ;
    cmns-av:adaptedFrom "http://www.bls.gov/cps/faq.htm#Ques3"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Persons are classified as unemployed if they do not have a job, have actively looked for work in the prior 4 weeks, and are currently available for work. Workers expecting to be recalled from layoff are counted as unemployed, whether or not they have engaged in a specific jobseeking activity. In all other cases, the individual must have been engaged in at least one active job search activity in the 4 weeks preceding the interview and be available for work (except for temporary illness)." ;
    cmns-qtu:describesActualExpression "unemployed population ÷ civilian labor force" .

fibo-ind-ei-ei:FixedBasket a owl:Class ;
    rdfs:label "fixed basket",
        "固定篮子（fixed basket）"@zh ;
    rdfs:comment "数量与质量在某段时期内保持固定的货物与服务篮子。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-ind-ei-ei:FixedBasketConstituent ],
        fibo-fbc-pas-fpas:Basket,
        fibo-fnd-dt-fd:DatedStructuredCollection ;
    skos:definition "basket of goods and services whose quantity and quality are held fixed for some period of time" ;
    cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
    cmns-av:synonym "basket of goods" .

fibo-ind-ei-ei:InstitutionalUnit a owl:Class ;
    rdfs:label "institutional unit",
        "机构单位（institutional unit）"@zh ;
    rdfs:comment "能够以自身名义拥有资产、承担负债、从事经济活动并与他方交易的参与方。"@zh ;
    rdfs:subClassOf fibo-be-fct-fct:FunctionalEntity,
        cmns-pts:PartyRole ;
    skos:definition "party that is capable, in its own right, of owning assets, incurring liabilities, and engaging in economic activities and in transactions with other parties" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=1415"^^xsd:anyURI,
        "http://www.statcan.gc.ca/eng/concepts/units"^^xsd:anyURI,
        "https://www.statcan.gc.ca/en/concepts/ccius/intro"^^xsd:anyURI ;
    cmns-av:explanatoryNote "There is a hierarchical relationship between institutional units and establishments. An institutional unit contains one or more entire establishment(s); an establishment belongs to one and only one institutional unit. There are two main types of units in the real world that may qualify as institutional units, namely persons or groups of persons in the form of households, and legal or social entities." .

fibo-ind-ei-ei:ProducerPriceIndex a owl:Class ;
    rdfs:label "producer price index",
        "生产者价格指数（producer price index）"@zh ;
    rdfs:comment "表示生产者买卖的货物与服务价格随时间变化率之度量的经济指标。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-oc:hasInput ;
            owl:someValuesFrom fibo-ind-ei-ei:FixedBasket ],
        [ a owl:Restriction ;
            owl:onProperty fibo-ind-ei-ei:hasBaselinePopulation ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-ind-ei-ei:EnterprisePopulation fibo-ind-ei-ei:EstablishmentPopulation fibo-ind-ei-ei:FixedBasketPopulation ) ] ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    owl:disjointWith fibo-ind-ei-ei:ConsumerPriceIndex ;
    skos:definition "economic indicator representing measure of the rate of change over time in the prices of goods and services bought and sold by producers" ;
    cmns-av:abbreviation "PPI" ;
    cmns-av:adaptedFrom "https://www.imf.org/external/pubs/ft/ppi/2010/manual/ppi.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Statistical agencies implement the Laspeyres index by putting it into price-relative (price change from the base period) and revenue-share (from the base period) format. In this form, the Laspeyres index can be written as the sum of base-period revenue shares of the items in the index times their corresponding price relatives. Statistical agency practice has introduced some approximations to the theoretical Laspeyres target due to a number of practical problems with producing the Laspeyres index exactly. For these and other pragmatic reasons, some agencies use alternatives depending on circumstances. See the IMF publication cited for a full explanation of the most commonly used approaches and trade-offs made for determining PPI.",
        "The standard methodology for a typical PPI is based on a Laspeyres price index with fixed quantities from an earlier base period. The construction of this index can be thought of in terms of selecting a basket of goods and services representative of base-period revenues, valuing this at base-period prices, and then repricing the same basket at current-period prices. The target PPI in this case is defined to be the ratio of these two revenues. Practicing statisticians use this methodology because it has at least three practical advantages. It is easily explained to the public, it can use often expensive and untimely weighting information from the date of the last (or an even earlier) survey or administrative source (rather than requiring sources of data for the current month), and it need not be revised if users accept the Laspeyres premise." .

fibo-ind-ei-ei:UnderemployedPopulation a owl:Class ;
    rdfs:label "underemployed population",
        "就业不足人口（underemployed population）"@zh ;
    rdfs:comment "就业人口中因经济原因兼职、想要并可从事全职工作但不得不接受兼职的子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EmployedPopulation ;
    skos:definition "subset of the employed population that includes persons employed part-time for economic reasons, who want and are available for full-time work but have had to settle for a part-time schedule" ;
    cmns-av:adaptedFrom "https://www.bls.gov/news.release/empsit.t15.htm" .

fibo-ind-ei-ei:hasComparisonPopulation a owl:ObjectProperty ;
    rdfs:label "has comparison population",
        "具有比较总体（has comparison population）"@zh ;
    rdfs:comment "指明用于比较或分析的基线统计全域或总体的子集。"@zh ;
    rdfs:range fibo-fnd-utl-alx:StatisticalUniverse ;
    rdfs:subPropertyOf fibo-fnd-dt-oc:hasInput ;
    skos:definition "specifies the subset of the baseline statistical universe or population used for comparison or analysis" .

fibo-ind-ei-ei:AverageEarnings a owl:Class ;
    rdfs:label "average earnings",
        "平均收入（average earnings）"@zh ;
    rdfs:comment "计时或受薪劳动者在给定时期内的平均工资度量。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-dt-fd:ExplicitRecurrenceInterval ;
            owl:onProperty fibo-fnd-utl-alx:hasReferencePeriod ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    skos:definition "measure of the average wage an hourly or salaried worker makes in a given period of time" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=4360"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Average earnings are typically calculated on an hourly, daily, weekly, or monthly basis. They may be expressed as an amount of money or in terms of a percent change with respect to a prior period, depending on the jurisdiction and report." .

fibo-ind-ei-ei:CivilianLaborForce a owl:Class ;
    rdfs:label "civilian labor force",
        "平民劳动力（civilian labor force）"@zh ;
    rdfs:comment "在给定报告期内被视为劳动力的平民非机构人口子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:CivilianNonInstitutionalPopulation ;
    owl:disjointWith fibo-ind-ei-ei:PopulationNotInLaborForce ;
    skos:definition "subset of the civilian, non-institutional population considered to be part of the labor force during a given reporting period" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" .

fibo-ind-ei-ei:EmployedPopulation a owl:Class ;
    rdfs:label "employed population",
        "就业人口（employed population）"@zh ;
    rdfs:comment "报告期内被视为就业的平民劳动力子集。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:CivilianLaborForce ;
    skos:definition "subset of the civilian labor force considered to be employed during the reporting period" ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" ;
    cmns-av:explanatoryNote "There are a number of distinctions with respect to how individuals are counted from country to country, including whether or not they are considered employed if they are on unpaid leave for some reason, and whether or not they are counted multiple times if they have more than one paying job." .

fibo-ind-ei-ei:Productivity a owl:Class ;
    rdfs:label "productivity",
        "生产率（productivity）"@zh ;
    rdfs:comment "表示产出量度量与投入使用量度量之比的经济指标。"@zh ;
    rdfs:subClassOf fibo-ind-ei-ei:EconomicIndicator,
        cmns-qtu:Expression ;
    skos:definition "economic indicator representing ratio of a volume measure of output to a volume measure of input use" ;
    cmns-av:adaptedFrom "http://stats.oecd.org/glossary/detail.asp?ID=2167"^^xsd:anyURI,
        "http://www.oecd.org/std/productivity-stats/2352458.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "The primary objectives of productivity measurement include: (a) tracing technology change, i.e., the currently known ways of converting resources into outputs desired by the economy, (b) identifying changes in efficiency, (c) understanding real cost savings, (d) benchmarking production processes, and (e) assessing standards of living. Productivity measures may also be single factor or multifactor." .

fibo-ind-ei-ei:CivilianNonInstitutionalPopulation a owl:Class ;
    rdfs:label "civilian non-institutional population",
        "平民非机构人口（civilian non-institutional population）"@zh ;
    rdfs:comment "由居住在给定地区、达到一定年龄、不住在机构内的平民构成的统计全域。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom fibo-ind-ei-ei:CivilianNonInstitutionalPerson ],
        fibo-fnd-utl-alx:StatisticalUniverse ;
    skos:definition "statistical universe consisting of people of a certain age who reside in a given region, do not live in institutions (for example, correctional facilities, long-term care hospitals, and nursing homes), and are not on active military duty" ;
    skos:scopeNote "The civilian non-institutional population is typically reported in thousands." ;
    cmns-av:adaptedFrom "U.S. Bureau of Labor Statistics and Statistics Canada reference definitions - https://wiki.edmcouncil.org/pages/viewpage.action?pageId=6358041" .

fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea a owl:Class ;
    rdfs:label "government-specified statistical area",
        "政府指定统计区（government-specified statistical area）"@zh ;
    rdfs:comment "由政府机构定义的统计区。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rga:isGovernedBy ;
            owl:someValuesFrom fibo-be-ge-ge:GovernmentBody ],
        fibo-fnd-utl-alx:StatisticalArea ;
    skos:definition "statistical area defined by a government agency" .

fibo-ind-ei-ei:hasBaselinePopulation a owl:ObjectProperty ;
    rdfs:label "has baseline population",
        "具有基线总体（has baseline population）"@zh ;
    rdfs:comment "指明用于比较或分析的起始统计全域或总体。"@zh ;
    rdfs:range fibo-fnd-utl-alx:StatisticalUniverse ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    skos:definition "specifies the starting point statistical universe or population used for comparison or analysis" .

fibo-ind-ei-ei:EconomicIndicator a owl:Class ;
    rdfs:label "economic indicator",
        "经济指标（economic indicator）"@zh ;
    rdfs:comment "在统计区（地区）情境内规律且可比的经济活动统计度量，用于经济绩效分析。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-dt:Date ;
            owl:onProperty fibo-fnd-utl-alx:hasReleaseDate ],
        [ a owl:Restriction ;
            owl:onProperty cmns-loc:hasCoverageArea ;
            owl:someValuesFrom fibo-ind-ei-ei:GovernmentSpecifiedStatisticalArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom cmns-dt:Date ;
            owl:onProperty fibo-ind-ei-ei:hasSeriesOrigin ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-dt:CombinedDateTime ;
            owl:onProperty fibo-fnd-utl-alx:hasReleaseDateTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty fibo-ind-ei-ei:isSeasonallyAdjusted ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-arr-doc:hasReportingPeriod ;
            owl:someValuesFrom cmns-dt:ExplicitDatePeriod ],
        fibo-fnd-utl-alx:ScopedMeasure ;
    skos:definition "statistical measure of economic activity that is regular and comparable in the context of a statistical area (region), used for analysis of economic performance and predictions of future performance" ;
    skos:example "Example indicators include the average work week, weekly claims for unemployment insurance, new orders, vendor performance, stock prices, and changes in the money supply." ;
    cmns-av:adaptedFrom "Barron's Dictionary of Business and Economic Terms, Fifth Edition, 2012" ;
    cmns-av:explanatoryNote "The two main features of any indicator are the regularity with which they are measured and published, and the fact that they are comparable from one release to the next." .

