    rdfs:comment "声明市场指数（Market Indices）模块由篮子指数本体构成，及版本信息。"@zh ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/IND/20230201/MarketIndices/MetadataINDMarketIndices/> ;
