		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义抵押贷款的发起与发放流程。"@zh ;
    owl:imports fibo-be-le-lei:,
        fibo-be-le-lp:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-dae-gty:,
        fibo-fbc-fi-fi:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-arr-asmt:,
        fibo-fnd-dt-fd:,
        fibo-fnd-dt-oc:,
        fibo-fnd-law-lcap:,
