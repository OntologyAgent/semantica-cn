fibo-loan-reln-org:AutomatedSystem a owl:Class ;
    rdfs:label "automated system",
        "自动化系统（automated system）"@zh ;
    rdfs:comment "减少或消除人工参与即可完成任务的系统。"@zh ;
    rdfs:subClassOf cmns-col:Arrangement ;
    skos:definition "system that reduces or eliminates the need for human involvement in order to complete a task" ;
    cmns-av:adaptedFrom "https://www.reference.com/technology/automated-system-c85583d0f17a632" .

fibo-loan-reln-org:MortgageIndemnityGuarantee a owl:Class ;
    rdfs:label "mortgage indemnity guarantee"@en,
        "抵押赔偿担保（mortgage indemnity guarantee）"@zh ;
    rdfs:comment "在抵押贷款还款因故中断（如借款人死亡或失业）时保护贷款人的保险型担保。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isExemplifiedBy ;
            owl:someValuesFrom fibo-loan-reln-org:MortgageIndemnityInsurancePolicy ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-gty:isGuaranteedBy ;
            owl:someValuesFrom fibo-loan-reln-org:MortgageIndemnityGuarantor ],
        fibo-fbc-dae-gty:InsuranceBackedGuaranty ;
    skos:definition "insurance-backed guarantee that protects lenders if the mortgage repayments cease for some reason, perhaps due to death or a homeowner being made redundant at work"@en ;
    skos:editorialNote "See notes from SME Review and in MIG Provider. Applies to securitized pool, insures the lender. Additional note (IBM): there is a further application of this. When a lender takes a loan which is a where the value of the loan is greater than 80% of the value of the property, at that point it is required for the lender to also get a private mortgage insurance, so they are paying separately for the mortgage insurance so that if the borrower defaults above 80% then the mortgage insurance pays the loss. In the Loan Party Insurer (new \"Party\" type) you have Loan Party Insured Ratio (e.g. the 80% in the example above). These are different situations but the same principle. So this needs to be modeled for both. 30 June: Is this Lender or Borrower? since you have one lender and one borrower in a single loan, but multiple lenders in the case of packaging this up for a security - there are then multiple lenders and multiple borrowers. A similar kind of insurance exists in the one lender one borrower scenario i.e. the mortgage loan itself. There are two concepts here. the MIG thing was for bundling these. the MIG might apply across multiple contracts, but still be a fact about \"the\" contract? The notes about 80% above (IBM) are about the individual loan. ACTION: Tidy this up."@en .

fibo-loan-reln-org:MortgageIndemnityInsurancePolicy a owl:Class ;
    rdfs:label "mortgage indemnity insurance policy"@en,
        "抵押赔偿保险单（mortgage indemnity insurance policy）"@zh ;
    rdfs:comment "提供抵押赔偿担保的保险单。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:isEvidenceFor ;
            owl:someValuesFrom fibo-loan-reln-org:MortgageIndemnityGuarantee ],
        fibo-fbc-dae-gty:InsurancePolicy ;
    skos:definition "insurance policy providing the mortgage indemnity guarantee"@en .

fibo-loan-reln-org:assumes a owl:ObjectProperty ;
    rdfs:label "assumes",
        "承接（assumes）"@zh ;
    rdfs:comment "将新抵押贷款合同关联到先前就同一物业向不同借款人发放的旧合同；新合同通过法律行为设立。"@zh ;
    skos:definition "relates a new mortgage loan contract to a previous one made to a different borrower for the same property. The new contract is created via a legally binding process where the new borrower assumes the terms of the previous loan contract" .

fibo-loan-reln-org:hasNumberOfAffordableDwellingUnits a owl:DatatypeProperty ;
    rdfs:label "has number of affordable dwelling units",
        "具有可负担住宅单元数（has number of affordable dwelling units）"@zh ;
    rdfs:comment "将房地产关联到其中按联邦、州或地方可负担住房计划设有收入限制的住宅单元数。"@zh ;
    rdfs:subPropertyOf fibo-loan-reln-org:hasNumberOfDwellingUnits ;
    skos:definition "relates real estate to the number of dwelling units it contains that are income-restricted under Federal, State, or local affordable housing programs." ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:hasOriginatingServiceProvider a owl:ObjectProperty ;
    rdfs:label "has originating service provider",
        "具有发起服务提供商（has originating service provider）"@zh ;
    rdfs:comment "将某事物（通常为贷款合同）关联到负责发起该贷款的服务提供商。"@zh ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( fibo-fbc-pas-fpas:FinancialServiceProvider [ a owl:Class ;
                        owl:unionOf ( fibo-fnd-agr-ctr:ContractParty fibo-fnd-agr-ctr:ContractThirdParty ) ] ) ] ;
    rdfs:subPropertyOf cmns-pts:hasPartyRole ;
    skos:definition "relates something, typically a loan contract, to the service provider responsible for originated the loan" ;
    cmns-av:explanatoryNote "Typically this will be a bank, mortgage broker, investment bank, or other similar party." .

fibo-loan-reln-org:hasOriginatorPerson a owl:ObjectProperty ;
    rdfs:label "has originator person",
        "具有发起人（has originator person）"@zh ;
    rdfs:comment "将某事物（通常为贷款）关联到最初发起或创建它的人。"@zh ;
    rdfs:range fibo-be-le-lp:LegallyCompetentNaturalPerson ;
    rdfs:subPropertyOf cmns-pts:hasParty ;
    skos:definition "relates something, typically a loan, to a person that initially originates or creates it" .

fibo-loan-reln-org:MortgageIndemnityGuarantor a owl:Class ;
    rdfs:label "mortgage indemnity guarantor"@en,
        "抵押赔偿担保人（mortgage indemnity guarantor）"@zh ;
    rdfs:comment "以抵押赔偿担保（MIG）形式提供抵押保险的担保人兼保险人。"@zh ;
    rdfs:subClassOf fibo-fbc-dae-gty:Guarantor,
        fibo-fbc-dae-gty:Insurer ;
    skos:definition "guarantor and insurer that provides mortgage insurance in the form of a mortgage indemnity guarantee (MIG)"@en ;
    cmns-av:explanatoryNote "SME Review notes 16 Sept: Guaranty - mortgage insurance e.g. insure up to 80% exposure. When you get into indemnification, then for instance if the product doesn't meet the investor's requirement such that if it doesn't get paid then the lender steps in and takes the hit for the loan - this is usually a precondition for securitizing (issuing) the loan in a pool. If the loan is not going to be sold on the secondary market there would be no need to indemnify that loan so this term would not apply. Indemnification is insurance for the investor, while the lender is the one providing that indemnification."@en .

fibo-loan-reln-org:NMLSR-ID a owl:Class ;
    rdfs:label "Nationwide Mortgage Licensing System and Registry Identifier",
        "全国抵押贷款许可系统与登记处标识符（Nationwide Mortgage Licensing System and Registry Identifier）"@zh ;
    rdfs:comment "NMLS 为每个维持登记的公司、分支和个人永久分配的编号。"@zh ;
    rdfs:subClassOf fibo-fnd-law-lcap:LicenseIdentifier ;
    skos:definition "the number permanently assigned by the Nationwide Mortgage Licensing System and Registry (NMLS) for each company, branch, and individual that maintains a single account on NMLS." ;
    cmns-av:abbreviation "NMLSR ID" ;
    cmns-av:adaptedFrom "http://mortgage.nationwidelicensingsystem.org/about/Pages/NMLSID.aspx" .

fibo-loan-reln-org:hasNumberOfDwellingUnits a owl:DatatypeProperty ;
    rdfs:label "has number of dwelling units",
        "具有住宅单元数（has number of dwelling units）"@zh ;
    rdfs:comment "将房地产关联到其所含的住宅单元数。"@zh ;
    rdfs:subPropertyOf fibo-fnd-dt-fd:hasCount ;
    skos:definition "relates real estate to the number of dwelling units it contains" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-mtg:LoanSecuredByRealEstate a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-loan-reln-org:hasOriginatorPerson ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( fibo-be-le-lp:LegallyCompetentNaturalPerson [ a owl:Restriction ;
                                owl:onProperty cmns-id:isIdentifiedBy ;
                                owl:someValuesFrom fibo-loan-reln-org:NMLSR-ID ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-loan-reln-org:hasOriginatingServiceProvider ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( fibo-fbc-pas-fpas:FinancialServiceProvider [ a owl:Restriction ;
                                owl:onProperty cmns-id:isIdentifiedBy ;
                                owl:someValuesFrom fibo-loan-reln-org:NMLSR-ID ] ) ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-loan-ln-ln:Servicer ;
            owl:onProperty fibo-loan-ln-ln:isServicedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-loan-reln-org:MortgageIndemnityGuarantor ;
            owl:onProperty fibo-fbc-dae-gty:hasGuarantor ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-loan-reln-mtg:LoanSecuredByRealEstate ;
            owl:onProperty fibo-loan-reln-org:assumes ] .

fibo-loan-reln-org:CashOutStatus a owl:Class ;
    rdfs:label "cash-out status",
        "提现状态（cash-out status）"@zh ;
    rdfs:comment "表明在以新贷款为现有贷款再融资的发放中向借款人释放资金之程度的分类符。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "classifier indicating the extent to which funds are released to the borrower on a new loan origination that refinances an existing loan" ;
    cmns-av:explanatoryNote "This is subject to lender and/or investor policy(s)." .

fibo-loan-reln-org:DwellingCapacity a owl:Class ;
    rdfs:label "dwelling capacity",
        "住宅容量（dwelling capacity）"@zh ;
    rdfs:comment "表明某物业拥有多少住宅单元的分类符。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "classifier indicating how many dwellings some property has" .

fibo-loan-reln-org:ManufacturedHomeLegalClassification a owl:Class ;
    rdfs:label "manufactured home legal classification",
        "活动房屋法律分类（manufactured home legal classification）"@zh ;
    rdfs:comment "表明覆盖贷款仅以活动房屋作担保、还是连同土地一起作担保的类别。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "category indicating whether the covered loan is secured by a manufactured home only or with land as well" ;
    cmns-av:adaptedFrom "2015 Revised HMDA regulation" .

fibo-loan-reln-org:PropertyUsage a owl:Class ;
    rdfs:label "property usage",
        "物业用途（property usage）"@zh ;
    rdfs:comment "表明借款人拟如何使用该物业的类别。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "a category indicating the manner in which the borrower intends to utilize the property" .

fibo-loan-reln-org:AutomatedUnderwritingSystem a owl:Class ;
    rdfs:label "automated underwriting system",
        "自动核保系统（automated underwriting system）"@zh ;
    rdfs:comment "收集批准贷款申请所需信息、支持抵押贷款人对新申请进行分析的软件系统。"@zh ;
    rdfs:subClassOf fibo-loan-reln-org:AutomatedSystem ;
    skos:definition "software system that collects the information necessary to approve a loan application and supports a mortgage lender's analysis of a new loan application" ;
    cmns-av:explanatoryNote "In the United States, automated underwriting systems review the applicant's credit history and ability to repay the loan, and determine whether the price the applicant is offering to pay is supported by the property value." .

fibo-loan-reln-org:ChargeCategory a owl:Class ;
    rdfs:label "charge category",
        "收费类别（charge category）"@zh ;
    rdfs:comment "收费类别，如结清费用、利息、税项及其他服务相关费用。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "Examples include closing costs, interest, taxes, and other service-related fees.",
        "classifier indicating what a particular fee or other expense is for" ;
    cmns-av:usageNote "Use with LineItem, (has ChargeCategory instance), (hasNumericalValue for number of units) and (hasCost for the amount of money)" .

fibo-loan-reln-org:MortgageLoanPurpose a owl:Class ;
    rdfs:label "mortgage loan purpose",
        "抵押贷款用途（mortgage loan purpose）"@zh ;
    rdfs:comment "抵押贷款资金的用途，如购置不动产、住宅建设或贷款再融资。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "the purpose for which mortgage loan proceeds will be used, such as real property purchase, dwelling construction, or loan refinancing" .

fibo-loan-reln-org:AmortizationType a owl:Class ;
    rdfs:label "amortization type",
        "摊销类型（amortization type）"@zh ;
    rdfs:comment "摊销算法的分类符。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "classifier of amortization algorithms" .

