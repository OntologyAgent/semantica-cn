@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-le-lei: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/> .
@prefix fibo-fbc-dae-gty: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-arr-asmt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-fnd-law-lcap: <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/> .
@prefix fibo-fnd-plc-adr: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/> .
@prefix fibo-fnd-plc-rp: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-loan-ln-ln: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/> .
@prefix fibo-loan-reln-mtg: <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/Mortgages/> .
@prefix fibo-loan-reln-org: <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-fnd-plc-rp:RealProperty a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-loan-reln-org:hasNumberOfDwellingUnits ;
            owl:someValuesFrom xsd:positiveInteger ],
        [ a owl:Restriction ;
            owl:onProperty fibo-loan-reln-org:hasNumberOfAffordableDwellingUnits ;
            owl:someValuesFrom xsd:positiveInteger ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:someValuesFrom fibo-loan-reln-org:DwellingCapacity ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:someValuesFrom fibo-loan-reln-org:ManufacturedHomeLegalClassification ] .

fibo-loan-reln-org:AmortizationType-adjustableRate a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "adjustable rate" ;
    skos:definition "a loan that allows the lender to periodically adjust the interest rate in accordance with a specified index" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:AmortizationType-fixedRate a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "fixed rate" ;
    skos:definition "a loan in which the interest rate and payments remain the same for the life of the loan" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:AmortizationType-graduatedPayment a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "graduated payment" ;
    skos:definition "a flexible payment loan where the payments increase for a specified period of time and then level off" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." ;
    cmns-av:explanatoryNote "Usually involves negative amortization." .

fibo-loan-reln-org:AmortizationType-graduatedPaymentAdjustable a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "graduated payment adjustable" ;
    skos:definition "a loan for which there are periodic payments/rate changes with additional specified principal and interest changes as documented in the Security Instruments." ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:AmortizationType-growingEquity a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "growing equity" ;
    skos:definition "A graduated payment loan in which increases in a borrowers loan payments are used to accelerate reduction of principal on the mortgage" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." ;
    cmns-av:explanatoryNote "Due to increased payment, the borrower acquires equity more rapidly and retires the debt earlier." .

fibo-loan-reln-org:AmortizationType-rateImprovement a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "rate improvement" ;
    skos:definition "a type of flexible loan where the interest rate may decrease based on payment history." ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:AmortizationType-step a owl:NamedIndividual,
        fibo-loan-reln-org:AmortizationType ;
    rdfs:label "step" ;
    skos:definition "a loan with fixed periodic payment/rate changes without subsidy or negative amortization." ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:AutomatedUnderwritingSystem-DesktopUnderwriter a owl:NamedIndividual,
        fibo-loan-reln-org:AutomatedUnderwritingSystem ;
    rdfs:label "Desktop Underwriter" ;
    skos:definition "an automated underwriting software system produced by Fannie Mae" .

fibo-loan-reln-org:AutomatedUnderwritingSystem-FHAScorecard a owl:NamedIndividual,
        fibo-loan-reln-org:AutomatedUnderwritingSystem ;
    rdfs:label "FHA Scorecard" ;
    skos:definition "an automated underwriting software system produced by Federal Housing Administration (FHA)" .

fibo-loan-reln-org:AutomatedUnderwritingSystem-GuaranteedUnderwritingSystem a owl:NamedIndividual,
        fibo-loan-reln-org:AutomatedUnderwritingSystem ;
    rdfs:label "Guaranteed Underwriting System" ;
    skos:definition "an automated underwriting software system used by the USDA rural development loan program" ;
    cmns-av:synonym "GUS" .

fibo-loan-reln-org:AutomatedUnderwritingSystem-LoanProspector a owl:NamedIndividual,
        fibo-loan-reln-org:AutomatedUnderwritingSystem ;
    rdfs:label "Loan Prospector" ;
    skos:definition "an automated underwriting software system produced by Freddie Mac" .

fibo-loan-reln-org:CashOutStatus-CashOut a owl:NamedIndividual,
        owl:Thing,
        fibo-loan-reln-org:CashOutStatus ;
    rdfs:label "cashout" ;
    skos:definition "the mortgage is refinanced for more than is owed and the borrower pockets the difference." .

fibo-loan-reln-org:CashOutStatus-LimitedCashOut a owl:NamedIndividual,
        owl:Thing,
        fibo-loan-reln-org:CashOutStatus ;
    rdfs:label "limited cashout" ;
    skos:definition "a cashout mortgage where the amount is limited by the lenger. 80% loan to value ratio is a common limit." .

fibo-loan-reln-org:CashOutStatus-NoCashOut a owl:NamedIndividual,
        owl:Thing,
        fibo-loan-reln-org:CashOutStatus ;
    rdfs:label "no cashout" ;
    skos:definition "The mortgage is refinanced for less than or equal to what is owed." .

fibo-loan-reln-org:ChargeCategory-appraisalFee a owl:NamedIndividual,
        fibo-loan-reln-org:ChargeCategory ;
    rdfs:label "appraisal fee" ;
    skos:definition "a charge for an appraisal" .

fibo-loan-reln-org:ChargeCategory-discountPoints a owl:NamedIndividual,
        fibo-loan-reln-org:ChargeCategory ;
    rdfs:label "discount points" ;
    skos:definition "a charge for lowering your interest rate" ;
    cmns-av:adaptedFrom "https://www.consumerfinance.gov/askcfpb/136/what-are-discount-points-and-lender-credits-and-how-do-they-work.html" .

fibo-loan-reln-org:ChargeCategory-lenderCredits a owl:NamedIndividual,
        fibo-loan-reln-org:ChargeCategory ;
    rdfs:label "lender credits" ;
    skos:definition "a credit whereby the lender reduces closing costs in exchange for a higher interest rate." ;
    cmns-av:adaptedFrom "https://www.consumerfinance.gov/askcfpb/136/what-are-discount-points-and-lender-credits-and-how-do-they-work.html" ;
    cmns-av:usageNote "This needs to be treated as a negative charge." .

fibo-loan-reln-org:ChargeCategory-originationFee a owl:NamedIndividual,
        fibo-loan-reln-org:ChargeCategory ;
    rdfs:label "origination fee" ;
    skos:definition "a charge for an origination" .

fibo-loan-reln-org:ChargeCategory-principal a owl:NamedIndividual,
        fibo-loan-reln-org:ChargeCategory ;
    rdfs:label "principal" ;
    skos:definition "the principal of the loan that is owed" .

fibo-loan-reln-org:DwellingCapacity-multiFamily a owl:NamedIndividual,
        fibo-loan-reln-org:DwellingCapacity ;
    rdfs:label "multi-family" ;
    skos:definition "5 or more units" .

fibo-loan-reln-org:DwellingCapacity-singleFamily a owl:NamedIndividual,
        owl:Thing,
        fibo-loan-reln-org:DwellingCapacity ;
    rdfs:label "single family" ;
    skos:definition "1-4 units" .

fibo-loan-reln-org:GovernmentSponsoredLoan a owl:Class ;
    rdfs:label "government-sponsored loan"@en,
        "政府支持贷款（government-sponsored loan）"@zh ;
    rdfs:comment "由政府支持机构发起或担保的贷款。"@zh ;
    rdfs:subClassOf fibo-loan-reln-mtg:LoanSecuredByRealEstate .

fibo-loan-reln-org:ManufacturedHomeLegalClassification-personalProperty a owl:NamedIndividual,
        fibo-loan-reln-org:ManufacturedHomeLegalClassification ;
    rdfs:label "personal property" ;
    skos:definition "the covered loan is secured by a manufactured home but not land" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:ManufacturedHomeLegalClassification-realProperty a owl:NamedIndividual,
        fibo-loan-reln-org:ManufacturedHomeLegalClassification ;
    rdfs:label "real property" ;
    skos:definition "the covered loan is secured by a manufactured home and land" ;
    cmns-av:adaptedFrom "the 2015 Revised HMDA regulation." .

fibo-loan-reln-org:MortgageLoanPurpose-BusinessOrCommercial a owl:NamedIndividual,
        fibo-loan-reln-org:MortgageLoanPurpose ;
    rdfs:label "business or commercial" .

fibo-loan-reln-org:MortgageLoanPurpose-DwellingConstruction a owl:NamedIndividual,
        fibo-loan-reln-org:MortgageLoanPurpose ;
    rdfs:label "dwelling construction" .

fibo-loan-reln-org:MortgageLoanPurpose-HomeImprovement a owl:NamedIndividual,
        fibo-loan-reln-org:MortgageLoanPurpose ;
    rdfs:label "home improvement" .

fibo-loan-reln-org:MortgageLoanPurpose-LoanRefinancing a owl:NamedIndividual,
        fibo-loan-reln-org:MortgageLoanPurpose ;
    rdfs:label "loan refinancing" .

fibo-loan-reln-org:MortgageLoanPurpose-MortgageModification a owl:NamedIndividual,
        fibo-loan-reln-org:MortgageLoanPurpose ;
    rdfs:label "mortgage modification" .

fibo-loan-reln-org:MortgageLoanPurpose-RealPropertyPurchase a owl:NamedIndividual,
        fibo-loan-reln-org:MortgageLoanPurpose ;
    rdfs:label "real property purchase" .

fibo-loan-reln-org:PropertyUsage-investment a owl:NamedIndividual,
        fibo-loan-reln-org:PropertyUsage ;
    rdfs:label "investment" ;
    skos:definition "a home owned for the purpose of generating income" .

fibo-loan-reln-org:PropertyUsage-primaryResidence a owl:NamedIndividual,
        fibo-loan-reln-org:PropertyUsage ;
    rdfs:label "primary residence" ;
    skos:definition "residence that the owner physically occupies and uses as his or her principal residence" .

fibo-loan-reln-org:PropertyUsage-secondHome a owl:NamedIndividual,
        owl:Thing,
        fibo-loan-reln-org:PropertyUsage ;
    rdfs:label "second home" ;
    skos:definition "a property occupied by the owner for a portion of the year that is not the primary residence" .

fibo-loan-reln-org:isLienOn a owl:ObjectProperty ;
    rdfs:label "is lien on",
        "是……的留置权（is lien on）"@zh ;
    rdfs:comment "标识留置权所针对的财产。"@zh .

