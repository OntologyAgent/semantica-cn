@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fnd-arr-lif: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-md-temx-trs: <https://spec.edmcouncil.org/fibo/ontology/MD/TemporalCore/SecurityTradingStatuses/> .
@prefix fibo-sec-sec-lst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

fibo-md-temx-trs:Active a owl:Class ;
    rdfs:label "active"@en,
        "活跃（active）"@zh ;
    rdfs:comment "证券处于活跃交易状态。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:SecurityTradingStatus ;
    owl:disjointWith fibo-md-temx-trs:Inactive ;
    skos:definition "Security is actively traded"@en .

fibo-md-temx-trs:ActivelyTrading a owl:Class ;
    rdfs:label "actively trading"@en,
        "活跃交易中（actively trading）"@zh ;
    rdfs:comment "证券正在交易所或交易设施上活跃交易。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:ExchangeSecurityTradingStatus ;
    owl:disjointWith fibo-md-temx-trs:TradingHalted ;
    skos:definition "Security is actively traded on the exchange or trading facility"@en .

fibo-md-temx-trs:Issued a owl:Class ;
    rdfs:label "issued"@en,
        "发布日期（issued）"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:SecurityLifecycleStatus ;
    skos:definition "The security has been issued into the secondary market."@en .

fibo-md-temx-trs:WhenDistributed a owl:Class ;
    rdfs:label "when distributed"@en,
        "发行后交付前交易（when distributed）"@zh ;
    rdfs:comment "指证券在发行日之后、证书交付之前进行交易的状态。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:SecurityLifecycleStatus ;
    skos:definition "Used to refer to a security that trades after the date of issue but before the time at which the certificates are delivered"@en .

fibo-md-temx-trs:WhenIssued a owl:Class ;
    rdfs:label "when issued"@en,
        "预发行交易（when issued）"@zh ;
    rdfs:comment "证券在其预定发行日之前进行的交易（灰市交易）。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:SecurityLifecycleStatus ;
    skos:definition "When Issued or Gray Market trading is when a security is traded ahead of the date at which it is to be issued."@en .

fibo-md-temx-trs:Worthless a owl:Class ;
    rdfs:label "worthless"@en,
        "无价值（worthless）"@zh ;
    rdfs:comment "监管机构公告该证券已变得毫无价值。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:SecurityLifecycleStatus ;
    skos:definition "Announcement by the regulator that the security has become worthless."@en ;
    cmns-av:explanatoryNote "e.g. bankruptcy hearings - might result in this being said."@en .

fibo-md-temx-trs: a owl:Ontology ;
    rdfs:label "SecurityTradingStatuses"@en,
        "证券交易状态时序本体（Security Trading Statuses Ontology）"@zh ;
    dcterms:abstract "This ontology defines the various kinds of trading status that a security may be in at any given point in time. These includes such terms as active and halted, inactive and so on, along with their qualifying terms." ;
    dcterms:license """Copyright (c) 2013-2025 EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.
		
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义证券交易状态（正常、停牌等）随时间的表示。"@zh ;
    owl:imports fibo-fbc-fi-fi:,
        fibo-fnd-arr-lif:,
        fibo-fnd-utl-av:,
        fibo-sec-sec-lst:,
        cmns-av:,
        cmns-cls: ;
    owl:versionIRI fibo-md-temx-trs: ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional ;
    cmns-av:copyright "Copyright (c) 2013-2025 EDM Council, Inc." .

fibo-md-temx-trs:Inactive a owl:Class ;
    rdfs:label "inactive"@en,
        "不活跃（inactive）"@zh ;
    rdfs:comment "证券处于不活跃状态。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:SecurityTradingStatus .

fibo-md-temx-trs:TradingHalted a owl:Class ;
    rdfs:label "trading halted"@en,
        "交易停牌（trading halted）"@zh ;
    rdfs:comment "证券交易被暂停。"@zh ;
    rdfs:subClassOf fibo-md-temx-trs:ExchangeSecurityTradingStatus .

fibo-md-temx-trs:ExchangeSecurityTradingStatus a owl:Class ;
    rdfs:label "exchange security trading status"@en,
        "交易所证券交易状态（exchange security trading status）"@zh ;
    rdfs:comment "上市证券在给定交易所的交易状态。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-sec-sec-lst:Listing ],
        fibo-fnd-arr-lif:LifecycleStatus ;
    skos:definition "trading status of a listed security on a given trading exchange"@en .

fibo-md-temx-trs:SecurityTradingStatus a owl:Class ;
    rdfs:label "security trading status"@en,
        "证券交易状态（security trading status）"@zh ;
    rdfs:comment "证券在是否可交易方面的状态，以及与交易相关的特殊事项。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-fbc-fi-fi:Security ],
        fibo-fnd-arr-lif:LifecycleStatus ;
    skos:definition "status of the security in terms of whether it is trading or not, and any special considerations relating to trading"@en ;
    skos:editorialNote "Exchange Traded Security trading status is now a separate term, covering trading suspension on an exchange, so that does not form part of this term."@en .

fibo-md-temx-trs:SecurityLifecycleStatus a owl:Class ;
    rdfs:label "security lifecycle status"@en,
        "证券生命周期状态（security lifecycle status）"@zh ;
    rdfs:comment "证券在其生命周期内所处的状态。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-fbc-fi-fi:Security ],
        fibo-fnd-arr-lif:LifecycleStatus ;
    skos:definition "status of a security within its lifecycle"@en .

