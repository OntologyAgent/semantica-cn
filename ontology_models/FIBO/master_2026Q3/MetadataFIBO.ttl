    rdfs:label "Metadata for FIBO",
        "FIBO 全库元数据清单（Metadata for FIBO）"@zh ;
    dcterms:abstract "This is the top-level metadata vocabulary used to describe the Financial Industry Business Ontology (FIBO)." ;
