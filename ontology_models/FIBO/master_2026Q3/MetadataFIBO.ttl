    dcterms:modified "2026-04-15T18:00:00"^^xsd:dateTime ;
    rdfs:comment "FIBO 的最高层清单文件：声明整个 FIBO 由 12 个域（BE、FBC、FND、SEC、DER、LOAN、IND、BP、CAE、MD、EXMP、ACTUS）构成，并携带全库的版本、版权与许可信息，是发布管理意义上的「总目录」。"@zh ;
    owl:imports fibo-actus-mod:,
        fibo-be-mod:,
        fibo-bp-mod:,
        fibo-cae-mod:,
        fibo-der-mod:,
        fibo-exmp-mod:,
        fibo-fbc-mod:,
        fibo-fnd-mod:,
        fibo-fnd-utl-av:,
        fibo-ind-mod:,
        fibo-loan-mod:,
        fibo-md-mod:,
        fibo-sec-mod:,
        cmns-av: ;
