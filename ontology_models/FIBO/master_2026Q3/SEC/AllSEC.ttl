		See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2026-07-08T18:00:00"^^xsd:dateTime ;
    dcterms:title "EDMC Financial Industry Business Ontology (FIBO) Securities (SEC) Domain" ;
    rdfs:comment "聚合证券（Securities，SEC）域的全部生产本体：债券、股票、基金、证券化产品、证券识别、分类、发行、上市与限制等，一次导入即获得 SEC 域完整模型。"@zh ;
    rdfs:seeAlso <https://www.edmcouncil.org/fibo/> ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/IND/AllIND/>,
        fibo-sec-dbt-abs:,
        fibo-sec-dbt-bnd:,
        fibo-sec-dbt-dbti:,
        fibo-sec-dbt-dln:,
        fibo-sec-dbt-ex:,
        fibo-sec-dbt-pbs:,
        fibo-sec-dbt-tstd:,
        fibo-sec-eq-dr:,
        fibo-sec-eq-eq:,
        <https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/Funds/>,
        fibo-sec-sec-bsk:,
        fibo-sec-sec-sch:,
        fibo-sec-sec-pls:,
        fibo-sec-sec-cls:,
        fibo-sec-sec-id:,
        fibo-sec-sec-iss:,
        fibo-sec-sec-lst:,
        fibo-sec-sec-rst: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/SEC/20260701/AllSEC/> ;
    cmns-av:copyright "Copyright (c) 2018-2025 Object Management Group, Inc.",
        "Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for SEC is provided for convenience for FIBO users. This ontology does not add new assertions, but imports most of the Production (Released) ontologies that comprise the FIBO Foundations (FND), Business Entities (BE), Financial Business and Commerce (FBC), Indices and Indicators (IND), and Securities (SEC) domains, excluding most individuals for governments and jurisdictions (aside from those used in depositary receipts), financial services, regulatory organizations and related registries, and reference individuals, as well as the LCC region-specific ontologies." .

