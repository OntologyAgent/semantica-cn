@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix cmns-ra: <https://www.omg.org/spec/Commons/RegistrationAuthorities/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-ge-ge: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/> .
@prefix fibo-be-le-cb: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/> .
@prefix fibo-be-tr-tr: <https://spec.edmcouncil.org/fibo/ontology/BE/Trusts/Trusts/> .
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/> .
@prefix fibo-fbc-dae-gty: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-acc-4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-agr-agr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-dt-bd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-pas-psch: <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-ind-ei-ei: <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/> .
@prefix fibo-ind-ind-ind: <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/> .
@prefix fibo-ind-ir-ir: <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/> .
@prefix fibo-sec-dbt-bnd: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/Bonds/> .
@prefix fibo-sec-dbt-dbti: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/> .
@prefix fibo-sec-dbt-tstd: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/TradedShortTermDebt/> .
@prefix fibo-sec-eq-eq: <https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/> .
@prefix fibo-sec-sec-iss: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/> .
@prefix fibo-sec-sec-lst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-sec-dbt-bnd: a owl:Ontology ;
    rdfs:label "Bonds Ontology",
        "债券本体（Bonds Ontology）"@zh ;
    dcterms:abstract "This ontology defines the basic concept of a bond and a number of bond variants including convertible and callable bonds. Medium term notes (MTNs) and debentures are also defined." ;
    dcterms:license """Copyright (c) 2016-2025 EDM Council, Inc.
Copyright (c) 2018-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义债券（bond）：期限、票面利率、付息方式与偿还结构。"@zh ;
    owl:imports <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/>,
        fibo-be-ge-ge:,
        fibo-be-le-cb:,
        fibo-be-tr-tr:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-dae-gty:,
        fibo-fbc-fi-fi:,
        fibo-fbc-fct-fse:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-acc-4217:,
        fibo-fnd-agr-agr:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-dt-bd:,
        fibo-fnd-dt-fd:,
        fibo-fnd-dt-oc:,
        fibo-fnd-gao-obj:,
        <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/>,
        fibo-fnd-pas-psch:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        fibo-ind-ei-ei:,
        fibo-ind-ind-ind:,
        fibo-ind-ir-ir:,
        fibo-sec-dbt-dbti:,
        fibo-sec-dbt-tstd:,
        fibo-sec-eq-eq:,
        fibo-sec-sec-iss:,
        fibo-sec-sec-lst:,
        cmns-av:,
        cmns-col:,
        cmns-dt:,
        cmns-doc:,
        cmns-org:,
        cmns-qtu:,
        cmns-ra:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/SEC/20251201/Debt/Bonds/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/SEC/20190901/Securities/Debt/Bonds.rdf version of this ontology was revised to reflect the refactored definition of a listing and improve the definition of corporate bond.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20191201/Securities/Debt/Bonds.rdf version of this ontology was revised to eliminate duplication of concepts in LCC and eliminate a redundant superclass from RegularCouponSchedule.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20200401/Securities/Debt/Bonds.rdf version of this ontology was revised to eliminate a duplicate 'isBasedOn' property and replace it with the property of the same name in the debt ontology, to revise the inheritance hierarchy for bond conversion terms to reflect changes in the representation of redemption more generally, to reflect the move of redemption provision from debt to financial instruments, and eliminate circular and ambiguous definitions.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20200901/Securities/Debt/Bonds.rdf version of this ontology was revised to eliminate false positives in hygiene tests due to concept names containing words, such as 'and', which might indicate that the concept actually reflects more than one thing, including distinguishing zero coupon from original issue discount bonds, and replace the use of call price and put price, which are overly constrained, with monetary price.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20210301/Securities/Debt/Bonds.rdf version of this ontology was revised to eliminate references to the exercise conventions ontology, which are not needed for bonds.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20210501/Securities/Debt/Bonds.rdf version of this ontology was revised to allow for variation in index-linked bonds, such as those whose interest payments vary with an index in addition to those that have a variable principal linked to an index and to make a number of corrections to the class hierarchy.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20211001/Securities/Debt/Bonds.rdf version of this ontology was revised to incorporate the concept of a credit agreement repaid at maturity, which is a component assumed to be part of the definition of a bond, and to add an explanatory note to the definition of Treasury Bill.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20220201/Securities/Debt/Bonds.rdf version of this ontology was revised to address text formatting hygiene issues.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20220801/Debt/Bonds.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20230201/Debt/Bonds.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC), eliminating redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20230301/Debt/Bonds.rdf version of the ontology was modified to replace concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20231201/Debt/Bonds.rdf version of the ontology was modified to replace concepts from additional FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20240101/Debt/Bonds.rdf version of this ontology was modified to add an optional restriction on bond for 'has series' (FBC-322).",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20240101/Debt/Bonds.rdf version of this ontology was modified to move details regarding step schedules to the debt instruments ontology for broader use and deprecate the use of a 'coupon' schedule in favor of interest payment schedule, which is the more modern terminology, aligning with other uses of the related terms in FIBO (FBC-317).",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20241001/Debt/Bonds.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20250301/Debt/Bonds.rdf version of the ontology was modified to align the definition of 'bond with warrant' with the CFI definition (SEC-207).",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20250701/Debt/Bonds.rdf version of the ontology was modified to align the definition of 'bond with warrant' with the CFI definition (SEC-207)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2016-2025 EDM Council, Inc.",
        "Copyright (c) 2018-2025 Object Management Group, Inc." .

fibo-sec-dbt-bnd:BondInsurance a owl:Class ;
    rdfs:label "bond insurance",
        "债券保险（bond insurance）"@zh ;
    rdfs:comment "债券发行人购买的保险单，在发行人违约时保证向债券持有人偿还本金及全部相关利息。"@zh ;
    rdfs:subClassOf fibo-fbc-dae-gty:InsurancePolicy ;
    skos:definition "insurance policy that a bond issuer purchases that guarantees the repayment of the principal and all associated interest payments to the bondholders in the event of default" .

fibo-sec-dbt-bnd:BondRegistrar a owl:Class ;
    rdfs:label "bond registrar",
        "债券登记机构（bond registrar）"@zh ;
    rdfs:comment "代表发行人负责维护记名债券所有人记录的一方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-ra:registers ;
            owl:someValuesFrom fibo-sec-dbt-bnd:Bond ],
        fibo-fbc-pas-fpas:LegalAgent,
        cmns-ra:Registrar ;
    skos:definition "party responsible for maintaining records on behalf of the issuer that identify the owners of a registered bond issue" ;
    cmns-av:explanatoryNote "The trustee under a bond contract often also acts as registrar." .

fibo-sec-dbt-bnd:BondWithPartialCall a owl:Class ;
    rdfs:label "bond with partial call",
        "可部分赎回债券（bond with partial call）"@zh ;
    rdfs:comment "具有发行人可自行决定金额部分赎回之特征的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasCallFeature ;
            owl:someValuesFrom fibo-sec-dbt-bnd:PartialCallFeature ],
        fibo-sec-dbt-bnd:CallableBond ;
    skos:definition "bond with a feature whereby the issue can be partially called for amounts that are at the discretion of the issuer" .

fibo-sec-dbt-bnd:BondWithPublishedSinkingFund a owl:Class ;
    rdfs:label "bond with published sinking fund",
        "公布偿债基金债券（bond with published sinking fund）"@zh ;
    rdfs:comment "按已知且公开的偿债基金计划表进行摊销的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:AmortizingBond ;
    skos:definition "bond whereby amortization is via a known and published schedule" .

fibo-sec-dbt-bnd:BondWithWarrant a owl:Class ;
    rdfs:label "bond with warrant",
        "附权证债券（bond with warrant）"@zh ;
    dcterms:source "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fifth edition, 2021-05" ;
    rdfs:comment "发行时附带一份或多份权证的债券，权证赋予持有人购买指定证券的权利。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond that is issued together with one or more warrant(s) attached as part of the offer, the warrant(s) granting the holder the right to purchase a designated security, often the common stock of the issuer of the debt, at a specified price" ;
    cmns-av:explanatoryNote "This concept is needed primarily to support cases where the bond issuer is the issuer of the warrant." .

fibo-sec-dbt-bnd:BuildAmericaBond a owl:Class ;
    rdfs:label "Build America Bond",
        "建设美国债券（Build America Bond）"@zh ;
    rdfs:comment "依 2009 年《美国复苏与再投资法》（ARRA）于 2010 年 12 月 31 日前发行的应税市政债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond ;
    skos:definition "taxable municipal bond issued through December 31, 2010 under the American Recovery and Reinvestment Act of 2009 (ARRA)" ;
    cmns-av:explanatoryNote "BABs may be direct pay subsidy bonds or tax credit bonds." .

fibo-sec-dbt-bnd:CallableConvertibleBond a owl:Class ;
    rdfs:label "callable convertible bond",
        "可赎回可转换债券（callable convertible bond）"@zh ;
    rdfs:comment "同时具有可赎回特征的可转换债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:CallableBond,
        fibo-sec-dbt-bnd:ConvertibleBond ;
    skos:definition "convertible bond that is also callable" .

fibo-sec-dbt-bnd:CertificateOfObligation a owl:Class ;
    rdfs:label "certificate of obligation",
        "义务证书（certificate of obligation）"@zh ;
    rdfs:comment "在自然灾害等需要立即行动而无时间表决的紧急情况下供地方议会使用的市政证券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalSecurity ;
    skos:definition "municipal security available to governing councils in case of emergency, such as a natural disaster, that needs immediate action without time for voter referendum" ;
    cmns-av:abbreviation "CO" ;
    cmns-av:explanatoryNote "CO's are similar to GO bonds, except that they do not require voter approval before they are issued. The CO's are also guaranteed by the City's taxation power and are counted in the calculation of the tax rate that is needed to support debt payments.",
        "For example, when a hurricane destroys the police and emergency services building, there is no time to go through the process of voter referendum. The local council must be able to borrow the money to set up provisional buildings and necessary equipment for police and emergency services so that the community is served in continuity." .

fibo-sec-dbt-bnd:CertificateOfParticipation a owl:Class ;
    rdfs:label "certificate of participation",
        "参与证书（certificate of participation）"@zh ;
    rdfs:comment "证明对特定质押收入流（通常为发行人的租赁付款）享有按比例份额的债务工具。"@zh ;
    rdfs:subClassOf fibo-fbc-fi-fi:DebtInstrument ;
    skos:definition "debt instrument evidencing a pro rata share in a specific pledged revenue stream, usually lease payments by the issuer that are typically subject to annual appropriation" ;
    cmns-av:abbreviation "COP" ;
    cmns-av:explanatoryNote "A certificate of participation (COP) is a type of financing where an investor purchases a share of the lease revenues of a program rather than the bond being secured by those revenues. The certificate generally entitles the holder to receive a share, or participation, in the payments from a particular project. The payments are passed through the lessor to the certificate holders. The lessor typically assigns the lease and the payments to a trustee, which then distributes the payments to the certificate holders." .

fibo-sec-dbt-bnd:ConventionalGilt a owl:Class ;
    rdfs:label "conventional gilt",
        "常规金边债券（conventional gilt）"@zh ;
    rdfs:comment "由英国财政部发行的固定票息债券，保证每六个月向持有人支付固定现金（票息）直至到期。"@zh ;
    rdfs:seeAlso <https://www.dmo.gov.uk/responsibilities/gilt-market/about-gilts/> ;
    rdfs:subClassOf fibo-sec-dbt-bnd:FixedCouponBond,
        fibo-sec-dbt-bnd:UKGovernmentSecurity ;
    skos:definition "fixed coupon bond issued by HM Treasury that guarantees to pay the holder of the gilt a fixed cash payment (coupon) every six months until the maturity date, at which point the holder receives the final coupon payment and the return of the principal" ;
    cmns-av:explanatoryNote "Conventional gilts are the simplest form of government bond and constitute around 75 percent of the gilt portfolio." .

fibo-sec-dbt-bnd:EquityLinkedBond a owl:Class ;
    rdfs:label "equity linked bond",
        "股票挂钩债券（equity linked bond）"@zh ;
    rdfs:comment "基于股票随时间的回报（即价格与股息支付或总回报，类似于总回报互换）的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:VariableCouponBond ;
    skos:definition "bond based on the return on an equity over time, i.e. the price and dividend payments or the total return (similar to total return swaps)" .

fibo-sec-dbt-bnd:FirstRegularCouponDate a owl:Class ;
    rdfs:label "first regular coupon date",
        "首个常规付息日（first regular coupon date）"@zh ;
    rdfs:comment "在任何非标准（长或短）首个票息期之后，常规重复票息期系列中首次常规票息支付的计划日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "scheduled date for the first regular coupon payment, in a regular repeating series of coupon periods, after any non standard (long or short) first coupon period in the schedule" .

fibo-sec-dbt-bnd:GeneralObligationMunicipalBond a owl:Class ;
    rdfs:label "general obligation municipal bond",
        "一般责任市政债券（general obligation municipal bond）"@zh ;
    rdfs:comment "由发行市政当局的完全信用、一般资源和一般征税权力支持的市政债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:FullFaithCreditBond,
        fibo-sec-dbt-bnd:MunicipalBond ;
    owl:disjointWith fibo-sec-dbt-bnd:RevenueBond ;
    skos:definition "municipal bond that is backed by the full faith and credit and general resources of the issuing municipality, including its general taxing authority" ;
    cmns-av:abbreviation "GO bond" .

fibo-sec-dbt-bnd:GreenBond a owl:Class ;
    rdfs:label "green bond",
        "绿色债券（green bond）"@zh ;
    rdfs:comment "专门为气候或环境项目融资而发行的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond issued specifically to fund climate or environmental projects" ;
    cmns-av:explanatoryNote "These bonds are typically asset-linked and backed by the issuer's balance sheet. Green bonds finance projects aimed at energy efficiency, pollution prevention, sustainable agriculture, fishery and forestry, the protection of aquatic and terrestrial ecosystems, clean transportation, sustainable water management and the cultivation of environmentally friendly technologies, and often include incentives such as tax exemption." .

fibo-sec-dbt-bnd:ImplicitFullFaithCreditBond a owl:Class ;
    rdfs:label "implicit full faith credit bond",
        "隐含完全信用债券（implicit full faith credit bond）"@zh ;
    rdfs:comment "由政府支持机构或公司（而非政府直接）发行的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:UnsecuredBond ;
    skos:definition "bond issued by a government sponsored agency or corporation rather than by the government directly" ;
    cmns-av:explanatoryNote "It doesn't carry an explicit full faith and credit guarantee but the market believes the government wouldn't let it default or fail." ;
    cmns-av:synonym "implicit full faith and credit bond" .

fibo-sec-dbt-bnd:LastRegularCouponDate a owl:Class ;
    rdfs:label "last regular coupon date",
        "最后常规付息日（last regular coupon date）"@zh ;
    rdfs:comment "常规重复票息期系列中最后一次常规票息支付的计划日期。"@zh ;
    rdfs:subClassOf cmns-dt:ExplicitDate ;
    skos:definition "scheduled date of the last regular coupon payment, that is the last of the payments that are made according to a regular repeating series of coupon periods, before any non-standard (long or short) final coupon period in the schedule" .

fibo-sec-dbt-bnd:ListedBond a owl:Class ;
    rdfs:label "listed bond",
        "上市债券（listed bond）"@zh ;
    rdfs:comment "可在交易所交易的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond,
        fibo-sec-sec-lst:ListedSecurity ;
    owl:disjointWith fibo-sec-dbt-bnd:UnlistedBond ;
    skos:definition "bond that may be traded on an exchange" ;
    cmns-av:explanatoryNote "Most exchange traded bonds are corporate bonds (but most corporate bonds are not exchange traded bonds)." .

fibo-sec-dbt-bnd:LotteryConvention a owl:NamedIndividual,
        fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention ;
    rdfs:label "lottery convention" ;
    skos:definition "convention involving an impartial lottery for determining which securities are subject to partial call or partial redemption" .

fibo-sec-dbt-bnd:MakeWholeCall a owl:Class ;
    rdfs:label "make whole call",
        "补偿赎回（make whole call）"@zh ;
    rdfs:comment "允许发行人提前清偿剩余债务的赎回安排。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-dbti:CallEvent ;
    skos:definition "call allowing the issuer to pay off remaining debt early" ;
    cmns-av:explanatoryNote "The issuer typically has to make a lump sum payment to the investor(s) derived from a formula based on the net present value (NPV) of future coupon payments that will not be paid incrementally because of the call combined with the principal payment the investor would have received at maturity." .

fibo-sec-dbt-bnd:MandatoryConvertibleBond a owl:Class ;
    rdfs:label "mandatory convertible bond",
        "强制可转换债券（mandatory convertible bond）"@zh ;
    rdfs:comment "无论股票价格如何、到期时强制转换为股份的可转换债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ;
            owl:someValuesFrom fibo-sec-dbt-bnd:BondConversionTerms ],
        fibo-sec-dbt-bnd:ConvertibleBond ;
    skos:definition "convertible bond that converts into shares at maturity regardless of the equity price" ;
    cmns-av:explanatoryNote "The conversion ratio at maturity reflects the equity price and par value of the bond when issued. There is also typically a second higher conversion ratio if the equity price rises above the strike during the term of the bond." .

fibo-sec-dbt-bnd:MunicipalNote a owl:Class ;
    rdfs:label "municipal note",
        "市政票据（municipal note）"@zh ;
    rdfs:comment "在某一日期偿还指定本金及按约定利率计付利息的短期债务，通常以特定收入来源偿付。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalSecurity ;
    skos:definition "short-term obligation to repay a specified principal amount on a certain date, together with interest at a stated rate, usually payable from a defined source of anticipated revenues" ;
    cmns-av:explanatoryNote "Notes usually mature in one year or less, although notes of longer maturities are also issued." .

fibo-sec-dbt-bnd:OriginalIssueDiscountBond a owl:Class ;
    rdfs:label "original issue discount bond",
        "原始发行折价债券（original issue discount bond）"@zh ;
    rdfs:comment "以面值大幅折价发行的附息债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-sec-dbt-dbti:ParValue ;
            owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-sec-dbt-bnd:hasOriginalIssueDiscountAmount ],
        fibo-sec-dbt-bnd:Bond ;
    skos:definition "interest-bearing bond issued at a deep discount to face value" ;
    cmns-av:explanatoryNote "An original issue discount (OID) is the discount in price from a bond's face value at the time a bond or other debt instrument is first issued. The OID is the amount of discount or the difference between the original face value and the price paid for the bond.",
        "The principal amount accretes over time at a constant accrual rate and is redeemed at full face value at maturity." ;
    cmns-av:synonym "OID bond" .

fibo-sec-dbt-bnd:PartialCall a owl:Class ;
    rdfs:label "partial call",
        "部分赎回（partial call）"@zh ;
    rdfs:comment "对债券发行的一部分进行赎回。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-dbti:CallEvent ;
    skos:definition "call of part of an issue" .

fibo-sec-dbt-bnd:PercentageCumulativeAverageValue a owl:NamedIndividual,
        fibo-sec-dbt-bnd:RateBasisConvention ;
    rdfs:label "percentage cumulative average value" ;
    skos:definition "rate basis calculated as a percentage of cumulative average value" ;
    cmns-av:abbreviation "percentage CAV" .

fibo-sec-dbt-bnd:PercentageParValue a owl:NamedIndividual,
        fibo-sec-dbt-bnd:RateBasisConvention ;
    rdfs:label "percentage par value" ;
    skos:definition "rate basis calculated as a percentage of par value" .

fibo-sec-dbt-bnd:PerpetualBond a owl:Class ;
    rdfs:label "perpetual bond",
        "永续债券（perpetual bond）"@zh ;
    rdfs:comment "没有到期日、永久支付利息的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond that has no maturity date, i.e., one that pays interest in perpetuity" ;
    cmns-av:explanatoryNote "Perpetual bonds function much like dividend-paying stocks or certain preferred securities. Just as the owner of the stock receives a dividend payment as long as the stock is held, the perpetual bond owner receives an interest payment as long as the bond is held." ;
    cmns-av:synonym "consul" .

fibo-sec-dbt-bnd:ProRataConvention a owl:NamedIndividual,
        fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention ;
    rdfs:label "pro rata convention" ;
    skos:definition "convention whereby securities that are subject to partial redemption are allocated proportionately" .

fibo-sec-dbt-bnd:RedemptionSchedule a owl:Class ;
    rdfs:label "redemption schedule",
        "赎回计划表（redemption schedule）"@zh ;
    rdfs:comment "按规定日期赎回债券发行一定百分比的偿还计划表。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-sec-dbt-dbti:RedemptionEvent ],
        fibo-fnd-pas-psch:PaymentSchedule ;
    skos:definition "repayment schedule whereby a given percentage of a bond issue is redeemed on predefined dates" .

fibo-sec-dbt-bnd:RegulatoryCall a owl:Class ;
    rdfs:label "regulatory call",
        "监管赎回（regulatory call）"@zh ;
    rdfs:comment "由某项监管特定规则触发的赎回。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-dbti:CallEvent ;
    skos:definition "call triggered by some regulation-specific rule" .

fibo-sec-dbt-bnd:RemarketableBond a owl:Class ;
    rdfs:label "remarketable bond",
        "可再营销债券（remarketable bond）"@zh ;
    rdfs:comment "未偿债券票息率通过拍卖程序定期重置的公司债券计划。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:CorporateBond,
        fibo-sec-dbt-bnd:FloatingRateNote ;
    skos:definition "corporate bond program where the coupon rate on outstanding bonds is periodically reset through an auction process" ;
    cmns-av:explanatoryNote "A remarketing agent (dealer or underwriter) periodically surveys bond holders to identify those who want to sell bonds. The agent surveys market (or holds an auction) to determine interest rate at which the bonds can be resold. The rate on all outstanding bonds resets at the new rate. These programs are perpetual in the sense they often don't have a fixed maturity date, but the company can redeem them. If an auction fails, i.e., the agent can't place all the bonds then." .

fibo-sec-dbt-bnd:SpecialAssessmentBond a owl:Class ;
    rdfs:label "special assessment bond",
        "特别摊派债券（special assessment bond）"@zh ;
    rdfs:comment "用于为开发项目融资、以受益社区的摊派（税收）收入偿付的市政债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond,
        fibo-sec-dbt-bnd:SecuredBond ;
    skos:definition "municipal bond used to fund a development project that is payable from the revenues of an assessment (tax) on the community that is intended to benefit from the project" ;
    cmns-av:explanatoryNote "A special assessment is a charge imposed against a property in a particular locality because that property receives a special benefit by virtue of some public improvement, separate and apart from the general benefit accruing to the public at large. Special assessments may be apportioned according to the value of the benefit received, rather than merely the cost of the improvement." .

fibo-sec-dbt-bnd:SpecialObligationBond a owl:Class ;
    rdfs:label "special obligation bond",
        "特别责任债券（special obligation bond）"@zh ;
    rdfs:comment "以有限收入来源（如指定项目所得收入）为担保的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond ;
    skos:definition "bond secured by a limited revenue source, such as receipts derived from a designated project" .

fibo-sec-dbt-bnd:SpecialTaxBond a owl:Class ;
    rdfs:label "special tax bond",
        "特别税债券（special tax bond）"@zh ;
    rdfs:comment "以从价税以外的指定税收收入为担保的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond,
        fibo-sec-dbt-bnd:SecuredBond ;
    skos:definition "bond secured by revenues derived from designated taxes other than ad valorem taxes" ;
    skos:example "For example, bonds for a particular purpose might be supported by sales, cigarette, fuel or business license taxes." .

fibo-sec-dbt-bnd:StepUpBond a owl:Class ;
    rdfs:label "step up bond",
        "票息递增债券（step up bond）"@zh ;
    rdfs:comment "票息在存续期内递增的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:SteppedCouponTerms ],
        fibo-sec-dbt-bnd:Bond,
        fibo-sec-dbt-dbti:FixedIncomeSecurity ;
    skos:definition "bond with a coupon that increases (steps up) while the bond is outstanding" ;
    cmns-av:explanatoryNote "The step change may be one time, or occur according to a schedule or at regular intervals." ;
    cmns-av:synonym "step down bond" .

fibo-sec-dbt-bnd:StripBond a owl:Class ;
    rdfs:label "strip bond",
        "拆息债券（strip bond）"@zh ;
    rdfs:comment "由债券的每笔利息支付和本金分别拆分为独立零息债券而形成的系列债券之一。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
            owl:someValuesFrom fibo-sec-dbt-bnd:Bond ],
        fibo-sec-dbt-bnd:ZeroCouponBond,
        fibo-sec-dbt-dbti:Strip ;
    skos:definition "bond that is part of a series of bonds formed by selling each interest payment and the principal amount of a bond as separate zero coupon bonds." .

fibo-sec-dbt-bnd:TaxAllocationBond a owl:Class ;
    rdfs:label "tax allocation bond",
        "税收增额债券（tax allocation bond）"@zh ;
    rdfs:comment "以财产价值和其他经济活动增加所实现税收增量偿付的债券，通常用于特定开发区。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond,
        fibo-sec-dbt-bnd:SecuredBond ;
    skos:definition "bond payable from the incremental increase in tax revenues realized from any increase in property value and other economic activity, often designed to capture the economic benefit resulting from a bond financing" ;
    cmns-av:explanatoryNote "Tax increment bonds, also known as tax allocation bonds, often are used to finance the redevelopment of blighted areas." .

fibo-sec-dbt-bnd:TreasuryBill a owl:Class ;
    rdfs:label "treasury bill",
        "短期国库券（treasury bill）"@zh ;
    rdfs:comment "期限为一至十二个月的短期零息国库债务。"@zh ;
    rdfs:seeAlso <https://www.treasurydirect.gov/indiv/research/indepth/tbills/res_tbill.htm>,
        <https://www.treasurydirect.gov/indiv/research/indepth/tbills/res_tbill_rates.htm> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:someValuesFrom fibo-ind-ir-ir:ReferenceInterestRate ],
        [ a owl:Restriction ;
            owl:hasValue fibo-sec-dbt-dbti:AtADiscount ;
            owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtIssue ],
        [ a owl:Restriction ;
            owl:hasValue fibo-sec-dbt-dbti:ParValue ;
            owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ],
        fibo-sec-dbt-bnd:USTreasurySecurity,
        fibo-sec-dbt-tstd:MoneyMarketInstrument ;
    skos:definition "short-term zero coupon treasury obligation with a maturity ranging from one to twelve months" ;
    cmns-av:abbreviation "T-bill" ;
    cmns-av:explanatoryNote "The pricing of T-bills is unique among U.S. government debt issues. Treasury bills are offered in multiples of $100 and in terms ranging from a few days to 52 weeks. Rather than providing interest payments as Treasury Bonds or Notes do, T-bills are sold at a discount, and the entire return is realized upon maturity. The price of a bill is determined at auction. The annualized interest rate earned on T-bills is equal to the difference between the purchase price and maturity value, divided by the maturity value." .

fibo-sec-dbt-bnd:TreasuryBond a owl:Class ;
    rdfs:label "treasury bond",
        "长期国债（treasury bond）"@zh ;
    rdfs:comment "以 20 年或 30 年期发行、每六个月付息一次直至到期的长期附息国库债务。"@zh ;
    rdfs:seeAlso <https://www.treasurydirect.gov/indiv/research/indepth/tbonds/res_tbond.htm> ;
    rdfs:subClassOf fibo-sec-dbt-bnd:SovereignBond,
        fibo-sec-dbt-bnd:USTreasurySecurity ;
    skos:definition "long term term coupon bearing treasury obligation issued in terms of 20 years or 30 years that pays interest every six months until they mature" .

fibo-sec-dbt-bnd:TreasuryInflationProtectedSecurity a owl:Class ;
    rdfs:label "treasury inflation-protected security",
        "通胀保值国债（treasury inflation-protected security）"@zh ;
    rdfs:comment "本金与通胀或通缩挂钩、并在证券存续期内相应变动的可变收益债券。"@zh ;
    rdfs:seeAlso <https://www.treasurydirect.gov/indiv/products/prod_tips_glance.htm> ;
    rdfs:subClassOf fibo-sec-dbt-bnd:InflationLinkedBond,
        fibo-sec-dbt-bnd:USTreasurySecurity,
        fibo-sec-dbt-bnd:VariablePrincipalBond ;
    skos:definition "variable income bond whose principal is indexed to inflation or deflation and thus changes over the life of the security" ;
    cmns-av:abbreviation "TIPS" ;
    cmns-av:explanatoryNote "Treasury Inflation-Protected Securities, or TIPS, provide protection against inflation. The principal of a TIPS increases with inflation and decreases with deflation, as measured by the Consumer Price Index. When a TIPS matures, you are paid the adjusted principal or original principal, whichever is greater." .

fibo-sec-dbt-bnd:TreasuryNote a owl:Class ;
    rdfs:label "treasury note",
        "中期国债（treasury note）"@zh ;
    rdfs:comment "原始期限为二至十年的中期附息国库债务。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MediumTermNote,
        fibo-sec-dbt-bnd:USTreasurySecurity ;
    skos:definition "medium term coupon bearing treasury obligation with original maturity ranging from two to ten years" .

fibo-sec-dbt-bnd:hasAwardDate a owl:ObjectProperty ;
    rdfs:label "has award date",
        "具有配售日（has award date）"@zh ;
    rdfs:comment "规定协议承销中债券配售给牵头行或银团的日期，或竞争性承销中的投标日期。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "specifies the date on which bonds are awarded to the lead manager or syndicate on negotiated deals, or the date of bidding on competitive deals" ;
    cmns-av:synonym "has sale date" .

fibo-sec-dbt-bnd:hasCallRateBasis a owl:ObjectProperty ;
    rdfs:label "has call rate basis",
        "具有赎回利率基准（has call rate basis）"@zh ;
    rdfs:comment "对计划表中的每一赎回事件，指明该利率以面值百分比还是累计平均百分比表示。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallEvent ;
    rdfs:range fibo-sec-dbt-bnd:RateBasisConvention ;
    skos:definition "for each call event on the schedule, indicates whether the rate is expressed as a percentage of par or percentage of percentage of cumulative average value (CAV)" ;
    cmns-av:explanatoryNote "Zero coupon bonds and OID bonds are callable at an accreted value." .

fibo-sec-dbt-bnd:hasConvertibleDate a owl:ObjectProperty ;
    rdfs:label "has convertible date",
        "具有转换日（has convertible date）"@zh ;
    rdfs:comment "债券可转换为指定权益证券的日期。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:BondConversionTerms ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "date on which a bond can be converted into the specified equity security" .

fibo-sec-dbt-bnd:hasFinalMaturityDate a owl:ObjectProperty ;
    rdfs:label "has final maturity date",
        "具有最终到期日（has final maturity date）"@zh ;
    rdfs:comment "指明金融工具的最后付款日，届时本金（及全部剩余利息）到期应付。"@zh ;
    rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "indicates the final payment date of a financial instrument, at which point the principal (and all remaining interest) is due to be paid" .

fibo-sec-dbt-bnd:hasFirstCouponPaymentDate a owl:ObjectProperty ;
    rdfs:label "has first coupon payment date",
        "具有首次付息日（has first coupon payment date）"@zh ;
    rdfs:comment "规定发行人或其代理人预期或承诺支付首次票息的日期。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:CouponPaymentTerms ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate,
        cmns-dt:hasStartDate ;
    skos:definition "specifies the first date on which the issuer or its agent expects or commits to make a coupon payment" ;
    cmns-av:explanatoryNote "The first coupon date sometimes occurs at an irregular time; that is, if the bond pays coupons every six months, the first coupon period may be longer or shorter than six months."@en,
        "The first coupon payment period can be long or short when this date doesn't coincide with the start of a normal coupon payment period."@en .

fibo-sec-dbt-bnd:hasFirstParCallDate a owl:ObjectProperty ;
    rdfs:label "has first par call date",
        "具有首次平价赎回日（has first par call date）"@zh ;
    rdfs:comment "指明债券首次可按面值赎回的日期。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate,
        cmns-dt:hasStartDate ;
    skos:definition "indicates the first date on which the bond may be called at par for redemption" .

fibo-sec-dbt-bnd:hasFirstParCallPrice a owl:ObjectProperty ;
    rdfs:label "has first par call price",
        "具有首次平价赎回价格（has first par call price）"@zh ;
    rdfs:comment "规定赎回计划表中首个平价赎回日的赎回金额。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
    rdfs:subPropertyOf fibo-sec-dbt-bnd:hasFirstCallPrice ;
    skos:definition "specifies the amount of the call on the first par call date as specified in the call schedule" .

fibo-sec-dbt-bnd:hasFirstPremiumCallDate a owl:ObjectProperty ;
    rdfs:label "has first premium call date",
        "具有首次溢价赎回日（has first premium call date）"@zh ;
    rdfs:comment "指明债券首次可按高于面值的价格赎回的日期。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate,
        cmns-dt:hasStartDate ;
    skos:definition "indicates the first date on which the bond may be called for redemption at a price above par" .

fibo-sec-dbt-bnd:hasFirstPremiumCallPrice a owl:ObjectProperty ;
    rdfs:label "has first premium call price",
        "具有首次溢价赎回价格（has first premium call price）"@zh ;
    rdfs:comment "规定赎回计划表中首次可按高于面值价格赎回之日的赎回金额。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
    rdfs:subPropertyOf fibo-sec-dbt-bnd:hasFirstCallPrice ;
    skos:definition "specifies the amount of the call on the first call date on which the bond may be called at a price above par as specified in the call schedule" .

fibo-sec-dbt-bnd:hasFirstPutDate a owl:ObjectProperty ;
    rdfs:label "has first put date",
        "具有首次回售日（has first put date）"@zh ;
    rdfs:comment "指明持有人可在到期前将债券售回给发行人的首个日期。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf fibo-sec-dbt-bnd:hasPutDate,
        cmns-dt:hasExplicitDate ;
    skos:definition "indicates the initial date on which the holder may sell the bond to the issuer prior to maturity" .

fibo-sec-dbt-bnd:hasFirstPutPrice a owl:ObjectProperty ;
    rdfs:label "has first put price",
        "具有首次回售价格（has first put price）"@zh ;
    rdfs:comment "规定持有人可在到期前将债券售回给发行人的初始价格。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
    rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
    skos:definition "specifies the initial price at which the holder may sell the bond to the issuer prior to maturity" .

fibo-sec-dbt-bnd:hasLastCouponPaymentDate a owl:ObjectProperty ;
    rdfs:label "has last coupon payment date",
        "具有最后付息日（has last coupon payment date）"@zh ;
    rdfs:comment "规定发行人预期支付最后一次票息的日期。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:CouponPaymentTerms ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasEndDate,
        cmns-dt:hasExplicitDate ;
    skos:definition "specifies the final date on which the issuer expects to make a final coupon payment" ;
    cmns-av:explanatoryNote "The last coupon date sometimes occurs at an irregular time; that is, if the bond pays coupons every six months, the last coupon period may be longer or shorter than six months."@en .

fibo-sec-dbt-bnd:hasLockoutPeriod a owl:ObjectProperty ;
    rdfs:label "has lockout period",
        "具有锁定期（has lockout period）"@zh ;
    rdfs:comment "指明可赎回证券不可赎回、持有人仅收到利息票息支付的时间段。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range cmns-dt:DatePeriod ;
    rdfs:subPropertyOf cmns-dt:hasDatePeriod ;
    skos:definition "indicates the period of time for which a callable security cannot be called and only interest coupon payments are received by the security holder" ;
    skos:example "With a 10-year noncall 3-year (\"10nc3\") debt security, the security cannot be called for the first three years." .

fibo-sec-dbt-bnd:hasMunicipalTrustee a owl:ObjectProperty ;
    rdfs:label "has municipal trustee",
        "具有市政受托机构（has municipal trustee）"@zh ;
    rdfs:comment "指明由发行人指定、依债券合同以受托人身份为债券持有人利益行事的具有信托权限的金融机构。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
    rdfs:range fibo-sec-dbt-bnd:MunicipalTrustee ;
    rdfs:subPropertyOf fibo-fnd-agr-ctr:hasThirdParty ;
    skos:definition "specifies the financial institution with trust powers, designated by the issuer, that acts, pursuant to a bond contract, in a fiduciary capacity for the benefit of the bondholders in enforcing the terms of the bond contract" .

fibo-sec-dbt-bnd:hasPenultimateCouponPaymentDate a owl:ObjectProperty ;
    rdfs:label "has penultimate coupon payment date",
        "具有到期前最后付息日（has penultimate coupon payment date）"@zh ;
    rdfs:comment "规定到期前的最后一次票息支付日期。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:CouponPaymentTerms ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "specifies the last coupon payment prior to maturity" ;
    cmns-av:explanatoryNote "This is important since the securities processing area needs to start its procedures in anticipation of maturity. For zero coupon bonds, it is the last compounding date prior to maturity."@en .

fibo-sec-dbt-bnd:hasPremiumAmount a owl:ObjectProperty ;
    rdfs:label "has premium amount",
        "具有溢价金额（has premium amount）"@zh ;
    rdfs:comment "指明债券被赎回时支付给债券持有人的溢价。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
    skos:definition "indicates the premium paid to a bond holder when the bond is called" .

fibo-sec-dbt-bnd:hasPutFrequency a owl:ObjectProperty ;
    rdfs:label "has put frequency",
        "具有回售频率（has put frequency）"@zh ;
    rdfs:comment "指明回售特征可行使的重复时间窗口。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
    rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
    rdfs:subPropertyOf fibo-fnd-dt-fd:hasRecurrenceInterval ;
    skos:definition "indicates the recurring window of time in which the put feature can be exercised" .

fibo-sec-dbt-bnd:hasRedemptionAmount a owl:ObjectProperty ;
    rdfs:label "has redemption amount",
        "具有赎回金额（has redemption amount）"@zh ;
    rdfs:comment "指明赎回付款中支付的本金金额。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:RedemptionPayment ;
    rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
    skos:definition "indicates the amount of the principal paid with a redemption payment" .

fibo-sec-dbt-bnd:hasRemarketingAgent a owl:ObjectProperty ;
    rdfs:label "has remarketing agent",
        "具有再营销代理（has remarketing agent）"@zh ;
    rdfs:comment "标识再营销代理。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:MunicipalSecurity ;
    rdfs:range fibo-sec-dbt-bnd:MunicipalDebtRemarketingAgent ;
    rdfs:subPropertyOf fibo-fnd-agr-ctr:hasThirdParty ;
    skos:definition "identifies the dealer responsible for reselling to investors securities (such as variable rate demand obligations and other tender option bonds) that have been tendered for purchase by their owner." .

fibo-sec-dbt-bnd:hasResetDateOffset a owl:ObjectProperty ;
    rdfs:label "has reset date offset",
        "具有重置日偏移（has reset date offset）"@zh ;
    rdfs:comment "指明相对于票息支付日进行利率重置的偏移量。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:VariableCouponTerms ;
    rdfs:range fibo-fnd-dt-fd:RelativeDate ;
    rdfs:subPropertyOf cmns-dt:hasDate ;
    skos:definition "indicates the offset from the coupon payment date on which the rate is reset" .

fibo-sec-dbt-bnd:isBankQualified a owl:DatatypeProperty ;
    rdfs:label "is bank qualified",
        "银行合格（is bank qualified）"@zh ;
    rdfs:comment "发行人在合理预期其在该发行日历年内的发行不超过规定额度时，给予公共目的债券发行的指定。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether or not a given municipal bond conforms with section 265(b)(3) of the IRS tax code; when purchased by a commercial bank for its portfolio, such designation allows the bank to deduct a portion of the interest cost of carry for the position" ;
    cmns-av:explanatoryNote "A bond that is bank qualified is also known as a qualified tax-exempt obligation." .

fibo-sec-dbt-bnd:isLegalOpinionAvailable a owl:DatatypeProperty ;
    rdfs:label "is legal opinion available",
        "是否有法律意见书（is legal opinion available）"@zh ;
    rdfs:comment "表明某一市政债券是否存在法律意见书。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:MunicipalBond ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether a legal opinion exists for a given municipal bond" .

fibo-sec-dbt-bnd:isLinkedToFallback a owl:ObjectProperty ;
    rdfs:label "is linked to fallback",
        "关联后备债券（is linked to fallback）"@zh ;
    rdfs:comment "将指数挂钩工具与计算代理人可选定的政府债券关联起来。"@zh ;
    rdfs:domain fibo-fbc-fi-fi:FinancialInstrument ;
    rdfs:range fibo-sec-dbt-bnd:GovernmentBond ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    skos:definition "relates an index-linked instrument to a government bond that may be selected by a calculation agent" ;
    cmns-av:explanatoryNote "Fallback Bond means, in relation to an Inflation Index applicable to an Inflation Linked Note, a bond selected by the Calculation Agent and issued by the government or one of the governments (but not any government agency) of the country (or countries) to whose level of inflation the Inflation Index relates and which pays a coupon and/or redemption amount which is calculated by reference to the Inflation Index, with a maturity date which falls on the same day as the Maturity Date of the Inflation Linked Notes, or such other date as the Calculation Agent shall select if there is no such bond maturing on the Maturity Date of the Inflation Linked Notes. If any bond so selected is redeemed, the Calculation Agent will select a new Fallback Bond on the same basis, but selected from all eligible bonds in issue at the time the original Fallback Bond is redeemed (including any bond for which the redeemed bond is exchanged). Note the rate of the fallback bond is used as a substitute for the inflation index if, for example, it is no longer published." .

fibo-sec-dbt-bnd:isProRated a owl:DatatypeProperty ;
    rdfs:label "is pro-rated",
        "是否按比例计算（is pro-rated）"@zh ;
    rdfs:comment "表明票息是否按付款期间实际天数与付款期数之比按比例计算。"@zh ;
    rdfs:domain fibo-fbc-dae-dbt:InterestPaymentTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether the coupon is pro rated to the actual number of days in the payment period versus the number of payment periods" .

fibo-sec-dbt-bnd:isSuperSinker a owl:DatatypeProperty ;
    rdfs:label "super sinker",
        "超级偿债债券（super sinker）"@zh ;
    rdfs:comment "表明该债券具有长期票息但潜在到期日较短。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:SinkingFundAmortizationTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates that the bond has a long-term coupon but short potential short maturity" ;
    cmns-av:explanatoryNote "Super-sinker is a colloquial term for a term maturity, usually from a single family mortgage revenue issue with several term maturities, that will be the first to be called from a sinking fund into which all proceeds from prepayments of mortgages financed by the issue are deposited. The maturity's priority status under the call provisions means that it is likely to be redeemed in its entirety well before the stated maturity date." .

fibo-sec-dbt-bnd:BondVariableCoupon a owl:Class ;
    rdfs:label "bond variable coupon",
        "债券浮动票息（bond variable coupon）"@zh ;
    rdfs:comment "利率可变的债券票息。"@zh ;
    rdfs:subClassOf fibo-fbc-dae-dbt:VariableInterestRate,
        fibo-sec-dbt-bnd:BondCoupon ;
    skos:definition "bond coupon that has a variable interest rate" .

fibo-sec-dbt-bnd:BulletBond a owl:Class ;
    rdfs:label "bullet bond",
        "子弹型债券（bullet bond）"@zh ;
    rdfs:comment "全部本金在到期日一次性支付、而非在存续期内摊销的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:BulletPrincipalRepaymentTerms ],
        fibo-sec-dbt-bnd:Bond ;
    owl:disjointWith fibo-sec-dbt-bnd:AmortizingBond,
        fibo-sec-dbt-bnd:CallableBond ;
    skos:definition "bond whose entire principal value is paid on the maturity date, rather than amortized over its lifetime" .

fibo-sec-dbt-bnd:CorporateBond a owl:Class ;
    rdfs:label "corporate bond",
        "公司债券（corporate bond）"@zh ;
    rdfs:comment "公司为筹集资金而发行的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom cmns-org:LegalEntity ] ],
        fibo-sec-dbt-bnd:Bond ;
    owl:disjointWith fibo-sec-dbt-bnd:GovernmentBond,
        fibo-sec-dbt-bnd:MunicipalBond ;
    skos:definition "bond issued by a company in order to raise financing" ;
    cmns-av:explanatoryNote "Corporate bonds are issued for purposes such as mergers and acquisitions, business expansion, or to cover ongoing operational needs, and are typically longer-term debt instruments that have a maturity of at least one year. Corporate debt instruments with maturity shorter than one year are referred to as commercial paper.",
        "Note that some classification schemes consider any bond except those issued by a government in its own currency to be a corporate bond, for example, a bond issued by Canada in US dollars might be classified as a corporate bond. Bonds issued by multinational / supranational organizations such as the European Bank for Reconstruction and Development (EBRD) may also be considered corporate bonds rather than government bonds." .

fibo-sec-dbt-bnd:FixedCouponBond a owl:Class ;
    rdfs:label "fixed coupon bond",
        "固定票息债券（fixed coupon bond）"@zh ;
    rdfs:comment "票息率和本金金额在发行或出售时确定、并在证券存续期内保持不变的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:FixedCouponTerms ],
        fibo-sec-dbt-bnd:Bond,
        fibo-sec-dbt-dbti:FixedIncomeSecurity ;
    owl:disjointWith fibo-sec-dbt-bnd:VariableCouponBond ;
    skos:definition "bond whose coupon rate and principal amount are fixed at the time of origination or sale and remain constant while the security is outstanding" .

fibo-sec-dbt-bnd:FloatingRateNote a owl:Class ;
    rdfs:label "floating rate note",
        "浮动利率票据（floating rate note）"@zh ;
    rdfs:comment "以公开参考利率为基础的浮动利率债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:someValuesFrom fibo-ind-ir-ir:ReferenceInterestRate ],
        fibo-sec-dbt-bnd:VariableCouponBond ;
    skos:definition "bond with a variable interest rate based on a published reference interest rate" ;
    cmns-av:explanatoryNote "The adjustments to the interest rate (coupon) are made periodically, usually on a quarterly or monthly basis, and are tied to a certain money-market index. Also known as a \"floater\". For example six months USD LIBOR + 0.20%." .

fibo-sec-dbt-bnd:FullFaithCreditBond a owl:Class ;
    rdfs:label "full faith credit bond",
        "完全信用担保债券（full faith credit bond）"@zh ;
    rdfs:comment "由另一实体无条件付款承诺担保的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:UnsecuredBond ;
    skos:definition "bond secured by an unconditional promise to pay by another entity" ;
    cmns-av:explanatoryNote "Full faith and credit bonds are typically backed by a government entity and are considered low risk." ;
    cmns-av:synonym "full faith and credit bond" .

fibo-sec-dbt-bnd:IndexLinkedBond a owl:Class ;
    rdfs:label "index-linked bond",
        "指数挂钩债券（index-linked bond）"@zh ;
    rdfs:comment "收益可能随时间变动的债券，因其票息率或本金金额与特定指数（如消费者价格指数）挂钩。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-ind-ei-ei:EconomicIndicator fibo-ind-ind-ind:MarketRate ) ] ],
        fibo-sec-dbt-bnd:VariableIncomeBond ;
    skos:definition "bond whose income may vary over time, because either the coupon rate or principal amount is related to a specific index, such as the Consumer Price Index" .

fibo-sec-dbt-bnd:InflationLinkedBond a owl:Class ;
    rdfs:label "inflation-linked bond",
        "通胀挂钩债券（inflation-linked bond）"@zh ;
    rdfs:comment "与通胀挂钩的债券，其本金或利息支付随通胀率升降。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
            owl:someValuesFrom fibo-ind-ei-ei:InflationRate ],
        fibo-sec-dbt-bnd:IndexLinkedBond ;
    skos:definition "bond indexed to inflation so that the principal or interest payments rise and fall with the rate of inflation" ;
    cmns-av:abbreviation "ILB" ;
    cmns-av:explanatoryNote "Inflation-linked bonds are primarily issued by sovereign governments, such as the U.S. and the UK." ;
    cmns-av:synonym "inflation-indexed bond" .

fibo-sec-dbt-bnd:MediumTermNote a owl:Class ;
    rdfs:label "medium term note",
        "中期票据（medium term note）"@zh ;
    rdfs:comment "在储架发行计划下分期发行的债券，各期可有不同票息，期限通常为一至十年。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond issued over time under a shelf registration program, where each issue may have a different coupon and maturity typically ranging from one to ten years" ;
    cmns-av:explanatoryNote "A medium-term note (MTN) is a debt note that usually matures (is paid back) in 5 to 10 years, but the term may be less than one year or as long as 100 years. They can be issued on a fixed or floating coupon basis.",
        "By shelf registration we mean the security registration process where an issuer registers in advance, and can issue lots of securities for up to three years.",
        "Medium term notes are typically issued by corporations and financial institutions, although GSEs also have MTN programs. MTNs may be issued under a shelf registration program which allows the company to issue bonds over time with varying maturities and coupons. Companies issue MTNs to have a more flexible source of funding. They may also issue MTN in response to 'reverse inquiry' by investors looking for bonds with specific maturities, issue size and coupon." .

fibo-sec-dbt-bnd:MunicipalDebtFundsUsage a owl:Class ;
    rdfs:label "municipal debt funds usage",
        "市政债务资金用途（municipal debt funds usage）"@zh ;
    rdfs:comment "说明新发行市政证券所筹资金用途的正式声明。"@zh ;
    rdfs:subClassOf cmns-doc:LegalDocument ;
    skos:definition "official statement specifying how the funds raised via a new issue of municipal securities are to be applied" .

fibo-sec-dbt-bnd:MunicipalDebtRemarketingAgent a owl:Class ;
    rdfs:label "municipal debt remarketing agent",
        "市政债务再营销代理人（municipal debt remarketing agent）"@zh ;
    rdfs:comment "负责向投资者转售证券（如浮动利率即期债务和其他投标选择权债券）的市政证券交易商。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-fpas:Dealer,
        fibo-fnd-agr-ctr:ContractThirdParty ;
    skos:definition "municipal securities dealer responsible for reselling to investors securities (such as variable rate demand obligations and other tender option bonds) that have been tendered for purchase by their owner" ;
    cmns-av:explanatoryNote "The remarketing agent also typically is responsible for resetting the interest rate for a variable rate issue and may act as tender agent." .

fibo-sec-dbt-bnd:MunicipalTrustee a owl:Class ;
    rdfs:label "municipal trustee",
        "市政受托机构（municipal trustee）"@zh ;
    rdfs:comment "由发行人指定、依债券合同以受托人身份为债券持有人利益行事的具有信托权限的金融机构。"@zh ;
    rdfs:subClassOf fibo-be-tr-tr:Trustee,
        fibo-fbc-fct-fse:FinancialInstitution ;
    skos:definition "financial institution with trust powers, designated by the issuer, that acts, pursuant to a bond contract, in a fiduciary capacity for the benefit of the bondholders in enforcing the terms of the bond contract" ;
    cmns-av:explanatoryNote "In many cases, the trustee also acts as custodian, paying agent, registrar and/or transfer agent for the bonds." .

fibo-sec-dbt-bnd:RedemptionPayment a owl:Class ;
    rdfs:label "redemption payment",
        "赎回付款（redemption payment）"@zh ;
    rdfs:comment "在到期或赎回时支付债券本金的偿还事件。"@zh ;
    rdfs:subClassOf fibo-fnd-pas-psch:PaymentEvent,
        fibo-sec-dbt-dbti:RedemptionEvent ;
    skos:definition "repayment event involving payment of a bond's principal amount at maturity or when it is called" .

fibo-sec-dbt-bnd:RevenueBond a owl:Class ;
    rdfs:label "revenue bond",
        "收益债券（revenue bond）"@zh ;
    rdfs:comment "由特定项目收入支持的市政债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:MunicipalBond,
        fibo-sec-dbt-bnd:SecuredBond ;
    skos:definition "municipal bond supported by the revenue from a specific project" ;
    cmns-av:explanatoryNote "Revenue bonds are municipal bonds that finance income-producing projects, such as toll bridges, highways, or local stadiums, and are secured by a specified revenue source. Typically, revenue bonds can be issued by any government agency or fund that is managed in the manner of a business, such as entities having both operating revenues and expenses." .

fibo-sec-dbt-bnd:SinkingFundAmortizationTerms a owl:Class ;
    rdfs:label "sinking fund amortization terms",
        "偿债基金摊销条款（sinking fund amortization terms）"@zh ;
    rdfs:comment "偿债基金型摊销证券本金偿付的条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty fibo-sec-dbt-bnd:isMandatory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-sec-dbt-bnd:BondAmortizationPaymentTerms ;
    skos:definition "terms for the paydown of principal in a sinking fund type of amortizing security" ;
    skos:editorialNote "At present there is only a schedule, there should be other terms for what happens on the scheduled dates. Sinking fund may be bullet e.g. x percent over year for y years. SF may be mandatory or contingent on some other economic event." .

fibo-sec-dbt-bnd:SovereignBond a owl:Class ;
    rdfs:label "sovereign bond",
        "主权债券（sovereign bond）"@zh ;
    rdfs:comment "由国家政府发行的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:GovernmentBond,
        fibo-sec-dbt-bnd:SovereignDebtInstrument ;
    owl:disjointWith fibo-sec-dbt-bnd:MunicipalBond ;
    skos:definition "bond issued by the government of a country" ;
    cmns-av:explanatoryNote "Sovereign bonds issued by G20 developed countries are generally full faith and credit obligations. Sovereign bonds issued by emerging and developing countries may be issued in local currency or a G7 currency, and may either be full faith and credit (unsecured) or secured." .

fibo-sec-dbt-bnd:SteppedCouponTerms a owl:Class ;
    rdfs:label "stepped coupon terms",
        "阶梯票息条款（stepped coupon terms）"@zh ;
    rdfs:comment "票息在债券存续期内递增的证券的票息支付条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
            owl:someValuesFrom fibo-sec-dbt-dbti:StepSchedule ],
        fibo-sec-dbt-bnd:CouponPaymentTerms ;
    skos:definition "coupon payment terms for securities with a coupon that increases (steps up) while the bond is outstanding" .

fibo-sec-dbt-bnd:UKGovernmentSecurity a owl:Class ;
    rdfs:label "U.K. Government security",
        "英国政府证券（U.K. Government security）"@zh ;
    rdfs:comment "由英国财政部发行并在伦敦证券交易所挂牌的债务工具。"@zh ;
    rdfs:seeAlso <https://www.dmo.gov.uk/responsibilities/gilt-market/buying-selling/> ;
    rdfs:subClassOf fibo-sec-dbt-bnd:SovereignDebtInstrument ;
    skos:definition "debt instrument issued by HM Treasury and listed on the London Stock Exchange" ;
    cmns-av:explanatoryNote "If a private investor wishes to purchase gilts the secondary market can be accessed through a stockbroker, bank or the DMO's Purchase and Sale Service.",
        "The term 'gilt' or 'gilt-edged security' is a reference to the primary characteristic of gilts as an investment: their security. This is a reflection of the fact that the British Government has never failed to make interest or principal payments on gilts as they fall due." ;
    cmns-av:synonym "gilt",
        "gilt-edged security" .

fibo-sec-dbt-bnd:UnlistedBond a owl:Class ;
    rdfs:label "unlisted bond",
        "非上市债券（unlisted bond）"@zh ;
    rdfs:comment "在场外交易（而非通过交易所或其他挂牌场所）的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond that is traded over the counter rather than via an exchange or other listing facility" ;
    cmns-av:synonym "OTC Bond" .

fibo-sec-dbt-bnd:VariableDebtPrincipal a owl:Class ;
    rdfs:label "variable debt principal",
        "可变债务本金（variable debt principal）"@zh ;
    rdfs:comment "随某一变量定义、因而随时间变动的本金。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-acc-cur:hasMonetaryAmount ;
            owl:someValuesFrom fibo-fnd-acc-cur:MonetaryAmount ],
        fibo-sec-dbt-dbti:PubliclyIssuedDebt ;
    skos:definition "principal that is defined in relation to some variable and so varies over time, as principal" ;
    cmns-av:explanatoryNote "Not the same as principal paydown. This is when the principal itself varies over time, usually as a result of being defined in relation to some index such as an inflation index. Forms the debt principal in instruments such as inflation bonds."@en .

fibo-sec-dbt-bnd:VariableInterestCalculationFormula a owl:Class ;
    rdfs:label "variable interest calculation formula",
        "可变利息计算公式（variable interest calculation formula）"@zh ;
    rdfs:comment "用于计算可变利息的公式。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-dbti:FullyIndexedInterestRate ;
    skos:definition "formula for the calculation of variable interest" .

fibo-sec-dbt-bnd:VariablePrincipalBond a owl:Class ;
    rdfs:label "variable principal bond",
        "可变本金债券（variable principal bond）"@zh ;
    rdfs:comment "本金随指数变动而调整的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:definesTermsFor ;
            owl:someValuesFrom fibo-sec-dbt-bnd:VariableDebtPrincipal ],
        fibo-sec-dbt-bnd:VariableIncomeBond ;
    skos:definition "bond whose principal adjusts over time with changes in an index" ;
    cmns-av:explanatoryNote "The principal on variable principal bonds adjusts line with an index such as inflation or GDP. For example, for a bond linked to the CPI, if inflation rises two percent the principal increases by 2 percent. The coupon rate is typically fixed. The best-known example is TIPS or Treasury Inflation Protected Bonds, which are linked to the CPI. TIPs offer a real or inflation adjusted rate of return." .

fibo-sec-dbt-bnd:ZeroCouponBond a owl:Class ;
    rdfs:label "zero coupon bond",
        "零息债券（zero coupon bond）"@zh ;
    rdfs:comment "票息率为零、以面值大幅折价交易的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-sec-dbt-dbti:ParValue ;
            owl:onProperty fibo-sec-dbt-dbti:hasRelativePriceAtMaturity ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:ZeroCouponTerms ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-sec-dbt-bnd:hasOriginalIssueDiscountAmount ],
        fibo-sec-dbt-bnd:Bond,
        fibo-sec-dbt-dbti:FixedIncomeSecurity ;
    skos:definition "bond issued with a coupon rate of zero and that trades at a deep discount to face value" ;
    cmns-av:explanatoryNote "Fannie Mae also issues zero-coupon callable debt securities. Zero-coupon notes are debt securities on which no coupon interest is paid to the investor. Rather, the security is purchased at a discounted dollar price and matures at par. If the option on a callable zero-coupon security is exercised, it is redeemed at a higher dollar price than the original issue price. The yield for a callable zero-coupon security is based on the difference between the original discounted price and the principal payment at the call date.",
        "The principal amount accretes over time at a constant accrual rate and is redeemed at full face value at maturity. In effect, the accrual rate is the coupon rate or yield which is added to the outstanding principal rather than being paid out to investors." ;
    cmns-av:synonym "z-bond" .

fibo-sec-dbt-bnd:ZeroCouponTerms a owl:Class ;
    rdfs:label "zero coupon terms",
        "零息条款（zero coupon terms）"@zh ;
    rdfs:comment "关于零息债券利息支付的条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-sec-dbt-bnd:ZeroInterestRate ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ],
        fibo-sec-dbt-bnd:BondAmortizationPaymentTerms,
        fibo-sec-dbt-bnd:FixedCouponTerms ;
    skos:definition "terms for payment of interest on a zero coupon bond" .

fibo-sec-dbt-bnd:ZeroInterestRate a owl:NamedIndividual,
        fibo-fbc-dae-dbt:FixedInterestRate ;
    rdfs:label "zero interest rate" ;
    skos:definition "an interest rate of zero (0) percent" ;
    fibo-fnd-acc-cur:hasRateValue 0.00 .

fibo-sec-dbt-bnd:hasCallPrice a owl:ObjectProperty ;
    rdfs:label "has call price",
        "具有赎回价格（has call price）"@zh ;
    rdfs:comment "指明指定赎回日的赎回金额，通常为面值加赎回溢价，按合约规定。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasPrice ;
    skos:definition "indicates the amount of the call on the specified call date, typically the sum of par value and the call premium, as specified in the contract" ;
    cmns-av:explanatoryNote "This is the price a bond issuer or preferred stock issuer must pay investors to buy back, or call, all or part of an issue before the maturity date." ;
    cmns-av:synonym "has redemption price" .

fibo-sec-dbt-bnd:hasCeiling a owl:DatatypeProperty ;
    rdfs:label "has ceiling",
        "具有上限（has ceiling）"@zh ;
    rdfs:comment "指明可变利息支付金额的最大值。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:VariableInterestExpression ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasRateValue ;
    skos:definition "indicates the maximum variable interest payment amount" .

fibo-sec-dbt-bnd:hasExtraordinaryRedemptionProvision a owl:ObjectProperty ;
    rdfs:label "has extraordinary redemption provision",
        "具有特别赎回条款（has extraordinary redemption provision）"@zh ;
    rdfs:comment "将债务工具的赎回条款与发行人在特定情况下可行使的一次性条款关联起来。"@zh ;
    rdfs:domain fibo-fbc-fi-fi:RedemptionProvision ;
    rdfs:range fibo-sec-dbt-bnd:ExtraordinaryRedemptionProvision ;
    rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement ;
    skos:definition "relates the redemption provision of a debt instrument to one-time provision that may be exercised by the issuer under certain circumstances" .

fibo-sec-dbt-bnd:hasFloor a owl:DatatypeProperty ;
    rdfs:label "has floor",
        "具有下限（has floor）"@zh ;
    rdfs:comment "指明可变利息支付金额的最小值。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:VariableInterestExpression ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasRateValue ;
    skos:definition "indicates the minimum variable interest payment amount" .

fibo-sec-dbt-bnd:hasFundingSource a owl:ObjectProperty ;
    rdfs:label "has funding source",
        "具有资金来源（has funding source）"@zh ;
    rdfs:comment "指明新发行市政证券的资金来源。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:MunicipalSecurity ;
    rdfs:range fibo-sec-dbt-bnd:MunicipalDebtSourceOfFunds ;
    rdfs:subPropertyOf cmns-doc:hasDataSource ;
    skos:definition "indicates the source of funds for a new issue of municipal securities" .

fibo-sec-dbt-bnd:hasPartialRedemptionAllocationConvention a owl:ObjectProperty ;
    rdfs:label "has partial redemption allocation convention",
        "具有部分赎回分配惯例（has partial redemption allocation convention）"@zh ;
    rdfs:comment "指明用于确定赎回如何在债券持有人集合中分摊的惯例。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:PartialCallFeature ;
    rdfs:range fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention ;
    skos:definition "indicates the convention used to determine how the redemption is allocated over the set of bond holders" .

fibo-sec-dbt-bnd:hasPutDate a owl:ObjectProperty ;
    rdfs:label "has put date",
        "具有回售日（has put date）"@zh ;
    rdfs:comment "指明证券可由债券持有人要求赎回的日期。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:PutFeature ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasExplicitDate ;
    skos:definition "indicates the date on which a security is subject to redemption by the bond holder" .

fibo-sec-dbt-bnd:AmortizingBond a owl:Class ;
    rdfs:label "amortizing bond",
        "摊销债券（amortizing bond）"@zh ;
    rdfs:comment "在债券存续期内随利息支出定期偿还债务本金（面值）的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:BondAmortizationPaymentTerms ],
        fibo-sec-dbt-bnd:Bond ;
    owl:disjointWith fibo-sec-dbt-bnd:BulletBond ;
    skos:definition "bond that regularly pays down the principal (face value) on the debt along with its interest expense over the life of the bond" .

fibo-sec-dbt-bnd:BondCoupon a owl:Class ;
    rdfs:label "bond coupon",
        "债券票息（bond coupon）"@zh ;
    rdfs:comment "发行人承诺在到期前向持有人支付的债务证券利率，以面值的年度百分比表示。"@zh ;
    rdfs:subClassOf fibo-fnd-acc-cur:InterestRate ;
    skos:definition "interest rate on a debt security that the issuer promises to pay to the holder until maturity, expressed as an annual percentage of the face value" ;
    cmns-av:synonym "coupon percent rate",
        "coupon rate",
        "nominal yield" .

fibo-sec-dbt-bnd:BulletPrincipalRepaymentTerms a owl:Class ;
    rdfs:label "bond bullet principal repayment terms",
        "债券子弹式本金偿还条款（bond bullet principal repayment terms）"@zh ;
    rdfs:comment "以一次性付款覆盖全部本金金额的债券本金偿还条款。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms ;
    skos:definition "terms for repayment of the principal for a bond as a single payment covering the whole principal amount" .

fibo-sec-dbt-bnd:ConvertibleBond a owl:Class ;
    rdfs:label "convertible bond",
        "可转换债券（convertible bond）"@zh ;
    rdfs:comment "当股票价格高于指定水平时，赋予持有人将债券转换为固定数量股份（转换比率）之权利的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-sec-dbt-bnd:BondConversionTerms ;
            owl:onProperty fibo-fnd-agr-ctr:hasContractualElement ],
        fibo-sec-dbt-bnd:Bond,
        fibo-sec-sec-iss:ConvertibleSecurity ;
    skos:definition "bond that gives the holder the right to convert the bond into a fixed number of shares (conversion ratio) if the equity price rises above a specified level (strike price)" ;
    cmns-av:explanatoryNote "If the equity price remains below the strike price throughout the term of the bond it matures and is redeemed like a regular bond. The conversion ratio and strike price are usually set when the convertible bond is issued." .

fibo-sec-dbt-bnd:ExtraordinaryRedemptionProvision a owl:Class ;
    rdfs:label "extraordinary redemption provision",
        "特别赎回条款（extraordinary redemption provision）"@zh ;
    rdfs:comment "赋予债券发行人在发行说明书规定的异常一次性事件发生时赎回债券之权利的条款。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-dbti:CallFeature ;
    skos:definition "provision that gives a bond issuer the right to call its bonds due to an unusual one-time occurrence, as specified in the offering statement" ;
    cmns-av:explanatoryNote "Such redemptions may occur when bond proceeds are not spent according to schedule; when bond proceeds are used in a way that makes nontaxable bond interest taxable; or when a catastrophe destroys the project being financed, among other reasons." .

fibo-sec-dbt-bnd:FixedCouponTerms a owl:Class ;
    rdfs:label "fixed coupon terms",
        "固定票息条款（fixed coupon terms）"@zh ;
    rdfs:comment "关于按固定利率支付债券利息的条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:someValuesFrom fibo-fbc-dae-dbt:FixedInterestRate ],
        fibo-sec-dbt-bnd:CouponPaymentTerms ;
    owl:disjointWith fibo-sec-dbt-bnd:VariableCouponTerms ;
    skos:definition "terms for payment of interest on a bond with a fixed interest rate" .

fibo-sec-dbt-bnd:MunicipalDebtSourceOfFunds a owl:Class ;
    rdfs:label "municipal debt source of funds",
        "市政债务资金来源（municipal debt source of funds）"@zh ;
    rdfs:comment "指明新发行市政证券资金来源的正式声明。"@zh ;
    rdfs:subClassOf cmns-doc:LegalDocument ;
    skos:definition "official statement identifying the source of funds for a new issue of municipal securities" .

fibo-sec-dbt-bnd:PartialCallFeature a owl:Class ;
    rdfs:label "partial call feature",
        "部分赎回特征（partial call feature）"@zh ;
    rdfs:comment "发行人可在预定日期按某规则或抽签方式选择部分债券进行赎回的赎回特征。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-bnd:hasPartialRedemptionAllocationConvention ;
            owl:someValuesFrom fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention ],
        fibo-sec-dbt-dbti:CallFeature ;
    skos:definition "call feature whereby the issuer can recall part of the issue on scheduled dates, where bonds are selected to be called according to some rule, or by selecting various bonds at random" .

fibo-sec-dbt-bnd:VariableCouponTerms a owl:Class ;
    rdfs:label "variable coupon terms",
        "浮动票息条款（variable coupon terms）"@zh ;
    rdfs:comment "规定浮动票息债券利率计算方法的合同条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:isBasedOn ;
            owl:someValuesFrom fibo-ind-ind-ind:MarketRate ],
        [ a owl:Restriction ;
            owl:onProperty cmns-qtu:hasExpression ;
            owl:someValuesFrom fibo-sec-dbt-bnd:VariableInterestCalculationFormula ],
        fibo-sec-dbt-bnd:CouponPaymentTerms ;
    skos:definition "contractual terms specifying the calculation of the interest rate for a variable coupon bond" .

fibo-sec-dbt-bnd:VariableInterestExpression a owl:Class ;
    rdfs:label "variable interest expression",
        "可变利息表达式（variable interest expression）"@zh ;
    rdfs:comment "用于确定可变利息支付金额的表达式。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-sec-dbt-dbti:FullyIndexedInterestRate ;
            owl:onProperty cmns-qtu:hasArgument ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-sec-dbt-bnd:hasCeiling ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-sec-dbt-bnd:hasFloor ],
        cmns-qtu:Expression ;
    skos:definition "an expression used to determine a variable interest payment amount" .

fibo-sec-dbt-bnd:hasFirstCallPrice a owl:ObjectProperty ;
    rdfs:label "has first call price",
        "具有首次赎回价格（has first call price）"@zh ;
    rdfs:comment "指明赎回计划表规定的首个赎回日的赎回金额。"@zh ;
    rdfs:domain fibo-sec-dbt-dbti:CallFeature ;
    rdfs:range fibo-fnd-acc-cur:MonetaryPrice ;
    rdfs:subPropertyOf fibo-sec-dbt-bnd:hasCallPrice ;
    skos:definition "indicates the amount of the call on the first call date as specified in the call schedule" .

fibo-sec-dbt-bnd:hasOriginalIssueDiscountAmount a owl:ObjectProperty ;
    rdfs:label "has original issue discount amount",
        "具有原始发行折价金额（has original issue discount amount）"@zh ;
    rdfs:comment "指明到期既定赎回价格与发行价格之间的差额。"@zh ;
    rdfs:domain fibo-sec-dbt-bnd:Bond ;
    rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    rdfs:subPropertyOf fibo-fnd-acc-cur:hasMonetaryAmount ;
    skos:definition "indicates the difference between the stated redemption price at maturity and the issue price" .

fibo-sec-dbt-bnd:isMandatory a owl:DatatypeProperty ;
    rdfs:label "is mandatory",
        "是否强制（is mandatory）"@zh ;
    rdfs:comment "表明某事物是否为必需。"@zh ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates whether something is required" .

fibo-sec-dbt-bnd:BondAmortizationPaymentTerms a owl:Class ;
    rdfs:label "bond amortization payment terms",
        "债券摊销支付条款（bond amortization payment terms）"@zh ;
    rdfs:comment "包含债券存续期内本金偿还计划的条款，通常按固定间隔等额支付。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
            owl:someValuesFrom fibo-fbc-dae-dbt:AmortizationSchedule ],
        fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms ;
    owl:disjointWith fibo-sec-dbt-bnd:BulletPrincipalRepaymentTerms ;
    skos:definition "terms that include a schedule for repayment of the principal over the lifetime of the bond, typically in equal payments at regular intervals" .

fibo-sec-dbt-bnd:BondConversionTerms a owl:Class ;
    rdfs:label "bond conversion terms",
        "债券转换条款（bond conversion terms）"@zh ;
    rdfs:comment "指明可转换债券何时可转换为另一证券（通常为同一发行人发行的公开交易股票）的条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-sec-iss:specifiesConversionInto ;
            owl:someValuesFrom fibo-sec-eq-eq:ListedShare ],
        fibo-sec-sec-iss:ConversionTerms ;
    skos:definition "terms indicating when a convertible bond can be converted to another security (usually a publicly traded share issued by of the same issuer)" .

fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms a owl:Class ;
    rdfs:label "bond principal repayment terms",
        "债券本金偿还条款（bond principal repayment terms）"@zh ;
    rdfs:comment "关于债券本金偿还的条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
            owl:someValuesFrom fibo-fnd-pas-psch:PaymentSchedule ],
        fibo-fbc-dae-dbt:PrincipalRepaymentTerms ;
    owl:disjointWith fibo-sec-dbt-dbti:CallFeature ;
    skos:definition "terms for the repayment of the principal on a bond" .

fibo-sec-dbt-bnd:CallableBond a owl:Class ;
    rdfs:label "callable bond",
        "可赎回债券（callable bond）"@zh ;
    rdfs:comment "包含允许发行人在赎回保护期后按赎回价回购并注销债券之条款的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasCallFeature ;
            owl:someValuesFrom fibo-sec-dbt-dbti:CallFeature ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty fibo-sec-dbt-dbti:isCallable ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-sec-dbt-bnd:ExtraordinaryRedemptionProvision ;
            owl:onProperty fibo-sec-dbt-bnd:hasExtraordinaryRedemptionProvision ],
        fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond that includes a stipulation allowing the issuer the right to repurchase and retire the bond at the call price after the call protection period" .

fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity a owl:Class ;
    rdfs:label "government issued debt security",
        "政府发行债务证券（government issued debt security）"@zh ;
    rdfs:comment "由某一政府代表某一政体发行的债务证券，包括主权债务和市政债务。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-be-ge-ge:Polity ] ],
        fibo-fbc-fi-fi:DebtInstrument ;
    skos:definition "debt security issued by some government on behalf of some polity, including sovereign and municipal debt" .

fibo-sec-dbt-bnd:RateBasisConvention a owl:Class ;
    rdfs:label "rate basis convention",
        "利率基准惯例（rate basis convention）"@zh ;
    rdfs:comment "在规定债券赎回百分比金额时所用百分比报价利率的基准。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-fnd-acc-cur:hasRateValue ],
        fibo-fnd-dt-bd:Convention ;
    skos:definition "basis for a percentage quoted rate as used in specifying bond call percentage amounts" .

fibo-sec-dbt-bnd:UnsecuredBond a owl:Class ;
    rdfs:label "unsecured bond",
        "无担保债券（unsecured bond）"@zh ;
    rdfs:comment "仅以债券发行人的良好信用为支持的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    skos:definition "bond that is only secured by the bond issuer's good credit standing" ;
    cmns-av:explanatoryNote "Most unsecured bonds pose limited risk of default, as the organizations that issue them are typically financially sound." ;
    cmns-av:synonym "debenture" .

fibo-sec-dbt-bnd:VariableCouponBond a owl:Class ;
    rdfs:label "variable coupon bond",
        "浮动票息债券（variable coupon bond）"@zh ;
    rdfs:comment "利率浮动的债券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:someValuesFrom fibo-sec-dbt-bnd:BondVariableCoupon ],
        fibo-sec-dbt-bnd:VariableIncomeBond ;
    skos:definition "bond that has a floating interest rate" ;
    cmns-av:explanatoryNote "The rate adjusts according to a predetermined formula outlined in the bond's prospectus or official statement." .

fibo-sec-dbt-bnd:VariableIncomeBond a owl:Class ;
    rdfs:label "variable income bond",
        "可变收益债券（variable income bond）"@zh ;
    rdfs:comment "收益可能随时间变动的债券，因其票息率或本金金额在存续期内随某指数或计划表变动。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond,
        fibo-sec-dbt-dbti:VariableIncomeSecurity ;
    skos:definition "bond whose income may vary over time, because either the coupon rate or principal amount changes in line with an index or schedule over the life of the security" .

fibo-sec-dbt-bnd:GovernmentBond a owl:Class ;
    rdfs:label "government bond",
        "政府债券（government bond）"@zh ;
    rdfs:comment "政府为资助政府开支而发行的债务证券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond,
        fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity ;
    skos:definition "debt security issued by a government to fund government spending" ;
    cmns-av:synonym "government-issued bond" .

fibo-sec-dbt-bnd:PartialRedemptionAllocationConvention a owl:Class ;
    rdfs:label "partial redemption allocation convention",
        "部分赎回分配惯例（partial redemption allocation convention）"@zh ;
    rdfs:comment "用于确定部分赎回如何在债券持有人之间分摊的惯例。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-fnd-acc-cur:hasRateValue ],
        fibo-fnd-dt-bd:Convention ;
    skos:definition "convention used to determine how the partial call will be actioned with respect to bond selection" .

fibo-sec-dbt-bnd:SecuredBond a owl:Class ;
    rdfs:label "secured bond",
        "有担保债券（secured bond）"@zh ;
    rdfs:comment "除一般付款承诺外，还以抵押品（如有形资产或收入流）为支持的债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:Bond ;
    owl:disjointWith fibo-sec-dbt-bnd:UnsecuredBond ;
    skos:definition "bond that is backed by collateral, such as a tangible asset or income stream, in addition to a general promise to pay" ;
    cmns-av:explanatoryNote "A secured bond may be collateralized by a claim on real assets, such as a factory or auto fleet; or by a claim on a revenue stream. A secured bond differs from a mortgage in that proceeds of the bond sale aren't used to acquire the asset." .

fibo-sec-dbt-bnd:SovereignDebtInstrument a owl:Class ;
    rdfs:label "sovereign debt instrument",
        "主权债务工具（sovereign debt instrument）"@zh ;
    rdfs:comment "由国家政府发行的债务证券。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom fibo-be-ge-ge:SovereignState ] ],
        fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity ;
    skos:definition "debt security issued by the government of a country" .

fibo-sec-dbt-bnd:USTreasurySecurity a owl:Class ;
    rdfs:label "U.S. Treasury security",
        "美国国债（U.S. Treasury security）"@zh ;
    rdfs:comment "由美国财政部发行、附有完全信用担保的债务工具。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-fnd-acc-4217:USDollar ;
            owl:onProperty fibo-fbc-fi-fi:isDenominatedIn ],
        fibo-sec-dbt-bnd:SovereignDebtInstrument ;
    skos:definition "debt instrument issued by the United States Department of the Treasury that carries a full faith and credit guarantee" .

fibo-sec-dbt-dbti:PutFeature a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty fibo-sec-dbt-bnd:isMandatory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

fibo-sec-dbt-bnd:MunicipalSecurity a owl:Class ;
    rdfs:label "municipal security",
        "市政证券（municipal security）"@zh ;
    rdfs:comment "由地方政府实体发行的债务凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:isPlayedBy ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:unionOf ( fibo-be-ge-ge:MunicipalEntity fibo-be-ge-ge:RegionalSovereignty ) ] ] ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ;
            owl:someValuesFrom fibo-sec-dbt-bnd:MunicipalDebtFundsUsage ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-bnd:hasFundingSource ;
            owl:someValuesFrom fibo-sec-dbt-bnd:MunicipalDebtSourceOfFunds ],
        fibo-sec-dbt-bnd:GovernmentIssuedDebtSecurity ;
    owl:disjointWith fibo-sec-dbt-bnd:SovereignDebtInstrument ;
    skos:definition "debt obligation issued by a regional governmental entity" ;
    cmns-av:explanatoryNote "A municipal security is typically a bond, note, warrant, certificate or other similar obligation issued by a state or local government or their agencies or authorities (such as cities, towns, villages, counties or special districts or authorities). A prime feature of most municipal securities is that interest or other investment earnings on them are generally excluded from gross income of the bondholder for federal income tax purposes. Some municipal securities are subject to federal income tax, although the issuers or bondholders may receive other federal tax advantages for certain types of taxable municipal securities. Some examples include Build America Bonds, municipal fund securities and direct pay subsidy bonds." .

fibo-sec-dbt-bnd:CouponPaymentTerms a owl:Class ;
    rdfs:label "coupon payment terms",
        "票息支付条款（coupon payment terms）"@zh ;
    rdfs:comment "关于债券利息支付的条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fbc-dae-dbt:hasInterestRate ;
            owl:someValuesFrom fibo-sec-dbt-bnd:BondCoupon ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
            owl:someValuesFrom fibo-fnd-acc-cur:Currency ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-dt-fd:hasSchedule ;
            owl:someValuesFrom fibo-fbc-dae-dbt:InterestPaymentSchedule ],
        fibo-fbc-dae-dbt:InterestPaymentTerms ;
    skos:definition "terms for payment of interest on a bond" .

fibo-sec-dbt-bnd:MunicipalBond a owl:Class ;
    rdfs:label "municipal bond",
        "市政债券（municipal bond）"@zh ;
    rdfs:comment "可由地方（而非国家）当局发行的政府债券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-bnd:GovernmentBond,
        fibo-sec-dbt-bnd:MunicipalSecurity ;
    skos:definition "government bond that may be issued by a regional, rather than national, authority" ;
    cmns-av:abbreviation "muni" ;
    cmns-av:explanatoryNote "Municipal bonds may be issued by states, cities, counties, special tax districts or special agencies or authorities of state or local governments." .

fibo-sec-dbt-bnd:Bond a owl:Class ;
    rdfs:label "bond",
        "债券（bond）"@zh ;
    rdfs:comment "代表一笔贷款的可交易债务工具，发行人对持有人负有债务。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasRepaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:BondPrincipalRepaymentTerms ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-dbt-dbti:hasInterestPaymentTerms ;
            owl:someValuesFrom fibo-sec-dbt-bnd:CouponPaymentTerms ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty fibo-sec-sec-iss:hasSeries ],
        fibo-fbc-dae-dbt:CreditAgreementRepaidAtMaturity,
        fibo-sec-dbt-dbti:TradableDebtInstrument ;
    skos:definition "tradable debt instrument representing a loan in which the issuer owes the holder(s) a debt" ;
    cmns-av:explanatoryNote "Depending on the terms of the contract, the issuer is obliged to pay interest (the coupon) and/or to repay the principal at maturity. The most common bonds are corporate or governmental, typically used to finance specific projects or operations." .

