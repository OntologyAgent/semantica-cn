@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-der-cr-cds: <https://spec.edmcouncil.org/fibo/ontology/DER/CreditDerivatives/CreditDefaultSwaps/> .
@prefix fibo-fbc-dae-crt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/CreditRatings/> .
@prefix fibo-fnd-oac-own: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-sec-dbt-cdo: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/CollateralizedDebtObligations/> .
@prefix fibo-sec-dbt-pbs: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/PoolBackedSecurities/> .
@prefix fibo-sec-dbt-syn: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/SyntheticCDOs/> .
@prefix fibo-sec-fund-fund: <https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/Funds/> .
@prefix fibo-sec-sec-pls: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/Pools/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-sec-dbt-cdo:CashCDOTranche a owl:Class ;
    owl:disjointWith fibo-sec-dbt-syn:SyntheticCDOTranche .

fibo-sec-dbt-syn:SyntheticAmortizingSecurity a owl:Class ;
    rdfs:label "synthetic amortizing security"@en,
        "合成摊销证券（synthetic amortizing security）"@zh ;
    rdfs:comment "为模拟摊销证券行为而构造的证券。"@zh ;
    rdfs:subClassOf fibo-sec-dbt-syn:SyntheticStructuredFinanceInstrument ;
    skos:definition "Security constructed to emulate an amortizing security."@en ;
    skos:scopeNote "Synthetic instruments can be created to mimic a wide range of debt instruments. These are not all shown here. This one is shown as an example"@en .

fibo-sec-dbt-syn:isCash a owl:DatatypeProperty ;
    rdfs:label "is cash"@en,
        "是否现金型（is cash）"@zh ;
    rdfs:comment "表明 CDO 是否拥有真实资产的标的池：是则为现金型，否则为合成型标的池。"@zh ;
    rdfs:domain fibo-sec-dbt-syn:SyntheticCDOTranche ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the CDO has an underlying pool of real assets. This is No: the CDO has a synthetic pool of underlying assets."@en .

fibo-sec-dbt-syn:percentageOfDefaultsThisTranche a owl:ObjectProperty ;
    rdfs:label "percentage of defaults this tranche"@en,
        "本分档违约百分比（percentage of defaults this tranche）"@zh ;
    rdfs:comment "该分档持有人所暴露的违约百分比，即该分档所代表的违约份额。"@zh ;
    rdfs:domain fibo-sec-dbt-syn:SyntheticCDOTranche ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "The percentage of defaults which holders of this are exposed to, that is the percentage of defaults that this tranche represents. Further Notes Review session notes 21 April: The first, second and so on, to stop paying out when there is a default. In each case you get the first, second etc. x% of defaults. Base underlying may be high or low quality. Create the pool by buying or selling protection depending on hich way you want to go, e..g. have high quality funds, (borrowers), would sell protection. If low quality, would buy protection to improve quality. So risk is no longer bound to the funding. REVIEW: More likely this is a band of percentages (from and to); review and formalize. See also note on attachment and detachment points."@en .

fibo-sec-dbt-syn:simulates a owl:ObjectProperty ;
    rdfs:label "simulates"@en,
        "模拟（simulates）"@zh ;
    rdfs:comment "表明某合成工具模拟某一真实工具或组合的行为。"@zh ;
    rdfs:domain fibo-sec-dbt-syn:SyntheticPoolAsset .

fibo-sec-dbt-syn:simulates.1 a owl:ObjectProperty ;
    rdfs:label "simulates"@en,
        "模拟（simulates）"@zh ;
    rdfs:comment "表明某合成工具模拟某一真实工具或组合的行为。"@zh ;
    rdfs:domain fibo-sec-dbt-syn:SyntheticDebtInstrumentPool .

fibo-sec-dbt-syn:trancheType a owl:ObjectProperty ;
    rdfs:label "tranche type"@en,
        "分档类型（tranche type）"@zh ;
    rdfs:comment "指明分档的类型。"@zh ;
    rdfs:domain fibo-sec-dbt-syn:SyntheticCDOTranche ;
    rdfs:range fibo-sec-dbt-cdo:CDOTrancheSenioritySelection .

fibo-sec-dbt-syn: a owl:Ontology ;
    rdfs:label "SyntheticCDOs"@en,
        "合成 CDO 本体（Synthetic CDOs Ontology）"@zh ;
    dcterms:abstract "Synthetic collateralized debt obligations are instruments designed to provide the same kind of structure and returns as a CDO, but these are not backed by an actual pool of debt assets." ;
    dcterms:license """Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc.
