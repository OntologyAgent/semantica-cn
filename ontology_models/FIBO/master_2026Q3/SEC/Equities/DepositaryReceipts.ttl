@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-ge-easj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/AsianJurisdiction/EasternAsiaGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-be-ge-euj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-be-ge-sasj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/AsianJurisdiction/SouthernAsiaGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-be-ge-usj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/NorthAmericanJurisdiction/USGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-be-ge-weuj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/WesternEuropeGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-sec-dbt-dbti: <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/> .
@prefix fibo-sec-eq-dr: <https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/DepositaryReceipts/> .
@prefix fibo-sec-eq-eq: <https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/> .
@prefix fibo-sec-sec-cls: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesClassification/> .
@prefix fibo-sec-sec-rst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesRestrictions/> .
@prefix fibo-sec-sec-usrst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/NorthAmericanSecurities/USSecuritiesRestrictions/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-sec-eq-dr: a owl:Ontology ;
    rdfs:label "Depositary Receipts"@en,
        "存托凭证本体（Depositary Receipts Ontology）"@zh ;
    dcterms:abstract "Depositary receipts are certificates which represent ownership of some underlying security. They are issued by a bank and give the holder the ability to participate in the returns on an instrument that they may not be able to hold directly." ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    rdfs:comment "定义存托凭证（DR，如 ADR、GDR）：代表境外公司股票的可交易凭证。"@zh ;
    owl:imports fibo-be-ge-easj:,
        fibo-be-ge-sasj:,
        fibo-be-ge-euj:,
        fibo-be-ge-weuj:,
        fibo-be-ge-usj:,
        fibo-fbc-fi-fi:,
        fibo-fnd-utl-av:,
        fibo-sec-dbt-dbti:,
        fibo-sec-eq-eq:,
        fibo-sec-sec-usrst:,
        fibo-sec-sec-cls:,
        fibo-sec-sec-rst:,
        cmns-av:,
        cmns-cls:,
        cmns-dsg: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/SEC/20230301/Equities/DepositaryReceipts/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/20221001/Equities/DepositaryReceipts.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20210501/Equities/DepositaryReceipts.rdf version of this ontology was modified to expand the definition of a depositary receipt to cover a broader range of securities.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20211101/Equities/DepositaryReceipts.rdf version of this ontology was modified to further refine the definition of a depositary receipt, add participatory notes, and broaden explanatory notes to allow for coverage of Chinese ADRs.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20220101/Equities/DepositaryReceipts.rdf version of this ontology was modified to address text formatting hygiene issues.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20220801/Equities/DepositaryReceipts.rdf version of this ontology was modified to add the concept of a Chinese depositary receipt.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/20230201/Equities/DepositaryReceipts.rdf version of this ontology was modified to move the property, 'is conferred on' to the Legal Capacity ontology and to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC), eliminating redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/SEC/2023020120230301/Equities/DepositaryReceipts.rdf version of this ontology was modified to address a deprecated term that was replaced with a new term over 6 months ago (FND-386) and eliminate punning issues (LOAN-169)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2013-2024 EDM Council, Inc.",
        "Copyright (c) 2013-2024 Object Management Group, Inc." .

fibo-sec-eq-dr:ChineseDepositaryReceipt a owl:Class ;
    rdfs:label "Chinese depositary receipt"@en,
        "中国存托凭证（Chinese depositary receipt）"@zh ;
    rdfs:comment "代表非中国公司证券所有权、在中国境内公开交易所交易的全球存托凭证（CDR）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-easj:JurisdictionOfTheRepublicOfChina ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        fibo-sec-eq-dr:GlobalDepositaryReceipt ;
    skos:definition "global depositary receipt that represents ownership in the securities of a non-Chinese company that trades on a public exchange in China"@en ;
    cmns-av:abbreviation "CDR"@en ;
    cmns-av:explanatoryNote "It refers to shares in non-Chinese companies that trade in China the same way that American depositary receipts (ADRs) allow non-U.S. company shares to trade on American exchanges."@en .

fibo-sec-eq-dr:EuropeanDepositaryReceipt a owl:Class ;
    rdfs:label "European depositary receipt"@en,
        "欧洲存托凭证（European depositary receipt）"@zh ;
    rdfs:comment "代表非欧洲公司证券所有权、在欧洲金融市场交易的全球存托凭证（EDR）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-euj:EuropeanUnionJurisdiction ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        fibo-sec-eq-dr:GlobalDepositaryReceipt ;
    skos:definition "global depositary receipt that represents ownership in the securities of a non-European company that trades in European financial markets"@en ;
    cmns-av:abbreviation "EDR"@en ;
    cmns-av:explanatoryNote "A European depositary receipt is a European equivalent of the original American depositary receipt (ADR). The EDR is issued by a bank in Europe representing securities traded on an exchange outside of the bank's home country."@en .

fibo-sec-eq-dr:HongKongDepositaryReceipt a owl:Class ;
    rdfs:label "Hong Kong depositary receipt"@en,
        "香港存托凭证（Hong Kong depositary receipt）"@zh ;
    rdfs:comment "代表购买或拥有存放于香港存托银行之外国资产的全球存托凭证（HDR）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-easj:JurisdictionOfHongKong ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        fibo-sec-eq-dr:GlobalDepositaryReceipt ;
    skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a depositary bank in Hong Kong"@en ;
    cmns-av:abbreviation "HKDR"@en ;
    cmns-av:explanatoryNote "A Hong Kong Depositary Receipt (HDR) is a negotiable instrument issued by a depositary bank that evidences ownership of securities in a corporation organized outside Hong Kong. HDRs trade on the Hong Kong Stock Exchange (HKEx), thus enabling foreign issuers to tap the Hong Kong market and local investors to efficiently invest in quality international companies."@en .

fibo-sec-eq-dr:IndianDepositoryReceipt a owl:Class ;
    rdfs:label "Indian depositary receipt"@en,
        "印度存托凭证（Indian depositary receipt）"@zh ;
    rdfs:comment "代表购买或拥有存放于印度账户（由境内托管人管理）之外国资产的全球存托凭证（IDR）。"@zh ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Indian_Depository_Receipt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-sasj:JurisdictionOfIndia ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        fibo-sec-eq-dr:GlobalDepositaryReceipt ;
    skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a Indian account managed by the Domestic Depository in India"@en ;
    cmns-av:abbreviation "IDR"@en ;
    cmns-av:explanatoryNote "An Indian Depository Receipt (IDR) is an instrument denominated in Indian Rupees in the form of a depositary receipt created by a Domestic Depository (custodian of securities registered with the Securities and Exchange Board of India) against the underlying securities of issuing company to enable foreign companies to raise funds from the Indian securities Markets."@en .

fibo-sec-eq-dr:JapaneseDepositaryReceipt a owl:Class ;
    rdfs:label "Japanese depositary receipt"@en,
        "日本存托凭证（Japanese depositary receipt）"@zh ;
    rdfs:comment "代表购买或拥有存放于日本信托银行之外国资产的全球存托凭证（JDR）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-easj:JurisdictionOfJapan ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        fibo-sec-eq-dr:GlobalDepositaryReceipt ;
    skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a trust bank in Japan"@en ;
    cmns-av:abbreviation "JDR"@en ;
    cmns-av:explanatoryNote "A Japanese Depositary Receipt (JDR) is an instrument issued by a trust bank in Japan that evidences ownership of securities in a corporation organized outside Japan. JDRs trade on the Tokyo Stock Exchange (TSE) in yen, and in accordance with Japanese market conventions, enabling foreign issuers to tap the Japanese capital market and local investors to efficiently invest in quality international companies."@en .

fibo-sec-eq-dr:LevelIIAmericanDepositaryReceipt a owl:NamedIndividual,
        fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ;
    rdfs:label "Level II American depositary receipt"@en ;
    skos:definition "American Depositary Receipt level that is sponsored and can be listed on an exchange"@en ;
    cmns-av:abbreviation "Level II ADR"@en ;
    cmns-av:explanatoryNote "This level is visible to a wider market and requires the company to comply with the SEC regulatory rules. However, they cannot be used to raise capital."@en .

fibo-sec-eq-dr:LevelIIIAmericanDepositaryReceipt a owl:NamedIndividual,
        fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ;
    rdfs:label "Level III American depositary receipt"@en ;
    skos:definition "American Depositary Receipt level that can be listed on an exchange and permit companies to issue shares to raise capital for the foreign issuer, but require the highest level of compliance and disclosure"@en ;
    cmns-av:abbreviation "Level III ADR"@en .

fibo-sec-eq-dr:LuxembourgDepositaryReceipt a owl:Class ;
    rdfs:label "Luxembourg depositary receipt"@en,
        "卢森堡存托凭证（Luxembourg depositary receipt）"@zh ;
    rdfs:comment "代表购买或拥有存放于卢森堡账户之外国资产的全球存托凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-weuj:JurisdictionOfLuxembourg ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        fibo-sec-eq-dr:GlobalDepositaryReceipt ;
    skos:definition "global depositary receipt that represents the purchase, or ownership, of foreign assets which are deposited in a Luxembourg-based account"@en ;
    cmns-av:abbreviation "LDR"@en ;
    cmns-av:explanatoryNote "A Luxembourg Depositary Receipt (LDR) is a certificate which represents the purchase, or ownership, of foreign assets which are deposited in a Luxembourg-based account. An LDR functions in much the same way as a global depositary receipt (GDR). LDRs may represent ownership of either an underlying number of shares or a notional amount of bonds."@en .

fibo-sec-eq-dr:OffshoreDepositaryReceipt a owl:Class ;
    rdfs:label "offshore depositary receipt"@en,
        "离岸存托凭证（offshore depositary receipt）"@zh ;
    rdfs:comment "依美国证券交易委员会（SEC）S 条例发行的存托凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-sec-sec-usrst:RegulationS ;
            owl:onProperty fibo-sec-sec-rst:hasRestriction ],
        fibo-sec-eq-dr:SponsoredDepositaryReceipt ;
    skos:definition "depositary receipt issued under SEC Regulation S"@en ;
    cmns-av:explanatoryNote "This regulation means that the securities are not, and will not be registered with any U.S. securities regulation authority. Regulation S shares cannot be held or traded by any 'U.S. person' as defined by SEC Regulation S rules. The shares are registered and issued to offshore, non-U.S. residents."@en .

fibo-sec-eq-dr:ParticipatoryNote a owl:Class ;
    rdfs:label "participatory note"@en,
        "参与票据（participatory note）"@zh ;
    rdfs:comment "便于持有在其他司法管辖区交易之证券的可交易债务工具。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-eq-dr:hasTradedSecurity ;
            owl:someValuesFrom fibo-sec-dbt-dbti:TradableDebtInstrument ],
        fibo-sec-dbt-dbti:TradableDebtInstrument,
        fibo-sec-eq-dr:DepositaryReceipt ;
    skos:definition "tradable debt instrument that facilitates the ownership of securities traded in other jurisdictions"@en ;
    skos:example "Participation notes are required by investors or hedge funds to invest in Indian securities without having to register with the Securities and Exchange Board of India (SEBI). P-Notes are among the group of investments considered to be Offshore Derivative Investments (ODIs) in Indian markets."@en ;
    cmns-av:abbreviation "P-Note"@en,
        "PN"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote """Depository receipts are widely used in order to allow the trading of debt instruments in
jurisdictions other than the one where the original debt instruments were issued"""@en,
        "Typically P-Notes are SPVs that are created to allow participation from outside that market. The SPV purchases a security on shore and issues a note that represents that security to offshore investors. They are similar to an ADR but always a debt security."@en ;
    cmns-av:synonym "participation note"@en .

fibo-sec-eq-dr:PrivatelyPlacedDepositaryReceipt a owl:Class ;
    rdfs:label "privately placed depositary receipt"@en,
        "私募存托凭证（privately placed depositary receipt）"@zh ;
    rdfs:comment "代表依美国证券交易委员会（SEC）144A 规则私募配售之股份的存托凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-sec-sec-usrst:Rule144A ;
            owl:onProperty fibo-sec-sec-rst:hasRestriction ],
        fibo-sec-eq-dr:SponsoredDepositaryReceipt ;
    skos:definition "depositary receipt that represents shares in a private placement under the SEC Rule 144-A"@en ;
    cmns-av:explanatoryNote "Some foreign companies will set up an ADR program under SEC Rule 144-A. This provision makes the issuance of shares a private placement. Shares of companies registered under Rule 144-A are restricted stock and may only be issued to or traded by qualified institutional buyers (QIBs). U.S. public shareholders are generally not permitted to invest in these ADR programs, and most are held exclusively through the Depository Trust & Clearing Corporation, so there is often very little information on these companies."@en .

fibo-sec-eq-dr:UnsponsoredDepositaryReceipt a owl:Class ;
    rdfs:label "unsponsored depositary receipt"@en,
        "无保荐存托凭证（unsponsored depositary receipt）"@zh ;
    rdfs:comment "未经该公司合作而设立的存托凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-sec-eq-dr:LevelIAmericanDepositaryReceipt ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        fibo-sec-eq-dr:AmericanDepositaryReceipt ;
    owl:disjointWith fibo-sec-eq-dr:SponsoredDepositaryReceipt ;
    skos:definition "depositary receipt that is established without the company's cooperation"@en ;
    cmns-av:explanatoryNote "For an unsponsored ADR, a depositary entity can issue certificates when there's heavy demand from investors for ownership in a specific company from abroad. The issuing entity is normally a broker-dealer that owns common stock in the company. Because they're issued without the consent or cooperation of the foreign company, unsponsored ADRs generally trade over-the-counter (OTC)—rather than on a stock exchange. Also, shareholder benefits and voting rights may not be extended to the holders of these particular securities. Many large global corporations use unsponsored ADRs to attract American capital. For example, American investors can invest in Royal Mail PLC, a postal and delivery service company from the United Kingdom that was founded by Henry VIII. The company's unsponsored ADR trades OTC under the ticker symbol ROYMY."@en .

fibo-sec-eq-dr:hasNumberOfDepositaryReceiptsIssued a owl:DatatypeProperty ;
    rdfs:label "has number of depositary receipts issued"@en,
        "具有存托凭证发行数量（has number of depositary receipts issued）"@zh ;
    rdfs:comment "指明向公众发行的凭证数量。"@zh ;
    rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "indicates the number of receipts issued to the general public"@en .

fibo-sec-eq-dr:hasTradedShare a owl:ObjectProperty ;
    rdfs:label "has traded share"@en,
        "具有所代表股份（has traded share）"@zh ;
    rdfs:comment "将存托凭证与其所代表的工具（股票或交易所交易基金）关联起来。"@zh ;
    rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
    rdfs:range fibo-sec-eq-eq:Share ;
    rdfs:subPropertyOf fibo-sec-eq-dr:hasTradedSecurity ;
    skos:definition "links a depositary receipt to the instrument (equity or exchange-traded fund) that it represents"@en .

fibo-sec-eq-dr:AmericanDepositaryReceiptLevelScheme a owl:Class ;
    rdfs:label "American depositary receipt level scheme"@en,
        "美国存托凭证级别方案（American depositary receipt level scheme）"@zh ;
    rdfs:comment "按外国公司进入美国市场程度对美国存托凭证（ADR）进行分级的方案。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ],
        fibo-sec-sec-cls:FinancialInstrumentClassificationScheme ;
    skos:definition "classifier for American depositary receipts that categorizes ADRs into levels based on the extent to which the foreign company has access to the U.S. market"@en ;
    cmns-av:abbreviation "ADR level"@en .

fibo-sec-eq-dr:LevelIAmericanDepositaryReceipt a owl:NamedIndividual,
        fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ;
    rdfs:label "Level I American depositary receipt"@en ;
    skos:definition "American Depositary Receipt level indicating that the ADR can only be traded over-the-counter in the U.S."@en ;
    cmns-av:abbreviation "Level I ADR"@en ;
    cmns-av:explanatoryNote "This level can apply to sponsored and unsponsored ADRs. However, this is the only level available for unsponsored ADRs. A Level I ADR is easier to set up for foreign companies since it does not require the same disclosures or the need to abide by generally accepted accounting principles (GAAP). There is some degree of risk with Level I ADRs given their relative lack of transparency."@en .

fibo-sec-eq-dr:hasMultiplier a owl:DatatypeProperty ;
    rdfs:label "has multiplier"@en,
        "具有乘数（has multiplier）"@zh ;
    rdfs:comment "指明单张存托凭证所代表的标的股份数量（可为多股或零碎股）。"@zh ;
    rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
    rdfs:range xsd:decimal ;
    skos:definition "indicates the number of underlying shares (whether multiple or fractional) represented by a single depositary receipt"@en .

fibo-sec-eq-dr:AmericanDepositaryReceipt a owl:Class ;
    rdfs:label "American depositary receipt"@en,
        "美国存托凭证（American depositary receipt）"@zh ;
    rdfs:comment "代表外国公司证券、使该公司证券得以在美国金融市场交易的存托凭证（ADR）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-usj:UnitedStatesJurisdiction ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-sec-eq-dr:AmericanDepositaryReceiptLevel ;
            owl:onProperty cmns-cls:isClassifiedBy ],
        fibo-sec-eq-dr:DepositaryReceipt ;
    skos:definition "depositary receipt that represents securities of a foreign company and allows that company's securities to trade in the U.S. financial markets"@en ;
    skos:example "For example, Accton Technology is traded on the Taiwanese exchange. In order for Accton Technology to be traded in the United States, Citibank, acting as a domestic custodian bank, purchases shares of Accton Technology and creates a security, ISIN US00437R1032, which can be traded on a U.S. exchange, in this case PORTAL. Note that the depositary shares do not have to equal the number of original shares. In the case of Accton Technology, one depositary share is equivalent to two original shares."@en ;
    cmns-av:abbreviation "ADR"@en ;
    cmns-av:explanatoryNote "Most ADRs are issued by a domestic custodian bank when the underlying securities are deposited in a foreign depositary bank, usually by a broker who has purchased the securities in the open market local to the foreign company. An ADR can represent a fraction of a share, a single share, or multiple shares of a foreign security. The holder of an ADR has the right to obtain the underlying foreign security that the ADR represents, but investors usually find it more convenient to own the ADR. The price of an ADR generally tracks the price of the foreign security in its home market, adjusted for the ratio of ADRs to foreign company shares. In the case of companies domiciled in the United Kingdom, creation of ADRs attracts a 1.5 percent creation fee; this creation fee is different than stamp duty reserve tax charge by the UK government. Depositary banks have various responsibilities to ADR holders and to the issuing foreign company the ADR represents."@en .

fibo-sec-eq-dr:SponsoredDepositaryReceipt a owl:Class ;
    rdfs:label "sponsored depositary receipt"@en,
        "有保荐存托凭证（sponsored depositary receipt）"@zh ;
    rdfs:comment "与外国公司合作发行、使其能够直接进入国际资本市场的存托凭证。"@zh ;
    rdfs:subClassOf fibo-sec-eq-dr:AmericanDepositaryReceipt ;
    skos:definition "depositary receipt that is issued in collaboration with the foreign company enabling them to tap into international capital markets directly"@en ;
    cmns-av:explanatoryNote "Although a sponsored ADR would be listed in the United States, the issuing company still has its revenue and profit denominated in its home currency."@en .

fibo-sec-eq-dr:hasTradedSecurity a owl:ObjectProperty ;
    rdfs:label "has traded security"@en,
        "具有所代表证券（has traded security）"@zh ;
    rdfs:comment "将存托凭证与其所代表的工具关联起来。"@zh ;
    rdfs:domain fibo-sec-eq-dr:DepositaryReceipt ;
    rdfs:range fibo-fbc-fi-fi:Security ;
    rdfs:subPropertyOf cmns-dsg:denotes ;
    skos:definition "links a depositary receipt to the instrument that it represents"@en .

fibo-sec-eq-dr:AmericanDepositaryReceiptLevel a owl:Class ;
    rdfs:label "American depositary receipt level"@en,
        "美国存托凭证级别（American depositary receipt level）"@zh ;
    rdfs:comment "按外国公司进入美国市场程度对美国存托凭证（ADR）进行分级的分类器。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:isDefinedIn ;
            owl:someValuesFrom fibo-sec-eq-dr:AmericanDepositaryReceiptLevelScheme ],
        [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-sec-eq-dr:AmericanDepositaryReceipt ],
        fibo-sec-sec-cls:FinancialInstrumentClassifier ;
    skos:definition "classifier for American depositary receipts that categorizes ADRs into levels based on the extent to which the foreign company has access to the U.S. market"@en ;
    cmns-av:abbreviation "ADR level"@en .

fibo-sec-eq-dr:GlobalDepositaryReceipt a owl:Class ;
    rdfs:label "global depositary receipt"@en,
        "全球存托凭证（global depositary receipt）"@zh ;
    rdfs:comment "由购入外国公司证券的存托银行签发凭证、在本地交易所创设证券的存托凭证（GDR）。"@zh ;
    rdfs:subClassOf fibo-sec-eq-dr:DepositaryReceipt ;
    skos:definition "depositary receipt where a certificate issued by a depositary bank, which purchases securities of foreign companies, creates a security on a local exchange backed by those securities"@en ;
    cmns-av:abbreviation "GDR"@en ;
    cmns-av:explanatoryNote "Global depositary receipts are the global equivalent of the original American depositary receipts (ADR) on which they are based. GDRs represent ownership of an underlying number of securities of a foreign company and are commonly used to invest in companies from developing or emerging markets by investors in developed markets."@en ;
    cmns-av:synonym "international depositary receipt"@en .

fibo-sec-eq-dr:DepositaryReceipt a owl:Class ;
    rdfs:label "depositary receipt"@en,
        "存托凭证（depositary receipt）"@zh ;
    rdfs:comment "由信托公司、证券存管机构或银行签发的可转让金融工具，是公开交易证券存托的凭证。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-sec-eq-dr:hasMultiplier ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-eq-dr:hasTradedSecurity ;
            owl:someValuesFrom fibo-fbc-fi-fi:Security ],
        fibo-fbc-fi-fi:Security ;
    skos:definition "negotiable financial instrument issued by a trust company, security depositary, or bank that is evidence of the deposit of publicly traded securities and that facilitates the ownership of securities traded in other jurisdictions"@en ;
    cmns-av:abbreviation "DR"@en ;
    cmns-av:adaptedFrom "ISO 10962, Securities and related financial instruments - Classification of financial instruments (CFI) code, Fourth Edition, October 2019"@en ;
    cmns-av:explanatoryNote """Depositary receipts are widely used in order to allow the trading of securities in jurisdictions other than
the one where the original securities were issued, such as in a local market. Depositary receipts facilitate buying securities in foreign companies, because the securities do not have to leave the home country. They enable domestic investors to buy securities of foreign companies without the accompanying risks or inconveniences of cross-border and cross-currency transactions."""@en ;
    cmns-av:synonym "depositary receipt"@en .

