fibo-sec-eq-10962:PreferredVotingExtendableParticipatingRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, extendable, participating, registered share"@en-US,
        "单一表决权、可展期、参与优先股（PreferredVotingExtendableParticipatingRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；到期日可由发行人和/或股东选择延长；除约定股息外可与普通股股东分享额外收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( fibo-sec-eq-eq:RedeemablePreferredShareWithExtendableRedemptionDate fibo-sec-eq-eq:RetractablePreferredShareWithExtendableRedemptionDate ) ],
        fibo-sec-eq-eq:ExtendablePreferredShare,
        fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-eq-eq:ParticipatingPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, may be redeemed at the option of the issuer and/or of the shareholder with an extendable redemption date, provides a periodic stated income and participates with common shareholders in further dividend and capital distributions, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualAdjustableIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, adjustable income, registered share"@en-US,
        "单一表决权、永续、可调整收益优先股（PreferredVotingPerpetualAdjustableIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；股息率按基准定期调整，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithAdjustableRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides a periodic income whose dividend rate is set periodically, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualAuctionRateIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, auction rate income, registered share"@en-US,
        "单一表决权、永续、拍卖利率收益优先股（PreferredVotingPerpetualAuctionRateIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；股息率通过拍卖定期重置，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithAuctionRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides a periodic income whose dividend rate is adjusted through an auction, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualCumulativeParticipatingRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, cumulative participating, registered share"@en-US,
        "单一表决权、永续、累积参与优先股（PreferredVotingPerpetualCumulativeParticipatingRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；未付股息累积递延，并可与普通股股东分享额外收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:CumulativePreferredShare,
        fibo-sec-eq-eq:ParticipatingPreferredShare,
        fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides a periodic stated income, dividends not paid in any year accumulate, and participates with common shareholders in further dividend and capital distributions, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualCumulativeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, cumulative, registered share"@en-US,
        "单一表决权、永续、累积优先股（PreferredVotingPerpetualCumulativeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；未付股息累积递延至日后支付，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:CumulativePreferredShare,
        fibo-sec-eq-eq:NonParticipatingPreferredShare,
        fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides a periodic stated income and dividends not paid in any year accumulate, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualFixedIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, fixed income, registered share"@en-US,
        "单一表决权、永续、固定收益优先股（PreferredVotingPerpetualFixedIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；按约定利率提供定期固定收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-eq-eq:NonParticipatingPreferredShare,
        fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides a periodic stated income, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualNormalIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, normal income, registered share"@en-US,
        "单一表决权、永续、普通收益优先股（PreferredVotingPerpetualNormalIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；提供与普通股股东相同的股息，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides the same dividends as common/ordinary shareholders, and is registered" .

fibo-sec-eq-10962:PreferredVotingPerpetualParticipatingRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, perpetual, participating, registered share"@en-US,
        "单一表决权、永续、参与优先股（PreferredVotingPerpetualParticipatingRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；无固定到期日；除约定股息外可与普通股股东分享额外收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-eq-eq:ParticipatingPreferredShare,
        fibo-sec-eq-eq:PerpetualPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, has no fixed maturity date, provides a periodic stated income and participates with common shareholders in further dividend and capital distributions, and is registered" .

fibo-sec-eq-10962:PreferredVotingRedeemableAdjustableIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, redeemable, adjustable income, registered share"@en-US,
        "单一表决权、可赎回、可调整收益优先股（PreferredVotingRedeemableAdjustableIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；发行人或股东可选择赎回；股息率按基准定期调整，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( fibo-sec-eq-eq:RedeemablePreferredShare fibo-sec-eq-eq:RetractablePreferredShare ) ],
