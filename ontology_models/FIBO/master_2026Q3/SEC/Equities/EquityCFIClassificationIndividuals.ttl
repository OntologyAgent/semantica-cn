    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( fibo-sec-eq-eq:RedeemablePreferredShareWithExtendableRedemptionDate fibo-sec-eq-eq:RetractablePreferredShareWithExtendableRedemptionDate ) ],
        fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExtendablePreferredShare,
        fibo-sec-eq-eq:PreferredShareWithAuctionRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be redeemed at the option of the issuer and/or of the shareholder with an extendable redemption date, provides a periodic income whose dividend rate is adjusted through an auction, and is registered" .

