fibo-sec-eq-10962:PreferredVotingRedeemableCumulativeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, redeemable, cumulative, registered share"@en-US,
        "单一表决权、可赎回、累积优先股（PreferredVotingRedeemableCumulativeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有一票表决权；发行人或股东可选择赎回；未付股息累积递延至日后支付，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( fibo-sec-eq-eq:RedeemablePreferredShare fibo-sec-eq-eq:RetractablePreferredShare ) ],
        fibo-sec-eq-eq:CumulativePreferredShare,
        fibo-sec-eq-eq:NonParticipatingPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-eq-eq:SingleVotingShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers exactly one vote per share, may be redeemed at the option of the issuer and/or of the shareholder, provides a periodic stated income and dividends not paid in any year accumulate, and is registered" .

fibo-sec-eq-10962:PreferredVotingRedeemableExchangeableAdjustableIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, voting, redeemable exchangeable, adjustable income, registered share"@en-US,
        "单一表决权、可赎回、可交换、可调整收益优先股（PreferredVotingRedeemableExchangeableAdjustableIncomeRegisteredShare）"@zh ;
