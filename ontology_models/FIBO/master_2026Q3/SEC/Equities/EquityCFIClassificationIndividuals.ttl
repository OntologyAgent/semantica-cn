        fibo-sec-eq-eq:RestrictedVotingShare,
        fibo-sec-eq-eq:UnrestrictedShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "common share that confers less than one vote per share, is unrestricted from a sales / transfer perspective, is nil paid and is registered" .

