fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableAdjustableIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, adjustable income, registered share"@en-US,
        "增强表决权、可交换、可调整收益优先股（PreferredEnhancedVotingExchangeableAdjustableIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；股息率按基准定期调整，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:PreferredShareWithAdjustableRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides a periodic income whose dividend rate is set periodically, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableAuctionRateIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, auction rate income, registered share"@en-US,
        "增强表决权、可交换、拍卖利率收益优先股（PreferredEnhancedVotingExchangeableAuctionRateIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；股息率通过拍卖定期重置，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:PreferredShareWithAuctionRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides a periodic income whose dividend rate is adjusted through an auction, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableCumulativeParticipatingRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, cumulative participating, registered share"@en-US,
        "增强表决权、可交换、累积参与优先股（PreferredEnhancedVotingExchangeableCumulativeParticipatingRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；未付股息累积递延，并可与普通股股东分享额外收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:CumulativePreferredShare,
        fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:ParticipatingPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides a periodic stated income, dividends not paid in any year accumulate, and participates with common shareholders in further dividend and capital distributions, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableCumulativeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, cumulative, registered share"@en-US,
        "增强表决权、可交换、累积优先股（PreferredEnhancedVotingExchangeableCumulativeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；未付股息累积递延至日后支付，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:CumulativePreferredShare,
        fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:NonParticipatingPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides a periodic stated income and dividends not paid in any year accumulate, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableFixedIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, fixed income, registered share"@en-US,
        "增强表决权、可交换、固定收益优先股（PreferredEnhancedVotingExchangeableFixedIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；按约定利率提供定期固定收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-eq-eq:NonParticipatingPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides a periodic stated income, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableNormalIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, normal income, registered share"@en-US,
        "增强表决权、可交换、普通收益优先股（PreferredEnhancedVotingExchangeableNormalIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；提供与普通股股东相同的股息，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides the same dividends as common/ordinary shareholders, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExchangeableParticipatingRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, exchangeable, participating, registered share"@en-US,
        "增强表决权、可交换、参与优先股（PreferredEnhancedVotingExchangeableParticipatingRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；可交换为另一发行人的证券；除约定股息外可与普通股股东分享额外收益，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExchangeablePreferredShare,
        fibo-sec-eq-eq:NonCumulativePreferredShare,
        fibo-sec-eq-eq:ParticipatingPreferredShare,
        fibo-sec-eq-eq:PreferredShareWithFixedRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be exchanged for securities of another issuer, provides a periodic stated income and participates with common shareholders in further dividend and capital distributions, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExtendableAdjustableIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, extendable, adjustable income, registered share"@en-US,
        "增强表决权、可展期、可调整收益优先股（PreferredEnhancedVotingExtendableAdjustableIncomeRegisteredShare）"@zh ;
    rdfs:comment "优先股：每股享有多于一票表决权；到期日可由发行人和/或股东选择延长；股息率按基准定期调整，记名股份。属 ISO 10962（CFI）股票分类中的组合类别个体。"@zh ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( fibo-sec-eq-eq:RedeemablePreferredShareWithExtendableRedemptionDate fibo-sec-eq-eq:RetractablePreferredShareWithExtendableRedemptionDate ) ],
        fibo-sec-eq-eq:EnhancedVotingShare,
        fibo-sec-eq-eq:ExtendablePreferredShare,
        fibo-sec-eq-eq:PreferredShareWithAdjustableRateDividend,
        fibo-sec-sec-lst:RegisteredSecurity ;
    skos:definition "preferred share that confers multiple votes per share, may be redeemed at the option of the issuer and/or of the shareholder with an extendable redemption date, provides a periodic income whose dividend rate is set periodically, and is registered" .

fibo-sec-eq-10962:PreferredEnhancedVotingExtendableAuctionRateIncomeRegisteredShare a owl:Class ;
    rdfs:label "preferred, enhanced voting, extendable, auction rate income, registered share"@en-US,
