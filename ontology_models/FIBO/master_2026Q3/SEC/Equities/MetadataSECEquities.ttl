		See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2026-06-25T18:00:00"^^xsd:dateTime ;
    rdfs:comment "声明权益（Equities）模块由股权工具、存托凭证、股票 CFI 分类个体三个本体构成，及版本信息。"@zh ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/SEC/20230201/Equities/MetadataSECEquities/> ;
    cmns-av:copyright "Copyright (c) 2018-2025 Object Management Group, Inc.",
        "Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc." .

fibo-sec-eq-mod:EquitiesModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "equities module" ;
    dcterms:abstract "This module defines concepts common to equities, including share-specific terminology and shareholder rights, for stocks and partnership equity, as well as depository receipts." ;
    dcterms:contributor "Adaptive, Inc.",
        "BIAN",
        "Bloomberg LP",
