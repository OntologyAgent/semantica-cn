fibo-sec-fund-civ:minimumSubscriptionUnits a owl:DatatypeProperty ;
    rdfs:label "minimum subscription units"@en,
        "最低申购单位数（minimum subscription units）"@zh ;
    rdfs:comment "现有投资者必须购买的最低单位/份额数量。"@zh ;
