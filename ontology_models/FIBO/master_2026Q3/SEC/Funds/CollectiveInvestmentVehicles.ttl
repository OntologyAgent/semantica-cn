    rdfs:range fibo-fnd-arr-rt:RatingScore ;
    skos:definition "The minimum rating of securities to be invested in."@en .

fibo-sec-fund-civ:minimumRemainingHoldingAmount a owl:ObjectProperty ;
    rdfs:label "minimum remaining holding amount"@en,
        "最低留存持有金额（minimum remaining holding amount）"@zh ;
    rdfs:comment "为避免自动赎回而必须留存的单位/份额最低价值。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    skos:definition "Minimum value of units/shares that must be retained to avoid automatic redemption."@en .

fibo-sec-fund-civ:minimumRemainingHoldingUnits a owl:DatatypeProperty ;
    rdfs:label "minimum remaining holding units"@en,
        "最低留存持有单位数（minimum remaining holding units）"@zh ;
    rdfs:comment "为避免自动赎回而必须留存的最低单位/份额数量。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range xsd:integer ;
    skos:definition "Minimum number of units/shares that must be retained to avoid automatic redemption."@en .

fibo-sec-fund-civ:minimumSubscriptionAmount a owl:ObjectProperty ;
    rdfs:label "minimum subscription amount"@en,
        "最低申购金额（minimum subscription amount）"@zh ;
