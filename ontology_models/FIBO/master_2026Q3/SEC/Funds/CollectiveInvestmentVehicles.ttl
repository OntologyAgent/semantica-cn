@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-col: <https://www.omg.org/spec/Commons/Collections/> .
@prefix cmns-cxtdsg: <https://www.omg.org/spec/Commons/ContextualDesignators/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-loc: <https://www.omg.org/spec/Commons/Locations/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-pts: <https://www.omg.org/spec/Commons/PartiesAndSituations/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix cmns-rga: <https://www.omg.org/spec/Commons/RegulatoryAgencies/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-be-fct-pub: <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/> .
@prefix fibo-be-ge-euj: <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/> .
@prefix fibo-be-le-cb: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/> .
@prefix fibo-be-le-fbo: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-be-oac-cown: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/> .
@prefix fibo-be-oac-exec: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/> .
@prefix fibo-be-oac-opty: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/> .
@prefix fibo-fbc-dae-dbt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-fi-stl: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/Settlement/> .
@prefix fibo-fbc-pas-caa: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-fbc-pas-fpas: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-arr-lif: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/> .
@prefix fibo-fnd-arr-rt: <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/> .
@prefix fibo-fnd-dt-bd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/> .
@prefix fibo-fnd-dt-fd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-law-cor: <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/> .
@prefix fibo-fnd-law-lcap: <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/> .
@prefix fibo-fnd-oac-own: <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/> .
@prefix fibo-fnd-plc-rp: <https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/> .
@prefix fibo-fnd-rel-rel: <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-ind-ind-ind: <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/> .
@prefix fibo-sec-eq-eq: <https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/> .
@prefix fibo-sec-fund-civ: <https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/CollectiveInvestmentVehicles/> .
@prefix fibo-sec-fund-fund: <https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/Funds/> .
@prefix fibo-sec-sec-cls: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesClassification/> .
@prefix fibo-sec-sec-iss: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/> .
@prefix fibo-sec-sec-pls: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/Pools/> .
@prefix fibo-sec-sec-rst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesRestrictions/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-sec-fund-civ:AccumulatingShareClass a owl:Class ;
    rdfs:label "accumulating share class"@en,
        "累积股类（accumulating share class）"@zh ;
    rdfs:comment "不提供分红再投资选择、收益累积于份额净值中的股类。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundShareClassUnit ;
    owl:disjointWith fibo-sec-fund-civ:DistributingShareClass ;
    skos:definition "A share class in which there is no option to reinvest."@en ;
    cmns-av:explanatoryNote "This fact would be determined by the fund unit having a specific Fund Distribution Policy of Accumulating."@en .

fibo-sec-fund-civ:CommonShareInFund a owl:Class ;
    rdfs:label "common share in fund"@en,
        "基金普通份额（common share in fund）"@zh ;
    rdfs:comment "基金中被归类为普通股类的份额单位。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundShareClassUnit ;
    owl:disjointWith fibo-sec-fund-civ:PreferredShareInFund ;
    skos:definition "A share unit in a fund, which is classified as a Common Share class."@en ;
    cmns-av:explanatoryNote "SR Review session notes: US: Closed and open ended funds may have common and preferred shares."@en .

fibo-sec-fund-civ:CurrencyStrategy a owl:Class ;
    rdfs:label "currency strategy"@en,
        "货币策略（currency strategy）"@zh ;
    rdfs:comment "基于货币的投资策略。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    skos:definition "Strategy which is currency based."@en .

fibo-sec-fund-civ:EquityFund a owl:Class ;
    rdfs:label "equity fund"@en,
        "股票基金（equity fund）"@zh ;
    rdfs:comment "至少 85% 投资于股票的基金。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-sec-fund-civ:EquityPortfolio ],
        fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "A fund which invests in at least 85% shares."@en .

fibo-sec-fund-civ:FondsCommunDePlacement a owl:Class ;
    rdfs:label "fonds commun de placement"@fr-FR,
        "共同投资基金（FondsCommunDePlacement）"@zh ;
    rdfs:comment "开放式集合投资基金，是基金管理人与投资者之间设立的合同形式，而非独立法律实体（法国 FCP）。"@zh ;
    rdfs:seeAlso <https://iclg.com/practice-areas/public-investment-funds-laws-and-regulations/france>,
        <https://www.alfi.lu/en-gb/understandinginvesting/post/which-structure-to-choose>,
        <https://www.ubp.com/en/glossary-risk-management/glossary-legal-compliance/fcp> ;
    rdfs:subClassOf fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "open-ended collective investment fund, which is a contractual form set up between the fund manager and investors and not a separate legal entity"@en ;
    skos:note "An FCP is similar to a unit trust in the UK. FCPs are not investment companies, but more like open partnerships. They can be set up as a single fund or as an umbrella fund with multiple sub-funds, typically issued in the French-speaking countries of Europe."@en ;
    cmns-av:abbreviation "FCP"@en .

fibo-sec-fund-civ:FundAccountant a owl:Class ;
    rdfs:label "fund accountant"@en,
        "基金会计（fund accountant）"@zh ;
    rdfs:comment "负责记录基金资产和负债账目的一方，计算交易价格、基金资产净值（NAV）等。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundsProcessingParty ;
    skos:definition "The party that keeps accounting records of the available assets and liabilities of the Fund. It calculates dealing prices, the Net Asset Value (NAV) of the Fund, and may provide fund performance and tax data. Can be subcontracted by the FundAdministrator."@en .

fibo-sec-fund-civ:FundClassificationScheme a owl:Class ;
    rdfs:label "fund classification scheme"@en,
        "基金分类方案（fund classification scheme）"@zh ;
    rdfs:comment "按资产类别对基金进行分类的公开方案。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-sec-fund-civ:FundClassification ],
        cmns-cls:ClassificationScheme ;
    skos:definition "A published scheme for the category of a fund according to the asset class."@en .

fibo-sec-fund-civ:FundDistributionPolicy a owl:Class ;
    rdfs:label "fund distribution policy"@en,
        "基金分配政策（fund distribution policy）"@zh ;
    rdfs:comment "表明基金分配总体策略或限制的政策。"@zh ;
    rdfs:subClassOf fibo-fnd-law-lcap:Policy ;
    skos:definition "policy indicating the overall strategy or limitations on distribution for the fund"@en ;
    cmns-av:explanatoryNote "Note that individual classes of Fund Unit also have specific distribution polcies as they effect that class of unit. This class is for terms with wording of the form: \" ... whether or not it is possible to hold shares ...\" for a given parameter."@en .

fibo-sec-fund-civ:FundDividendPolicy a owl:Class ;
    rdfs:label "fund dividend policy"@en,
        "基金股息政策（fund dividend policy）"@zh ;
    rdfs:comment "关于股息预期分配的条款。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundCashDistributionPolicy ;
    skos:definition "Terms for the expected distributions of dividends."@en .

fibo-sec-fund-civ:FundsCashDistribution a owl:Class ;
    rdfs:label "funds cash distribution"@en,
        "基金现金分配（funds cash distribution）"@zh ;
    rdfs:comment "应计收益定期分配给投资者的方式。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundUnitDistributionMethod ;
    skos:definition "Accrued income is distributed periodically to the investor."@en .

fibo-sec-fund-civ:FundsProcessing a owl:Class ;
    rdfs:label "funds processing"@en,
        "基金处理（funds processing）"@zh ;
    rdfs:comment "管理和处理基金、发行基金单位等的业务语境，基金相关各方即在此语境中定义。"@zh ;
    rdfs:subClassOf fibo-fnd-arr-lif:LifecycleStage ;
    skos:definition "The context of managing and processing funds, issuing funds units etc. This is the context in which the different parties involved in a fund are defined as parties."@en .

fibo-sec-fund-civ:IncomeAccumulation a owl:Class ;
    rdfs:label "income accumulation"@en,
        "收益累积（income accumulation）"@zh ;
    rdfs:comment "应计收益不予分配，而是继续反映在单位/份额价格中的方式。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundUnitDistributionMethod ;
    skos:definition "Accrued income is not distributed and instead remains reflected within the unit/share price."@en .

fibo-sec-fund-civ:JurisdictionStrategy a owl:Class ;
    rdfs:label "jurisdiction strategy"@en,
        "司法管辖区策略（jurisdiction strategy）"@zh ;
    rdfs:comment "基于司法管辖区的投资策略。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ;
            owl:someValuesFrom cmns-rga:Jurisdiction ],
        fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    skos:definition "Strategy which is jurisdiction based."@en .

fibo-sec-fund-civ:KeyInvestorInformationDocument a owl:Class ;
    rdfs:label "key investor information document",
        "关键投资者信息文件（key investor information document）"@zh ;
    rdfs:comment "为投资者提供关键信息的简短文件，汇总招募说明书内容以便投资者理解（KIID）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom fibo-sec-fund-fund:FundUnit ],
        [ a owl:Restriction ;
            owl:hasValue fibo-be-ge-euj:EuropeanUnionJurisdiction ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ],
        fibo-sec-sec-iss:OfferingDocument ;
    skos:definition "short document that provides critical information for investors, summarizing content derived from a prospectus such that it can be understood by investors without reference to other documents, as required by law in the European Union" ;
    cmns-av:abbreviation "KIID" ;
    cmns-av:adaptedFrom "https://eur-lex.europa.eu/eli/dir/2009/65/2020-01-07"^^xsd:anyURI ;
    cmns-av:explanatoryNote "Key investor information shall include appropriate information about the essential characteristics of the UCITS concerned, which is to be provided to investors so that they are reasonably able to understand the nature and the risks of the investment product that is being offered to them and, consequently, to take investment decisions on an informed basis." .

fibo-sec-fund-civ:NoteFundShare a owl:Class ;
    rdfs:label "note fund share",
        "票据基金份额（note fund share）"@zh ;
    rdfs:comment "在基金以公司形式组建时，发行票据而非传统权益的基金中的投资权益。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom fibo-sec-fund-civ:NoteFund ],
        fibo-sec-fund-fund:FundUnit ;
    skos:definition "investment interest in a fund that issues notes rather than traditional equity, in cases where the fund is structured as a company" ;
    cmns-av:explanatoryNote "A note fund share refers to an equity or debt-linked interest in a corporate fund vehicle that issues notes." .

fibo-sec-fund-civ:NoteFundUnit a owl:Class ;
    rdfs:label "note fund unit",
        "票据基金单位（note fund unit）"@zh ;
    rdfs:comment "在基金以信托、合伙或单位信托形式组建时，发行票据而非传统权益的基金中的投资权益。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom fibo-sec-fund-civ:NoteFund ],
        fibo-sec-fund-fund:FundUnit ;
    skos:definition "investment interest in a fund that issues notes rather than traditional equity, in cases where the fund is structured as a trust, partnership, or unitized fund" ;
    cmns-av:explanatoryNote "A note fund unit refers to a non-equity interest in a fund that issues rated notes and is organized as a unit trust or limited partnership." .

fibo-sec-fund-civ:PrivateEquityHolding a owl:Class ;
    rdfs:label "private equity holding"@en,
        "私募股权持有（private equity holding）"@zh ;
    rdfs:comment "对私募股权的持有。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-sec-eq-eq:PrivatelyHeldShare ],
        fibo-fnd-oac-own:Portfolio ;
    skos:definition "A holding of private equity."@en .

fibo-sec-fund-civ:RealEstateHolding a owl:Class ;
    rdfs:label "real estate holding"@en,
        "房地产持有（real estate holding）"@zh ;
    rdfs:comment "由个人、组织或实体为投资、运营或战略目的拥有或控制的房地产有形资产。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fnd-plc-rp:RealEstate ],
        fibo-fnd-oac-own:Portfolio ;
    skos:definition "tangible asset consisting of real estate that is owned or controlled by an individual, organization, or entity for investment, operational, or strategic purposes"@en .

fibo-sec-fund-civ:SICAF a owl:Class ;
    rdfs:label "s i c a f"@en,
        "法国固定资本投资公司（SICAF）"@zh ;
    rdfs:comment "法国的一种基金载体形式，资本固定的投资公司。"@zh ;
    rdfs:subClassOf fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "A French fund vehicle type. Designation and definition needed."@en .

fibo-sec-fund-civ:SICAV a owl:Class ;
    rdfs:label "s i c a v"@en,
        "可变资本投资公司（SICAV）"@zh ;
    rdfs:comment "法国及欧洲大陆常见的开放式投资公司形式，资本可变的集合投资公司。"@zh ;
    rdfs:subClassOf fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "Societe Collective a Capital Variable"@en .

fibo-sec-fund-civ:SectorStrategy a owl:Class ;
    rdfs:label "sector strategy"@en,
        "行业策略（sector strategy）"@zh ;
    rdfs:comment "基于行业板块的投资策略。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    skos:definition "Strategy which is sector based."@en .

fibo-sec-fund-civ:accountingYearEndDate a owl:ObjectProperty ;
    rdfs:label "accounting year end date"@en,
        "会计年度截止日（accounting year end date）"@zh ;
    rdfs:comment "基金会计年度的最后一天。"@zh ;
    rdfs:range fibo-fnd-dt-bd:DayOfMonth ;
    skos:definition "Last day of the accounting year for the fund."@en .

fibo-sec-fund-civ:additionalRestrictions a owl:DatatypeProperty ;
    rdfs:label "additional restrictions"@en,
        "附加限制（additional restrictions）"@zh ;
    rdfs:comment "关于该策略及其所指机构的其他限制或处理信息。"@zh ;
    rdfs:domain fibo-sec-fund-civ:OrganizationStrategy ;
    rdfs:range xsd:string ;
    skos:definition "Other restrictions or treatment information in respect of this strategy and the organization to which it refers."@en .

fibo-sec-fund-civ:authorizedCountry a owl:ObjectProperty ;
    rdfs:label "authorized country"@en,
        "获准销售国（authorized country）"@zh ;
    rdfs:comment "获准在该国销售基金的国家。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range cmns-loc:Country ;
    skos:definition "Country in which it is authorised to commercialise the fund."@en .

fibo-sec-fund-civ:backEndLoadApplicable a owl:DatatypeProperty ;
    rdfs:label "back end load applicable"@en,
        "是否适用后端收费（back end load applicable）"@zh ;
    rdfs:comment "该类别的赎回指令是否可收取退出费用（如或有递延销售费 CDSC）。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether an exit charge, eg, CDSC, on redemption orders for this class can be applied."@en .

fibo-sec-fund-civ:benchmarkWeight a owl:ObjectProperty ;
    rdfs:label "benchmark weight"@en,
        "基准权重（benchmark weight）"@zh ;
    rdfs:comment "工具在组合基准中的权重。"@zh ;
    rdfs:domain fibo-sec-fund-civ:PortfolioBenchmark ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "Instrument weighting in the benchmark for the portfolio."@en .

fibo-sec-fund-civ:blacklisted a owl:DatatypeProperty ;
    rdfs:label "blacklisted"@en,
        "是否列入黑名单（blacklisted）"@zh ;
    rdfs:comment "该策略是否将所指商业实体列入黑名单：若是，则该策略禁止投资于该实体。"@zh ;
    rdfs:domain fibo-sec-fund-civ:OrganizationStrategy ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether or not the strategy in framed so as to include the referenced business entity as being blacklisted. If yes, the strategy prevents investment in securities issued by that organization."@en .

fibo-sec-fund-civ:clearFundsRequired a owl:DatatypeProperty ;
    rdfs:label "clear funds required"@en,
        "是否需要资金到账（clear funds required）"@zh ;
    rdfs:comment "执行申购指令前是否要求资金已清算到账。"@zh ;
    rdfs:domain fibo-fbc-pas-fpas:SettlementTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether cleared funds may be required before a subscription order can be executed."@en .

fibo-sec-fund-civ:couponPaymentDate a owl:ObjectProperty ;
    rdfs:label "coupon payment date"@en,
        "票息支付日（coupon payment date）"@zh ;
    rdfs:comment "票息分配给债券单位持有人的日期。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundCouponPolicy ;
    rdfs:range fibo-fnd-dt-bd:DayOfMonth ;
    skos:definition "The date at which the coupon is distributed to the bond unit holder."@en .

fibo-sec-fund-civ:dealingFrequencyDescription a owl:DatatypeProperty ;
    rdfs:label "dealing frequency description"@en,
        "交易频率描述（dealing frequency description）"@zh ;
    rdfs:comment "对申购和赎回执行频率的文字描述。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingTerms ;
    rdfs:range xsd:string ;
    skos:definition "Description of frequency at which the subscriptions and redemptions are done."@en .

fibo-sec-fund-civ:declarationChannel a owl:DatatypeProperty ;
    rdfs:label "declaration channel"@en,
        "公告渠道（declaration channel）"@zh ;
    rdfs:comment "资产净值公布的渠道，例如报纸。"@zh ;
    rdfs:domain fibo-sec-fund-civ:NetAssetValueCalculationMethod ;
    rdfs:range xsd:string ;
    skos:definition "Means of the net asset value publication, eg, a newspaper."@en .

fibo-sec-fund-civ:distributionWithReinvestment a owl:DatatypeProperty ;
    rdfs:label "distribution with reinvestment"@en,
        "分配并再投资（distribution with reinvestment）"@zh ;
    rdfs:comment "可以持有这样一类份额：应计收益先予分配，然后自动再投资于额外单位/份额。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundReinvestmentPolicy,
        fibo-sec-fund-civ:FundUnitDistributionPolicy ;
    rdfs:range xsd:boolean ;
    skos:definition "It is possible to hold shares for which the accrued income is distributed, but then reinvested automatically in additional units/shares allocated to the investor."@en .

fibo-sec-fund-civ:dualFund a owl:DatatypeProperty ;
    rdfs:label "dual fund"@en,
        "是否双价基金（dual fund）"@zh ;
    rdfs:comment "该基金是否有两个价格。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the fund has two prices."@en .

fibo-sec-fund-civ:endOfFiscalYear a owl:ObjectProperty ;
    rdfs:label "end of fiscal year"@en,
        "财年截止日（end of fiscal year）"@zh ;
    rdfs:comment "每年结账并确定损益的日期（月和日）。"@zh ;
    rdfs:range fibo-fnd-dt-bd:DayOfMonth ;
    skos:definition "Day and month on any given year at which the books are closed and profit and loss is determined."@en .

fibo-sec-fund-civ:exCouponDate a owl:ObjectProperty ;
    rdfs:label "ex coupon date"@en,
        "除息日（ex coupon date）"@zh ;
    rdfs:comment "票息从资产净值（NAV）中扣除的日期。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundCouponPolicy ;
    rdfs:range fibo-fnd-dt-bd:DayOfMonth ;
    skos:definition "The date at which the coupon is substracted from the NAV"@en .

fibo-sec-fund-civ:firstAccountingYearEndDate a owl:DatatypeProperty ;
    rdfs:label "first accounting year end date"@en,
        "首个会计年度截止日（first accounting year end date）"@zh ;
    rdfs:comment "基金第一个会计年度的最后一天。"@zh ;
    skos:definition "Last day of the first accounting year for the fund."@en .

fibo-sec-fund-civ:firstNAVCalculationDate a owl:DatatypeProperty ;
    rdfs:label "first n a v calculation date"@en,
        "首次资产净值计算日（first NAV calculation date）"@zh ;
    rdfs:comment "首次计算资产净值（NAV）的日期。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "The first date of NAV calculation"@en .

fibo-sec-fund-civ:frontEndLoadApplicable a owl:DatatypeProperty ;
    rdfs:label "front end load applicable"@en,
        "是否适用前端收费（front end load applicable）"@zh ;
    rdfs:comment "该类别的申购指令是否可收取前端费用。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a front end charge on subscription orders for this class can be applied."@en .

fibo-sec-fund-civ:fundClassTypeIdentifier a owl:DatatypeProperty ;
    rdfs:label "fund class type identifier"@en,
        "基金类别类型标识符（fund class type identifier）"@zh ;
    rdfs:comment "基金单位类别的文字标识，用于唯一标识某一基金单位类别及其特征。"@zh ;
    rdfs:domain fibo-sec-fund-fund:FundUnit ;
    rdfs:range xsd:string ;
    skos:definition "A textual identification of the class of fund units. This is used to uniquely identify a particular class of fund units, and thereby identify features of this type of unit within the fund."@en .

fibo-sec-fund-civ:hasIssueDate a owl:ObjectProperty ;
    rdfs:label "has issue date"@en,
        "具有设立日（has issue date）"@zh ;
    rdfs:comment "首次资产净值计算和业绩计算开始的日期（同成立日）。"@zh ;
    rdfs:domain fibo-sec-fund-fund:FundUnit ;
    rdfs:range cmns-dt:Date ;
    skos:definition "Date of first NAV calculation and start of performance calculations (same as launch date)"@en .

fibo-sec-fund-civ:hasPortfolio a owl:ObjectProperty ;
    rdfs:label "has portfolio"@en,
        "具有组合（has portfolio）"@zh ;
    rdfs:comment "指明基金的投资组合。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundPortfolio .

fibo-sec-fund-civ:hasTradableUnit a owl:ObjectProperty ;
    rdfs:label "has tradable unit"@en,
        "具有可交易单位（has tradable unit）"@zh ;
    rdfs:comment "指明基金的可交易单位。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-fund:FundUnit .

fibo-sec-fund-civ:historicPricingIndicator a owl:DatatypeProperty ;
    rdfs:label "historic pricing indicator"@en,
        "历史定价标志（historic pricing indicator）"@zh ;
    rdfs:comment "表明价格是历史价还是远期价。"@zh ;
    rdfs:domain fibo-sec-fund-civ:NetAssetValueCalculationMethod ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the price is historic or forward."@en .

fibo-sec-fund-civ:holderMayReinvest a owl:DatatypeProperty ;
    rdfs:label "holder may reinvest"@en,
        "持有人可否再投资（holder may reinvest）"@zh ;
    rdfs:comment "持有人是否可以将股息再投资于该基金。"@zh ;
    rdfs:domain fibo-sec-fund-civ:DistributingShareClass ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether or not the holder may reinvest dividends in the fund."@en .

fibo-sec-fund-civ:holdingTransferable a owl:DatatypeProperty ;
    rdfs:label "holding transferable"@en,
        "持有可否转让（holding transferable）"@zh ;
    rdfs:comment "注册投资者是否可以将其部分或全部持有转让给第三方。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether registered investors are able to transfer some or all of their holdings to third parties."@en .

fibo-sec-fund-civ:inceptionDate a owl:ObjectProperty ;
    rdfs:label "inception date"@en,
        "核准设立日（inception date）"@zh ;
    rdfs:comment "在原产国获得核准的日期。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range cmns-dt:Date ;
    skos:definition "Authorization date in the country of origin."@en .

fibo-sec-fund-civ:inceptionDate.1 a owl:ObjectProperty ;
    rdfs:label "inception date"@en,
        "核准设立日（inception date）"@zh ;
    rdfs:comment "在原产国获得核准的日期。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundShareClassUnit ;
    rdfs:range cmns-dt:Date ;
    skos:definition "Authorization date in the country of origin. Further Notes See definition in Inception Date for Fund. Separate fact exists here. Same definition used. EFAMA Review notes: Inception Date exists as soon as there is a prospectus, so it is a fact about a Share Class even if the share class is never formally issued or offered to the public. Legal structure exists even if something is not launched. Editor question: Review stated this was a fact about Share Class; confirm this fact does not apply to Bond and Note units, or was the term Share Class being used to mean all three? Meanwhile I have put the term \"Issue Date\" as a fact about all Fund Unit, as this is given a sa separate term in the EFAMA DD spreadsheet. MAy come clearer in the next version of that."@en .

fibo-sec-fund-civ:includeRelatedFirms a owl:DatatypeProperty ;
    rdfs:label "include related firms"@en,
        "是否包含关联公司（include related firms）"@zh ;
    rdfs:comment "该策略是否包含与所指机构存在某种关联的公司。"@zh ;
    rdfs:domain fibo-sec-fund-civ:OrganizationStrategy ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether or not the strategy includes firms which are related in some way to the referenced organization."@en .

fibo-sec-fund-civ:inclusion a owl:DatatypeProperty ;
    rdfs:label "inclusion"@en,
        "是否纳入（inclusion）"@zh ;
    rdfs:comment "所指策略是否被纳入；若为否，则该描述指将所述内容排除于组合之外。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the referred strategy is included. No means this description refers to the exclusion of what is described, from the portfolio."@en .

fibo-sec-fund-civ:initialApplicationForm a owl:ObjectProperty ;
    rdfs:label "initial application form"@en,
        "首次申请表（initial application form）"@zh ;
