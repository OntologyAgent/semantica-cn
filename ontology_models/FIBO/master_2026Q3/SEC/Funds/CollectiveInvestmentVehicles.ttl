    skos:definition "Maximum percentage or fixed amount of money due when redeeming fund shares Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:maximumRedemptionPercentage a owl:ObjectProperty ;
    rdfs:label "maximum redemption percentage"@en,
