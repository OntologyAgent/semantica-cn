    rdfs:domain fibo-sec-fund-fund:FundUnit ;
    rdfs:range fibo-fnd-acc-cur:Price ;
    skos:definition "The price at which the Fund Unit was first issued."@en .

fibo-sec-fund-civ:launchDate a owl:DatatypeProperty ;
    rdfs:label "launch date"@en,
        "成立日（launch date）"@zh ;
    rdfs:comment "首次资产净值计算和业绩计算开始的日期。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "Date of first NAV calculation and start of performance calculations"@en .

fibo-sec-fund-civ:limitedSharesAreIssued a owl:DatatypeProperty ;
    rdfs:label "limited shares are issued"@en,
        "是否限量发行份额（limited shares are issued）"@zh ;
