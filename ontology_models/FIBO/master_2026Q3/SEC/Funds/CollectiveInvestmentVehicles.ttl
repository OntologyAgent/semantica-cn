    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range xsd:string ;
    skos:definition "Company specific description of a group of funds."@en .

fibo-sec-fund-civ:purchasingFee a owl:ObjectProperty ;
    rdfs:label "purchasing fee"@en,
        "申购费（purchasing fee）"@zh ;
    rdfs:comment "购买基金份额时应付的实际百分比或固定金额费用。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range fibo-fbc-pas-caa:Fee ;
    skos:definition "Actual percentage or fixed amount of money due when purchasing fund shares Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:redemptionCutoffDateTime a owl:ObjectProperty ;
    rdfs:label "redemption cutoff date time"@en,
        "赎回截止时间（redemption cutoff date time）"@zh ;
    rdfs:comment "可以提交赎回指令的最后日期/时间。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundRedemptionTerms ;
    rdfs:range cmns-dt:DateTime ;
    skos:definition "Last date/time at which an order to redeem can be given."@en .

fibo-sec-fund-civ:redemptionCycleInBusinessDays a owl:DatatypeProperty ;
    rdfs:label "redemption cycle in business days"@en,
        "赎回周期（营业日）（redemption cycle in business days）"@zh ;
    rdfs:comment "自赎回指令定价日（T）起算、主基金下单台受理指令应完成结算的最后营业日。"@zh ;
    rdfs:domain fibo-fbc-fi-stl:SettlementConvention ;
    rdfs:range xsd:integer ;
    skos:definition "The last business day following the day on which a redemption order is priced (T) by which settlement will be due for orders placed with the main Fund Order Desk. Alternatively, if proceeds will be paid following receipt of written renunciation, the last business day following receipt of the relevant renunciation documentation by the main Fund Order Desk (R) by which the proceeds will be sent."@en .

fibo-sec-fund-civ:redemptionDealingFrequency a owl:ObjectProperty ;
    rdfs:label "redemption dealing frequency"@en,
        "赎回交易频率（redemption dealing frequency）"@zh ;
    rdfs:comment "赎回执行的频率。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundRedemptionTerms ;
    rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
    skos:definition "Frequency at which the redemptions are done."@en .

fibo-sec-fund-civ:redemptionFee a owl:ObjectProperty ;
    rdfs:label "redemption fee"@en,
        "赎回费（redemption fee）"@zh ;
    rdfs:comment "赎回基金份额时应付的实际百分比或固定金额费用。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range fibo-fbc-pas-caa:Fee ;
    skos:definition "Actual percentage or fixed amount of money due when redeeming fund shares Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:redemptionForm a owl:ObjectProperty ;
    rdfs:label "redemption form"@en,
        "赎回申请表（redemption form）"@zh ;
    rdfs:comment "投资者赎回单位/份额的纸质书面指令/弃权表格。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundRedemptionTerms ;
    skos:definition "Physical written instruction/renunciation form for redemption of units/shares by the investor."@en .

fibo-sec-fund-civ:redemptionInAmountAllowed a owl:DatatypeProperty ;
    rdfs:label "redemption in amount allowed"@en,
        "是否允许按金额赎回（redemption in amount allowed）"@zh ;
    rdfs:comment "是否允许按金额赎回。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundRedemptionTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether redemptions in amount are allowed."@en .

fibo-sec-fund-civ:redemptionPeriod a owl:ObjectProperty ;
    rdfs:label "redemption period"@en,
        "赎回期（redemption period）"@zh ;
    rdfs:comment "可以赎回单位/份额的特定期间，例如某些保本基金的赎回期。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundRedemptionTerms ;
    rdfs:range cmns-dt:DatePeriod ;
    skos:definition "Specific period, eg, for some guaranteed funds, during which the units/shares may be redeemed."@en .

fibo-sec-fund-civ:registrationDate a owl:DatatypeProperty ;
    rdfs:label "registration date"@en,
        "注册日期（registration date）"@zh ;
    rdfs:comment "基金在原产国以外国家获得法律核准的日期。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    skos:definition "The date at which the fund is legally approved in a country other than the country of origin."@en .

fibo-sec-fund-civ:reinvestmentFrequency a owl:ObjectProperty ;
    rdfs:label "reinvestment frequency"@en,
        "再投资频率（reinvestment frequency）"@zh ;
    rdfs:comment "对采取再投资分配方式的单位，再投资发生的频率。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundReinvestmentPolicy ;
    rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
    skos:definition "For units where there is Reinvestment distribution, the frequency with which the reinvestment takes place (this will be the same or less frequently than the Dividend Payment Frequency), otherwise this fact does not apply."@en .

fibo-sec-fund-civ:signatureRequired a owl:DatatypeProperty ;
    rdfs:label "signature required"@en,
        "是否需要签名（signature required）"@zh ;
    rdfs:comment "是否必须通过主基金下单台提交附有投资者亲笔签名的纸质表格。"@zh ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a phsyical form with the investor's written signature is required through the main fund order desk. Yes:A phsyical form with the investor's written signature is required through the main fund order desk."@en .

fibo-sec-fund-civ:statedDistributionFee a owl:ObjectProperty ;
    rdfs:label "stated distribution fee"@en,
        "列明分销费（stated distribution fee）"@zh ;
    rdfs:comment "在招募说明书中列明的分销费用。"@zh ;
    rdfs:domain fibo-sec-sec-iss:Prospectus ;
    rdfs:range fibo-fnd-acc-cur:MonetaryAmount .

fibo-sec-fund-civ:statedInvestmentAim a owl:DatatypeProperty ;
    rdfs:label "stated investment aim"@en,
        "列明投资目标（stated investment aim）"@zh ;
    rdfs:comment "以文字表述的基金目标，例如超越某一基准。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundInvestmentObjective ;
    rdfs:range xsd:string ;
    skos:definition "The stated aim of the Fund in words, e.g outperfom a given benchmark."@en .

fibo-sec-fund-civ:statedManagementFee a owl:ObjectProperty ;
    rdfs:label "stated management fee"@en,
        "列明管理费（stated management fee）"@zh ;
    rdfs:comment "在招募说明书中列明的管理费用，可为货币金额或百分比。"@zh ;
    rdfs:domain fibo-sec-sec-iss:Prospectus ;
    rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    skos:definition "The fee that is stated in the Prospectus as being what is to be charged for management. Further notes: Can be monetary amount or a percentage or a combination. Action: simple type is wrong."@en .

fibo-sec-fund-civ:statedObjective a owl:DatatypeProperty ;
    rdfs:label "stated objective"@en,
        "列明目标（stated objective）"@zh ;
    rdfs:comment "以文字表述的基金目标。"@zh ;
    rdfs:domain fibo-sec-sec-iss:Prospectus ;
    rdfs:range xsd:string ;
    skos:definition "The stated objective of the fund, in words."@en .

fibo-sec-fund-civ:subscriptionCutoffDateTime a owl:ObjectProperty ;
    rdfs:label "subscription cutoff date time"@en,
        "申购截止时间（subscription cutoff date time）"@zh ;
    rdfs:comment "可以提交申购指令的最后日期/时间。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range cmns-dt:DateTime ;
    skos:definition "Last date/time at which an order to subscribe can be given."@en .

fibo-sec-fund-civ:subscriptionDealingFrequency a owl:ObjectProperty ;
    rdfs:label "subscription dealing frequency"@en,
        "申购交易频率（subscription dealing frequency）"@zh ;
    rdfs:comment "申购执行的频率。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
    skos:definition "Frequency at which the subscriptions are done."@en .

fibo-sec-fund-civ:subscriptionPeriod a owl:ObjectProperty ;
    rdfs:label "subscription period"@en,
        "认购期间（subscription period）"@zh ;
    rdfs:comment "证券可被认购的期间。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range cmns-dt:DatePeriod ;
    skos:definition "Specific period, eg, for some guaranteed funds, during which the units/shares may be subscribed to."@en .

fibo-sec-fund-civ:subscriptionsInAmountAllowed a owl:DatatypeProperty ;
    rdfs:label "subscriptions in amount allowed"@en,
        "是否允许按金额申购（subscriptions in amount allowed）"@zh ;
    rdfs:comment "是否允许按金额申购。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether subscriptions in amount are allowed."@en .

fibo-sec-fund-civ:subsequentApplicationForm a owl:ObjectProperty ;
    rdfs:label "subsequent application form"@en,
        "后续申请表（subsequent application form）"@zh ;
    rdfs:comment "同一投资者后续投资的纸质申请表。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    skos:definition "Physical application form for subsequent investments by the same investor."@en .

fibo-sec-fund-civ:switchingChargeable a owl:DatatypeProperty ;
    rdfs:label "switching chargeable"@en,
        "是否收取转换费（switching chargeable）"@zh ;
    rdfs:comment "同一伞形基金下子基金之间转换是否可收取转换费。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingGeneralTerms ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a switching charge for changing between sub-funds of the same umbrella can be applied."@en .

fibo-sec-fund-civ:switchingFee a owl:ObjectProperty ;
    rdfs:label "switching fee"@en,
        "转换费（switching fee）"@zh ;
    rdfs:comment "转换至另一基金时应付的实际百分比或固定金额费用。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:range fibo-fbc-pas-caa:Fee ;
    skos:definition "Actual percentage or fixed amount of money due when switching to another fund. Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:trackingError a owl:ObjectProperty ;
    rdfs:label "tracking error"@en,
        "跟踪误差（tracking error）"@zh ;
    rdfs:comment "组合回报与基准回报之间差异的度量。"@zh ;
    rdfs:domain fibo-sec-fund-civ:InvestmentRestriction ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "See RiskFactors narrative in EFAMA DD"@en .

fibo-sec-fund-civ:typeOfSecurities a owl:DatatypeProperty ;
    rdfs:label "type of securities"@en,
        "证券类型（type of securities）"@zh ;
    rdfs:comment "可投资的证券或其他持有资产的类型。"@zh ;
    rdfs:domain fibo-sec-fund-civ:InvestmentRestriction ;
    rdfs:range xsd:string ;
    skos:definition "The type of securities or other holdings that may be invested in."@en .

fibo-sec-fund-civ:valuationFrequency a owl:ObjectProperty ;
    rdfs:label "valuation frequency"@en,
        "估值频率（valuation frequency）"@zh ;
    rdfs:comment "资产净值计算的频率。"@zh ;
    rdfs:domain fibo-sec-fund-civ:NetAssetValueCalculationMethod ;
    rdfs:range fibo-fnd-dt-fd:RecurrenceInterval ;
    skos:definition "Frequency of the net asset value calculation."@en .

fibo-sec-fund-civ:valuationFrequencyTextualDescription a owl:DatatypeProperty ;
    rdfs:label "valuation frequency textual description"@en,
        "估值频率文字描述（valuation frequency textual description）"@zh ;
    rdfs:comment "对资产净值计算频率的文字描述。"@zh ;
    rdfs:domain fibo-sec-fund-civ:NetAssetValueCalculationMethod ;
    rdfs:range xsd:string ;
    skos:definition "Description of the frequency of the net asset value calculation."@en .

fibo-sec-fund-civ:valueAtRisk a owl:ObjectProperty ;
    rdfs:label "value at risk"@en,
        "风险价值（value at risk）"@zh ;
    rdfs:comment "对基金（而非组合）在给定置信水平下潜在损失的度量（VaR）。"@zh ;
    rdfs:domain fibo-sec-fund-civ:InvestmentRestriction ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "See RiskClassification_NameOf in EFAMA DD Applies to Fund not Portfolio."@en .

fibo-sec-fund-fund:FundContract a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:isEvidencedBy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundLegalFormDocumentation ] ;
    cmns-av:explanatoryNote "From ISO FIBIM \"Umbrella Fund\" narrative: In securities, a collective investment scheme that has a contractual or a corporate form. When it has a contractual form, a fund is constituted under either the law of contract or under the trust law and thus it is not a legal entity. In its corporate form, a fund is a legal entity and is structured as a company."@en .

fibo-sec-fund-civ: a owl:Ontology ;
    rdfs:label "Collective Investment Vehicles Ontology"@en,
        "集合投资工具本体（Collective Investment Vehicles Ontology）"@zh ;
    dcterms:abstract "Reference data terms and non time dependent facts about funds and CIVs." ;
    dcterms:license """Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.

