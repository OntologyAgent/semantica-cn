The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义集合投资工具（CIV）：汇集多投资者资金共同投资的载体，是基金的上位概念。"@zh ;
    owl:imports fibo-be-fct-pub:,
        fibo-be-ge-euj:,
        fibo-be-le-cb:,
        fibo-be-le-fbo:,
        fibo-be-le-lp:,
        fibo-be-oac-cown:,
        fibo-be-oac-exec:,
        fibo-be-oac-opty:,
        fibo-fbc-dae-dbt:,
        fibo-fbc-fi-fi:,
        fibo-fbc-fi-stl:,
        fibo-fbc-fct-fse:,
        fibo-fbc-pas-caa:,
        fibo-fbc-pas-fpas:,
        fibo-fnd-acc-cur:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-arr-lif:,
        fibo-fnd-arr-rt:,
        fibo-fnd-dt-bd:,
        fibo-fnd-dt-fd:,
        fibo-fnd-gao-obj:,
        fibo-fnd-law-lcap:,
        fibo-fnd-law-cor:,
        fibo-fnd-oac-own:,
        fibo-fnd-plc-rp:,
        fibo-fnd-rel-rel:,
        fibo-fnd-utl-av:,
        fibo-ind-ind-ind:,
        fibo-sec-eq-eq:,
        fibo-sec-fund-fund:,
        fibo-sec-sec-pls:,
        fibo-sec-sec-cls:,
        <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIdentification/>,
        fibo-sec-sec-iss:,
        fibo-sec-sec-rst:,
        cmns-av:,
        cmns-cls:,
        cmns-col:,
        cmns-cxtdsg:,
        cmns-dt:,
        cmns-dsg:,
        cmns-doc:,
        cmns-loc:,
        cmns-org:,
        cmns-pts:,
        cmns-qtu:,
        cmns-rga:,
        cmns-rlcmp:,
        <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/> ;
    owl:versionIRI fibo-sec-fund-civ: ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional ;
    cmns-av:copyright "Copyright (c) 2013-2025 Object Management Group, Inc.",
        "Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc." .

fibo-sec-fund-civ:AssetClassStrategy a owl:Class ;
    rdfs:label "asset class strategy"@en,
        "资产类别策略（asset class strategy）"@zh ;
    rdfs:comment "基于资产类别的投资策略。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:identifiesAssetTypesBy ;
            owl:someValuesFrom fibo-sec-sec-cls:FinancialInstrumentClassifier ],
        fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    skos:definition "Strategy which is asset class based."@en ;
    cmns-av:explanatoryNote "EFAMA: The type of securities or other holdings that may be invested in. FIBIM: Strategy which is asset class based. Can implement this in terms of a classification of those things. Wording implies this is a policy."@en .

fibo-sec-fund-civ:EquityPortfolio a owl:Class ;
    rdfs:label "equity portfolio"@en,
        "股票组合（equity portfolio）"@zh ;
    rdfs:comment "至少 85% 敞口为股票的投资组合。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-be-oac-cown:Shareholding ],
        fibo-sec-fund-civ:FundPortfolio ;
    skos:definition "A portfolio which has at least 85% exposure to shares."@en .

fibo-sec-fund-civ:FundBondClassUnit a owl:Class ;
    rdfs:label "fund bond class unit"@en,
        "基金债券类单位（fund bond class unit）"@zh ;
    rdfs:comment "以对该基金之债权形式存在的基金单位。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasExpectedCoupon ;
            owl:someValuesFrom fibo-sec-fund-civ:FundBondUnitCoupon ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasStrategy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundUnitDistributionPolicy ],
        fibo-sec-fund-fund:FundUnit ;
    skos:definition "A fund unit which takes the form of debt in that fund."@en ;
    cmns-av:explanatoryNote "From EFAMA Review: called denominations e.g. issued in $5000 pieces. You cannot buy fractional amounts in a bond."@en .

fibo-sec-fund-civ:FundClassification a owl:Class ;
    rdfs:label "fund classification"@en,
        "基金分类（fund classification）"@zh ;
    rdfs:comment "按资产类别对基金进行的分类，是用于对基金归类的公开代码。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-sec-sec-pls:CollectiveInvestmentVehicle ],
        cmns-cls:Classifier ;
    skos:definition "The category of the fund according to the asset class. This is a published code by which the Fund is classified. Further notes: Could be EFCF codes. This is the way in which \"Type of fund\" is articulated."@en .

fibo-sec-fund-civ:FundLegalFormDocumentation a owl:Class ;
    rdfs:label "fund legal form documentation"@en,
        "基金法律形式文件（fund legal form documentation）"@zh ;
    rdfs:comment "依合同法设立的基金的章程或组织文件，以合同形式体现。"@zh ;
    rdfs:subClassOf fibo-fnd-law-cor:Constitution ;
    skos:definition "For a fund which is constituted under the law of contract, the constitution or articles that define the fund. These are embodied in a Contract."@en ;
    cmns-av:explanatoryNote "From ISO FIBIM \"Umbrella Fund\" narrative: In securities, a collective investment scheme that has a contractual or a corporate form. When it has a contractual form, a fund is constituted under either the law of contract or under the trust law and thus it is not a legal entity. In its corporate form, a fund is a legal entity and is structured as a company."@en .

fibo-sec-fund-civ:FundOrderDesk a owl:Class ;
    rdfs:label "fund order desk"@en,
        "基金下单台（fund order desk）"@zh ;
    rdfs:comment "基金下单台账户的一方，负责接收投资者申购赎回指令。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom cmns-org:LegalEntity ],
        fibo-fbc-pas-caa:AccountProvider ;
    skos:definition "The Fund Order Desk is a party to the Fund Order Desk Account."@en ;
    skos:editorialNote "This party would presumably be identified as the Fund Management Company in terms of what legal entity fulcils this role? to be determined at further review."@en .

fibo-sec-fund-civ:FundRedemptionRestriction a owl:Class ;
    rdfs:label "fund redemption restriction"@en,
        "基金赎回限制（fund redemption restriction）"@zh ;
    rdfs:comment "对投资者赎回基金单位施加的限制。"@zh ;
    rdfs:subClassOf fibo-sec-sec-rst:SecuritiesRestriction .

fibo-sec-fund-civ:PreferredShareInFund a owl:Class ;
    rdfs:label "preferred share in fund"@en,
        "基金优先份额（preferred share in fund）"@zh ;
    rdfs:comment "基金中被归类为优先股类的份额单位。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundShareClassUnit .

fibo-sec-fund-civ:administeredBy a owl:ObjectProperty ;
    rdfs:label "administered by"@en,
        "由……管理（administered by）"@zh ;
    rdfs:comment "标识负责管理某事物的机构。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-fund:FundAdministrator ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:advisedBy a owl:ObjectProperty ;
    rdfs:label "advised by"@en,
        "由……担任顾问（advised by）"@zh ;
    rdfs:comment "指明为基金提供投资顾问服务的一方。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-fbc-fct-fse:RegisteredInvestmentAdvisor ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:assessedAgainst a owl:ObjectProperty ;
    rdfs:label "assessed against"@en,
        "对照……评估（assessed against）"@zh ;
    rdfs:comment "指明用于评估组合表现的基准。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolio ;
    rdfs:range fibo-sec-fund-civ:PortfolioBenchmark .

fibo-sec-fund-civ:definedInRelationTo a owl:ObjectProperty ;
    rdfs:label "defined in relation to"@en,
        "相对于……定义（defined in relation to）"@zh ;
    rdfs:comment "表明某术语是相对于另一事物定义的。"@zh ;
    rdfs:domain fibo-sec-fund-civ:OrganizationStrategy ;
    rdfs:range fibo-be-le-cb:Corporation .

fibo-sec-fund-civ:definesAllocations a owl:ObjectProperty ;
    rdfs:label "defines allocations"@en,
        "规定配置（defines allocations）"@zh ;
    rdfs:comment "规定组合资产的配置方式。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolioInvestmentPolicy ;
    rdfs:range fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    rdfs:subPropertyOf cmns-dsg:defines .

fibo-sec-fund-civ:definesBenchmark a owl:ObjectProperty ;
    rdfs:label "defines benchmark"@en,
        "规定基准（defines benchmark）"@zh ;
    rdfs:comment "规定组合所用的基准。"@zh ;
    rdfs:domain fibo-sec-fund-civ:PortfolioBenchmark ;
    rdfs:range fibo-ind-ind-ind:MarketRate .

fibo-sec-fund-civ:definesMainFundOrderDeskAccount a owl:ObjectProperty ;
    rdfs:label "defines main fund order desk account"@en,
        "规定主基金下单台账户（defines main fund order desk account）"@zh ;
    rdfs:comment "规定基金的主要下单台账户。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingTerms ;
    rdfs:range fibo-sec-fund-civ:FundsProcessingAccount .

fibo-sec-fund-civ:distributedBy a owl:ObjectProperty ;
    rdfs:label "distributed by"@en,
        "由……分销（distributed by）"@zh ;
    rdfs:comment "指明分销基金的一方。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundDistributor ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:hasAdditionalInformation a owl:ObjectProperty ;
    rdfs:label "has additional information"@en,
        "具有附加信息（has additional information）"@zh ;
    rdfs:comment "指明基金的附加信息。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:OtherInvestmentFundInformation .

fibo-sec-fund-civ:hasAdditionalRedemptionRestrictions a owl:ObjectProperty ;
    rdfs:label "has additional redemption restrictions"@en,
        "具有附加赎回限制（has additional redemption restrictions）"@zh ;
    rdfs:comment "指明基金的附加赎回限制。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundRedemptionTerms ;
    rdfs:range fibo-sec-fund-civ:ReferToFundOrderDesk .

fibo-sec-fund-civ:hasAuditor a owl:ObjectProperty ;
    rdfs:label "has auditor"@en,
        "具有审计师（has auditor）"@zh ;
    rdfs:comment "指明基金的审计师。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-be-oac-exec:ExternalAuditor ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:hasDataProvider a owl:ObjectProperty ;
    rdfs:label "has data provider"@en,
        "具有数据提供方（has data provider）"@zh ;
    rdfs:comment "指明作为数据提供方并对所提供信息承担法律责任的机构。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-be-fct-pub:MarketDataProvider ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty ;
    skos:definition "has an organization which is the data provider and is legally responsible for the information provided"@en .

fibo-sec-fund-civ:hasDefaultSettlementConvention a owl:ObjectProperty ;
    rdfs:label "has default settlement convention"@en,
        "具有默认结算惯例（has default settlement convention）"@zh ;
    rdfs:comment "指明基金交易的默认结算惯例。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundProcessingTerms ;
    rdfs:range fibo-fbc-fi-stl:SettlementConvention .

fibo-sec-fund-civ:hasDepository a owl:ObjectProperty ;
    rdfs:label "has depository"@en,
        "具有存管人（has depository）"@zh ;
    rdfs:comment "指明基金的存管人。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundDepositary ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:hasDetails a owl:ObjectProperty ;
    rdfs:label "has details"@en,
        "具有明细（has details）"@zh ;
    rdfs:comment "关于投资基金组成部分资产净值计算的信息。"@zh ;
    rdfs:domain fibo-sec-fund-fund:FundUnit ;
    rdfs:range fibo-sec-fund-civ:NetAssetValueCalculationMethod ;
    skos:definition "Information on the net asset value calculation of the investment fund component."@en .

fibo-sec-fund-civ:hasExpectedCoupon a owl:ObjectProperty ;
    rdfs:label "has expected coupon"@en,
        "具有预期票息（has expected coupon）"@zh ;
    rdfs:comment "指明预期的票息分配。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundBondClassUnit ;
    rdfs:range fibo-sec-fund-civ:FundBondUnitCoupon .

fibo-sec-fund-civ:hasFundPolicy a owl:ObjectProperty ;
    rdfs:label "has fund policy"@en,
        "具有基金政策（has fund policy）"@zh ;
    rdfs:comment "关于投资金额、限制等的总体政策，不同于详细的组合政策。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundInvestmentPolicy ;
    skos:definition "Overall policy for amounts invested, limitations etc. Not the same as the detailed Portfolio policy."@en .

fibo-sec-fund-civ:hasIntendedRiskLevel a owl:ObjectProperty ;
    rdfs:label "has intended risk level"@en,
        "具有预期风险级别（has intended risk level）"@zh ;
    rdfs:comment "指明基金的预期风险级别。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundInvestmentObjective ;
    rdfs:range fibo-sec-fund-civ:RiskLevel .

fibo-sec-fund-civ:hasInvestmentStrategy a owl:ObjectProperty ;
    rdfs:label "strategy"@en,
        "战略（strategy）"@zh ;
    rdfs:comment "指导决策并协调行动与计划以追求某意向的高层途径。"@zh ;
    rdfs:domain fibo-fnd-oac-own:Portfolio ;
    rdfs:range fibo-sec-fund-civ:InvestmentStrategy .

fibo-sec-fund-civ:hasManagementCompany a owl:ObjectProperty ;
    rdfs:label "has management company"@en,
        "具有管理公司（has management company）"@zh ;
    rdfs:comment "指明基金的管理公司。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-fund:FundManager ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:hasPolicyTerms a owl:ObjectProperty ;
    rdfs:label "has policy terms"@en,
        "具有政策条款（has policy terms）"@zh ;
    rdfs:comment "指明基金的政策条款。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundBondUnitCoupon ;
    rdfs:range fibo-sec-fund-civ:FundCouponPolicy .

fibo-sec-fund-civ:hasRelatedTerms a owl:ObjectProperty ;
    rdfs:label "has related terms"@en,
        "具有相关条款（has related terms）"@zh ;
    rdfs:comment "指明相关的条款。"@zh ;
    rdfs:range fibo-fnd-agr-ctr:ContractualElement .

fibo-sec-fund-civ:hasSubscriptionTerms a owl:ObjectProperty ;
    rdfs:label "has subscription terms"@en,
        "具有申购条款（has subscription terms）"@zh ;
    rdfs:comment "指明基金的申购条款。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundSubscriptionTerms ;
    rdfs:subPropertyOf fibo-sec-fund-civ:hasRelatedFundTerms .

fibo-sec-fund-civ:hasTransferAgent a owl:ObjectProperty ;
    rdfs:label "has transfer agent"@en,
        "具有过户代理（has transfer agent）"@zh ;
    rdfs:comment "标识过户代理。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundTransferAgent ;
    rdfs:subPropertyOf fibo-sec-fund-civ:fundHasRelatedParty .

fibo-sec-fund-civ:identifiesAssetTypesBy a owl:ObjectProperty ;
    rdfs:label "identifies asset types by"@en,
        "以……标识资产类型（identifies asset types by）"@zh ;
    rdfs:comment "指明用于标识资产类型的分类方式。"@zh ;
    rdfs:domain fibo-sec-fund-civ:AssetClassStrategy ;
    rdfs:range fibo-sec-sec-cls:FinancialInstrumentClassifier .

fibo-sec-fund-civ:implementsFundPolicy a owl:ObjectProperty ;
    rdfs:label "implements fund policy"@en,
        "实施基金政策（implements fund policy）"@zh ;
    rdfs:comment "表明某一策略实施某一基金政策。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolio ;
    rdfs:range fibo-sec-fund-civ:FundPortfolioInvestmentPolicy .

fibo-sec-fund-civ:isCalculatedIn a owl:ObjectProperty ;
    rdfs:label "is calculated in"@en,
        "以……计算（is calculated in）"@zh ;
    rdfs:comment "指明资产净值等数值计算所用的货币或单位。"@zh ;
    rdfs:domain fibo-sec-fund-civ:NetAssetValueCalculationMethod ;
    rdfs:range fibo-fnd-acc-cur:Currency .

fibo-sec-fund-civ:outlines a owl:ObjectProperty ;
    rdfs:label "outlines"@en,
        "概述（outlines）"@zh ;
    rdfs:comment "表明某文件概述某一事项。"@zh ;
    rdfs:domain fibo-sec-sec-iss:Prospectus ;
    rdfs:range fibo-sec-fund-civ:FundInvestmentObjective ;
    owl:inverseOf fibo-sec-fund-civ:statedIn .

fibo-sec-fund-civ:providesDepositaryServiceFor a owl:ObjectProperty ;
    rdfs:label "provides depositary service for"@en,
        "为……提供存管服务（provides depositary service for）"@zh ;
    rdfs:comment "指明存管人为某一基金提供存管服务。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundDepositary ;
    rdfs:range fibo-sec-fund-fund:FundUnit .

fibo-sec-fund-civ:stipulatesBenchmark a owl:ObjectProperty ;
    rdfs:label "stipulates benchmark"@en,
        "规定基准（stipulates benchmark）"@zh ;
    rdfs:comment "规定组合业绩评价所用的基准。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundInvestmentPolicy ;
    rdfs:range fibo-ind-ind-ind:MarketRate .

fibo-sec-fund-civ:supervisedBy a owl:ObjectProperty ;
    rdfs:label "supervised by"@en,
        "由……监管（supervised by）"@zh ;
    rdfs:comment "指明监管基金的机构。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundSupervisoryAuthority .

fibo-sec-fund-civ:DistributingShareClass a owl:Class ;
    rdfs:label "distributing share class"@en,
        "分红股类（distributing share class）"@zh ;
    rdfs:comment "将收益定期分配给份额持有人的股类。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundShareClassUnit .

fibo-sec-fund-civ:FundCashDistributionPolicy a owl:Class ;
    rdfs:label "fund cash distribution policy"@en,
        "基金现金分配政策（fund cash distribution policy）"@zh ;
    rdfs:comment "在基金单位分配政策为「现金」而非「再投资」时，关于现金股息或票据分配的政策。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundUnitDistributionPolicy ;
    skos:definition "Policy for distribution of cash dividends or notes in the event that the fund units have a distribution policy of \"Cash\" rather than \"Reinvestment\"."@en .

fibo-sec-fund-civ:FundDistributor a owl:Class ;
    rdfs:label "fund distributor"@en,
        "基金分销商（fund distributor）"@zh ;
    rdfs:comment "投资者通过其购买基金份额的实体，可基于全权委托、咨询或仅执行交易的方式。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundsProcessingParty ;
    skos:definition "an entity through which a fund may be bought by or for an investor. This may be on a discretionary or advisory basis, or as an execution-only service. Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:FundReinvestmentPolicy a owl:Class ;
    rdfs:label "fund reinvestment policy"@en,
        "基金再投资政策（fund reinvestment policy）"@zh ;
    rdfs:comment "关于基金单位收益预期再投资的条款。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundUnitDistributionPolicy ;
    skos:definition "Terms for the expected reinvestment of profits on fund units."@en .

fibo-sec-fund-civ:FundSupervisoryAuthority a owl:Class ;
    rdfs:label "fund supervisory authority"@en,
        "基金监管机构（fund supervisory authority）"@zh ;
    rdfs:comment "监管基金或基金行业的一方。"@zh ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    skos:definition "party that supervises the fund or fund industry"@en .

fibo-sec-fund-civ:FundTransferAgent a owl:Class ;
    rdfs:label "fund transfer agent"@en,
        "基金过户代理人（fund transfer agent）"@zh ;
    rdfs:comment "代表基金执行申购、赎回和转换指令的实体。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundsProcessingParty ;
    skos:definition "An entity that undertakes the execution of subscription, redemption and switch orders on behalf of a fund. Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:FundsProcessingAccount a owl:Class ;
    rdfs:label "funds processing account"@en,
        "基金处理账户（funds processing account）"@zh ;
    rdfs:comment "专门用于基金处理的账户，按 FIBIM 定义是两个实体之间的业务关系。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:isProvidedBy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundOrderDesk ],
        fibo-fbc-pas-caa:Account ;
    skos:definition "An account used specifically in the processing of funds. Like all accounts this is (per FIBIM definition) a business relationship between two entities; one entity is the account owner, the other entity is the account servicer. Please refer to Financial global model for treatment of accounts relationships in this model."@en ;
    cmns-av:explanatoryNote "Derived from FIBIM definition for \"Account\", which is: \"Business relationship between two entities; one entity is the account owner, the other entity is the account servicer.\" this corresponds to the Global Terms definition for Account."@en .

fibo-sec-fund-civ:InvestmentStrategy a owl:Class ;
    rdfs:label "investment strategy"@en,
        "投资策略（investment strategy）"@zh ;
    rdfs:comment "为实现特定投资目标而制定的计划、方法或一系列策略安排。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ;
            owl:someValuesFrom fibo-fnd-gao-obj:InvestmentObjective ],
        fibo-fnd-gao-obj:BusinessStrategy ;
    skos:definition "plan, method, or series of maneuvers or stratagems for obtaining a specific investment goal"@en .

fibo-sec-fund-civ:NoteFund a owl:Class ;
    rdfs:label "note fund",
        "票据基金（note fund）"@zh ;
    rdfs:comment "向投资者发行债务工具（票据）而非（或同时发行）传统权益的集合投资工具。"@zh ;
    rdfs:subClassOf fibo-sec-sec-pls:ManagedInvestment ;
    skos:definition "pooled investment vehicle that issues debt instruments (notes) to investors rather than (or in addition to) traditional equity interests" ;
    cmns-av:explanatoryNote "The notes issued by a note fund are typically privately rated by agencies like KBRA, DBRS, or Moody's, tranched into senior and junior classes, and linked to underlying assets such as private loans, credit instruments, or structured products. Note funds are designed to optimize regulatory capital treatment, especially for insurance companies, by offering rated debt instead of equity." .

fibo-sec-fund-civ:OtherInvestmentFundInformation a owl:Class ;
    rdfs:label "other investment fund information"@en,
        "其他投资基金信息（other investment fund information）"@zh ;
    rdfs:comment "不属于招募说明书、但对理解基金很重要的信息。"@zh ;
    rdfs:subClassOf cmns-doc:Document ;
    skos:definition "Things which are not part of the prospectus but are important if you want to understand the fund."@en ;
    skos:editorialNote "See terms in EFAMA spreadsheet. These are properties of the fund but are not legally binding. Author follow-up note: I have managed to find a \"home\" for disposition for most of the entries that are in the spreadsheet. It is not clear which of the spreadsheet terms are indended to come under the general heading in this class. The first place I would look is in the terms I have defined as \"Fund Processing Terms\", which are defined as formal, legal contractual terms. If any of those are not legally binding on some party, then this is where they belong instead."@en .

fibo-sec-fund-civ:ReferToFundOrderDesk a owl:Class ;
    rdfs:label "refer to fund order desk"@en,
        "须洽基金下单台（refer to fund order desk）"@zh ;
    rdfs:comment "要求投资者在赎回基金前先与基金下单台联系的限制。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundRedemptionRestriction ;
    skos:definition "Restriction requiring an investor to refer to the fund order desk prior to redeeming a fund."@en ;
    skos:editorialNote "While it's unclear from original data models, it's likely that this restriction is actually to learn from the fund order desk of any other individual kinds of restriction that will apply. This is itself treated as a kind of restriction here."@en .

fibo-sec-fund-civ:RiskLevel a owl:Class ;
    rdfs:label "risk level"@en,
        "风险级别（risk level）"@zh ;
    rdfs:comment "对基金或投资组合风险程度的度量。"@zh ;
    rdfs:subClassOf cmns-cls:Classifier .

fibo-sec-fund-civ:UnitIssuer a owl:Class ;
    rdfs:label "unit issuer"@en,
        "单位发行人（unit issuer）"@zh ;
    rdfs:comment "发行基金单位的一方。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom fibo-be-le-cb:Corporation ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:issues ;
            owl:someValuesFrom fibo-sec-fund-fund:FundUnit ],
        fibo-sec-fund-civ:FundsProcessingParty ;
    skos:definition "The party which issues the Fund Unit."@en .

fibo-sec-fund-civ:hasFundProcessingTerms a owl:ObjectProperty ;
    rdfs:label "has fund processing terms"@en,
        "具有基金处理条款（has fund processing terms）"@zh ;
    rdfs:comment "指明基金的处理条款。"@zh ;
    rdfs:domain fibo-sec-fund-fund:FundUnit ;
    rdfs:range fibo-sec-fund-civ:FundProcessingTerms ;
    rdfs:subPropertyOf fibo-fnd-agr-ctr:hasContractualElement .

fibo-sec-fund-civ:hasRelatedFundTerms a owl:ObjectProperty ;
    rdfs:label "has related fund terms"@en,
        "具有相关基金条款（has related fund terms）"@zh ;
    rdfs:comment "指明基金的相关条款。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundProcessingTerms ;
    rdfs:subPropertyOf fibo-sec-fund-civ:hasRelatedTerms .

fibo-sec-fund-civ:statedIn a owl:ObjectProperty ;
    rdfs:label "stated in"@en,
        "列明于（stated in）"@zh ;
    rdfs:comment "指明某信息列明于某一文件。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundInvestmentObjective ;
    rdfs:range fibo-sec-sec-iss:Prospectus .

fibo-sec-fund-civ:FundBondUnitCoupon a owl:Class ;
    rdfs:label "fund bond unit coupon"@en,
        "基金债券单位票息（fund bond unit coupon）"@zh ;
    rdfs:comment "向基金债券单位持有人支付的固定票息。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasPolicyTerms ;
            owl:someValuesFrom fibo-sec-fund-civ:FundCouponPolicy ],
        fibo-fnd-acc-cur:InterestRate ;
    skos:definition "A fixed coupon paid out to holders of the Fund Bond Unit."@en .

fibo-sec-fund-civ:FundDepositary a owl:Class ;
    rdfs:label "fund depositary"@en,
        "基金存管人（fund depositary）"@zh ;
    rdfs:comment "持有并保管基金所持资产的一方，还负责组合符合法定比例等合规事项。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:providesDepositaryServiceFor ;
            owl:someValuesFrom fibo-sec-fund-fund:FundUnit ],
        fibo-sec-fund-civ:FundsProcessingParty ;
    skos:definition "The party that holds and safeguards holdings owned by a fund. It is also responsible for compliance of the portfolio with legal ratios etc."@en ;
    cmns-av:explanatoryNote "The depository may delegate custody to another entity (custodian). Definition origin:EFAMA DD"@en .

fibo-sec-fund-civ:FundInvestmentPolicy a owl:Class ;
    rdfs:label "fund investment policy"@en,
        "基金投资政策（fund investment policy）"@zh ;
    rdfs:comment "基金为实现既定目标而实施的政策。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-ind-ind-ind:MarketRate ;
            owl:onProperty fibo-sec-fund-civ:stipulatesBenchmark ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rga:governs ;
            owl:someValuesFrom fibo-sec-fund-civ:PortfolioInvestmentStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-sec-fund-civ:InvestmentRestriction ],
        fibo-fnd-law-lcap:Policy ;
    skos:definition "policy that the fund implements in order to achieve the stated fund objectives"@en ;
    cmns-av:explanatoryNote "EFAMA Note: Model distinguishes between strategy (what you intend to invest in) and portfolio structure (what is held). This semantics matches the EFAMA DD \"Fund Investment Policy\" No stated definition in EFAMA DD (\"Further discussion required\")."@en .

fibo-sec-fund-civ:FundCouponPolicy a owl:Class ;
    rdfs:label "fund coupon policy"@en,
        "基金票息政策（fund coupon policy）"@zh ;
    rdfs:comment "关于债券单位票息预期分配的条款。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundCashDistributionPolicy ;
    skos:definition "Terms for the expected distribution of bond unit coupons."@en .

fibo-sec-fund-civ:FundPortfolioInvestmentPolicy a owl:Class ;
    rdfs:label "fund portfolio investment policy"@en,
        "基金组合投资政策（fund portfolio investment policy）"@zh ;
    rdfs:comment "为实现既定投资策略和目标而制定的组合配置政策。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:definesAllocations ;
            owl:someValuesFrom fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rga:governs ;
            owl:someValuesFrom fibo-sec-fund-civ:PortfolioInvestmentStrategy ],
        fibo-fnd-law-lcap:Policy ;
    skos:definition "policy with respect to allocation of the portfolio that is designed to meet the stated investment strategy and goals"@en ;
    cmns-av:explanatoryNote "ISO FIBIM: Rough allocation of the portfolio."@en .

fibo-sec-fund-civ:FundUnitDistributionMethod a owl:Class ;
    rdfs:label "fund unit distribution method"@en,
        "基金单位分配方式（fund unit distribution method）"@zh ;
    rdfs:comment "基金的常规分配政策方式。"@zh ;
    rdfs:subClassOf fibo-fnd-gao-obj:DistributionStrategy ;
    skos:definition "The normal distribution policy for funds."@en .

fibo-sec-fund-civ:OrganizationStrategy a owl:Class ;
    rdfs:label "organization strategy"@en,
        "机构策略（organization strategy）"@zh ;
    rdfs:comment "基于特定机构的投资策略。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:definedInRelationTo ;
            owl:someValuesFrom fibo-be-le-cb:Corporation ],
        fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    skos:definition "Strategy which is organization based."@en .

fibo-sec-fund-civ:PortfolioInvestmentStrategy a owl:Class ;
    rdfs:label "portfolio investment strategy"@en,
        "组合投资策略（portfolio investment strategy）"@zh ;
    rdfs:comment "组合管理人试图实现基金目标的方式。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ],
        fibo-sec-fund-civ:InvestmentStrategy ;
    skos:definition "The manner in which the portfolio manager tries to reach the funds objectives."@en ;
    cmns-av:explanatoryNote "Describes how you get there. E.g fully invested v not fully invested. MB Note: The terms labeled \"Strategy\" in EFAMA and in FIBIM are more like dictionary definition of policy, while \"How you get there\" is a dictionary definition of Strategy. Therefore original labels may be reversed from dictionary definition of the global semantics these are derived from."@en .

fibo-sec-fund-civ:FundInvestmentObjective a owl:Class ;
    rdfs:label "fund investment objective"@en,
        "基金投资目标（fund investment objective）"@zh ;
    rdfs:comment "基金的目标，例如超越某一基准。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:statedIn ;
            owl:someValuesFrom fibo-sec-sec-iss:Prospectus ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasIntendedRiskLevel ;
            owl:someValuesFrom fibo-sec-fund-civ:RiskLevel ],
        fibo-fnd-gao-obj:InvestmentObjective ;
    skos:definition "The aim of a Fund e.g outperfom a given benchmark."@en ;
    skos:editorialNote "This could be broken down into other terms that can be itemised here, that are not in the EFAMA DD explicitly. Examples may include: - Risk level - Return - Exposure to different markets"@en .

fibo-sec-fund-civ:FundPortfolio a owl:Class ;
    rdfs:label "fund portfolio"@en,
        "基金组合（fund portfolio）"@zh ;
    rdfs:comment "包含若干金融工具以及一种或多种货币现金头寸、并归属于某一基金的账户。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasInvestmentStrategy ;
            owl:someValuesFrom fibo-sec-fund-civ:PortfolioInvestmentStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom fibo-fnd-oac-own:Portfolio ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:implementsFundPolicy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundPortfolioInvestmentPolicy ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-acc-cur:hasMonetaryAmount ;
            owl:someValuesFrom fibo-fbc-pas-caa:Balance ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:assessedAgainst ;
            owl:someValuesFrom fibo-sec-fund-civ:PortfolioBenchmark ],
        fibo-fnd-oac-own:Portfolio ;
    skos:definition "An account containing a number of financial instruments along with cash positions in one or more currencies and belonging to a Fund"@en .

fibo-sec-fund-civ:FundUnitDistributionPolicy a owl:Class ;
    rdfs:label "fund unit distribution policy"@en,
        "基金单位分配政策（fund unit distribution policy）"@zh ;
    rdfs:comment "与基金单位相关的政策，例如收益是分配给投资者还是留存于基金中，以及如何处理。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasStrategy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundUnitDistributionMethod ],
        fibo-fnd-law-lcap:Policy ;
    skos:definition "policy relating to the unit, e.g. if income is paid out or retained in the fund and how this is treated, including distribution policy details for dividends and coupons."@en .

fibo-sec-fund-civ:FundShareClassUnit a owl:Class ;
    rdfs:label "fund share class unit"@en,
        "基金股类单位（fund share class unit）"@zh ;
    rdfs:comment "购买投资池一部分的法律结构，由投资者类型、最低投资额等多种特征定义。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasStrategy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundUnitDistributionPolicy ],
        fibo-sec-fund-fund:FundUnit ;
    skos:definition "The legal structure in which you can purchase part of an investment pool, defined by a variety of characteristics like investor type, minimum size of investment, distribution type, fee and currency. A fund unit which gives the holder an equity stake in the fund."@en ;
    cmns-av:explanatoryNote "From review sessions: Theoretically you can buy a fraction of a share in a fund. This would depend on the legal structure of the fund, e.g. a minimum investment. There is always a distribution plan."@en .

fibo-sec-fund-civ:PortfolioBenchmark a owl:Class ;
    rdfs:label "portfolio benchmark"@en,
        "组合基准（portfolio benchmark）"@zh ;
    rdfs:comment "用于评价组合表现的证券或其他价格基准。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom fibo-sec-fund-civ:FundPortfolio ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:definesBenchmark ;
            owl:someValuesFrom fibo-ind-ind-ind:MarketRate ],
        cmns-qtu:Measure ;
    skos:definition "Security or other price against which the performance of the portfolio is evaluated."@en .

fibo-sec-fund-civ:FundsProcessingParty a owl:Class ;
    rdfs:label "funds processing party"@en,
        "基金处理参与方（funds processing party）"@zh ;
    rdfs:comment "参与基金处理的一方。"@zh ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    skos:definition "party involved in the processing of funds"@en .

fibo-sec-fund-civ:InvestmentRestriction a owl:Class ;
    rdfs:label "fund investment restrictions set"@en,
        "基金投资限制集（fund investment restrictions set）"@zh ;
    rdfs:comment "适用于基金整体的限制（如风险因素），用于判断该基金是否适合某类投资者。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:isPartOf ;
            owl:someValuesFrom fibo-sec-sec-iss:Prospectus ],
        fibo-sec-sec-rst:SecuritiesRestriction ;
    skos:definition "Limitations that apply to the fund as a whole, such as risk factors. these are used to determine whether the fund is appropriate for a given type of investor to invest in."@en ;
    cmns-av:explanatoryNote "These are defined by the overall Fund investment policy. Not the same as the detailed policies for investing in percentages of this or that."@en .

fibo-sec-fund-civ:NetAssetValueCalculationMethod a owl:Class ;
    rdfs:label "net asset value calculation method"@en,
        "资产净值计算方法（net asset value calculation method）"@zh ;
    rdfs:comment "计算投资基金/基金类别资产净值（NAV）的参数。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:isCalculatedIn ;
            owl:someValuesFrom fibo-fnd-acc-cur:Currency ],
        cmns-qtu:Expression ;
    skos:definition "Parameters for the calculation of the net asset value for an investment fund/fund class."@en ;
    skos:editorialNote "These terms were in the ISO FIBIM model but correspond to some details in the EFAMA DD."@en .

fibo-sec-sec-iss:Prospectus a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:outlines ;
            owl:someValuesFrom fibo-sec-fund-civ:FundInvestmentObjective ] ;
    skos:editorialNote "EFAMA Review description for this: The fund is issued with a prospectus; there is material in the prospectus that is binding; material that is expected but not binding, and information that may or may not be in the prospectus or a given fund."@en ;
    cmns-av:explanatoryNote "This document includes facts about the fund investment objective, investment focus and other details of the fund. Some of this information becomes binding on the fund once it is issued, while other information is guidelines only." .

fibo-sec-fund-civ:FundProcessingGeneralTerms a owl:Class ;
    rdfs:label "fund processing general terms"@en,
        "基金处理一般条款（fund processing general terms）"@zh ;
    rdfs:comment "基金一般处理的正式条款，规定投资者和基金可以或不可以做什么。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:FundProcessingTerms ;
    skos:definition "Formal terms for general processing of the fund. These set out what the investor and the fund may or may not do."@en .

fibo-sec-fund-civ:fundHasRelatedParty a owl:ObjectProperty ;
    rdfs:label "fund has related party"@en,
        "基金具有相关方（fund has related party）"@zh ;
    rdfs:comment "指明与基金相关联的一方。"@zh ;
    rdfs:domain fibo-sec-sec-pls:CollectiveInvestmentVehicle ;
    rdfs:range fibo-sec-fund-civ:FundsProcessingParty .

fibo-sec-fund-civ:FundRedemptionTerms a owl:Class ;
    rdfs:label "fund redemption terms"@en,
        "基金赎回条款（fund redemption terms）"@zh ;
    rdfs:comment "基金单位赎回的正式条款，规定投资者和基金可以或不可以做什么。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasAdditionalRedemptionRestrictions ;
            owl:someValuesFrom fibo-sec-fund-civ:ReferToFundOrderDesk ],
        fibo-sec-fund-civ:FundProcessingTerms ;
    skos:definition "Formal terms for redemption of units in the fund. These set out what the investor and the fund may or may not do."@en .

fibo-sec-fund-civ:FundProcessingTerms a owl:Class ;
    rdfs:label "fund processing terms"@en,
        "基金处理条款（fund processing terms）"@zh ;
    rdfs:comment "基金处理的正式条款，规定投资者和基金可以或不可以做什么，包括赎回和申购条款。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasDefaultSettlementConvention ;
            owl:someValuesFrom fibo-fbc-fi-stl:SettlementConvention ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:definesMainFundOrderDeskAccount ;
            owl:someValuesFrom fibo-sec-fund-civ:FundsProcessingAccount ],
        fibo-fnd-agr-ctr:ContractualCommitment ;
    skos:definition "Formal terms for processing of the fund. These set out what the investor and the fund may or may not do. These include terms for redemption and subscription processing as well as general processing terms. ISO FIBIM definition: Processing characteristics linked to the instrument, ie, not to the market."@en ;
    cmns-av:explanatoryNote "These include Fund Subscription Terms, Fund Redemption Terms. and terms which relate to general processing and restrictions or otherwise on the holder. FPP notes: FPP presentation identifies many of these terms under the heading of Valuation Dealing characteristics. May need to revise which goes where in line with FPP. See also terms under NAV Valuation Calculation Method. Others of these terms appear in FPP under Instrument Restrictions. These cover the subscription, redemption and holding amounts and units and minimum holding period."@en .

fibo-sec-fund-civ:FundPortfolioInvestmentLimitations a owl:Class ;
    rdfs:label "fund portfolio investment limitations"@en,
        "基金组合投资限制（fund portfolio investment limitations）"@zh ;
    rdfs:comment "关于组合应如何配置以实现既定投资目标的详细政策，构成详细策略的基础。"@zh ;
    rdfs:subClassOf fibo-sec-fund-civ:InvestmentRestriction ;
    skos:definition "Detailed Policy on approximately how the portfolio is to be allocated to achieve the stated investment goals. This underpins the detailed strategy of how to achieve this."@en ;
    cmns-av:explanatoryNote "Defined as \"Strategy\" in FIBIM and elsewhere. WG11: Rough allocation of the portfolio."@en .

fibo-sec-fund-fund:FundUnit a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasDetails ;
            owl:someValuesFrom fibo-sec-fund-civ:NetAssetValueCalculationMethod ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasFundProcessingTerms ;
            owl:someValuesFrom fibo-sec-fund-civ:FundRedemptionTerms ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasFundProcessingTerms ;
            owl:someValuesFrom fibo-sec-fund-civ:FundProcessingGeneralTerms ] ;
    cmns-av:explanatoryNote "If it is a closed fund, you can still trade the units. You trade back with the fund. Not with a counterparty. Therefore this is a tradable contract, though it may not necessarily be a transferable contract."@en .

fibo-sec-fund-civ:FundSubscriptionTerms a owl:Class ;
    rdfs:label "fund subscription terms"@en,
        "基金申购条款（fund subscription terms）"@zh ;
    rdfs:comment "基金的申购条款，规定投资者和基金在申购环节可以或不可以做什么。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom fibo-sec-fund-fund:FundUnit ],
        fibo-sec-fund-civ:FundProcessingTerms ;
    skos:definition "Subscription terms for the fund. Further notes: ISO FIBIM, EFAMA DD and FPP combine terms for subscription, redemption and general holding requirements. These have been separated here as they are different kinds of term, but this can be reviewed. Subscription Terms are identified as terms of the fund and not the fund unit, since terms for how you might subscribe can't be binding one someone who has not yet subscribed."@en .

fibo-sec-sec-pls:CollectiveInvestmentVehicle a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasManagementCompany ;
            owl:someValuesFrom fibo-sec-fund-fund:FundManager ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:supervisedBy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundSupervisoryAuthority ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasTransferAgent ;
            owl:someValuesFrom fibo-sec-fund-civ:FundTransferAgent ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasDataProvider ;
            owl:someValuesFrom fibo-be-fct-pub:MarketDataProvider ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:distributedBy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundDistributor ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasAdditionalInformation ;
            owl:someValuesFrom fibo-sec-fund-civ:OtherInvestmentFundInformation ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasDepository ;
            owl:someValuesFrom fibo-sec-fund-civ:FundDepositary ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:advisedBy ;
            owl:someValuesFrom fibo-fbc-fct-fse:RegisteredInvestmentAdvisor ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasSubscriptionTerms ;
            owl:someValuesFrom fibo-sec-fund-civ:FundSubscriptionTerms ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:fundHasRelatedParty ;
            owl:someValuesFrom fibo-sec-fund-civ:FundsProcessingParty ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasAuditor ;
            owl:someValuesFrom fibo-be-oac-exec:ExternalAuditor ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-acc-cur:hasCurrency ;
            owl:someValuesFrom fibo-fnd-acc-cur:Currency ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:someValuesFrom fibo-sec-fund-civ:UnitIssuer ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-gao-obj:hasStrategy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundUnitDistributionMethod ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:administeredBy ;
            owl:someValuesFrom fibo-sec-fund-fund:FundAdministrator ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasRelatedFundTerms ;
            owl:someValuesFrom fibo-sec-fund-civ:FundProcessingTerms ],
        [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-civ:hasFundPolicy ;
            owl:someValuesFrom fibo-sec-fund-civ:FundInvestmentPolicy ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fbc-fi-fi:isLegallyRecordedIn ;
            owl:someValuesFrom cmns-rga:Jurisdiction ],
        [ a owl:Restriction ;
            owl:onProperty cmns-dsg:isDescribedBy ;
            owl:someValuesFrom fibo-sec-sec-iss:Prospectus ] ;
    cmns-av:explanatoryNote "From EFAMA DD: The word fund can refer to either an investment pool, umbrella or share class, and is commonly refered to as a collective investment vehicle (can have ISIN or not). The meaning here is for the investment pool (of which an Umbrella fund is also one such) and not to the share class."@en .

