    rdfs:range fibo-sec-fund-civ:UnitIssuer ;
    skos:definition "The unit issuer would be the fund administrator (except when it is a Bond)."@en .

fibo-sec-fund-civ:minimumDeviation a owl:ObjectProperty ;
    rdfs:label "minimum deviation"@en,
        "最小偏离度（minimum deviation）"@zh ;
    rdfs:comment "允许偏离基准的最小幅度。"@zh ;
    rdfs:domain fibo-sec-fund-civ:PortfolioBenchmark ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "Minimum allowable deviation from the benchmark."@en .

fibo-sec-fund-civ:minimumHoldingPeriod a owl:ObjectProperty ;
