    rdfs:comment "在指定策略中可投资的最大百分比。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "Maximum percentage that may be invested in the specified strategy."@en .

fibo-sec-fund-civ:maximumPurchasingFee a owl:ObjectProperty ;
