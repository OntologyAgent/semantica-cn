    rdfs:comment "以语言表达式对某事物的指称。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolioInvestmentPolicy ;
    rdfs:range xsd:string ;
    skos:definition "Name given to the defined strategy."@en .

fibo-sec-fund-civ:percentageInvested a owl:ObjectProperty ;
    rdfs:label "percentage invested"@en,
