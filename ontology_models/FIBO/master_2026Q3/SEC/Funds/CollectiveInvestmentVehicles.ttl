    rdfs:domain fibo-sec-fund-civ:PortfolioInvestmentStrategy ;
    rdfs:range xsd:string ;
    skos:definition "The information about the area the fund is mostly invested into (for example stock market in Germany)."@en .

fibo-sec-fund-civ:isUnitHolder a owl:ObjectProperty ;
    rdfs:label "is unit holder"@en,
        "是单位持有人（is unit holder）"@zh ;
