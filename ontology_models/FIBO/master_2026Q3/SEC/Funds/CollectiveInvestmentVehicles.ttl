    rdfs:range fibo-fnd-acc-cur:MonetaryAmount ;
    skos:definition "Minimum amount that has to be invested in the specified strategy."@en .

fibo-sec-fund-civ:minimumInvestmentPercentage a owl:ObjectProperty ;
    rdfs:label "minimum investment percentage"@en,
        "最低投资比例（minimum investment percentage）"@zh ;
    rdfs:comment "在指定策略中必须投资的最低百分比。"@zh ;
    rdfs:domain fibo-sec-fund-civ:FundPortfolioInvestmentLimitations ;
    rdfs:range cmns-qtu:Percentage ;
    skos:definition "Minimum percentage that has to be invested in the specified strategy."@en .

fibo-sec-fund-civ:minimumRatingRestriction a owl:ObjectProperty ;
    rdfs:label "minimum rating restriction"@en,
