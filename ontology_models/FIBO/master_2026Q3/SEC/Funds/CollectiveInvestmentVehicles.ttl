    rdfs:domain fibo-sec-fund-civ:FundShareClassUnit ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether or not new shares can be issued in the fund. This is what makes it a closed end or open end fund."@en .

fibo-sec-fund-civ:mainFundOrderDesk a owl:DatatypeProperty ;
    rdfs:label "main fund order desk"@en,
        "是否主基金下单台（main fund order desk）"@zh ;
