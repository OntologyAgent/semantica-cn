@prefix cmns-av: <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix cmns-cls: <https://www.omg.org/spec/Commons/Classifiers/> .
@prefix cmns-doc: <https://www.omg.org/spec/Commons/Documents/> .
@prefix cmns-dsg: <https://www.omg.org/spec/Commons/Designators/> .
@prefix cmns-org: <https://www.omg.org/spec/Commons/Organizations/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-fbc-dae-gty: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/> .
@prefix fibo-fbc-pas-caa: <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/> .
@prefix fibo-fnd-agr-agr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/> .
@prefix fibo-fnd-utl-av: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/> .
@prefix fibo-sec-fund-fund: <https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/Funds/> .
@prefix fibo-sec-fund-pp: <https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/PensionPlans/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fibo-sec-fund-pp:BookReservedPensionPlan a owl:Class ;
    rdfs:label "book reserved pension plan",
        "账面储备养老金计划（book reserved pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "资产负债表反映计划发起人资产负债表中以储备或拨备形式入账之职业养老金计划金额的养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:PensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:FundedPensionPlan,
        fibo-sec-fund-pp:UnfundedPensionPlan ;
    skos:definition "pension plan whose balance sheet reflects sums entered in the balance sheet of the plan sponsor as reserves or provisions for occupational pension plan benefits" ;
    skos:note "Some assets may be held in separate accounts for the purpose of financing benefits, but are not legally or contractually pension plan assets. Most OECD countries do not allow this method of financing. Those that do usually require these plans to be insured against bankruptcy of the plan sponsor through an insolvency guaranty arrangement." .

fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier-Hybrid a owl:NamedIndividual,
        fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier ;
    rdfs:label "defined benefit occupational pension plan classifier - hybrid" ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    skos:definition "classifier for DB plans where benefits depend on a rate of return credited to contributions, where this rate of return is either specified in the plan rules, independently of the actual return on any supporting assets (e.g. fixed, indexed to a market benchmark, tied to salary or profit growth, etc.), or is calculated with reference to the actual return of any supporting assets and a minimum return guarantee specified in the plan rules" ;
    cmns-dsg:hasTag "hybrid" .

fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier-Mixed a owl:NamedIndividual,
        fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier ;
    rdfs:label "defined benefit occupational pension plan classifier - mixed" ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    skos:definition "classifier for DB plans that have two separate DB and DC components but which are treated as part of the same plan" ;
    cmns-dsg:hasTag "mixed" .

fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier-Traditional a owl:NamedIndividual,
        fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier ;
    rdfs:label "defined benefit occupational pension plan classifier - traditional" ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    skos:definition "classifier for DB plans where benefits are linked through a formula to the members' wages or salaries, length of employment, or other factors" ;
    cmns-dsg:hasTag "traditional" .

fibo-sec-fund-pp:IndividualPensionAccount a owl:Class ;
    rdfs:label "individual pension account",
        "个人养老金账户（individual pension account）"@zh ;
    rdfs:comment "记录归属于个人之金额的养老金账户。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:IndividualRetirementAccount,
        fibo-sec-fund-pp:PensionAccount ;
    skos:definition "pension account in which amounts attributable to an individual are recorded" .

fibo-sec-fund-pp:MultiEmployerPensionFund a owl:Class ;
    rdfs:label "multi-employer pension fund",
        "多雇主养老基金（multi-employer pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "汇集多个计划发起人所设养老金计划资产的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:ClosedPensionFund ;
    owl:disjointWith fibo-sec-fund-pp:IndividualPensionFund,
        fibo-sec-fund-pp:RelatedMemberPensionFund,
        fibo-sec-fund-pp:SingleEmployerPensionFund ;
    skos:definition "pension fund that pools the assets of pension plans established by various plan sponsors" ;
    cmns-av:explanatoryNote "There are three types of multi-employer pension funds: a) for related employers i.e. companies that are financially connected or owned by a single holding group (group pension funds); b) for unrelated employers who are involved in the same trade or business (industry pension funds); c) for unrelated employers that may be in different trades or businesses (collective pension funds)." .

fibo-sec-fund-pp:OpenPensionFund a owl:Class ;
    rdfs:label "open pension fund",
        "开放型养老基金（open pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "支持至少一个成员资格不受限制之计划的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-fund:PensionFund ;
    owl:disjointWith fibo-sec-fund-pp:ClosedPensionFund ;
    skos:definition "pension fund that supports at least one plan with no restriction on membership" .

fibo-sec-fund-pp:PrivatePensionFund a owl:Class ;
    rdfs:label "private pension fund",
        "私营养老基金（private pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "受私营部门法律监管的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-fund:PensionFund ;
    owl:disjointWith fibo-sec-fund-pp:PublicPensionFund ;
    skos:definition "pension fund that is regulated under private sector law" .

fibo-sec-fund-pp:PrivatePensionPlan a owl:Class ;
    rdfs:label "private pension plan",
        "私营养老金计划（private pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "由一般政府以外机构管理的养老金计划。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty fibo-sec-fund-pp:isMandatory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-sec-fund-pp:PensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:PublicPensionPlan ;
    skos:definition "pension plan administered by an institution other than general government" ;
    skos:note "Private pension plans may be administered directly by a private sector employer acting as the plan sponsor, a private pension fund substitute for public pension plans. In some countries, these may include plans for public sector workers." .

fibo-sec-fund-pp:VoluntaryOccupationalPensionPlan a owl:Class ;
    rdfs:label "voluntary occupational pension plan",
        "自愿性职业养老金计划（voluntary occupational pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "雇主自愿设立的职业养老金计划（包括作为雇佣安排一部分自动加入的情形）。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty fibo-sec-fund-pp:isMandatory ],
        fibo-sec-fund-pp:OccupationalPensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:MandatoryOccupationalPensionPlan ;
    skos:definition "occupational pension plan for which establishment is voluntary for employers (including those in which there is automatic enrollment as part of an employment contract or where the law requires employees to join plans set up on a voluntary basis by their employers)" ;
    skos:note "In some countries, employers can on a voluntary basis establish occupational plans that provide benefits that replace at least partly those of the social security system. These plans are classified as voluntary, even though employers must continue sponsoring these plans in order to be exempted (at least partly) from social security contributions." .

fibo-sec-fund-pp:VoluntaryPersonalPensionPlan a owl:Class ;
    rdfs:label "voluntary personal pension plan",
        "自愿性个人养老金计划（voluntary personal pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "个人自愿参加的个人养老金计划。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty fibo-sec-fund-pp:isMandatory ],
        fibo-sec-fund-pp:PersonalPensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:MandatoryPersonalPensionPlan ;
    skos:definition "personal pension plan in which participation is voluntary for individuals" ;
    skos:note "By law in some jurisdictions, individuals are not obliged to participate in a pension plan. They are not required to make pension contributions to a pension plan. Voluntary personal plans include those plans that individuals must join if they choose to replace part of their social security benefits with those from personal pension plans." .

fibo-sec-fund-pp: a owl:Ontology ;
    rdfs:label "Pension Plans Ontology"@en,
        "养老金计划本体（Pension Plans Ontology）"@zh ;
    dcterms:abstract "This ontology defines fundamental concepts about pension plans, and in particular, private pension plans, based on part on the classification and glossary of private pension systems developed by the OECD. Coverage is quite broad and is intended to be agnostic to jurisdiction as is the OECD classification scheme. In other words, not all classifications apply in all jurisdictions. Jurisdiction-specific extensions may be developed as use cases mandate, but the scaffolding provided in this ontology is sufficient to cover all jurisdictions that the OECD used in developing the classification scheme." ;
    dcterms:contributor "Intuitive Technology Partners Inc.",
        "John F. Gemski",
        "ProBanker Simulations, LLC",
        "T. Rowe Price",
        "Tahoe Blue",
        "Thematix Partners LLC" ;
    dcterms:license """Copyright (c) 2026 EDM Association dba EDM Council, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

		See https://opensource.org/licenses/MIT.""" ;
    rdfs:comment "定义养老金计划（pension plan）：确定缴费型（DC）与确定给付型（DB）等形态。"@zh ;
    owl:imports fibo-fbc-dae-gty:,
        fibo-fbc-pas-caa:,
        fibo-fnd-agr-agr:,
        fibo-fnd-agr-ctr:,
        fibo-fnd-gao-obj:,
        fibo-fnd-utl-av:,
        fibo-sec-fund-fund:,
        cmns-av:,
        cmns-cls:,
        cmns-dsg:,
        cmns-doc:,
        cmns-org: ;
    owl:versionIRI fibo-sec-fund-pp: ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Provisional ;
    cmns-av:copyright "Copyright (c) 2026 EDM Association dba EDM Council, Inc." .

fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlan a owl:Class ;
    rdfs:label "defined benefit occupational pension plan",
        "待遇确定型职业养老金计划（defined benefit occupational pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "按预定待遇公式预先确定退休待遇的职业养老金计划，由发起雇主承担给付责任。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:someValuesFrom fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier ],
        fibo-sec-fund-pp:OccupationalPensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:DefinedContributionOccupationalPensionPlan ;
    skos:definition "occupational pension plan that provides retirement benefits determined in advance according to a prescribed benefit formula, with the sponsoring employer or plan sponsor bearing the primary responsibility for financing any shortfall required to provide the promised benefits" ;
    cmns-av:abbreviation "DB" .

fibo-sec-fund-pp:DefinedContributionOccupationalPensionPlan a owl:Class ;
    rdfs:label "defined contribution occupational pension plan",
        "缴费确定型职业养老金计划（defined contribution occupational pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "计划发起人支付固定缴费、且无法定或推定义务支付额外缴费的职业养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:OccupationalPensionPlan ;
    skos:definition "occupational pension plan under which the plan sponsor pays fixed contributions and has no legal or constructive obligation to pay further contributions to an ongoing plan in the event of unfavourable plan experience" ;
    skos:note "The IASB's definition of constructive obligations in pension markets is defined in IAS 37 as an obligation that derives from an entity's actions where: a) by an established pattern of past practice, published policies or a sufficiently specific current standard, the entity has indicated to other parties that it will accept responsibilities; and, b) as a result, the entity has created a valid expectation on the part of those other parties that it will discharge those responsibilities." ;
    cmns-av:abbreviation "DC" ;
    cmns-av:usageNote "Note that the sponsor responsibility is a defining characteristic in this ontology." .

fibo-sec-fund-pp:FundedPensionPlan a owl:Class ;
    rdfs:label "funded pension plan",
        "基金制养老金计划（funded pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "积累专门资产以覆盖计划负债的养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:PensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:UnfundedPensionPlan ;
    skos:definition "pension plan that accumulates dedicated assets to cover the plan's liabilities" ;
    cmns-av:explanatoryNote "Note that its commitments could be unfunded in the sense that the assets are insufficient to cover the commitments, i.e., underfunded.",
        "These assets are assigned by law or contract to the pension plan. Their use is restricted to the payment of pension plan benefits." .

fibo-sec-fund-pp:IndividualRetirementAccount a owl:Class ;
    rdfs:label "individual retirement account",
        "个人退休账户（individual retirement account）"@zh ;
    rdfs:comment "记录归属于个人之金额的退休账户（IRA）。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:RetirementAccount ;
    skos:definition "retirement account in which amounts attributable to an individual are recorded" ;
    skos:note "An individual retirement account may be established pursuant to a pension plan, or it may be established independently." ;
    cmns-av:explanatoryNote "The term 'individual retirement account' is also the designation of a particular U.S. legal/tax concept, Individual Retirement Account (IRA). This class represents the more general notion of an individual account established by an individual for the purposes of managing funds designated for retirement purposes." .

fibo-sec-fund-pp:MandatoryOccupationalPensionPlan a owl:Class ;
    rdfs:label "mandatory occupational pension plan",
        "强制性职业养老金计划（mandatory occupational pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "雇主必须参加的职业养老金计划。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty fibo-sec-fund-pp:isMandatory ],
        fibo-sec-fund-pp:OccupationalPensionPlan ;
    skos:definition "occupational pension plan for which participation is mandatory for employers" ;
    skos:note "Some employers are obliged by law to participate in a pension plan, depending on the jurisdiction. In such cases, employers must set up (and make contributions to) occupational pension plans which employees will normally be required to join. Where employers are obliged to offer an occupational pension plan, but the employees' membership is on a voluntary basis, these plans are also considered mandatory." .

fibo-sec-fund-pp:MandatoryPersonalPensionPlan a owl:Class ;
    rdfs:label "mandatory personal pension plan",
        "强制性个人养老金计划（mandatory personal pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "个人必须加入、或可接收强制性养老金缴费的个人养老金计划。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty fibo-sec-fund-pp:isMandatory ],
        fibo-sec-fund-pp:PersonalPensionPlan ;
    skos:definition "personal pension plan that individuals must join or that are eligible to receive mandatory pension contributions" ;
    skos:note "Individuals may be required to make pension contributions to a pension plan of their choice - normally within a certain range of choices - or to a specific pension plan." .

fibo-sec-fund-pp:PensionInsuranceContract a owl:Class ;
    rdfs:label "pension insurance contract",
        "养老金保险合同（pension insurance contract）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "规定养老金计划向保险企业缴费、以换取由保险企业支付养老金计划待遇的保险合同。"@zh ;
    rdfs:subClassOf fibo-fbc-dae-gty:InsurancePolicy ;
    skos:definition "insurance contract that specifies pension plan contributions to an insurance undertaking in exchange for which the pension plan benefits will be paid when the members reach a specified retirement age or on earlier exit of members from the plan" ;
    skos:note "Most countries limit the integration of pension plans only into pension funds, as the financial vehicle of the pension plan. Other countries also consider the pension insurance contract as the financial vehicle for pension plans." .

fibo-sec-fund-pp:PublicPensionFund a owl:Class ;
    rdfs:label "public pension fund",
        "公共养老基金（public pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "受公共部门法律监管的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-fund:PensionFund ;
    skos:definition "pension fund that is regulated under public sector law" .

fibo-sec-fund-pp:PublicPensionPlan a owl:Class ;
    rdfs:label "public pension plan",
        "公共养老金计划（public pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "由一般政府（即中央、州和地方政府以及社会保障机构等其他公共部门机构）管理的养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:PensionPlan ;
    skos:definition "pension plan administered by the general government (that is central, state, and local governments, as well as other public sector bodies such as social security institutions)" ;
    skos:note "Public pension plans have been traditionally PAYG-financed, but some OECD countries have partial funding of public pension liabilities or have replaced these plans by private pension plans." .

fibo-sec-fund-pp:RelatedMemberPensionFund a owl:Class ;
    rdfs:label "related member pension fund",
        "关联成员养老基金（related member pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "由数量有限的关联成员资产组成、且成员均为该养老基金管理机构成员的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:ClosedPensionFund ;
    owl:disjointWith fibo-sec-fund-pp:IndividualPensionFund,
        fibo-sec-fund-pp:SingleEmployerPensionFund ;
    skos:definition "pension fund that comprises the assets of a limited number of related members who are all in the governing body of the pension fund" .

fibo-sec-fund-pp:RetirementArrangement a owl:Class ;
    rdfs:label "retirement arrangement",
        "退休安排（retirement arrangement）"@zh ;
    rdfs:comment "确立为退休积累或提供财务资源之条件的安排。"@zh ;
    rdfs:subClassOf fibo-fnd-agr-agr:Agreement ;
    skos:definition "arrangement that establishes conditions for the accumulation or provision of financial resources for retirement" .

fibo-sec-fund-pp:isUnprotected a owl:DatatypeProperty ;
    rdfs:label "is unprotected"@en,
        "是否无保障（is unprotected）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "若为真，表明养老金计划/基金本身或养老金提供方不提供任何投资回报或待遇保证。"@zh ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates, if true, that the pension plan/fund itself or the pension provider does not offer any investment return or benefit guarantees or promises covering the whole plan/fund"@en .

fibo-sec-fund-pp:IndividualPensionFund a owl:Class ;
    rdfs:label "individual pension fund",
        "个人养老基金（individual pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "支持一个或多个个人养老金计划、并按成员个人为基础维持资产和权益的封闭型养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:ClosedPensionFund ;
    owl:disjointWith fibo-sec-fund-pp:SingleEmployerPensionFund ;
    skos:definition "closed pension fund that supports one or more individual pension plans and in which assets and entitlements are maintained on an individual-member basis" .

fibo-sec-fund-pp:PensionAccount a owl:Class ;
    rdfs:label "pension account",
        "养老金账户（pension account）"@zh ;
    rdfs:comment "记录与养老金计划相关之金额的退休账户。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-doc:isSpecifiedIn ;
            owl:someValuesFrom fibo-sec-fund-pp:PensionPlan ],
        fibo-sec-fund-pp:RetirementAccount ;
    skos:definition "retirement account in which amounts associated with a pension plan are recorded" ;
    skos:editorialNote "Could create new properties for 'is account of'/'has account' for the relationship between the account and the plan instead of using specifies/is specified in.",
        "Need to determine how/whether to link an account to any specific interest in a given pension fund - percentage ownership, number of shares ... maybe that the account records an interest in the fund?" ;
    skos:note "A pension account may record (1) a monetary balance, (2) units in a pooled investment, (3) contributions and earnings, (4)  accrued benefits, (5) a notional amount, or (6) some combination thereof. Thus, the relationship with a particular fund is optional, and may record an interest in multiple funds, depending on the plan." .

fibo-sec-fund-pp:PersonalPensionPlan a owl:Class ;
    rdfs:label "personal pension plan",
        "个人养老金计划（personal pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "无须与雇佣或职业关系相关联的养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:PensionPlan ;
    owl:disjointWith fibo-sec-fund-pp:OccupationalPensionPlan ;
    skos:definition "pension plan that does not need to be linked to an employment or professional relationship" ;
    skos:note "Personal plans are established and administered directly by a pension fund or a financial institution acting as pension provider without any intervention of employers. Individuals independently purchase and select material aspects of the arrangements. The employer may nonetheless make contributions to personal pension plans. Some personal plans may have restricted membership." .

fibo-sec-fund-pp:RetirementAccount a owl:Class ;
    rdfs:label "retirement account",
        "退休账户（retirement account）"@zh ;
    rdfs:comment "记录旨在为退休期间提供收入或财务资源之金额的账户。"@zh ;
    rdfs:subClassOf fibo-fbc-pas-caa:InvestmentAccount ;
    skos:definition "account in which amounts intended to provide income or financial resources during retirement are recorded" ;
    skos:note "The term 'amounts' is used intentionally here as the account is the record, not necessarily the assets themselves, and because 'amounts' can encompass balances or entitlements that do not correspond to a separately segregated pool of assets." .

fibo-sec-fund-pp:UnfundedPensionPlan a owl:Class ;
    rdfs:label "unfunded pension plan",
        "现收现付养老金计划（unfunded pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "直接以计划发起人或提供方和/或计划参与人的缴费支付的养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:PensionPlan ;
    skos:definition "pension plan that is financed directly from contributions from the plan sponsor or provider and/or the plan participant" ;
    skos:note "Note that this is not the same as a plan whose funding source(s) lack sufficient funds to pay out committed obligations.",
        "Unfunded pension plans are said to be paid on a current disbursement method (also known as the pay-as-you-go, PAYG, method). Unfunded plans may still have associated reserves to cover immediate expenses or smooth contributions within given time periods. Most OECD countries do not allow unfunded private pension plans." ;
    cmns-av:abbreviation "PAYG" ;
    cmns-av:synonym "PAYG pension plan",
        "pay-as-you-go pension plan" .

fibo-sec-fund-pp:isFundedBy a owl:ObjectProperty ;
    rdfs:label "is funded by"@en,
        "由……提供资金（is funded by）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "将计划或基金与为其提供资金的协议或其他资金安排关联起来。"@zh ;
    rdfs:subPropertyOf cmns-org:isProvidedBy ;
    owl:inverseOf fibo-sec-fund-pp:providesFundingFor ;
    skos:definition "links a plan or fund to an agreement or other funding arrangement that funds it"@en .

fibo-sec-fund-pp:providesFundingFor a owl:ObjectProperty ;
    rdfs:label "provides funding for"@en,
        "为……提供资金（provides funding for）"@zh ;
    rdfs:comment "将协议或资金安排与其所资助的事物关联起来。"@zh ;
    rdfs:subPropertyOf cmns-org:provides ;
    owl:inverseOf fibo-sec-fund-pp:isFundedBy ;
    skos:definition "relates an agreement or funding arrangement to something that funds it"@en .

fibo-sec-fund-pp:SingleEmployerPensionFund a owl:Class ;
    rdfs:label "single employer pension fund",
        "单一雇主养老基金（single employer pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "汇集单一发起人所设养老金计划资产的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:ClosedPensionFund ;
    skos:definition "pension fund that pools the assets of pension plans established by a single sponsor" .

fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlanClassifier a owl:Class ;
    rdfs:label "defined benefit occupational pension plan classifier",
        "待遇确定型职业养老金计划分类器（defined benefit occupational pension plan classifier）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "对按预定待遇公式预先确定退休待遇、并由发起雇主承担义务的职业计划进行分类的分类器。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom fibo-sec-fund-pp:DefinedBenefitOccupationalPensionPlan ],
        cmns-cls:Classifier ;
    skos:definition "classifier for occupational plans that provide retirement benefits determined in advance according to a prescribed benefit formula, and whose sponsoring employer or plan sponsor bears the primary responsibility for financing any shortfall required to provide the promised benefits" ;
    skos:note "DB plans generally can be classified into one of three main types, 'traditional', 'mixed' and 'hybrid' plans." .

fibo-sec-fund-fund:PensionFund a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-sec-fund-pp:providesFundingFor ;
            owl:someValuesFrom fibo-sec-fund-pp:PensionPlan ] ;
    cmns-av:explanatoryNote "A pension fund is the pool of assets, typically forming an independent legal entity, that are bought with the contributions to a pension plan for the exclusive purpose of financing pension plan benefits. The plan/fund members have a legal or beneficial right or some other contractual claim against the assets of the pension fund. Pension funds take the form of either a special purpose entity with legal personality (such as a trust, foundation, or corporate entity) or a legally separated fund without legal personality managed by a dedicated provider (pension fund management company) or other financial institution on behalf of the plan/fund members." .

fibo-sec-fund-pp:ClosedPensionFund a owl:Class ;
    rdfs:label "closed pension fund",
        "封闭型养老基金（closed pension fund）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "成员资格限于特定人士或特定类别人士的养老基金。"@zh ;
    rdfs:subClassOf fibo-sec-fund-fund:PensionFund ;
    skos:definition "pension fund whose membership is restricted to specified persons or categories of persons" ;
    cmns-av:explanatoryNote "A closed pension fund is a pension fund whose membership is restricted to a defined group of people rather than being open to the general public or any employer. Typically, membership is limited to employees of a particular employer, a group of employers, members of an association, or another specified category. A closed pension fund can continue receiving contributions and paying benefits. The term simply refers to who is eligible to participate, not whether new money can enter the fund." .

fibo-sec-fund-pp:OccupationalPensionPlan a owl:Class ;
    rdfs:label "occupational pension plan",
        "职业养老金计划（occupational pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "与计划成员和设立计划的实体（计划发起人）之间雇佣或职业关系相关联的养老金计划。"@zh ;
    rdfs:subClassOf fibo-sec-fund-pp:PensionPlan ;
    skos:definition "pension plan linked to an employment or professional relationship between the plan member and the entity that establishes the plan (the plan sponsor)" ;
    skos:note "Occupational plans may be established by employers or groups thereof (e.g. industry associations) and labour or professional associations, jointly or separately. The plan may be administered directly by the plan sponsor or by an independent entity (a pension fund or a financial institution acting as pension provider). In the latter case, the plan sponsor may still have oversight responsibilities over the operation of the plan." .

fibo-sec-fund-pp:isMandatory a owl:DatatypeProperty ;
    rdfs:label "is mandatory"@en,
        "是否强制（is mandatory）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "表明某事物是否为必需。"@zh ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates, if true, that something is required"@en .

fibo-sec-fund-pp:PensionPlan a owl:Class ;
    rdfs:label "pension plan",
        "养老金计划（pension plan）"@zh ;
    dcterms:source "Private Pensions - OECD Classification and Glossary, available at https://www.oecd.org/content/dam/oecd/en/publications/reports/2005/03/private-pensions_g1gh562b/9789264017009-en-fr.pdf." ;
    rdfs:comment "具有明确退休目标的具有法律约束力的安排，或为满足税收相关条件或合同条款而设定受益安排的安排。"@zh ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty fibo-sec-fund-pp:isUnprotected ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( fibo-sec-fund-fund:PensionFund fibo-sec-fund-pp:PensionInsuranceContract ) ] ;
            owl:onProperty fibo-sec-fund-pp:isFundedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-sec-fund-pp:PensionAccount ;
            owl:onProperty cmns-doc:specifies ],
        fibo-fnd-agr-agr:Agreement,
        fibo-sec-fund-pp:RetirementArrangement ;
    skos:definition "legally binding arrangement having an explicit retirement objective or - in order to satisfy tax related conditions or contract provisions - the benefits can not be paid at all or without a significant penalty unless the beneficiary is older than a legally defined retirement age" ;
    cmns-av:explanatoryNote "A pension plan is a retirement arrangement that establishes conditions for contributions, accrual of pension benefits, or provision of pension benefits to members or beneficiaries, in other words.",
        "This contract may be part of a broader employment contract, it may be set forth in the plan rules or documents, or it may be required by law. The elements of the pension plan may be mandated by law or statute or set forth as pre-requisites for special tax treatment, as is the case for many tax qualified savings or retirement programmes designed to provide the plan's members and beneficiaries with an income after retirement. In addition to having an explicit retirement objective, pension plans may offer additional benefits, such as disability, sickness, and survivors benefits." .

